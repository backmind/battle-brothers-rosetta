        mode = "pattern"
        en = "[color=<this.Const.UI.Color.PositiveValue>]+<1*this.m.RageStacks>[/color] damage dealt"
        es = "[color=<this.Const.UI.Color.PositiveValue>]+<1*this.m.RageStacks>[/color] Daño"
    }
    {
        // text = "[color=" + this.Const.UI.Color.PositiveValue + "]+" + 1 * this.m.RageStacks + "[/color] Resolve"
