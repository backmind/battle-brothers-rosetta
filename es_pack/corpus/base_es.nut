        es = "<this.World.FactionManager.getFaction(this.m.Faction).addPlayerRelation(this.Const.World.Assets.RelationContractCancel, Romper un contrato)>"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\locations\abandoned_fortress_location.nut
    {
        en = "The remains of an old fortress. It looks entirely abandoned."
        es = "Los restos de una antigua fortaleza. Parece completamente abandonada."
    }
    {
        en = "Abandoned Fortress"
        es = "Fortaleza abandonada"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\locations\bandit_camp_location.nut
    {
        en = "A fortified wooden encampment used by outlaws to stash their loot, rest in between raids and play drinking games."
        es = "Un campamento de madera fortificado utilizado por forajidos para esconder su botín, descansar entre incursiones y hacer juegos de borracho."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\locations\bandit_hideout_location.nut
    {
        en = "An abandoned homestead with a collapsed roof."
        es = "Una casa abandonada con el techo derrumbado."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\locations\bandit_ruins_location.nut
    {
        en = "These ancient ruins cast their shadows far over the surrounding sands."
        es = "Estas antiguas ruinas proyectan sus sombras sobre las arenas circundantes."
    }
    {
        en = "A once proud fortress now lying in ruins."
        es = "Una otrora orgullosa fortaleza que ahora está en ruinas."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\locations\barbarian_camp_location.nut
    {
        en = "A set of fur jurts typical for the barbarians of the northern regions."
        es = "Un montón de yurtas de pieles típicas de los bárbaros de las regiones del norte."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\locations\barbarian_sanctuary_location.nut
    {
        en = "Barbarians have flocked to this place and set up camp around a site of worship. A lot of fierce northern warriors are likely to be found nearby."
        es = "Los bárbaros han acudido en masa a este lugar y han establecido un campamento alrededor de un lugar de culto. Es probable que cerca se encuentren muchos feroces guerreros del norte."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\locations\barbarian_shelter_location.nut
    {
        en = "A couple of simple barbarian fur huts huddled down in a circle."
        es = "Un par de sencillas chozas de pieles bárbaras se apiñaban formando un círculo."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\locations\battlefield_location.nut
    {
        en = "A battle took place here a short while ago. Broken and lost equipment, blood stains and torn ground tell of a determined fight."
        es = "Hace poco tuvo lugar aquí una batalla. Equipos rotos y perdidos, manchas de sangre y suelo destrozado hablan de una lucha decidida."
    }
    {
        en = "Battle Site"
        es = "Sitio de batalla"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\locations\goblin_camp_location.nut
    {
        en = "A makeshift encampment erected by goblins for shelter and stashing supplies."
        es = "Un campamento improvisado erigido por goblins para refugiarse y guardar suministros."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\locations\goblin_city_location.nut
    {
        en = "A great goblin city nested into the remains of an ancient fortress. Protected by dark and towering walls, it is host to a standing army of vicious greenskins."
        es = "Una gran ciudad de goblins anidada en los restos de una antigua fortaleza. Protegida por oscuros e imponentes muros, alberga un ejército permanente de feroces pieles verdes."
    }
    {
        en = "Rul'gazhix"
        es = ""
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\locations\goblin_outpost_location.nut
    {
        en = "A defensible outpost erected by goblins."
        es = "Un puesto de avanzada defendible erigido por goblins."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\locations\goblin_settlement_location.nut
    {
        en = "The gates to a great underground Goblin city, its maze-like tunnels teeming with vicious greenskins."
        es = "Las puertas de una gran ciudad subterránea de goblins, con sus túneles laberínticos repletos de feroces pieles verdes."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\locations\legendary\abandoned_village_location.nut
    {
        en = "A seemingly abandoned village, with a towering statue dominating the square."
        es = "Un pueblo aparentemente abandonado, con una imponente estatua que domina la plaza."
    }
    {
        en = "Abandoned Village"
        es = "Aldea abandonada"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\locations\legendary\ancient_statue_location.nut
    {
        en = "A huge statue glittering in the sun that towers over the surrounding landscape."
        es = "Una enorme estatua que brilla bajo el sol y se eleva sobre el paisaje circundante."
    }
    {
        en = "Ancient Statue"
        es = "Estatua Antigua"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\locations\legendary\ancient_temple_location.nut
    {
        en = "The sunken and half buried entrance to some sort of temple or mausoleum that sticks out of the ground."
        es = "La entrada hundida y medio enterrada a una especie de templo o mausoleo que sobresale del suelo."
    }
    {
        en = "Ancient Temple"
        es = "Templo Antiguo"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\locations\legendary\ancient_watchtower_location.nut
    {
        en = "A thin spire reaching high into the sky. The view from the top must be staggering."
        es = "Una delgada aguja que se eleva hacia el cielo. La vista desde la cima debe ser asombrosa."
    }
    {
        en = "Ancient Spire"
        es = "Aguja Antigua"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\locations\legendary\artifact_reliquary_location.nut
    {
        en = "A collapsed ruin from days long past. The occasional flicker of torchlight betrays the presence of current inhabitants, as do the strange sounds eminating from deep within."
        es = "Una ruina derrumbada de tiempos pasados. El destello ocasional de una antorcha delata la presencia de sus habitantes, al igual que los extraños sonidos que emanan de sus profundidades."
    }
    {
        en = "Artifact Reliquary"
        es = "Relicario de artefactos"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\locations\legendary\black_monolith_location.nut
    {
        en = "A pitch black monolith towers over the surrounding lands, emitting a baleful aura. No living being dares drawing close to it."
        es = "Un monolito de tono ébano se eleva sobre las tierras circundantes, emitiendo un aura siniestra. Ningún ser vivo se atreve a acercarse a él."
    }
    {
        en = "Black Monolith"
        es = "Monolito Negro"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\locations\legendary\fountain_of_youth_location.nut
    {
        en = "A small clearing in the forest centered around a curios, slender tree. Something seems to be off about this tree but it is difficult to make out from afar."
        es = "Un pequeño claro en el bosque centrado alrededor de un árbol delgado y curioso. Algo parece estar mal en este árbol, pero es difícil distinguirlo desde lejos."
    }
    {
        en = "Grotesque Tree"
        es = "Árbol Grotesco"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\locations\legendary\icy_cave_location.nut
    {
        en = "A cave amidst a sea of snow and rock. A thick gate of icicles keeps your entrance well stayed."
        es = "Una cueva en medio de un mar de nieve y rocas. Una gruesa puerta de carámbanos mantiene la entrada bien fijada."
    }
    {
        en = "Icy Cave"
        es = "Cueva helada"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\locations\legendary\kraken_cult_location.nut
    {
        en = "Stone circles and pillars with strange markings hint at something eerie looming in the area."
        es = "Los círculos de piedra y los pilares con extrañas marcas insinúan que algo espeluznante se avecina en la zona."
    }
    {
        en = "Stone Pillars"
        es = "Pilares de piedra"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\locations\legendary\land_ship_location.nut
    {
        en = "Atop some trees sits a large wooden structure. As strange as it seems, it looks a lot like a ship."
        es = "En lo alto de algunos árboles se encuentra una gran estructura de madera. Por extraño que parezca, se parece mucho a un barco."
    }
    {
        en = "Curious Ship Wreck"
        es = "Naufragio curioso"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\locations\legendary\meteorite_location.nut
    {
        en = "A great crater in the ground made by a rock that fell from the sky. A mausoleum was built around it a long ago, and to this day people from all corners of the world set out to pilgrimage here."
        es = "Un gran cráter en el suelo formado por una roca que cayó del cielo. Hace mucho tiempo se construyó un mausoleo a su alrededor y hasta el día de hoy personas de todos los rincones del mundo peregrinan aquí."
    }
    {
        en = "The Fallen Star"
        es = "La Estrella Caída"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\locations\legendary\oracle_location.nut
    {
        en = "The remains of a temple that once housed an oracle in an age long past. Although ruined now, people still flock to it and have visions of things that will come to pass."
        es = "Los restos de un templo que alguna vez albergó un oráculo en una época pasada. Aunque ahora está en ruinas, la gente todavía acude a él y tiene visiones de cosas que sucederán."
    }
    {
        en = "The Oracle"
        es = "El Oráculo"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\locations\legendary\sunken_library_location.nut
    {
        en = "Shimmering in the sun, golden domes peer out of the sand and give away that something larger lies dormant here, sunken and buried under the sand for ages."
        es = "Brillando al sol, las cúpulas doradas asoman desde la arena y delatan que algo más grande yace dormido aquí, hundido y enterrado bajo la arena durante siglos."
    }
    {
        en = "Sunken Library"
        es = "Biblioteca Hundida"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\locations\legendary\tundra_elk_location.nut
    {
        en = "A lone elk grazes on green meadows, in the shadow of some trees and by a small lake."
        es = "Un alce solitario pasta en prados verdes, a la sombra de algunos árboles y junto a un pequeño lago."
    }
    {
        en = "Hunting Ground"
        es = "Coto de Caza"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\locations\legendary\unhold_graveyard_location.nut
    {
        en = "A wide field littered with gigantic bones and skulls. Some are bleached to white but some are fresh and still have flesh attached to them."
        es = "Un amplio campo lleno de huesos y cráneos gigantes. Algunos están blanqueados hasta quedar blancos, pero otros están frescos y todavía tienen carne adherida."
    }
    {
        en = "Unhold Graveyard"
        es = "Cementerio de Trolls"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\locations\legendary\vulcano_location.nut
    {
        en = "Once a thriving city, now but ruins covered in ash. A fallen metropolis with many names, it has become an object of cultural and religious pride for north and south alike."
        es = "Una vez fue una ciudad próspera, ahora son ruinas cubiertas de ceniza. Una metrópolis caída con muchos nombres, se ha convertido en un objeto de orgullo cultural y religioso tanto para el norte como para el sur."
    }
    {
        en = "The Ancient City"
        es = "La Ciudad Antigua"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\locations\legendary\waterwheel_location.nut
    {
        en = "A small watermill with a stony house at its side. It looks like someone might be living here."
        es = "Un pequeño molino de agua con una casa de piedra a su lado. Parece que alguien podría estar viviendo aquí."
    }
    {
        en = "Watermill"
        es = "Molino de agua"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\locations\legendary\witch_hut_location.nut
    {
        en = "A skewed and withered hut that looks like it could collapse at any moment. Smoke is rising from an awry chimney."
        es = "Una cabaña torcida y marchita que parece que podría derrumbarse en cualquier momento. Sale humo de una chimenea torcida."
    }
    {
        en = "Witch Hut"
        es = "Cabaña de la bruja"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\locations\noble_camp_location.nut
    {
        en = "A sea of tents, host to the army of a noble house."
        es = "Un mar de tiendas de campaña, sede del ejército de una casa noble."
    }
    {
        en = "Army Camp"
        es = "Campamento del ejército"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\locations\nomad_hidden_camp_location.nut
    {
        en = "Nomads hide their camps well to avoid unwanted visitors or pursuing soldiers of the city states."
        es = "Los nómadas esconden bien sus campamentos para evitar visitantes no deseados o soldados perseguidores de las ciudades-estado."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\locations\nomad_tent_city_location.nut
    {
        en = "A large collection of colorful nomad huts and tents huddled together in the desert."
        es = "Una gran colección de coloridas cabañas y tiendas nómadas apiñadas en el desierto."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\locations\nomad_tents_location.nut
    {
        en = "A small camp of nomad tents that can be packed up and moved quickly."
        es = "Un pequeño campamento de tiendas nómadas que se puede empacar y trasladar rápidamente."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\locations\orc_camp_location.nut
    {
        en = "A small camp erected by Orcs, either as part of a large horde in the vicinity or a small tribes of its own. They'll eventually move on to hunt and pillage elsewhere."
        es = "Un pequeño campamento erigido por orcos, ya sea como parte de una gran horda en los alrededores o como una pequeña tribu propia. Eventualmente se dedicarán a cazar y saquear en otros lugares."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\locations\orc_cave_location.nut
    {
        en = "This cave has been occupied by greenskins and turned into a foul-smelling camp."
        es = "Esta cueva ha sido ocupada por pieles verdes y convertida en un campamento maloliente."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\locations\orc_fortress_location.nut
    {
        en = "A mighty fortress made from massive iron wood logs and covered in tribal paintings of war. The bloodthirsty shouts of orcs echoing behind the walls can be heard from afar."
        es = "Una poderosa fortaleza hecha de enormes troncos de madera y hierro y cubierta con pinturas tribales de guerra. Los gritos sanguinarios de los orcos que resuenan detrás de los muros se pueden escuchar desde lejos."
    }
    {
        en = "Fortress of the Warlord"
        es = "Fuerte del Señor de la guerra"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\locations\orc_settlement_location.nut
    {
        en = "A large and foul-smelling sea of tents, with a warlord's tent and throne-room in the middle, the largest of all. It's home to a whole tribe until they move on to hunt and raid elsewhere."
        es = "Un mar grande y maloliente de tiendas de campaña, con la tienda de un Señor de la guerra y una sala del trono en el medio, la más grande de todas. Es el hogar de toda una tribu hasta que se van a cazar y atacar en otros lugares."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\locations\undead_buried_castle_location.nut
    {
        en = "Sunken into the ground, this castle has been long abandoned, only to give refuge to much darker creatures."
        es = "Hundido en el suelo, este castillo ha estado abandonado durante mucho tiempo, sólo para dar refugio a criaturas mucho más oscuras."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\locations\undead_crypt_location.nut
    {
        en = "A long forgotten crypt haunted by the ghosts of the past. The dead won't find sleep here."
        es = "Una cripta olvidada hace mucho tiempo perseguida por los fantasmas del pasado. Los muertos no encontrarán sueño aquí."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\locations\undead_graveyard_location.nut
    {
        en = "A place where people have buried their dead, placing them down for their last rest. Or at least they hoped so."
        es = "Un lugar donde la gente enterraba a sus muertos, colocándolos para su último descanso. O al menos así lo esperaban."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\locations\undead_mass_grave_location.nut
    {
        en = "The sad remains of a merciless battle, an epidemic or other catastrophe. The survivors dug a large hole and piled all the corpses into it to get rid of them quickly."
        es = "Los tristes restos de una batalla despiadada, una epidemia u otra catástrofe. Los supervivientes cavaron un gran hoyo y amontonaron todos los cadáveres en él para deshacerse de ellos rápidamente."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\locations\undead_necromancers_lair_location.nut
    {
        en = "A necromancer has made this lair his refuge for practicing dark rituals undisturbed."
        es = "Un nigromante ha hecho de esta guarida su refugio para practicar rituales oscuros sin ser molestado."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\locations\undead_necropolis_location.nut
    {
        en = "Once a thriving human settlement, this place has been defiled and fallen into ruin, turned into a necropolis of the undead. Waves of walking corpses pour forth to spread terror and fear in the surrounding lands."
        es = "Este lugar, que alguna vez fue un próspero asentamiento humano, ha sido profanado y está en ruinas, convertido en una necrópolis de no-muertos. Oleadas de cadáveres andantes se derraman para sembrar el terror y el miedo en las tierras circundantes."
    }
    {
        // this.world_entity.setName("Ruins of " + _n);
        mode = "pattern"
        en = "Ruins of <this.getName()>"
        es = "Ruinas de <this.getName()>"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\locations\undead_vampire_coven_location.nut
    {
        en = "Hidden for centuries, this ancient place became a safe haven for a coven of hemovores."
        es = "Oculto durante siglos, este antiguo lugar se convirtió en un refugio seguro para un aquelarre de chupasangres."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\party.nut
    {
        en = "Unknown troops"
        es = "Tropas desconocidas"
    }
    {
        // text = "Hired by " + f.getName()
        mode = "pattern"
        en = "Hired by <faction:str>"
        es = "Contratados por <faction:t>"
    }
    {
        // text = "From " + f.getName()
        mode = "pattern"
        en = "From <f.getName()>"
        es = "Desde <f.getName()>"
    }
    {
        en = "Fighting"
        es = ""
    }
    {
        en = "orders"
        es = ""
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\settlement.nut
    {
        en = "goods"
        es = ""
    }
    {
        // text = "Ruins of " + this.getName()
        mode = "pattern"
        en = "Ruins of <this.getName()>"
        es = "Ruinas de <this.getName()>"
    }
    {
        en = "Only ruins are left of what was once a formidable castle."
        es = "Sólo las ruinas de lo que una vez fue un formidable castillo."
    }
    {
        en = "Only ruins are left of what was once a flourishing town."
        es = "Sólo las ruinas de lo que una vez fue una ciudad floreciente."
    }
    {
        en = "You've never been to this place."
        es = "Nunca has estado en este lugar."
    }
    {
        // text = "Relations: " + f.getPlayerRelationAsText()
        mode = "pattern"
        en = "Relations: <f.getPlayerRelationAsText()>"
        es = "Relaciones: <f.getPlayerRelationAsText()>"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\settlements\buildings\alchemist_building.nut
    {
        en = "Alchemist"
        es = "Alquimista"
    }
    {
        en = "Exotic and dangerous alchemical contraptions can be bought here"
        es = "Aquí se pueden comprar artilugios alquímicos exóticos y peligrosos"
    }
    {
        en = "shop"
        es = ""
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\settlements\buildings\armorsmith_building.nut
    {
        en = "Armorer"
        es = "Armero"
    }
    {
        en = "This armorer's workshop is the right place to look for well-made and durable protection"
        es = "El taller de este armero es el lugar adecuado para buscar una protección duradera y bien hecha"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\settlements\buildings\barber_building.nut
    {
        en = "Barber"
        es = "Barbero"
    }
    {
        en = "Customize the appearance of your men at the barber"
        es = "Personaliza la apariencia de tus hombres en la barbería"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\settlements\buildings\crowd_building.nut
    {
        en = "Hire"
        es = "Contratar"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\settlements\buildings\fletcher_building.nut
    {
        en = "Fletcher"
        es = "Flechero"
    }
    {
        en = "All kinds of expertly crafted ranged weaponry can be found here"
        es = "Aquí se pueden encontrar todo tipo de armas a distancia diseñadas por expertos artesanos"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\settlements\buildings\kennel_building.nut
    {
        en = "Kennel"
        es = "Perrera"
    }
    {
        en = "Strong and fast wardogs are bred and kept at this kennel"
        es = "En esta perrera se crían y mantienen perros de guerra fuertes y rápidos"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\settlements\buildings\marketplace_building.nut
    {
        en = "Marketplace"
        es = "Mercado"
    }
    {
        en = "A lively market offering all sorts of goods common in the region"
        es = "Un mercado animado que ofrece todo tipo de productos comunes en la región."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\settlements\buildings\port_building.nut
    {
        en = "A harbor that serves both foreign trading ships and local fishermen"
        es = "Un puerto que sirve tanto a barcos comerciales extranjeros como a pescadores locales"
    }
    {
        en = "A harbor that allows you to book passage by ship to other parts of the continent"
        es = "Un puerto te permite reservar pasajes en barco a otros puntos del continente"
    }
    {
        // ListName = "Sail to " + s.getName(),
        mode = "pattern"
        en = "Sail to <s.getName()>"
        es = "Navegar a <s.getName()>"
    }
    {
        // local desc = "{A fast ship | A sturdy ship | A cog | A longship | A small ship | A trading ship | A knarr | A local fishing boat | A creaking old ship} by the name of \'%shipname%\' {would take your company onboard and to %destname% | happens to sail to %destname% and would take your company onboard | is soon to depart and could be a way to safely and quickly make passage to %destname% | could provide a means to reach %destname% a lot faster than going overland | could drop you off at %destname% for a full purse of crowns}.";
        mode = "pattern"
        en = "\x7bA fast ship | A sturdy ship | A cog | A longship | A small ship | A trading ship | A knarr | A local fishing boat | A creaking old ship\x7d by the name of '%shipname%' \x7bwould take your company onboard and to %destname% | happens to sail to %destname% and would take your company onboard | is soon to depart and could be a way to safely and quickly make passage to %destname% | could provide a means to reach %destname% a lot faster than going overland | could drop you off at %destname% for a full purse of crowns\x7d."
        es = "\x7bUna veloz nave | Una resistente nave | Un barco | Un drakkar | Una pequeña nave | Un barco mercante | Un barcolargo nórdico | Un knorr | Un barco pesquero local | Un viejo y agrietado barco\x7d con el nombre de '%shipname%' \x7bllevaría a tu compañía a bordo hasta %destname% | resulta que navega hacia %destname% y llevaría a tu compañía a bordo | está a punto de partir y podría ser una forma de viajar de manera segura y rápida a %destname% | podría proporcionar un medio para llegar a %destname% mucho más rápido que por tierra | Podría dejarte en %destname% a cambio de una bolsa completa de coronas\x7d."
    }
