    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\actives\whip_slave_skill.nut
    {
        en = "Remind your indebted of who their master is by giving them a good whipping, so that they give their all - up to and including their very life."
        es = "Recuerda a tus endeudados quién es su amo dándoles una buena paliza, para que lo den todo, incluída su vida."
    }
    {
        // text = "Inflicts [color=" + this.Const.UI.Color.DamageValue + "]1[/color] - [color=" + this.Const.UI.Color.DamageValue + "]3[/color] damage that ignores armor to the target"
        mode = "pattern"
        en = "Inflicts [color=<this.Const.UI.Color.DamageValue>]1[/color] - [color=<this.Const.UI.Color.DamageValue>]3[/color] damage that ignores armor to the target"
        es = "Inflije [color=<this.Const.UI.Color.DamageValue>]1[/color] - [color=<this.Const.UI.Color.DamageValue>]3[/color] que ignora la armadura del objetivo"
    }
    {
        en = "Gives the targeted indebted the 'Whipped' status effect, increasing many of their stats for 2 rounds. The higher the level of the character using this skill, the higher the increase."
        es = "Le otorga al endeudado objetivo el efecto de estado 'Azotado', aumentando muchas de sus estadísticas durante 2 rondas. Cuanto mayor sea el nivel del personaje que usa esta habilidad, mayor será el aumento."
    }
    {
        en = "Resets the morale of the targeted indebted to 'Steady' if currently below"
        es = "Restablece la moral del endeudado objetivo a 'Firme' si actualmente está por debajo"
    }
    {
        // if (!this.isKindOf(target, "player") || target.getBackground() == null || target.getBackground().getID() != "background.slave")
        mode = "pattern"
        en = "<!this.isKindOf(target, , , player)||target.getBackground()==null||target.getBackground().getID()!=>background.slave"
        es = ""
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\actives\wither_skill.nut
