        en = "Fragile"
        es = "Frágil"
    }
    {
        en = "With a physique like an eggshell, this guy is not the natural born brawler."
        es = "Con un físico resistente como una cáscara de huevo, este tipo no es un luchador nato."
    }
    {
        // text = "[color=" + this.Const.UI.Color.NegativeValue + "]-10[/color] Hitpoints"
