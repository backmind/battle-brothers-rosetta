        es = "Tendón de Aquiles cortado"
    }
    {
        en = "An injury like this makes even the quickest man hobble across the battlefield."
        es = "Una lesión como esta hace que incluso el hombre más rápido cojee por el campo de batalla."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\injury\cut_arm_injury.nut
