    {
        // text = "Locked until " + (perk.Unlocks - player.getPerkPointsSpent()) + " more perk point is spent"
        mode = "pattern"
        en = "Locked until <perk.Unlocks-player.getPerkPointsSpent()> more perk point is spent"
        es = "Bloqueado hasta gastar <perk.Unlocks-player.getPerkPointsSpent()> punto de habilidad más"
