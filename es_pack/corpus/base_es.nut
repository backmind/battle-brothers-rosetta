        es = "\x7bObtendrás | Vas a recibir | Se te pagará | Son\x7d %reward_advance% coronas por adelantado, %reward_count% coronas por cabeza que traigas, \x7bpara hasta %maxcount% cabezas | y pagaré hasta %maxcount% cabezas | %maxcount% se dirige como máximo\x7d, y otro %reward_completion% cuando el trabajo esté terminado.%SPEECH_OFF%"
