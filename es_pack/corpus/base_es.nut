        es = "[color=<this.Const.UI.Color.NegativeValue>]-10[/color] Puntos de vida"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\traits\glorious_endurance_trait.nut
    {
        en = "Glorious Endurance"
        es = "Resistencia Gloriosa"
    }
    {
        en = "Forged in the arenas of the south, this character has fought many a battle, and every blow will only strengthen his indomitable will and endurance. His fabulous lifestyle demands high pay, but he'll never desert you and can't be dismissed. If all three original members should die, your campaign ends."
        es = "Forjado en las arenas del sur, este personaje ha librado muchas batallas, y cada golpe sólo fortalecerá su voluntad y resistencia indomables. Su fabuloso estilo de vida exige un salario alto, pero nunca te abandonará y no puede ser despedido. Si los tres miembros originales mueren, tu campaña termina."
    }
    {
        // text = "Receives only [color=" + this.Const.UI.Color.PositiveValue + "]" + (1.0 - this.m.DamageReduction) * 100 + "%[/color] of any damage"
        mode = "pattern"
        en = "Receives only [color=<this.Const.UI.Color.PositiveValue>]<1.0-this.m.DamageReduction*100>%[/color] of any damage"
        es = "Recibe solo [color=<this.Const.UI.Color.PositiveValue>]<1.0-this.m.DamageReduction*100>%[/color] de cualquier daño"
    }
    {
        en = "Gains 5% damage reduction with every hit taken, up to a limit of 25%"
        es = "Obtiene una reducción de daño del 5% con cada golpe recibido, hasta un límite del 25%."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\traits\glorious_quickness_trait.nut
    {
        en = "Glorious Quickness"
        es = "Rapidez Gloriosa"
    }
    {
        en = "Forged in the arenas of the south, this character has fought many a battle, and is an expert in dispatching multiple opponents in a row. His fabulous lifestyle demands high pay, but he'll never desert you  and can't be dismissed. If all three original members should die, your campaign ends."
        es = "Forjado en las arenas del sur, este personaje ha librado muchas batallas y es un experto en eliminar a múltiples oponentes seguidos. Su fabuloso estilo de vida exige un salario alto, pero nunca te abandonará y no puede ser despedido. Si los tres miembros originales mueren, tu campaña termina."
    }
    {
        // text = "Upon killing an enemy on their turn, this character immediately regains [color=" + this.Const.UI.Color.PositiveValue + "]1[/color] Action Point"
        mode = "pattern"
        en = "Upon killing an enemy on their turn, this character immediately regains [color=<this.Const.UI.Color.PositiveValue>]1[/color] Action Point"
        es = "Al matar a un enemigo en su turno, este personaje recupera inmediatamente [color=<this.Const.UI.Color.PositiveValue>]1[/color] Punto de Acción."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\traits\glorious_resolve_trait.nut
    {
        en = "Glorious Resolve"
        es = "Resolución Gloriosa"
    }
    {
        en = "Forged in the arenas of the south, this character has fought man and beast alike, and it takes a lot to break his resolve. His fabulous lifestyle demands high pay, but he'll never desert you  and can't be dismissed. If all three original members should die, your campaign ends."
        es = "Forjado en las arenas del sur, este personaje ha luchado contra hombres y bestias por igual, y se necesita mucho para romper su determinación. Su fabuloso estilo de vida exige un salario alto, pero nunca te abandonará y no puede ser despedido. Si los tres miembros originales mueren, tu campaña termina."
    }
    {
        en = "Re-roll every failed morale check for a second chance"
        es = "Vuelve a lanzar cada chequo de moral fallido para tener una segunda oportunidad"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\traits\gluttonous_trait.nut
    {
        en = "Gluttonous"
        es = "Glotón"
    }
    {
        en = "Tasty, let's have another one! Better bring extra provisions when traveling with this character and expect them to leave fast if you ever run out of provisions entirely."
        es = "Delicioso, ¡comeré otro poco! Es mejor llevar provisiones adicionales cuando viajes con este personaje y esperar que se vaya rápido si alguna vez te quedas sin provisiones por completo."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\traits\greedy_trait.nut
    {
        en = "Greedy"
        es = "Codicioso"
    }
    {
        en = "I want more! This character is greedy and will demand a higher daily payment than others with a similar background, as well as being fast to leave you if you ever run out of crowns."
        es = "¡Quiero más! Este personaje es codicioso y exigirá un pago diario más alto que otros con un trasfondo similar al suyo, además de abandonarte rápidamente si alguna vez te quedas sin coronas."
    }
