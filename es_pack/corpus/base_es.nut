        es = "Los aliados en un rango de 4 casillas o menos reciben [color=<this.Const.UI.Color.PositiveValue>]10%[/color] de la Resolución del personaje que tiene este estandarte como bonificación, hasta un máximo de la Resolución del portaestandarte."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\tools\reinforced_throwing_net.nut
    {
        en = "Reinforced Throwing Net"
        es = "Red arrojadiza reforzada"
    }
    {
        en = "A net used to throw over a target in order to hamper their ability to move and defend themself effectively. Reinforced with gossamer taken from a webknecht, it is even harder to break free from."
        es = "Una red que se utiliza para lanzar sobre un objetivo con el fin de obstaculizar su capacidad de moverse y defenderse de manera efectiva. Reforzado con telaraña extraída de un webknecht, es aún más difícil liberarse de él."
    }
    {
        en = "Will root a target in place and reduce their defenses"
        es = "Atrapará al objetivo en su lugar y reducirá sus defensas"
    }
    {
        // text = "Chance to break free is reduced by [color=" + this.Const.UI.Color.NegativeValue + "]-15[/color]"
        mode = "pattern"
        en = "Chance to break free is reduced by [color=<this.Const.UI.Color.NegativeValue>]-15[/color]"
        es = "La posibilidad de liberarse se reduce en [color=<this.Const.UI.Color.NegativeValue>]-15[/color]"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\tools\smoke_bomb_item.nut
    {
        en = "Smoke Pot"
        es = "Bomba de humo"
    }
    {
        en = "A small pot that quickly creates a dense smoke cloud when broken on the ground. Useful for covering movement."
        es = "Un pequeño recipiente que crea rápidamente una densa nube de humo cuando se rompe en el suelo. Útil para cubrir el movimiento."
    }
    {
