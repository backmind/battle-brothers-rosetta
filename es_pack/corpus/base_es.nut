        es = "<this.World.FactionManager.getFaction(this.m.Faction).addPlayerRelation(this.Const.World.Assets.RelationContractCancel, Romper un contrato)>"
    }
    {
        en = "objective1"
        es = ""
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\contracts\contracts\siege_fortification_contract.nut
    {
        en = "Siege Fortification"
        es = "Asediar Fortificación"
    }
    {
        // this.m.Name = "Siege " + this.m.Origin.getName();
        mode = "pattern"
        en = "Siege <this.m.Origin.getName()>"
        es = "Asedia <this.m.Origin.getName()>"
    }
    {
        en = "Help in the siege"
        es = "Ayuda en el asedio"
    }
    {
        // this.Contract.m.Origin.getOwner().addPlayerRelation(-99.0, "Took sides in the war");
        mode = "pattern"
        en = "<this.World.FactionManager.getFaction(this.m.Faction).addPlayerRelation(this.Const.World.Assets.RelationContractCancel, Broke a contract)>"
        es = "<this.World.FactionManager.getFaction(this.m.Faction).addPlayerRelation(this.Const.World.Assets.RelationContractCancel, Romper un contrato)>"
    }
    {
