        es = "Otras mutaciones provocarán un período más largo de enfermedad."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\effects\ancient_priest_potion_effect.nut
    {
        en = "Synapse Blockage"
        es = "Bloqueo de Sinapsis"
    }
    {
        en = "This character's body has mutated in such a way that their fight-or-flight response is altered. In high stress situations, their limbic system is simply refused resources for flight, making them effectively unbreakable in the battle line."
        es = "El cuerpo de este personaje ha mutado de tal manera que su respuesta de lucha o huida se ve alterada. En situaciones de alto estrés, a su sistema límbico simplemente se le niegan recursos para huir, lo que los hace efectivamente irrompibles en la línea de batalla."
    }
    {
        en = "Can not be reduced to Fleeing morale, only Breaking"
        es = "No se puede reducir su moral a 'Huyendo', solo hasta 'Quebrándose'"
    }
