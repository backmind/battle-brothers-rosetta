    {
        en = "Open Hiring Screen to replace"
        es = ""
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\retinue\followers\agent_follower.nut
    {
        en = "The Agent"
        es = "La Agente"
    }
    {
        en = "The Agent has eyes and ears everywhere and knows where to go for current events to take advantage of and well-paying contracts both."
        es = "La Agente tiene ojos y oídos en todas partes y sabe dónde acudir para tomar ventaja y contratos bien remunerados por igual."
    }
    {
        en = "Reveals available contracts and active situations in the tooltip of settlements no matter where you are"
        es = "Revela contratos disponibles y situaciones activas en la ventana emergente de los asentamientos sin importar dónde te encuentres"
    }
    {
        en = "Have allied relations with a noble house or city state"
        es = "Tener relaciones 'Aliado' con una casa noble o una ciudad estado."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\retinue\followers\alchemist_follower.nut
    {
        en = "The Alchemist"
        es = "El Alquimista"
    }
    {
        en = "The Alchemist is knowledgeable in crafting all kinds of mysterious contraptions and concoctions from exotic ingredients when given access to taxidermist equipment, and uses less material to do so."
        es = "El Alquimista tiene conocimiento en la elaboración de todo tipo de artilugios y brebajes misteriosos a partir de ingredientes exóticos cuando se le da acceso al equipo de taxidermista, y utiliza menos material para hacerlo."
    }
    {
        en = "Has a 25% chance of not consuming any crafting component used by you"
        es = "Tiene un 25% de posibilidades de no consumir ningún componente de elaboración utilizado por ti."
    }
    {
        en = "Unlocks 'Snake Oil' recipe to earn money by crafting from various low tier components"
        es = "Desbloquea el 'Aceite de serpiente', con ingredientes de nivel bajo, para ganar dinero."
    }
    {
        // this.m.Requirements[0].Text = "Crafted " + this.Math.min(15, this.World.Statistics.getFlags().getAsInt("ItemsCrafted")) + "/15 items at the taxidermist";
        mode = "pattern"
        en = "Crafted <this.Math.min(15, this.World.Statistics.getFlags().getAsInt(ItemsCrafted))>/15 items at the taxidermist"
        es = "Elaborar <this.Math.min(15, this.World.Statistics.getFlags().getAsInt(ItemsCrafted))>/15 artículos en el taxidermista"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\retinue\followers\blacksmith_follower.nut
    {
        en = "The Blacksmith"
        es = "El Herrero"
    }
    {
        en = "Mercenaries are good at getting arms and armor destroyed, but not at maintaining them. The Blacksmith will take care of this tedious task quickly and efficiently, and can mend even equipment otherwise thought lost."
        es = "Los mercenarios son buenos destruyendo armas y armaduras, pero no manteniéndolas. El herrero se encargará de esta tediosa tarea de forma rápida y eficiente, y puede reparar incluso equipos que de otro modo se considerarían perdidos."
    }
    {
        en = "Recovers all equipment worn by your men even if broken or lost because of death"
        es = "Recupera todo el equipo que llevan tus hombres incluso si está roto o perdido por muerte"
    }
    {
        en = "Increases repair speed by 20%"
        es = "Aumenta la velocidad de reparación en 20%"
    }
    {
        en = "Reduces tool consumption by 20%"
        es = "Reduce el consumo de Herramientas y suministros en 20%"
    }
    {
        // this.m.Requirements[0].Text = "Had " + this.Math.min(5, this.World.Statistics.getFlags().getAsInt("ItemsRepaired")) + "/5 items repaired at a town\'s smith";
        mode = "pattern"
        en = "Had <this.Math.min(5, this.World.Statistics.getFlags().getAsInt(ItemsRepaired))>/5 items repaired at a town's smith"
        es = "Haber reparado <this.Math.min(5, this.World.Statistics.getFlags().getAsInt(ItemsRepaired))>/5 artículos en el herrero de una ciudad"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\retinue\followers\bounty_hunter_follower.nut
    {
        en = "The Bounty Hunter"
        es = "El Cazador de Recompensas"
    }
    {
        en = "This colorful Bounty Hunter has a pocket full of contracts on the most dangerous individuals. He knows how to get them from hiding and will pay handsomely for any bounty fulfilled."
        es = "Este colorido Cazador de Recompensas tiene un bolsillo lleno de contratos de los individuos más peligrosos. Sabe cómo sacarlos de su escondite, y pagará generosamente por cualquier recompensa obtenida."
    }
    {
        en = "Significantly increases the chance of encountering champions"
        es = "Aumenta significativamente las posibilidades de encontrar campeones"
    }
    {
        en = "Pays between 300 and 750 crowns for every champion slain"
        es = "Paga entre 300 y 750 coronas por cada campeón asesinado"
    }
    {
        // this.m.Requirements[0].Text = "Have " + this.Math.min(3, namedItems) + "/3 named or legendary items in your possession";
        mode = "pattern"
        en = "Have <this.Math.min(3, namedItems)>/3 named or legendary items in your possession"
        es = "Tener <this.Math.min(3, namedItems)>/3 objetos con nombre o legendarios en tu poder"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\retinue\followers\brigand_follower.nut
    {
        en = "The Brigand"
        es = "El Forajido"
    }
    {
        en = "The Brigand may be old and weak now, but at one point his name was feared across the land. In exchange for a hot meal he happily shares with you what he learns from his contacts about caravans on the road."
        es = "Puede que el Forajido sea viejo y débil ahora, pero en su momento su nombre fue temido en toda la comarca. A cambio de una comida caliente, él felizmente comparte contigo lo que recibe de sus contactos sobre las caravanas en la carretera."
    }
    {
        en = "Makes you see the position of some caravans at all times and even if outside your sight radius"
        es = "Te permite ver la posición de algunas caravanas en todo momento e incluso fuera de tu radio de visión"
    }
    {
        // this.m.Requirements[0].Text = "Raided " + this.Math.min(4, this.World.Statistics.getFlags().getAsInt("CaravansRaided")) + "/4 caravans";
        mode = "pattern"
        en = "Raided <this.Math.min(4, this.World.Statistics.getFlags().getAsInt(CaravansRaided))>/4 caravans"
        es = "Asaltar <this.Math.min(4, this.World.Statistics.getFlags().getAsInt(CaravansRaided))>/4 caravanas"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\retinue\followers\cartographer_follower.nut
    {
        en = "The Cartographer"
        es = "El Cartógrafo"
    }
    {
        en = "The Cartographer is a man of culture and knowledge, but he also realizes that traveling in the company of well-armed mercenaries is one of the best ways to safely see the world and explore places that few visited before."
        es = "El Cartógrafo es un hombre de cultura y conocimiento, pero también se da cuenta de que viajar en compañía de mercenarios bien armados es una de las mejores formas de ver el mundo de forma segura y explorar lugares que pocos visitaron antes."
    }
    {
        en = "Pays you between 100 and 400 crowns for every location you discover on your own. The further away from civilization, the more you're paid. Legendary locations pay double."
        es = "Te paga entre 100 y 400 coronas por cada lugar que descubras por tu cuenta. Cuanto más lejos de la civilización, más te pagan. Las ubicaciones legendarias pagan el doble."
    }
    {
        en = "Discovered a legendary location"
        es = "Descubrir una ubicación legendaria"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\retinue\followers\cook_follower.nut
    {
        en = "The Cook"
        es = "La Cocinera"
    }
    {
        en = "A good warm meal goes a long way towards healing body and mind. The Cook makes sure that no provisions go to waste, and provides the men with invigorating meals."
        es = "Una buena comida caliente contribuye en gran medida a sanar el cuerpo y la mente. La cocinera se asegura de que no se desperdicien provisiones y proporciona a los hombres comidas vigorizantes."
    }
    {
        en = "Makes all provisions last 3 extra days"
        es = "Hace que todas las provisiones duren 3 días adicionales"
    }
    {
        en = "Increases hitpoint recovery by 1 per hour"
        es = "Aumenta la recuperación de puntos de vida en 1 por hora"
    }
    {
        // this.m.Requirements[0].Text = "Have " + this.Math.min(8, uniqueProvisions) + "/8 different types of provisions";
        mode = "pattern"
        en = "Have <this.Math.min(8, uniqueProvisions)>/8 different types of provisions"
        es = "Tener <this.Math.min(8, uniqueProvisions)>/8 tipos diferentes de provisiones"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\retinue\followers\drill_sergeant_follower.nut
    {
        en = "The Drill Sergeant"
        es = "El Instructor"
    }
    {
        en = "The Drill Sergeant was a mercenary once, but an injury ended his career prematurely. Now he drills discipline into your men and yells a lot to make sure that everyone learns from their mistakes."
        es = "El Instructor fue mercenario una vez, pero una flecha en su rodilla acabó prematuramente con su carrera. Ahora, inculca disciplina a sus hombres y grita mucho para asegurarse de que todos aprendan de sus errores."
    }
    {
        en = "Makes your men gain 20% more experience at level 1, with 2% less at each further level"
        es = "Hace que tus hombres ganen un 20% más de experiencia en el nivel 1, y un 2% menos en cada nivel adicional (10% en nivel 6)"
    }
    {
        en = "Makes men in reserve never lose mood from not taking part in battles"
        es = "Hace que los hombres en reserva nunca pierdan el ánimo por no participar en las batallas"
    }
    {
        en = "Retired a man with a permanent injury that isn't indebted"
        es = "Se jubiló un hombre con una lesión permanente (Endeudados no cuentan)."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\retinue\followers\lookout_follower.nut
    {
        en = "The Lookout"
        es = "La Exploradora"
    }
    {
        en = "Having a quick Lookout with sharp eyes travel in advance of the company can prove invaluable in being aware of dangers and points of interests before others become aware of the company."
        es = "Tener a una Exploradora veloz con ojos agudos viajando por delante de la compañía puede resultar invaluable para avistar peligros y puntos de interés antes que otros detecten a la compañía."
    }
    {
        en = "Increases your sight radius by 25%"
        es = "Incrementa el rango de visión en un 25%"
    }
    {
        en = "Reveals extended information about footprints"
        es = "Revela información adicional de las huellas"
    }
    {
        // this.m.Requirements[0].Text = "Discovered " + this.Math.min(10, this.World.Statistics.getFlags().getAsInt("LocationsDiscovered")) + "/10 locations on your own";
        mode = "pattern"
        en = "Discovered <this.Math.min(10, this.World.Statistics.getFlags().getAsInt(LocationsDiscovered))>/10 locations on your own"
        es = "Descubriste <this.Math.min(10, this.World.Statistics.getFlags().getAsInt(LocationsDiscovered))>/10 ubicaciones por tu cuenta"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\retinue\followers\minstrel_follower.nut
    {
        en = "The Minstrel"
        es = "El Bardo"
    }
    {
        en = "A good song and story play a large part in creating the reputation of a company. The Minstrel is a master of these crafts and will help to spread the word about your deeds to all ears - willing to hear them or not."
        es = "Una buena canción y una buena historia juegan un papel importante en la creación de la reputación de cualquier compañía. El juglar es un maestro en estos oficios y ayudará a difundir tus hazañas a todos los oídos - estén dispuestos a escucharlas o no."
    }
    {
        en = "Makes you earn 15% more renown with every action"
        es = "Te hace ganar un 15% más de renombre con cada acción"
    }
    {
        en = "Makes tavern rumors more likely to contain useful information"
        es = "Aumenta la probabilidad de que los rumores de taberna contengan información útil"
    }
    {
        // this.m.Requirements[0].Text = "Visited " + settlementsVisited + "/" + maxSettlements + " settlements";
        mode = "pattern"
        en = "Visited <settlementsVisited>/<maxSettlements> settlements"
        es = "Visitar <settlementsVisited>/<maxSettlements> asentamientos"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\retinue\followers\negotiator_follower.nut
    {
        en = "The Negotiator"
        es = "El Negociante"
    }
    {
        en = "The Negotiator is home to noble courts and fancy halls, and not used to travelling with a band of sellswords with muddy boots, but he is an expert on traversing the mire of social relations and contract negotiations."
        es = "El Negociante viene de cortes nobles y salones elegantes, y no está acostumbrado a viajar con una banda de mercenarios con botas embarradas, pero es un experto en atravesar el fango de las relaciones sociales y las negociaciones de contratos."
    }
    {
        en = "Allows for more rounds of contract negotiations with potential employers, and without any hit to relations"
        es = "Permite más rondas de negociaciones de contratos con empleadores potenciales y sin afectar las relaciones"
    }
    {
        en = "Makes good relations with any faction decay slower and bad relations recover faster"
        es = "Hace que las buenas relaciones con cualquier facción se deterioren más lentamente y las malas se recuperen más rápido"
    }
    {
        // this.m.Requirements[0].Text = "Completed " + this.Math.min(15, this.World.Contracts.getContractsFinished()) + "/15 contracts";
        mode = "pattern"
        en = "Completed <this.Math.min(15, this.World.Contracts.getContractsFinished())>/15 contracts"
        es = "Completar <this.Math.min(15, this.World.Contracts.getContractsFinished())>/15 contratos"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\retinue\followers\paymaster_follower.nut
    {
        en = "The Paymaster"
        es = "El Contador"
    }
    {
        en = "The Paymaster takes care of all the day-to-day financial and organizational aspects of running a mercenary company, like paying out wages."
        es = "El Contador se encarga de todos los aspectos financieros y organizativos del día a día de la gestión de una compañía mercenaria, como el pago de los salarios."
    }
    {
        en = "Reduces the daily wage of each man by 15%"
        es = "Reduce el salario diario de cada hombre un 15%"
    }
    {
        en = "Reduces the chance of desertion by 50%"
        es = "Reduce las probabilidades de deserción un 50%"
    }
    {
        en = "Prevents men demanding more pay in events"
        es = "Impide que los hombres exijan más salario en los eventos"
    }
    {
        // this.m.Requirements[0].Text = "Have a roster of " + this.Math.min(16, this.World.getPlayerRoster().getSize()) + "/16 men";
        mode = "pattern"
        en = "Have a roster of <this.Math.min(16, this.World.getPlayerRoster().getSize())>/16 men"
        es = "Tener un grupo de <this.Math.min(16, this.World.getPlayerRoster().getSize())>/16 hombres"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\retinue\followers\quartermaster_follower.nut
    {
        en = "The Quartermaster"
        es = "El Intendente"
    }
    {
        en = "With years of experience from traveling with caravans, the Quartermaster is able to squeeze and rotate any piece of gear, luggage or armor into the perfect spot to use space as efficiently as possible."
        es = "Con años de experiencia viajando con caravanas, el intendente es capaz de apretar y rotar cualquier pieza de equipo, equipaje o armadura en el lugar perfecto para utilizar el espacio de la manera más eficiente posible."
    }
    {
        en = "Increases the amount of ammunition you can carry by 100"
        es = "Incrementa la cantidad de munición que puedes cargar en 100"
    }
    {
        en = "Increases the amount of medical supplies and tools you can carry by 50 each"
        es = "Incrementa la cantidad de suministros médicos y herramientas que puedes cargar en 50"
    }
    {
        // this.m.Requirements[0].Text = "Completed " + this.Math.min(5, this.World.Statistics.getFlags().getAsInt("EscortCaravanContractsDone")) + "/5 caravan escort contracts";
        mode = "pattern"
        en = "Completed <this.Math.min(5, this.World.Statistics.getFlags().getAsInt(EscortCaravanContractsDone))>/5 caravan escort contracts"
        es = "Completar <this.Math.min(5, this.World.Statistics.getFlags().getAsInt(EscortCaravanContractsDone))>/5 contratos de escolta de caravana"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\retinue\followers\recruiter_follower.nut
    {
        en = "The Recruiter"
        es = "El Reclutador"
    }
    {
        en = "The Recruiter is a sleazy jawsmith that tricks desperate people into joining a mercenary company to escape their poor lives, only to find their demise. Quite useful for anyone running a mercenary company."
        es = "El Reclutador es un astuto embaucador que engaña a personas desesperadas para que se unan a tu compañía y escapen de sus vidas miserables, solo para encontrarse con su perdición. Bastante útil para cualquiera que dirija una compañía de mercenarios."
    }
    {
        en = "Makes you pay 10% less up front for hiring new men, and 50% less for tryouts"
        es = "Hace que pagues un 10% menos por adelantado al contratar nuevos hombres, y un 50% menos por las pruebas de reclutamiento."
    }
    {
        en = "Makes between 2 and 4 additional men available to recruit in every settlement"
        es = "Hace que estén disponibles entre 2 y 4 hombres adicionales para reclutar en cada asentamiento."
    }
    {
        // this.m.Requirements[0].Text = "Recruited " + this.Math.min(12, this.World.Statistics.getFlags().getAsInt("BrosHired")) + "/12 men";
        mode = "pattern"
        en = "Recruited <this.Math.min(12, this.World.Statistics.getFlags().getAsInt(BrosHired))>/12 men"
        es = "Contratar <this.Math.min(12, this.World.Statistics.getFlags().getAsInt(BrosHired))>/12 hombres"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\retinue\followers\scavenger_follower.nut
    {
        en = "The Scavenger"
        es = "El Carroñero"
    }
    {
        en = "Whether the son of one of your men or an urchin you took pity on, the Scavenger pulls his weight by collecting bits and pieces from every battlefield."
        es = "Ya sea el hijo de uno de tus hombres o un niño del que te compadeciste, el Carroñero recoge su peso en objetos recolectados de cada campo de batalla."
    }
    {
        en = "Recovers a part of all ammo you use during battle"
        es = "Recupera una parte de todas las municiones que uses durante la batalla"
    }
    {
        en = "Recovers tools and supplies from every armor destroyed by you during battle"
        es = "Recupera herramientas y suministros de cada armadura destruida por ti durante la batalla"
    }
    {
        en = "Have a heart"
        es = "Tener un corazón"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\retinue\followers\scout_follower.nut
    {
        en = "The Scout"
        es = "El Guía"
    }
    {
        en = "The Scout is an expert in finding mountain passes, navigating through treacherous swamps, and guiding anyone safely through the darkest of forests."
        es = "El Guía es un experto en encontrar pasajes de montaña, navegar por pantanos traicioneros y guiar a cualquiera de manera segura a través de los bosques más oscuros."
    }
    {
        en = "Makes the company travel 15% faster on any terrain"
        es = "Acelera el viaje de la compañía en un 15% en cualquier terreno"
    }
    {
        en = "Prevents sickness and accidents due to terrain"
        es = "Evita enfermedades y accidentes debido al terreno"
    }
    {
        // this.m.Requirements[0].Text = "Won " + this.Math.min(5, this.World.Statistics.getFlags().getAsInt("BeastsDefeated")) + "/5 battles against beasts";
        mode = "pattern"
        en = "Won <this.Math.min(5, this.World.Statistics.getFlags().getAsInt(BeastsDefeated))>/5 battles against beasts"
        es = "Ganar <this.Math.min(5, this.World.Statistics.getFlags().getAsInt(BeastsDefeated))>/5 batallas contra Bestias"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\retinue\followers\surgeon_follower.nut
    {
        en = "The Surgeon"
        es = "El Cirujano"
    }
    {
        en = "The Surgeon is a walking tome of anatomical knowledge. A mercenary company seems the perfect place both to apply that knowledge in healing, but also to learn more about how the insides of men are made up."
        es = "El Cirujano es un caminante tomo de conocimiento anatómico. Una compañía de mercenarios parece el lugar perfecto tanto para aplicar ese conocimiento en la curación, como para aprender más sobre cómo están compuestas las entrañas de los hombres."
    }
    {
        en = "Makes every man without a permanent injury guaranteed to survive an otherwise fatal blow"
        es = "Hace que cada hombre sin una lesión permanente tenga garantizado sobrevivir un golpe fatal"
    }
    {
        en = "Makes every injury take one less day to heal"
        es = "Hace que cada lesión tarde un día menos en sanar"
    }
    {
        // this.m.Requirements[0].Text = "Treated " + this.Math.min(5, this.World.Statistics.getFlags().getAsInt("InjuriesTreatedAtTemple")) + "/5 men with injuries at a temple";
        mode = "pattern"
        en = "Treated <this.Math.min(5, this.World.Statistics.getFlags().getAsInt(InjuriesTreatedAtTemple))>/5 men with injuries at a temple"
        es = "Tratar <this.Math.min(5, this.World.Statistics.getFlags().getAsInt(InjuriesTreatedAtTemple))>/5 hombres con lesiones en el templo"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\retinue\followers\trader_follower.nut
    {
        en = "The Trader"
        es = "El Comerciante"
    }
    {
        en = "Southern traders are renowned for their bartering skills. Lucky you that you could convince one such master of haggling to join your company. And at such a bargain!"
        es = "Los comerciantes sureños son conocidos por sus habilidades de regateo. Tuviste suerte de convencer a uno de estos maestros del regateo para que se uniera a tu compañía. ¡Y a tan buen precio!"
    }
    {
        en = "Increases the amount of trade goods for sale by 1 for each location that produces them, like salt near salt mines, allowing you to trade at higher volumes"
        es = "Aumenta la cantidad de productos comerciales a la venta en 1 por cada ubicación que los produce, como la sal cerca de las minas de sal, lo que te permite comerciar en volúmenes más altos."
    }
    {
        // this.m.Requirements[0].Text = "Sold " + this.Math.min(25, this.World.Statistics.getFlags().getAsInt("TradeGoodsSold")) + "/25 trade goods";
        mode = "pattern"
        en = "Sold <this.Math.min(25, this.World.Statistics.getFlags().getAsInt(TradeGoodsSold))>/25 trade goods"
        es = "Vender <this.Math.min(25, this.World.Statistics.getFlags().getAsInt(TradeGoodsSold))>/25 bienes comerciales"
    }
