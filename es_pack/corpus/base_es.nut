        en = "<this.Const.UI.getColorizedEntityName(bro)> vomits"
        es = "<this.Const.UI.getColorizedEntityName(bro)> vomita"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\injury\smashed_hand_injury.nut
    {
        en = "Smashed Hand"
        es = "Mano aplastada"
    }
    {
        en = "A hand smashed by blunt force makes it almost impossible to hold on to any kind of weapon."
        es = "Una mano aplastada por una fuerza contundente hace que sea casi imposible agarrar cualquier tipo de arma."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\injury\split_hand_injury.nut
    {
        en = "Split Hand"
        es = "Mano partida"
    }
    {
        en = "A sharp cut split the hand right down the middle. Until healed, it can barely be used anymore."
        es = "Un corte agudo partió la mano de este personaje por la mitad. Hasta que no se cure, ya casi no se puede utilizar."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\injury\split_nose_injury.nut
    {
        en = "Split Nose"
        es = "Nariz partida"
    }
    {
        en = "A close swing split this character's nose in two and made any attempt to breathe an exercise in swallowing copious amounts of blood."
        es = "Un golpe cercano partió la nariz de este personaje en dos e hizo que cualquier intento de respirar fuera un ejercicio de tragar grandes cantidades de sangre."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\injury\split_shoulder_injury.nut
    {
        en = "Split Shoulder"
        es = "Hombro partido"
    }
    {
        en = "A deep cut has split this character's shoulder open, injuring the muscle tissue and severely limiting mobility of the arms."
        es = "Un corte profundo ha partido el hombro de este personaje, dañando el tejido muscular y limitando gravemente la movilidad de los brazos."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\injury\sprained_ankle_injury.nut
    {
        en = "Sprained Ankle"
        es = "Esguince de tobillo"
    }
    {
        en = "A sprained ankle makes even the quickest man hobble across the battlefield."
        es = "Un esguince de tobillo hace que incluso el hombre más rápido cojee por el campo de batalla."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\injury\stabbed_guts_injury.nut
    {
        en = "Stabbed Guts"
        es = "Vientre apuñalado"
    }
    {
        en = "A wound at the intestines drains constitution, and the high chance of infection and the prospect of a slow and painful death don't help either."
        es = "Una herida en los intestinos drena la constitución, y la alta probabilidad de infección y la perspectiva de una muerte lenta y dolorosa tampoco ayudan."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\injury_permanent\brain_damage_injury.nut
    {
        en = "Brain Damage"
        es = "Daño cerebral"
    }
    {
        en = "A hard hit to the head shook some things up and didn't exactly benefit this character's cognitive skills. On the bright side, he may now be just too stupid to realize when it's time to run."
        es = "Un fuerte golpe en la cabeza sacudió algunas cosas y no benefició exactamente las habilidades cognitivas de este personaje. Lo bueno es que ahora puede que sea demasiado estúpido para darse cuenta de cuándo es el momento de huir."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\injury_permanent\broken_elbow_joint_injury.nut
    {
