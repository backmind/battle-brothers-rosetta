    {
        en = "Quick Shot"
        es = "Disparo rápido"
    }
    {
        en = "A quick shot with little time used for drawing and aiming. Accuracy drops sharply with distance. Can not be used while engaged in melee."
        es = "Un disparo realizado rápidamente, ahorrando el tiempo que tomaría tensar y apuntar. La precisión disminuye drásticamente con la distancia. No se puede utilizar mientras se está en combate cuerpo a cuerpo."
    }
    {
