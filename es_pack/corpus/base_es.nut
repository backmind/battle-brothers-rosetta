        es = "Una cota de escamas pesada y deslustrada de diseño antiguo que pertenece a una colección de museo, no al campo de batalla."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\armor\ancient\ancient_scale_harness.nut
    {
        en = "Ancient Scale Harness"
        es = "Arnés de escamas antiguo"
    }
    {
        en = "A sturdy, but heavy and partly decayed ancient scale harness."
        es = "Un arnés de escamas antiguo, resistente, pero pesado y parcialmente deteriorado."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\armor\apron.nut
    {
        en = "Apron"
        es = "Delantal"
    }
