        en = "Ancient Bladed Pike"
        es = "Voulge antiguo"
    }
    {
        en = "A long, ancient pike used to attack over some distance and keeping the enemy at bay."
        es = "Una larga y antigua pica utilizada para atacar a cierta distancia y mantener al enemigo a raya."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\ancient\broken_ancient_sword.nut
