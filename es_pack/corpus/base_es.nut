        es = "¡Doble golpe!"
    }
    {
        // return "Having just landed a hit, this character is ready to perform a powerful followup strike! The next attack will inflict [color=" + this.Const.UI.Color.PositiveValue + "]+20%[/color] damage to a single target. If multiple targets are hit, only the first one will receive increased damage. If the attack misses, the effect is wasted.";
        mode = "pattern"
        en = "Having just landed a hit, this character is ready to perform a powerful followup strike! The next attack will inflict [color=<this.Const.UI.Color.PositiveValue>]+20%[/color] damage to a single target. If multiple targets are hit, only the first one will receive increased damage. If the attack misses, the effect is wasted."
        es = "¡Después de haber dado un golpe, este personaje está listo para realizar un poderoso ataque de seguimiento! El siguiente ataque infligirá [color=<this.Const.UI.Color.PositiveValue>]+20%[/color] de daño a un solo objetivo. Si se alcanzan varios objetivos, sólo el primero recibirá mayor daño. Si el ataque falla, el efecto se desperdicia."
