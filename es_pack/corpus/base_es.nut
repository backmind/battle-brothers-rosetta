    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\armor\decayed_coat_of_scales.nut
    {
        en = "Decayed Coat of Scales"
        es = "Cota de escamas deteriorada"
