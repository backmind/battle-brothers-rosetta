    {
        // URL = this.isSteamBuild() ? "steam://advertise/1067690" : "https://www.gog.com/game/battle_brothers_warriors_of_the_north"
        en = "https://www.gog.com/game/battle_brothers_warriors_of_the_north"
        es = ""
