    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\shields\named\named_red_white_shield.nut
    {
        en = "A large and thick wooden shield of foreign style. It offers great protection despite its peculiar form."
        es = "Un gran y grueso escudo de madera de estilo extranjero. Ofrece una gran protección a pesar de su peculiar forma."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\shields\named\named_rider_on_horse_shield.nut
    {
        en = "A relic heater shield covered in iconographic images. It seem to be old, yet is durable and well to handle."
        es = "Un escudo calentador reliquia cubierto de imágenes iconográficas. Parece viejo, pero es duradero y fácil de manejar."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\shields\named\named_sipar_shield.nut
    {
        en = "A full metal round shield of southern design with elaborate ornaments. Quite heavy, but also durable."
        es = "Un escudo redondo completamente metálico de diseño sureño con adornos elaborados. Bastante pesado, pero también duradero."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\shields\named\named_undead_heater_shield.nut
    {
        en = "A triangular wooden shield covered with leather and canvas, old but very well balanced."
        es = "Un escudo triangular de madera recubierto de cuero y lona, antiguo pero muy bien equilibrado."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\shields\named\named_undead_kite_shield.nut
    {
        en = "An elongated wooden shield that offers good protection also to the lower body, despite its apparent age. Somewhat bulky to handle in close combat engagements."
        es = "Un escudo de madera alargado que ofrece una buena protección también a la parte inferior del cuerpo, a pesar de su aparente antigüedad. Algo voluminoso para manejar en combates cuerpo a cuerpo."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\shields\named\named_wing_shield.nut
    {
        en = "A reinforced wooden heater shield made from the finest materials and quite obviously crafted by a master shield maker."
        es = "Un escudo calentador de madera reforzado, hecho con los mejores materiales y obviamente elaborado por un maestro fabricante de escudos."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\shields\oriental\metal_round_shield.nut
    {
        en = "Sipar Shield"
        es = "Escudo Sipar"
    }
    {
        en = "A full metal round shield of southern design. Quite heavy, but also durable."
        es = "Un escudo redondo totalmente metálico de diseño sureño. Bastante pesado, pero también duradero."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\shields\oriental\southern_light_shield.nut
    {
        en = "Adarga Shield"
        es = "Escudo Adarga"
    }
    {
        en = "A light wooden shield with a metal frame, covered in leather. Offers good protection against ranged attacks due to its size, but is not very sturdy."
        es = "Un escudo de madera ligera con estructura de metal, revestido de cuero. Ofrece buena protección contra ataques a distancia debido a su tamaño, pero no es muy resistente."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\shields\shield.nut
    {
        // text = "Shield skills build up [color=" + this.Const.UI.Color.NegativeValue + "]" + this.m.FatigueOnSkillUse + "[/color] more fatigue"
        mode = "pattern"
        en = "Shield skills build up [color=<this.Const.UI.Color.NegativeValue>]<this.m.FatigueOnSkillUse>[/color] more fatigue"
        es = "Habilidades con escudo cuestan [color=<this.Const.UI.Color.NegativeValue>]<this.m.FatigueOnSkillUse>[/color] más fatiga"
    }
    {
        // text = "Shield skills build up [color=" + this.Const.UI.Color.PositiveValue + "]" + this.m.FatigueOnSkillUse + "[/color] less fatigue"
        mode = "pattern"
        en = "Shield skills build up [color=<this.Const.UI.Color.PositiveValue>]<this.m.FatigueOnSkillUse>[/color] less fatigue"
        es = "Habilidades con escudo cuestan [color=<this.Const.UI.Color.PositiveValue>]<this.m.FatigueOnSkillUse>[/color] menos fatiga"
    }
    {
        // text = "[color=" + this.Const.UI.Color.NegativeValue + "]Broken and unusable[/color]"
        mode = "pattern"
        en = "[color=<this.Const.UI.Color.NegativeValue>]Broken and unusable[/color]"
        es = "[color=<this.Const.UI.Color.NegativeValue>]Roto e inutilizable[/color]"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\shields\special\craftable_kraken_shield.nut
    {
        en = "Kraken Shield"
        es = "Escudo de Kraken"
    }
    {
        en = "This shield, carved out of a horn plate taken from a giant kraken, is stronger than any common shield."
        es = "Este escudo, tallado en una placa de cuerno extraída de un kraken gigante, es más fuerte que cualquier escudo común."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\shields\special\craftable_lindwurm_shield.nut
    {
        en = "Lindwurm Shield"
        es = "Escudo de Lindwurm"
    }
    {
        en = "This sturdy shield fashioned from the shimmering scales of a Lindwurm makes for protection nigh indestructible."
        es = "Este resistente escudo creado a partir de las relucientes escamas de un Lindwurm lo convierte en una protección casi indestructible."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\shields\special\craftable_schrat_shield.nut
    {
        en = "Living Tree Shield"
        es = "Escudo de árbol viviente"
    }
    {
        en = "This shield carved out of the remains of a living tree slowly regrows if it sustains any damage. At a glance, it almost looks as if its grotesque face is still moving."
        es = "Este escudo tallado a partir de los restos de un árbol vivo vuelve a crecer lentamente si sufre algún daño. A primera vista, casi parece como si su grotesco rostro todavía se estuviera moviendo."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\shields\wooden_shield_old.nut
    {
        en = "Old Wooden Shield"
        es = "Viejo escudo de madera"
    }
    {
        en = "An old round wooden shield."
        es = "Un viejo escudo redondo de madera. Es mejor que no tener uno."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\shields\worn_heater_shield.nut
    {
        en = "Decayed Heater Shield"
        es = "Escudo calentador deteriorado"
    }
    {
        en = "A rotten triangular wooden shield covered with leather, canvas and moss."
        es = "Un escudo triangular de madera podrido cubierto de cuero, pintura... y musgo."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\shields\worn_kite_shield.nut
    {
        en = "Worn Kite Shield"
        es = "Escudo de cometa desgastado"
    }
    {
        en = "An elongated wooden shield that offers good protection also to the lower body. Somewhat bulky to handle in close combat engagements."
        es = "Un desgastado escudo de madera alargado que ofrece una buena protección también a la parte inferior del cuerpo. Algo voluminoso para manejar en combates cuerpo a cuerpo."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\special\black_book_item.nut
    {
        en = "The Black Book"
        es = "El Libro Negro"
    }
    {
        en = "An old and eerie looking tome with a fleshen cover. Its pages are filled with inscrutable writing and mysterious drawings that you can't begin to understand. The longer you look at the book, the more uneasy it makes you feel. Perhaps someone with more knowledge in ancient languages could make some sense of it."
        es = "Un tomo de aspecto antiguo y espeluznante con una cubierta de carne. Sus páginas están llenas de escrituras inescrutables y dibujos misteriosos que no puedes ni empezar a entender. Cuanto más miras el libro, más incómodo te hace sentir. Quizás alguien con más conocimientos de lenguas antiguas pueda entenderlo."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\special\bodily_reward_item.nut
    {
        en = "Green Vial"
        es = "Vial Verde"
    }
    {
        en = "Traded for with a malevolent witch at the expense of another man's life, this mysterious concoction promises to be a magical drink for the body, and to instantly heal any injury that would also heal on its own."
        es = "Intercambiado con una bruja malévola a expensas de la vida de otro hombre, este misterioso brebaje promete ser una bebida mágica para el cuerpo y curar instantáneamente cualquier herida, que también sanaría por sí sola con el tiempo."
    }
    {
        en = "Instantly heals all temporary injuries, as well as the Hangover and Exhausted status effects"
        es = "Cura instantáneamente todas las lesiones temporales, así como los efectos de estado de Resaca y Exhausto"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\special\broken_ritual_armor_item.nut
    {
        en = "Broken Ritual Armor"
        es = "Armadura ritual rota"
    }
    {
        en = "The broken remains of a heavy barbarian armor, covered in ritual runes. It's unusable like this, and yet you feel that there's something special about it. Perhaps there is some way to mend it?"
        es = "Los restos rotos de una pesada armadura bárbara, cubiertos de runas rituales. Es inutilizable así y, sin embargo, sientes que tiene algo especial. ¿Quizás haya alguna forma de repararla?"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\special\fountain_of_youth_item.nut
    {
        en = "Water Skin"
        es = "Odre de agua"
    }
    {
        en = "A leather water skin filled up with the liquid from under a bizarre human-shaped tree. It whispered in your head that you should drink it to heal."
        es = "Un odre de cuero se llenó con el líquido de debajo de un extraño árbol con forma humana. Te susurró en la mente que deberías beberlo para curarte."
    }
    {
        en = "Will remove all temporary or permanent injuries, as well as the Old, Addicted, Exhausted and Hangover traits and status effects"
        es = "Eliminará todas las lesiones temporales o permanentes, así como los rasgos y efectos de estado de Viejo, Adicto, Exhausto y Resaca."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\special\golden_goose_item.nut
    {
        en = "Golden Goose"
        es = "Ganso Dorado"
    }
    {
        en = "A small goose statue crafted from solid gold. A tiny golden egg mysteriously emerges from the statue once a day."
        es = "Una pequeña estatua de ganso elaborada en oro macizo. Un diminuto huevo dorado emerge misteriosamente de la estatua una vez al día."
    }
    {
        // text = "Generates [color=" + this.Const.UI.Color.PositiveValue + "]15[/color] crowns daily."
        mode = "pattern"
        en = "Generates [color=<this.Const.UI.Color.PositiveValue>]15[/color] crowns daily."
        es = "Genera [color=<this.Const.UI.Color.PositiveValue>]15[/color] coronas diarias"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\special\legendary_sword_blade_item.nut
    {
        en = "Sword Blade"
        es = "Hoja de espada"
    }
    {
        en = "The glimmering blade of a broken sword you retrieved from the Kraken. In all your years of fighting you never encountered such a masterfully crafted blade. Perhaps the sword could be reforged if you had both parts."
        es = "La hoja reluciente de una espada rota que recuperaste del Kraken. En todos tus años de lucha, nunca te has topado con una hoja tan magistralmente elaborada. Quizás la espada podría reforjarse si tuvieras ambas partes."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\special\legendary_sword_grip_item.nut
    {
        en = "Sword Grip"
        es = "Mango de espada"
    }
    {
        en = "A masterfully crafted sword grip covered in mysterious blue stones. The stones seem to have a glimmering light emerging from deep within. Perhaps the sword could be reforged if you had both parts."
        es = "Una empuñadura de espada magistralmente elaborada y cubierta de misteriosas piedras azules. Las piedras parecen tener una luz brillante que emerge desde lo más profundo de su interior. Quizás la espada podría reforjarse si tuvieras ambas partes."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\special\spiritual_reward_item.nut
    {
        en = "Blue Vial"
        es = "Vial Azul"
    }
    {
        en = "Traded for with a malevolent witch at the expense of another man's life, this mysterious concoction promises to be a magical drink for the spirit, and to grant wisdom and insight as if having fought a dozen battles."
        es = "Intercambiado con una bruja malévola a expensas de la vida de otro hombre, este misterioso brebaje promete ser una bebida mágica para el espíritu y otorgar sabiduría y perspicacia como si hubieras luchado en una docena de batallas."
    }
    {
        en = "Grants a veteran level up"
        es = "Otorga un nivel veterano para subir"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\special\trade_jug_01_item.nut
    {
        en = "Mysterious Jug"
        es = "Jarra misteriosa"
    }
    {
        en = "Traded for with a mysterious traveler named Yuchi, the contents of this jug promises to be a magical drink that grants strength beyond imagining."
        es = "Intercambiado con un misterioso viajero llamado Yuchi, el contenido de esta jarra promete ser una bebida mágica que otorga una fuerza más allá de lo imaginable."
    }
    {
        en = "Grants a perk point"
        es = "Otorga un punto de beneficio"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\supplies\ammo_item.nut
    {
        en = "Ammunition"
        es = "Munición"
    }
    {
        // text = "A good [color=" + this.Const.UI.Color.PositiveValue + "]" + this.m.Amount + "[/color] units of assorted ammunition - arrows, bolts and javelins. Used to automatically refill your quivers after battle. Will be added to your global stock once you\'re back on the worldmap."
        mode = "pattern"
        en = "A good [color=<this.Const.UI.Color.PositiveValue>]<this.m.Amount>[/color] units of assorted ammunition - arrows, bolts and javelins. Used to automatically refill your quivers after battle. Will be added to your global stock once you're back on the worldmap."
        es = "Unas [color=<this.Const.UI.Color.PositiveValue>]<this.m.Amount>[/color] unidades de munición variada: flechas, virotes y jabalinas. Se utiliza para recargar automáticamente tus carcaj después de la batalla. Se agregará a su stock global una vez que regreses al mapa mundial."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\supplies\armor_parts_item.nut
    {
        en = "Tools and Supplies"
        es = "Herramientas y suministros"
    }
    {
        // text = "A good [color=" + this.Const.UI.Color.PositiveValue + "]" + this.m.Amount + "[/color] assorted tools and supplies to repair weapons, armor, helmets and shields with after battle. Will be added to your global stock once you\'re back on the worldmap."
        mode = "pattern"
        en = "A good [color=<this.Const.UI.Color.PositiveValue>]<this.m.Amount>[/color] assorted tools and supplies to repair weapons, armor, helmets and shields with after battle. Will be added to your global stock once you're back on the worldmap."
        es = "Unas [color=<this.Const.UI.Color.PositiveValue>]<this.m.Amount>[/color] herramientas y suministros variados para reparar armas, armaduras, cascos y escudos después de la batalla. Se agregará a tu stock global una vez que regreses al mapa mundial."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\supplies\beer_item.nut
    {
        en = "Beer"
        es = "Cerveza"
    }
    {
        en = "Provisions. This fermented hop or barley drink is more durable and safer to drink than plain water."
        es = "Provisiones. Esta bebida fermentada de lúpulo o cebada es más duradera y segura de beber que el agua corriente."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\supplies\black_marsh_stew_item.nut
    {
        en = "Black Marsh Stew"
        es = "Estofado de pantano negro"
    }
    {
        en = "Provisions. Black as the marshes it hails from, this ghastly stew is far from delicious but takes ages to spoil. Possibly because it already is spoiled to begin with."
        es = "Provisiones. Negro como los pantanos de los que proviene, este espantoso guiso está lejos de ser delicioso, pero tarda mucho en echarse a perder. Posiblemente porque para empezar ya está estropeado."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\supplies\bread_item.nut
    {
        en = "Bread"
        es = "Pan"
    }
    {
        en = "Provisions. Light bread made from wheat makes for a filling meal."
        es = "Provisiones. Un pan ligero elaborado con trigo es una comida saciante."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\supplies\cured_rations_item.nut
    {
        en = "Masterfully Cured Rations"
        es = "Raciones magistralmente curadas"
    }
    {
        en = "Provisions. These rations consist of assorted, well cured meats and vegetables that are sealed in small boxes. The ideal provision to take with you on long journeys and expeditions."
        es = "Provisiones. Estas raciones consisten en carnes y verduras variadas y bien curadas que se sellan en pequeñas cajas. La provisión ideal para llevar contigo en largos viajes y expediciones."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\supplies\cured_venison_item.nut
    {
        en = "Cured Venison"
        es = "Venado curado"
    }
    {
        en = "Provisions. A cured chunk of venison preserved by salt. Fine food for a travelling sellsword."
        es = "Provisiones. Un trozo de venado curado conservado en sal. Buena comida para un mercenario viajero."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\supplies\dates_item.nut
    {
        en = "Dates"
        es = "Dátiles"
    }
    {
        en = "Provisions. Dried dates are common in the south. These sweet, dried fruits are high energy and well preserved."
        es = "Provisiones. Los dátiles secos son comunes en el sur. Estas frutas dulces y secas dan mucha energía y están bien conservadas."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\supplies\dried_fish_item.nut
    {
        en = "Dried Fish"
        es = "Pescado seco"
    }
    {
        en = "Provisions. Fish is a common and filling food in coastal regions. It is dried to preserve it."
        es = "Provisiones. El pescado es un alimento común y saciante en las regiones costeras. Se seca para conservarlo."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\supplies\dried_fruits_item.nut
    {
        en = "Dried Fruits"
        es = "Frutas secas"
    }
    {
        en = "Provisions. Fruits from orchards are both tasty and nutritious. They are dried to preserve them longer."
        es = "Provisiones. Las frutas de los huertos son sabrosas y nutritivas. Se secan para conservarlas por más tiempo."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\supplies\dried_lamb_item.nut
    {
        en = "Dried Lamb"
        es = "Cordero seco"
    }
    {
        en = "Provisions. Dried Lamb is a speciality and a highy sought-after food in the south. A real treat for any hungry mercenary."
        es = "Provisiones. El cordero seco es una especialidad y un alimento muy solicitado en el sur. Un verdadero placer para cualquier mercenario hambriento."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\supplies\fermented_unhold_heart_item.nut
    {
        en = "Fermented Unhold Heart"
        es = "Corazón de trol fermentado"
    }
    {
        en = "Provisions. Once a delicacy for barbarian kings of the north who wished to embolden their virility, fermented unhold heart tastes distinctively awful."
        es = "Provisiones. Alguna vez fue un manjar para los reyes bárbaros del norte que deseaban envalentonar su virilidad. Sin embargo, el corazón fermentado o sin fermentar tiene un sabor distintivamente horrible."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\supplies\food_item.nut
    {
        // text = "Bought for [img]gfx/ui/tooltips/money.png[/img]" + this.m.BoughtAtPrice
