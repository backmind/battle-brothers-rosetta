    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\contracts\contracts\escort_envoy_contract.nut
    {
        en = "Escort Envoy"
        es = "Escoltar al emisario"
    }
    {
        en = "the Envoy"
        es = "el Enviado"
    }
    {
        en = "the Emissary"
        es = "el Emisario"
    }
    {
        // "Escort %envoy% %envoy_title% to " + this.Contract.m.Destination.getName() + " in the %direction%"
        mode = "pattern"
        en = "Escort %envoy% %envoy_title% to <this.Contract.m.Destination.getName()> in the %direction%"
        es = "Escolta a %envoy% %envoy_title% a <this.Contract.m.Destination.getName()> hacia %direction%"
    }
    {
        en = "Arrival"
        es = ""
    }
