    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\injury\injury.nut
    {
        en = "Is content for now with being in reserve"
        es = "Por ahora, estará contento de estar en la reserva"
    }
    {
        en = "Will take effect only after combat ends due to the Iron Will effect"
        es = "No sanará porque este personaje ha hecho un Juramento de Sacrificio"
