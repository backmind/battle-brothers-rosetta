    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\billhook.nut
    {
        en = "A pike-like weapon with a blade for striking over some distance and a hook attached for pulling in targets."
