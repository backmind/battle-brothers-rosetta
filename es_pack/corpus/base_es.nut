        mode = "pattern"
        en = "Grants [color=<this.Const.UI.Color.PositiveValue>]+<this.Math.floor(item.getRangedDefense()*mult + proficiencyBonus)>[/color] Ranged Defense for one turn"
        es = "Otorga [color=<this.Const.UI.Color.PositiveValue>]+<this.Math.floor(item.getRangedDefense()*mult + proficiencyBonus)>[/color] Defensa a distancia por un turno"
