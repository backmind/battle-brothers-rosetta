    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\shields\named\named_bandit_heater_shield.nut
    {
        en = "A sturdy triangular shield well suited for close combat. This one is an exceptionally well-crafted and balanced exemplar."
        es = "Un escudo triangular resistente muy adecuado para el combate cuerpo a cuerpo. Este es un ejemplo excepcionalmente bien elaborado y equilibrado."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\shields\named\named_bandit_kite_shield.nut
    {
        en = "A long, wooden shield covering the whole body for good protection against ranged attacks. This particular shield shows some unique craftsmanship and is a rare find."
        es = "Un escudo largo de madera que cubre todo el cuerpo para una buena protección contra ataques a distancia. Este escudo en particular muestra una artesanía única y es un hallazgo poco común."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\shields\named\named_buckler_shield.nut
    {
        en = "This buckler has been crafted entirely from metal, vastly enhancing its durability. Though it offers poor protection against ranged attacks, it is far lighter to handle than larger shields."
        es = ""
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\shields\named\named_dragon_shield.nut
    {
        en = "A large kite shield covered in drawings. Extraordinary craftsmanship went into making this piece."
        es = "Un gran escudo cometa cubierto de dibujos. Se utilizó una artesanía extraordinaria para hacer esta pieza."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\shields\named\named_full_metal_heater_shield.nut
    {
        en = "A finely crafted heater shield made almost entirely out of metal. Heavy and durable, yet lighter than it looks. The craftsmen who made this must have truly been a master of his trade."
        es = "Un escudo calefactor finamente elaborado, hecho casi en su totalidad de metal. Pesado y duradero, pero más ligero de lo que parece. Los artesanos que hicieron esto deben haber sido verdaderamente maestros en su oficio."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\shields\named\named_golden_round_shield.nut
    {
        en = "A full metal round shield of extraordinary quality. This must have been the pride of any warrior boasting it."
        es = "Un escudo redondo totalmente metálico de extraordinaria calidad. Este debe haber sido el orgullo de cualquier guerrero que se jactara de ello."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\shields\named\named_lindwurm_shield.nut
    {
        en = "A sturdy wooden frame lays the base for a shimmering heap of rare Lindwurm scales to form a shield impenetrable."
        es = "Un robusto marco de madera sienta la base para que un brillante montón de raras escamas de Lindwurm formen un escudo impenetrable."
    }
    {
        en = "Lindwurm's"
        es = ""
