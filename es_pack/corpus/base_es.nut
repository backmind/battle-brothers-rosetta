    {
        en = "Spear, One-Handed"
        es = "Lanza, Una mano"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\ancient\ancient_sword.nut
    {
        en = "Ancient Sword"
        es = "Espada antigua"
    }
    {
