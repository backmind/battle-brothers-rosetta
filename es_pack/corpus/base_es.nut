        es = "¡<actor> se ha levantado de entre los muertos!"
    }
    {
        en = "Too few indebted in battle"
        es = "Muy poco endeudados en combate"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\attached_location\amber_collector_location.nut
    {
        en = "Amber Collector"
        es = "Coleccionista de Ámbar"
    }
    {
        en = "The collectors living in these huts search for valuable amber shards along the shore."
        es = "Los coleccionistas que viven en estas cabañas buscan valiosos fragmentos de ámbar a lo largo de la orilla."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\attached_location\beekeeper_location.nut
    {
        en = "Beekeeper"
        es = "Apicultor"
    }
    {
        en = "Surrounded by humming bees, these small huts are home to beekeepers. The honey they produce is a precious ingredient to sweeten pastries and other foods."
        es = "Rodeadas de zumbidos de abejas, estas pequeñas cabañas son el hogar de los apicultores. La miel que producen es un ingrediente precioso para endulzar pasteles y otros alimentos."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\attached_location\blast_furnace_location.nut
    {
        en = "Blast Furnace"
        es = "Alto horno"
    }
    {
        en = "The blast furnace produces the blazing temperatures needed to make the most durable of metal alloys. Handy armorsmiths will use these alloys to create sturdy armor in the nearest settlement."
        es = "El alto horno produce las temperaturas abrasadoras necesarias para fabricar las aleaciones metálicas más duraderas. Los hábiles armeros utilizarán estas aleaciones para crear armaduras resistentes en el asentamiento más cercano."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\attached_location\brewery_location.nut
    {
        en = "Brewery"
        es = "Cervecería"
    }
    {
        en = "This brewery produces large quantities of beer for both local taverns and traders."
        es = "Esta cervecería produce grandes cantidades de cerveza tanto para las tabernas como para los comerciantes locales."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\attached_location\dye_maker_location.nut
    {
        en = "Dye Maker"
        es = "Fabricante de tintes"
    }
    {
        en = "This dye maker creates precious dies from all kinds of ingredients. The recipes for these expensive goods are well-kept secrets."
        es = "Este tintero crea preciosos troqueles a partir de todo tipo de ingredientes. Las recetas de estos costosos productos son secretos bien guardados."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\attached_location\fishing_huts_location.nut
    {
        en = "Fishing Huts"
        es = "Cabañas de pesca"
    }
    {
        en = "A small group of huts surrounded by nets, spears, hooks and other fishing equipment. The smell from baskets of fish guts travels quite a distance."
        es = "Un pequeño grupo de cabañas rodeadas de redes, arpones, anzuelos y otros equipos de pesca. El olor de las cestas llenas de tripas de pescado llega muy lejos."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\attached_location\fletchers_hut_location.nut
    {
        en = "Arrow Maker's Shed"
        es = "Choza del flechero"
    }
    {
        en = "The arrow makers in these sheds produce all kinds of ranged ammunition which they then sell at the nearest settlement."
        es = "Los fabricantes de flechas de estos cobertizos producen todo tipo de munición a distancia que luego venden en el asentamiento más cercano."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\attached_location\fortified_outpost_location.nut
    {
        en = "Barracks"
        es = "Cuarteles"
    }
    {
        en = "Large barracks housing a host of professional soldiers."
        es = "Grandes cuarteles que albergan una gran cantidad de soldados profesionales."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\attached_location\gatherers_hut_location.nut
    {
        en = "Gatherer's Hut"
        es = "Cabaña del recolector"
    }
    {
        en = "Even in sparse environments an experienced gatherer can find berries, roots and other edible things. Although not the most delicious, it can still keep a man fed."
        es = "Incluso en entornos dispersos, un recolector experimentado puede encontrar bayas, raíces y otros objetos comestibles. Aunque no es lo más delicioso, aún puede mantener alimentado a un hombre."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\attached_location\gem_mine_location.nut
    {
        en = "Gem Mine"
        es = "Mina de gemas"
    }
    {
        en = "The shiny gems found in this mine are usually brought directly to the next settlement in well-guarded caravans for further refinement."
        es = "Las gemas brillantes que se encuentran en esta mina generalmente se llevan directamente al siguiente asentamiento en caravanas bien custodiadas para su posterior refinamiento."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\attached_location\goat_herd_location.nut
    {
        en = "Goat Pens"
        es = "Corrales de cabras"
    }
    {
        en = "The goats held here are mainly used for their milk which is then turned into cheese to make it more durable."
        es = "Las cabras que se encuentran aquí se utilizan principalmente por su leche, que luego se convierte en queso para hacerlo más duradero."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\attached_location\gold_mine_location.nut
    {
        en = "Gold Mine"
        es = "Mina de oro"
    }
    {
        en = "A deep mine build atop a gold ore vein. This rare metal has a tendency to bring out the worst in people."
        es = "Una mina profunda construida sobre una veta de mineral de oro. Este metal raro tiene tendencia a sacar lo peor de las personas."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\attached_location\guarded_checkpoint_location.nut
    {
        en = "Guarded Checkpoint"
        es = "Puesto de control vigilado"
    }
    {
        en = "A road checkpoint manned by professional soldiers."
        es = "Un puesto de control en la carretera custodiado por soldados profesionales."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\attached_location\harbor_location.nut
    {
        en = "Harbor"
        es = "Puerto"
    }
    {
        en = "A harbor that serves both foreign trading ships and local fishermen."
        es = "Un puerto que sirve tanto a barcos mercantes extranjeros como a pescadores locales."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\attached_location\herbalists_grove_location.nut
    {
        en = "Herbalist's Grove"
        es = "Choza del herbolario"
    }
    {
        en = "In this remote grove the knowing herbalist collects all kinds of medicinal plants and roots."
        es = "En esta remota arboleda, el experto herbolario recolecta todo tipo de plantas y raíces medicinales."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\attached_location\hunters_cabin_location.nut
    {
        en = "Hunter's Cabin"
        es = "Cabaña del cazador"
    }
    {
        en = "Hunters take shelter in these small huts while on the hunt. Chopped up game, venison and hides hung up to dry in the sun surround the huts."
        es = "Los cazadores se refugian en estas pequeñas cabañas mientras cazan. Las cabañas están rodeadas de caza picada, venado y pieles colgadas para secarse al sol."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\attached_location\incense_dryer_location.nut
    {
        en = "Incense Dryer"
        es = "Secador de incienso"
    }
    {
        en = "Tree sap is gathered from the surrounding trees and dried in the sun to create valuable incense."
        es = "La savia de los árboles se recoge de los árboles circundantes y se seca al sol para crear un valioso incienso."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\attached_location\leather_tanner_location.nut
    {
        en = "Leather Tanner"
        es = "Curtidor de cuero"
    }
    {
        en = "This leather tanner's workshop produces durable leather pieces from hides. The supply of this leather will increase the availability of light armor in the nearest settlement."
        es = "El taller de este curtidor produce piezas de cuero duraderas a partir de pieles. El suministro de este cuero aumentará la disponibilidad de armaduras ligeras en el asentamiento más cercano."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\attached_location\lumber_camp_location.nut
    {
        en = "Lumber Camp"
        es = "Campamento Maderero"
    }
    {
        en = "This lumber camp is used as a base for lumberjacks on the search for the most precious and durable materials in the nearby woods."
        es = "Este campamento maderero sirve de base a leñadores que buscan los materiales más valiosos y duraderos en los bosques cercanos."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\attached_location\militia_trainingcamp_location.nut
    {
        en = "Militia Barracks"
        es = "Cuartel de la milicia"
    }
    {
        en = "A large compound of militia barracks. This camp will turn ordinary peasants into somewhat able soldiers that can defend their home and their loved ones."
        es = "Un gran complejo de cuarteles de la milicia. Este campamento convertirá a los campesinos corrientes en soldados algo capaces que podrán defender su hogar y a sus seres queridos."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\attached_location\mushroom_grove_location.nut
    {
        en = "Mushroom Grove"
        es = "Bosque de hongos"
    }
    {
        en = "Hidden in the mud and reed, the expert gatherer can find groves and caves full of precious mushrooms like these."
        es = "Escondidos entre el barro y los juncos, el experto recolector puede encontrar arboledas y cuevas llenas de preciosas setas como estas."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\attached_location\orchard_location.nut
    {
        en = "Orchard"
        es = "Huerta"
    }
    {
        en = "Dense rows of trees with ripe fruit frame a small warehouse where everything is stored until offered on local markets."
        es = "Densas hileras de árboles con fruta madura enmarcan un pequeño almacén donde se almacena todo hasta que se ofrece en los mercados locales."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\attached_location\ore_smelters_location.nut
    {
        en = "Ore Smelters"
        es = "Fundiciones de mineral"
    }
    {
        en = "The burning hot ore smelters produce high quality metal ingots used by able weapon smiths to create the most sophisticated of arms."
        es = "Las fundiciones de mineral ardiendo producen lingotes de metal de alta calidad utilizados por hábiles herreros para crear las armas más sofisticadas."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\attached_location\peat_pit_location.nut
    {
        en = "Peat Pit"
        es = "Pozo de turba"
    }
    {
        en = "These peat pits produce a valuable fuel source once the peat has been dug up and dried."
        es = "Estos pozos de turba producen una valiosa fuente de combustible una vez que la turba ha sido desenterrada y secada."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\attached_location\pig_farm_location.nut
    {
        en = "Pig Farm"
        es = "Granja de cerdos"
    }
    {
        en = "The smell of this pig farm is just as distinct as the squeeking sounds coming from the muddy pits. The pork chops produced here are usually sold in the nearby settlement."
        es = "El olor de esta granja de cerdos es tan distintivo como los chirridos que provienen de los pozos fangosos. Las chuletas de cerdo que se producen aquí suelen venderse en el asentamiento cercano."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\attached_location\plantation_location.nut
    {
        en = "Plantation"
        es = "Plantación"
    }
    {
        en = "All kinds of wonderous spices and herbs are cultivated in this plantation. A small and rare fruitful spot in the barren desert."
        es = "En esta plantación se cultivan todo tipo de maravillosas especias y hierbas. Un pequeño y raro lugar fructífero en el árido desierto."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\attached_location\salt_mine_location.nut
    {
        en = "Salt Mine"
        es = "Minas de sal"
    }
    {
        en = "A mine in which precious rock salt is extracted and shipped off to only the most trustworthy traders."
        es = "Una mina en la que se extrae la preciosa roca de sal y se envía únicamente a los comerciantes más confiables."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\attached_location\silk_farm_location.nut
    {
        en = "Silk Farm"
        es = "Granja de seda"
    }
    {
        en = "In these huts the precious silk is spun from cocoons of small insects by secret methods."
        es = "En estas chozas se hila la preciosa seda a partir de capullos de pequeños insectos mediante métodos secretos."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\attached_location\stone_watchtower_location.nut
    {
        en = "Stone Watchtower"
        es = "Atalaya de piedra"
    }
    {
        en = "A stone watchtower occupied by well trained soldiers on guard duty."
        es = "Una torre de vigilancia de piedra ocupada por soldados bien entrenados en guardia."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\attached_location\surface_copper_vein_location.nut
    {
        en = "Surface Copper Vein"
        es = "Veta de cobre superficial"
    }
    {
        en = "A mining camp has been set up to mine a surfaced copper vein and smelt the ore into ingots on the spot."
        es = "Se ha instalado un campamento minero para explotar una veta de cobre aflorada y fundir el mineral en lingotes en el lugar."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\attached_location\surface_iron_vein_location.nut
    {
        en = "Surface Iron Vein"
        es = "Veta de hierro superficial"
    }
    {
        en = "This surfaced iron vein attracted a small mining camp that is gathering the precious metal. Access to this resource increases the selection of weapons available in the next settlement."
        es = "Esta veta de hierro aflorada atrajo un pequeño campamento minero que está recolectando el metal precioso. El acceso a este recurso aumenta la selección de armas disponibles en el próximo asentamiento."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\attached_location\trapper_location.nut
    {
        en = "Trapper"
        es = "Trampero"
    }
    {
        en = "Small huts provide shelter for the trappers living here and setting traps for animals with valuable furs."
        es = "Las pequeñas cabañas sirven de refugio a los tramperos que viven aquí y colocan trampas para animales con pieles valiosas."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\attached_location\wheat_fields_location.nut
    {
        en = "Wheat Fields"
        es = "Campos de trigo"
    }
    {
        en = "Golden wheat can be seen glistening in the sun from afar. Many people from the nearby settlement work here, farmhands and daytalers mostly."
        es = "Desde lejos se puede ver el trigo dorado brillando al sol. Aquí trabajan muchas personas del asentamiento cercano, en su mayoría peones y jornaleros."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\attached_location\winery_location.nut
    {
        en = "Winery"
        es = "Bódega de vino"
    }
    {
        en = "This winery is surrounded by a large vineyard. The wine produced here is a priced commodity in wealthier circles."
        es = "Esta bodega está rodeada por un gran viñedo. El vino que se produce aquí es un bien valorado en los círculos más ricos."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\attached_location\wooden_watchtower_location.nut
    {
        en = "Wooden Watchtower"
        es = "Atalaya de madera"
    }
    {
        en = "A wooden watchtower with a small garrison on watch duty."
        es = "Torre de vigilancia de madera con una pequeña guarnición de guardia."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\attached_location\wool_spinner_location.nut
    {
        en = "Wool Spinner"
        es = "Hilandero de lana"
    }
    {
        en = "The wool of the sheep herded here is spun into wool and then shipped to the next settlement. Refined wares like these can be quite valuable."
        es = "La lana de las ovejas que aquí se crían se hila y luego se envía al siguiente asentamiento. Artículos refinados como estos pueden ser muy valiosos."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\attached_location\workshop_location.nut
    {
        en = "Workshop"
        es = "Taller"
    }
    {
        en = "The workshop is proficient in making all kinds of tools and other supplies needed to keep carts and machines working."
        es = "El taller es experto en fabricar todo tipo de herramientas y otros suministros necesarios para mantener los carros y las máquinas en funcionamiento."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\attached_location.nut
    {
        en = "Once part of the nearby settlement, these are now burned down and abandoned ruins."
        es = "Antiguamente parte del asentamiento cercano, ahora no son más que ruinas quemadas y abandonadas."
    }
    {
        en = "lighting"
        es = ""
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\entity_manager.nut
    {
        en = "A free mercenary company travelling the lands and lending their swords to the highest bidder."
        es = "Una compañía de mercenarios libres que viaja por las tierras y presta sus espadas al mejor postor."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\entity\world\location.nut
    {
        en = "Unknown garrison"
        es = "Guarnición desconocida"
    }
    {
