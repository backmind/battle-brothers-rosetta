    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\helmets\legendary\emperors_countenance.nut
    {
        en = "The Emperor's Countenance"
        es = "El Semblante del Emperador"
    }
    {
        en = "A golden helmet and facemask, showing the visage of an emperor from an age long past, imbued with mystical energies. When you hold it into the light, it almost looks as if the face were moving and making expressions of disgust."
        es = "Un yelmo y máscara dorados que muestran el rostro de un emperador de una época pasada, imbuido de energías místicas. Cuando lo miras a la luz, casi parece como si la cara se moviera y hiciera expresiones de disgusto."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\helmets\legendary\fangshire.nut
    {
        en = "The Fangshire"
        es = "El Colmillo"
    }
    {
        en = "The Fangshire is a northern tiger's skull that nestles the faces of men deeply and darkly behind two ferocious fangs. Originally worn by Bjarund the Beastman, a fierce northern raider, it instilled fear into the hearts of his enemies as he went on bloody raids and burned down many a village along the coastline. When Bjarund was finally slain, Fangshire was taken as a trophy and went further south. Rumors proclaim that its wearer's eyes glow a sharpened yellow, allowing them to see through the very night."
        es = "El Comillo es el cráneo de un tigre del norte que esconde los rostros de los hombres profunda y oscuramente detrás de dos feroces colmillos. Originalmente usado por Bjarund el Hombre Bestia, un feroz asaltante del norte, infundió miedo en los corazones de sus enemigos mientras realizaba sangrientas incursiones y quemaba muchas aldeas a lo largo de la costa. Cuando finalmente mataron a Bjarund, el 'yelmo' fue tomado como trofeo y fue más al sur. Los rumores proclaman que los ojos de su portador brillan de un amarillo intenso, lo que les permite ver a través de la noche."
    }
    {
        en = "Allows the wearer to see at night and negates any penalties due to nighttime."
        es = "Permite al usuario ver de noche y anula cualquier penalización debida a la noche."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\helmets\legendary\ijirok_helmet.nut
    {
        en = "Helmet of the Ijirok"
        es = "Yelmo del Ijirok"
    }
    {
        en = "Once a barbarian helmet broken in battle, this piece has been bathed in the blood of the legendary Ijirok. Powers beyond your understanding mended it whole again, and will likewise mend any wounds of the wearer as well."
        es = "Esta pieza, que alguna vez fue un casco bárbaro roto en batalla, ha sido bañada en la sangre del legendario Ijirok. Poderes más allá de tu comprensión lo repararon por completo nuevamente y también repararán cualquier herida del usuario."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\helmets\legendary\mask_of_davkul.nut
    {
        en = "Glimpse of Davkul"
        es = "Vislumbre de Davkul"
    }
    {
        en = "The Glimpse of Davkul is a gift bestowed upon man by ancient and dark powers, a helmet merged with human skin and bones through the most unspeakable of rituals. A glimpse of a future where man shall become one with creations from a realm beyond. It shall never break, but instead keep regrowing its scarred skin on the spot."
        es = "El Vislumbre de Davkul es un regalo otorgado al hombre por poderes antiguos y oscuros, un casco fusionado con piel y huesos humanos a través del más indescriptible de los rituales. Un vistazo a un futuro en el que el hombre se volverá uno con las creaciones de un reino más allá. Nunca se romperá, sino que seguirá creciendo su piel llena de cicatrices en el lugar."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\helmets\mail_coif.nut
