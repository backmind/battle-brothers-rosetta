    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\helmets\oriental\turban_helmet.nut
    {
        en = "Turban Helmet"
        es = "Yelmo turbante"
    }
    {
        en = "A full helmet crafted from overlapping long metal splints in the shape of a traditional southern head wrap."
        es = "Un casco completo fabricado a partir de largas láminas de metal superpuestas con la forma de una tradicional envoltura para la cabeza del sur."
