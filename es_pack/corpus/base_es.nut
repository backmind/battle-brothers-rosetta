        es = "Una capa de acolchado, una capa de malla resistente, y pesadas placas de metal remachadas encima. Una armadura muy pesada que ofrece una gran protección."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\armor\coat_of_scales.nut
