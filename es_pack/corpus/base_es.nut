    {
        en = "Ready another shot to be fired. Can not be used while engaged in melee."
        es = "Recarga para realizar otro disparo. No se puede utilizar mientras se está en combate cuerpo a cuerpo."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\actives\repel.nut
    {
        en = "Repel"
        es = "Repeler"
    }
    {
        en = "Poke and shove at a target in order to force it away from the user by one tile. Targets hit will be staggered and lose initiative, and may take damage if they are pushed down several levels of height. Shieldwall, Spearwall and Riposte will be canceled for a target that is successfully repelled. A rooted target can not be repelled."
        es = "Pincha y empuja a un objetivo para alejarlo del usuario una casilla. Los objetivos alcanzados quedarán Tambaleante y perderán Iniciativa, y pueden sufrir daños si son empujados hacia abajo varios niveles de altura. Muro de escudos, Muro de lanzas y Contrataque se cancelarán para un objetivo que sea repelido con éxito. Un objetivo enraizado no puede ser repelido."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\actives\return_favor.nut
    {
        en = "Return Favor"
        es = "Devolver el favor"
    }
    {
        en = "Use your superior fighting skills to assume a defensive stance and seek to incapacitate anyone attacking you that you can reach yourself."
        es = "Usa tus habilidades de lucha superiores para asumir una postura defensiva y busca incapacitar a cualquiera que te ataque y que puedas alcanzar por ti mismo."
    }
    {
        // text = "Gain a [color=" + this.Const.UI.Color.PositiveValue + "]50%[/color] chance to stun any opponent missing this character with a melee attack (resistances and immunities still apply)."
        mode = "pattern"
        en = "Gain a [color=<this.Const.UI.Color.PositiveValue>]50%[/color] chance to stun any opponent missing this character with a melee attack (resistances and immunities still apply)."
        es = "Gana un [color=<this.Const.UI.Color.PositiveValue>]50%[/color] de prob. de Aturdir a cualquier oponente que falle en asestar un golpe cuerpo a cuerpo a este personaje (resistencias e inmunidades aún se aplican.)."
