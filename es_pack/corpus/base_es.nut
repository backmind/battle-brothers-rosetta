        en = "Thorned Whip"
        es = "Látigo de Espinas"
    }
    {
        en = "A sturdy thorned whip. Used by barbarians both in battle and to herd wild beasts, even the largest of which will flinch from its crack."
        es = "Un látigo durable de espinas. Utilizado por los bárbaros en combate y para domar bestias salvajes, incluidas las más grandes que se verán intimidadas con su chasquido."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\barbarians\two_handed_spiked_mace.nut
