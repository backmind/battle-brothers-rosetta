    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\special\double_grip.nut
    {
        en = "Double Grip"
        es = "Agarre doble"
    }
    {
        en = "With the second hand free, this character can get a firm double grip on his weapon and inflicts additional damage."
