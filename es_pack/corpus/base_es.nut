    {
        en = "Available, but this character has no perk point to spend"
        es = "Disponible, pero este personaje no tiene puntos de habilidada para gastar"
    }
    {
        // text = "Locked until " + (perk.Unlocks - player.getPerkPointsSpent()) + " more perk points are spent"
