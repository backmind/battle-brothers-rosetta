    {
        en = "A quiver of bolts, required to use crossbows. Is automatically refilled after each battle if you have enough ammunition."
        es = "Un carcaj de virotes, necesario para usar ballestas. Se recarga automáticamente después de cada batalla si tienes suficiente munición."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\armor\adorned_heavy_mail_hauberk.nut
    {
        en = "Adorned Heavy Mail Hauberk"
        es = "Cota de malla pesada adornada"
    }
    {
        en = "A heavy chainmail hauberk worn under a thick riveted jacket and reinforced with vambraces. Adorned with trophies and lovingly maintained despite its extensive use, this is the armor of a true questing knight."
        es = "Una pesada cota de malla que se lleva debajo de una gruesa chaqueta remachada y reforzada con brazales. Adornada con trofeos y mantenida con cariño a pesar de su uso extensivo, esta es la armadura de un verdadero caballero en busca de aventuras."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\armor\adorned_mail_shirt.nut
    {
        en = "Adorned Mail Shirt"
        es = "Camisa de malla adornada"
    }
    {
        en = "A heavy mail shirt covered by a quilted surcoat. An impressive and well-maintained piece, adorned with trophies and holy symbols."
        es = "Una pesada cota de malla cubierta por una sobrevesta acolchada. Una pieza impresionante y bien mantenida, adornada con trofeos y símbolos sagrados."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\armor\adorned_warriors_armor.nut
    {
        en = "Adorned Warrior's Armor"
        es = "Armadura de guerrero adornada"
    }
    {
        en = "A long mail shirt covered by a riveted leather gambeson. Heavily worn from extensive use, but adorned with relics and well-maintained."
        es = "Una cota de malla larga cubierta por un gambesón de cuero remachado. Muy desgastado por el uso extensivo, pero adornado con reliquias y en buen estado."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\armor\ancient\ancient_breastplate.nut
    {
        en = "Ancient Breastplate"
        es = "Coraza antigua"
    }
    {
        en = "A tarnished thick breastplate of ancient origin."
        es = "Una coraza gruesa y deslustrada de origen antiguo."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\armor\ancient\ancient_double_layer_mail.nut
    {
        en = "Ancient Double Layer Mail"
        es = "Cota de malla de doble capa antigua"
    }
    {
        en = "A heavy and rotten double-layered mail of ancient design. Not comfortable to wear but still useable."
        es = "Una cota de malla pesada y podrida de doble capa de diseño antiguo. No es cómodo de usar pero aún se puede usar."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\armor\ancient\ancient_lich_attire.nut
    {
        en = "Ancient Attire"
        es = "Atuendo antiguo"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\armor\ancient\ancient_mail.nut
    {
        en = "Ancient Mail"
        es = "Cota de malla antigua"
    }
    {
        en = "An old and crusted heavy mail of ancient design. Some parts are missing, but it still offers decent protection."
        es = "Una cota de malla pesada, vieja y con costras, de diseño antiguo. Faltan algunas piezas, pero aún ofrece una protección decente."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\armor\ancient\ancient_plate_harness.nut
    {
        en = "Ancient Plate Harness"
        es = "Arnés de placas antiguo"
    }
    {
        en = "Made of thick metal plates and mail, this heavy ancient armor still offers great protection after countless years. It's crusted and rotten in parts, however, severely limiting the mobility of the wearer."
        es = "Fabricada con gruesas placas de metal y cota de malla, esta pesada armadura antigua todavía ofrece una gran protección después de incontables años. Sin embargo, tiene costras y partes podridas, lo que limita gravemente la movilidad del usuario."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\armor\ancient\ancient_plated_mail_hauberk.nut
    {
        en = "Ancient Plated Mail Hauberk"
        es = "Hauberk de malla chapada antigua"
    }
    {
        en = "An ancient mail armor with plated arm guards. Very heavy and severely limiting the mobility of the wearer."
        es = "Una antigua armadura de malla con protectores de brazos chapados. Muy pesado y limite gravemente la movilidad del usuario."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\armor\ancient\ancient_plated_scale_hauberk.nut
    {
        en = "Ancient Plated Scale Hauberk"
        es = "Hauberk de escamas chapada antigua"
    }
    {
        en = "A heavy coat of scales, partly reinforced with a layer of plated metal on top. It's a massive armor of ancient origin that didn't age well."
        es = "Una pesada cota de escamas, parcialmente reforzada con una capa de metal chapado en la parte superior. Es una enorme armadura de origen antiguo que no envejeció bien."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\armor\ancient\ancient_priest_attire.nut
    {
        en = "Ancient Priest Attire"
        es = "Atuendo de sacerdote antiguo"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\armor\ancient\ancient_ripped_cloth.nut
    {
