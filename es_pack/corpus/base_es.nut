    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\effects\hex_slave_effect.nut
    {
        en = "Died from a hex"
        es = "Murió por un hechizo"
    }
    {
        // return "This character has been cursed to feel the same pain and receive the same wounds as another character. Be careful, as it could kill him. The effect will persist for another [color=" + this.Const.UI.Color.NegativeValue + "]1[/color] turn(s).";
        mode = "pattern"
        en = "This character has been cursed to feel the same pain and receive the same wounds as another character. Be careful, as it could kill him. The effect will persist for another [color=<this.Const.UI.Color.NegativeValue>]1[/color] turn(s)."
        es = "Este personaje ha sido maldecido para sentir el mismo dolor y recibir las mismas heridas que otro personaje. Ten cuidado, ya que esto podría matarlo. El efecto persistirá durante [color=<this.Const.UI.Color.NegativeValue>]1[/color] turno(s) más."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\effects\hexe_potion_effect.nut
    {
        en = "Sympathetic Call"
        es = ""
    }
    {
        en = "There's something different about this character. Physically they seem unchanged, yet somehow a sense of dread precedes them. Any harm that they endure, on or off the battlefield, seems to affect another nearby. Useful in a fight, annoying in camp, and surely isolating in every day society."
        es = "Hay algo diferente en este personaje. Físicamente parecen no haber cambiado, pero de alguna manera le precede una sensación de temor. Cualquier daño que sufra, dentro o fuera del campo de batalla, parece afectar a otro cercano. Útil en una pelea, molesto en el campamento y seguramente aislante en la sociedad cotidiana."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\effects\holy_water_effect.nut
    {
        en = "Sprayed with Blessed Water"
        es = "Rociado con agua bendita"
    }
    {
        // this.Tactical.EventLog.log(this.Const.UI.getColorizedEntityName(this.getContainer().getActor()) + "\'s body has been sprayed with holy water");
        mode = "pattern"
        en = "<this.Const.UI.getColorizedEntityName(this.getContainer().getActor())>'s body has been sprayed with holy water"
        es = "<this.Const.UI.getColorizedEntityName(this.getContainer().getActor())> ha sido rociado con agua bendita"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\effects\honor_guard_potion_effect.nut
    {
        en = "Subdermal Stitching"
        es = "Costuras subdérmicas"
    }
    {
        en = "This character's skin and subdermal tissue has mutated and will rapidly stitch itself back together. The effect is most pronounced on small puncture wounds, where the flesh can seal the wound from all directions evenly."
        es = "La piel y el tejido subdérmico de este personaje han mutado y se coserán rápidamente. El efecto es más pronunciado en pequeñas heridas punzantes, donde la carne puede sellar la herida desde todas las direcciones de manera uniforme."
    }
    {
        // text = "This character takes between [color=" + this.Const.UI.Color.PositiveValue + "]25%[/color] and [color=" + this.Const.UI.Color.PositiveValue + "]50%[/color] less damage from piercing attacks, such as those from bows or spears"
        mode = "pattern"
        en = "This character takes between [color=<this.Const.UI.Color.PositiveValue>]25%[/color] and [color=<this.Const.UI.Color.PositiveValue>]50%[/color] less damage from piercing attacks, such as those from bows or spears"
        es = "Este personaje recibe entre [color=<this.Const.UI.Color.PositiveValue>]25%[/color] y [color=<this.Const.UI.Color.PositiveValue>]50%[/color] menos de daño de los ataques perforantes, como los de arcos o lanzas."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\effects\horrified_effect.nut
    {
        en = "Horrified"
        es = "Horrorizado"
    }
    {
        en = "This character is horrified and unable to act until next turn."
        es = "Este personaje está horrorizado y no puede actuar hasta el próximo turno."
    }
    {
        // this.Tactical.EventLog.log(this.Const.UI.getColorizedEntityName(this.actor) + " resists being frozen with fear thanks to his unnatural physiology");
        mode = "pattern"
        en = "<this.Const.UI.getColorizedEntityName(this.actor)> resists being frozen with fear thanks to his unnatural physiology"
        es = ""
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\effects\hyena_potion_effect.nut
    {
        en = "Subdermal Clotting"
        es = "Coagulación Subdérmica"
    }
    {
        en = "When this character's skin is broken, a substance is secreted that drastically quickens the blood clotting process in the area. Bleeding wounds are much less harmful as a result, although some blood loss still occurs."
        es = "Cuando la piel de este personaje se rompe, se secreta una sustancia que acelera drásticamente el proceso de coagulación de la sangre en la zona. Como resultado, las heridas sangrantes son mucho menos dañinas, aunque todavía se produce cierta pérdida de sangre."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\effects\ifrit_potion_effect.nut
    {
        en = "Stone Skin"
        es = "Piel de piedra"
    }
    {
        en = "This character's skin has mutated and now forms hard, rock-like patches that are much hardier and difficult to puncture. When broken, these patches will gradually reform in what is apparently a rather painful, uncomfortable process. You should tell them to stop picking at that scab."
        es = "La piel de este personaje ha mutado y ahora forma parches duros y parecidos a rocas que son mucho más resistentes y difíciles de perforar. Cuando se rompen, estos parches se regenerarán gradualmente en un proceso aparentemente bastante doloroso e incómodo. Deberías decirle que deje de tocar esa costra.La piel de este personaje ha mutado y ahora forma parches duros y parecidos a rocas que son mucho más resistentes y difíciles de perforar. Cuando se rompen, estos parches se regenerarán gradualmente en un proceso aparentemente bastante doloroso e incómodo. Deberías decirle que deje de tocar esa costra."
    }
    {
        // text = "This character\'s skin is hard and stone-like, granting [color=" + this.Const.UI.Color.PositiveValue + "]25[/color] points of natural armor"
        mode = "pattern"
        en = "This character's skin is hard and stone-like, granting [color=<this.Const.UI.Color.PositiveValue>]25[/color] points of natural armor"
        es = "La piel de este personaje es dura y similar a la piedra, lo que le otorga [color=<this.Const.UI.Color.PositiveValue>]25[/color] Puntos de armadura natural."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\effects\ijirok_potion_effect.nut
    {
        en = "Auspice of the Mad God"
        es = "Auspicio del Dios Loco"
    }
    {
        en = "There's something wrong with this character. Fits of crazed laughter and muttered tirades aside, their body seems to, at random, reject changes visited upon it. In battle, this has the fortunate effect of letting them sometimes shrug off debilitating effects."
        es = "Hay algo mal con este personaje. Dejando a un lado los ataques de risa enloquecida y las diatribas murmuradas, su cuerpo parece, aleatoriamente, rechazar los cambios que le afectan. En la batalla, esto tiene el afortunado efecto de permitirle a veces hacer caso omiso de los efectos debilitantes."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\effects\indomitable_effect.nut
    {
