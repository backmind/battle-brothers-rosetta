    }
    {
        en = "A shining armor once worn by the emperor of an age long past, made from the most wondrous of materials, imbued with mystical energies. Light reflects easily off the polished armor, turning the wearer into a shimmering figure of light during the day."
        es = "Una armadura brillante que alguna vez usó el emperador de una época pasada, hecha con los materiales más maravillosos e imbuida de energías místicas. La luz se refleja fácilmente en la armadura pulida, convirtiendo al usuario en una figura de luz brillante durante el día."
    }
    {
        // text = "Reflects [color=" + this.Const.UI.Color.PositiveValue + "]25%[/color] of damage taken in melee back to the attacker"
        mode = "pattern"
        en = "Reflects [color=<this.Const.UI.Color.PositiveValue>]25%[/color] of damage taken in melee back to the attacker"
        es = "Refleja [color=<this.Const.UI.Color.PositiveValue>]25%[/color] del Daño cuerpo a cuerpo recibido hacia el atacante"
    }
