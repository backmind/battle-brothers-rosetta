    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\special\mood_check.nut
    {
        en = "Mood Check"
        es = ""
    }
    {
        en = "This character is content with how things are going. Could be better, could be worse.\n\nMood will always trend towards this state over time."
        es = "Este personaje está contento con cómo van las cosas. Podría ser mejor, podría ser peor.\n\nEl estado de ánimo siempre tenderá hacia este estado con el tiempo."
    }
    {
        en = "Not uncommon for someone living the hardships of mercenary life, this character isn't quite satisfied and is hoping for things to improve."
        es = "Aunque no es extraño a las dificultades de la vida de mercenario, este personaje no está completamente satisfecho y espera que las cosas mejoren."
    }
    {
        // text = "Can only have [color=" + this.Const.UI.Color.NegativeValue + "]steady[/color] morale or worse"
        mode = "pattern"
        en = "Can only have [color=<this.Const.UI.Color.NegativeValue>]steady[/color] morale or worse"
        es = "Solo puede tener una moral [color=<this.Const.UI.Color.NegativeValue>]'Firme'[/color] o peor"
    }
    {
        en = "Recent events have left this character disgruntled and disappointed how things are going. It may fade, or it may get a lot worse if other events tip him over the edge."
        es = "Los eventos recientes han dejado a este personaje descontento y decepcionado por cómo van las cosas. Su moral puede mejorar o puede empeorar mucho si otros eventos lo llevan al límite."
    }
    {
        // text = "Can only have [color=" + this.Const.UI.Color.NegativeValue + "]wavering[/color] morale or worse"
        mode = "pattern"
        en = "Can only have [color=<this.Const.UI.Color.NegativeValue>]wavering[/color] morale or worse"
        es = "Solo puede tener una moral [color=<this.Const.UI.Color.NegativeValue>]'Vacilante'[/color] o algo peor"
    }
    {
        en = "Recent events have left this character angry and vengeful towards those around him. If things don't improve very quickly, this character may decide to desert the company!"
        es = "Los acontecimientos recientes han dejado a este personaje enojado y vengativo hacia quienes lo rodean. Si las cosas no mejoran rápidamente, ¡este personaje puede decidir desertar de la compañía!"
    }
    {
        // text = "Can only have [color=" + this.Const.UI.Color.NegativeValue + "]breaking[/color] morale or worse"
        mode = "pattern"
        en = "Can only have [color=<this.Const.UI.Color.NegativeValue>]breaking[/color] morale or worse"
        es = "Solo puede tener una moral [color=<this.Const.UI.Color.NegativeValue>]'Quebrándose'[/color] o peor"
    }
    {
        en = "Recent events have left this character in good spirit. It will probably pass as reality takes a grip again, but for now, things are looking well."
        es = "Los últimos acontecimientos han dejado a este personaje de buen humor. Probablemente pasará cuando la realidad vuelva a tomar control, pero por ahora las cosas pintan bien."
    }
    {
        // text = "Has a [color=" + this.Const.UI.Color.PositiveValue + "]25%[/color] chance to start battle at confident morale"
        mode = "pattern"
        en = "Has a [color=<this.Const.UI.Color.PositiveValue>]25%[/color] chance to start battle at confident morale"
        es = "Tiene un [color=<this.Const.UI.Color.PositiveValue>]25%[/color] de probabilidad de comenzar la batalla con un moral 'Confiado'"
    }
    {
        en = "Recent events have left this character eager to fight with the company, pleased with how things are going and motivating to those around him."
        es = "Los últimos acontecimientos han dejado a este personaje con muchas ganas de luchar con la compañía, satisfecho de cómo van las cosas y motivando a quienes le rodean."
    }
    {
        en = "Recent events have left this character in a state of euphoria, happy to spend his time in service of the company and sure of victory against any foe. It's bordering on the annoying, really."
        es = "Eventos recientes han dejado a este personaje en un estado de euforia, feliz de pasar su tiempo al servicio de la compañía y seguro de la victoria contra cualquier enemigo. Está rozando lo molesto, realmente."
    }
