    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\armor\barbarians\thick_furs_armor.nut
    {
        en = "Thick Furs"
        es = "Pieles gruesas"
    }
    {
        en = "Thick furs that are crudely dried and tied together to protect from both the cold and any incoming blows."
        es = "Pieles gruesas que se secan toscamente y se atan para proteger tanto del frío como de cualquier golpe."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\armor\barbarians\thick_plated_barbarian_armor.nut
    {
        en = "Thick Plated Barbarian Armor"
        es = "Armadura bárbara de placas gruesas"
    }
    {
        en = "A heavy armor that is made from mostly metal. Only one chosen by the ancestors will own a set like this."
        es = "Una armadura pesada hecha principalmente de metal. Sólo un elegido por los antepasados poseerá un conjunto como éste."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\armor\barbarians\unhold_armor_heavy.nut
    {
        en = "Armor"
        es = "Armadura de trol"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\armor\basic_mail_shirt.nut
    {
        en = "Basic Mail Shirt"
        es = "Camisa de malla básica"
    }
    {
        en = "A basic and simple mail shirt. Offers decent and affordable protection against slashing and piercing attacks."
        es = "Una camisa de malla básica y sencilla. Ofrece una protección decente y asequible contra ataques cortantes y perforantes."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\armor\blotched_gambeson.nut
    {
        en = "Blotched Gambeson"
        es = "Gambesón manchado"
    }
    {
        en = "A padded gambeson that has seen lots of patching and repairing."
        es = "Un gambesón acolchado que ha sido objeto de muchos parches y reparaciones."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\armor\butcher_apron.nut
    {
        en = "Butcher's Apron"
        es = "Delantal de carnicero"
    }
    {
        en = "A rugged apron worn by butchers to protect against accidental cuts."
        es = "Un delantal resistente que usan los carniceros para protegerse contra cortes accidentales."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\armor\coat_of_plates.nut
