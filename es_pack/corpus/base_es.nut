    }
    {
        // Relentless = "Don\'t slow down! At all times your Initiative is reduced only by [color=" + this.Const.UI.Color.NegativeValue + "]50%[/color] of your accumulated Fatigue, instead of all of it. In addition, using the \'Wait\' command will no longer give you a penalty to Initiative in the next round.",
        mode = "pattern"
        en = "Don't slow down! At all times your Initiative is reduced only by [color=<this.Const.UI.Color.NegativeValue>]50%[/color] of your accumulated Fatigue, instead of all of it. In addition, using the 'Wait' command will no longer give you a penalty to Initiative in the next round."
        es = "¡No te detengas! En todo momento, tu Iniciativa se reduce solo en [color=<this.Const.UI.Color.NegativeValue>]50%[/color] de tu Fatiga acumulada, en lugar de toda ella. Además, usar el comando 'Esperar' ya no te dará una penalización a la Iniciativa en la próxima ronda."
    }
    {
        en = "Unlocks the 'Rotation' skill which allows two characters to switch places while ignoring Zone of Control as long as neither character is stunned, rooted or otherwise disabled."
        es = "Yo te cubro. Desbloquea la habilidad 'Rotación', que permite a dos personajes intercambiar lugares sin activar la Zona de Control, siempre que ninguno de los personajes esté aturdido, inmovilizado o incapacitado de alguna u otra manera."
    }
    {
        en = "Unlocks the 'Footwork' skill which allows you to leave a Zone of Control without triggering free attacks by using skillful footwork."
        es = "Desbloquea la habilidad 'Juego de pies', que te permite abandonar una Zona de Control sin provocar ataques de oportunidad al usar movimientos hábiles.\n\n\x22Un buen duelista mueve más sus pies que sus manos.\x22"
    }
    {
        // Debilitate = "Unlocks the \'Debilitate\' skill which can prime your next attack to cripple a target for one turn, reducing their ability to inflict damage by [color=" + this.Const.UI.Color.NegativeValue + "]-50%[/color].",
        mode = "pattern"
        en = "Unlocks the 'Debilitate' skill which can prime your next attack to cripple a target for one turn, reducing their ability to inflict damage by [color=<this.Const.UI.Color.NegativeValue>]-50%[/color]."
        es = "Desbloquea la habilidad 'Debilitar', que puede preparar tu próximo ataque para debilitar a un objetivo durante un turno, reduciendo su capacidad para infligir daño en [color=<this.Const.UI.Color.NegativeValue>]-50%[/color]."
    }
    {
        // Indomitable = "Unlocks the \'Indomitable\' skill which grants a [color=" + this.Const.UI.Color.PositiveValue + "]50%[/color] damage reduction and immunity to being stunned, knocked back or grabbed for one turn.",
        mode = "pattern"
        en = "Unlocks the 'Indomitable' skill which grants a [color=<this.Const.UI.Color.PositiveValue>]50%[/color] damage reduction and immunity to being stunned, knocked back or grabbed for one turn."
        es = "Desbloquea la habilidad 'Indomable', que otorga una reducción de daño del [color=<this.Const.UI.Color.PositiveValue>]50%[/color] e inmunidad al Aturdimiento, el Derribo o la Inmovilización durante un turno.\n\n\x22Solo hay un dios, la Muerte. Y hay una sola cosa que se le dice a la muerte: 'Hoy no'\x22."
    }
    {
        en = "Unlocks the 'Rally' skill which can rally fleeing allies, and raise morale of all nearby allies to a steady level. The higher the Resolve of the character using the skill, the higher the chance to succeed."
        es = "¡Todos, a mi! Desbloquea la habilidad 'Reunir a las Tropas', que puede reunir a los aliados que huyen y elevar la moral de todos los aliados cercanos a un nivel estable. Cuanto mayor sea la Resolución del personaje que usa la habilidad, mayor será la probabilidad de éxito."
    }
    {
        en = "Unlocks the 'Adrenaline' skill which puts you first in the turn order for the next round, to have another turn before your enemies do. Feel the adrenaline rushing through your veins!"
        es = "Desbloquea la habilidad 'Adrenalina', que te coloca primero en el orden de turnos para la próxima ronda, para tener otro turno antes que tus enemigos. ¡Siente la adrenalina corriendo por tus venas!"
    }
    {
        // Fearsome = "Make them scatter and flee! Any attack that inflicts at least 1 point of damage to hitpoints triggers a morale check for the opponent with a penalty equal to [color=" + this.Const.UI.Color.NegativeValue + "]15%[/color] of your Resolve, as opposed to with no penalty and only if at or above 15 points of damage.",
        mode = "pattern"
        en = "Make them scatter and flee! Any attack that inflicts at least 1 point of damage to hitpoints triggers a morale check for the opponent with a penalty equal to [color=<this.Const.UI.Color.NegativeValue>]15%[/color] of your Resolve, as opposed to with no penalty and only if at or above 15 points of damage."
        es = "¡Haz que se dispersen y huyan! Cualquier ataque que inflija al menos 1 punto de daño a los puntos de vida desencadena un chequeo de moral para el oponente con una penalización igual al [color=<this.Const.UI.Color.NegativeValue>]15%[/color] de tu Resolución - 10, en vez de lo normal (sin penalización y solo si es igual o superior a 15 puntos de daño.)"
    }
    {
        en = "Go for the head! Hitting the head of a target will give you a guaranteed hit to the head also with your next attack. Connecting with your hit will reset the effect."
        es = "¡Ve a por la cabeza! Golpear la cabeza de un objetivo te dará un golpe garantizado en la cabeza también con tu próximo ataque. Conectar tu golpe reiniciará el efecto."
    }
    {
        // SunderingStrikes = "Effectiveness vs. Armor is increased by [color=" + this.Const.UI.Color.PositiveValue + "]+20%[/color] for any weapon used.",
        mode = "pattern"
        en = "Effectiveness vs. Armor is increased by [color=<this.Const.UI.Color.PositiveValue>]+20%[/color] for any weapon used."
        es = "La efectividad contra la armadura aumenta en [color=<this.Const.UI.Color.PositiveValue>]+20%[/color] para cualquier arma utilizada."
    }
    {
        // FastAdaption = "Adapt to your opponent\'s moves! Gain an additional stacking [color=" + this.Const.UI.Color.PositiveValue + "]+10%[/color] chance to hit with each attack that misses an opponent. Bonus is reset upon landing a hit.",
        mode = "pattern"
        en = "Adapt to your opponent's moves! Gain an additional stacking [color=<this.Const.UI.Color.PositiveValue>]+10%[/color] chance to hit with each attack that misses an opponent. Bonus is reset upon landing a hit."
        es = "¡Adáptate a los movimientos de tu oponente! Obtén un [color=<this.Const.UI.Color.PositiveValue>]+10%[/color] de probabilidad adicional de golpear con cada ataque que esquive tu oponente. El bono se reinicia al acertar un golpe."
    }
    {
        // Weaponmaster = "All attacks cost [color=" + this.Const.UI.Color.NegativeValue + "]-20%[/color] Fatigue to use and weapon condition degrades only half as fast. Dance gracefully with your weapon and make every hit count. ",
        mode = "pattern"
        en = "All attacks cost [color=<this.Const.UI.Color.NegativeValue>]-20%[/color] Fatigue to use and weapon condition degrades only half as fast. Dance gracefully with your weapon and make every hit count. "
        es = "Todos los ataques cuestan [color=<this.Const.UI.Color.NegativeValue>]-20%[/color] de Fatiga de usar y la condición del arma se degrada solo a la mitad de velocidad. ¡Baila agraciadamente con tu arma y haz que cada golpe cuente!"
    }
    {
        // CoupDeGrace = "Inflict additional [color=" + this.Const.UI.Color.PositiveValue + "]20%[/color] damage against targets that have sustained any injury effects, like a broken arm.",
        mode = "pattern"
        en = "Inflict additional [color=<this.Const.UI.Color.PositiveValue>]20%[/color] damage against targets that have sustained any injury effects, like a broken arm."
        es = "Nadie escapa de la sentencia del verdugo. Inflige un [color=<this.Const.UI.Color.PositiveValue>]+20%[/color] de daño adicional a los objetivos que han sufrido efectos de lesiones, como un brazo roto."
    }
    {
        en = "Hits to the head no longer cause critical damage to this character, which also lowers the risk of sustaining debilitating head injuries significantly."
        es = "Necesitarás más que eso. Los golpes en la cabeza ya no causan daño crítico a este personaje, lo que también reduce significativamente el riesgo de sufrir lesiones debilitantes en la cabeza."
    }
    {
        // Anticipation = "When being attacked with ranged weapons, gain [color=" + this.Const.UI.Color.PositiveValue + "]1 + 10% of your base Ranged Defense[/color] as additional Ranged Defense per tile that the attacker is away, and always at least [color=" + this.Const.UI.Color.PositiveValue + "]+10[/color] to Ranged Defense.",
        mode = "pattern"
        en = "When being attacked with ranged weapons, gain [color=<this.Const.UI.Color.PositiveValue>]1 + 10% of your base Ranged Defense[/color] as additional Ranged Defense per tile that the attacker is away, and always at least [color=<this.Const.UI.Color.PositiveValue>]+10[/color] to Ranged Defense."
        es = "¡Aciértame si puedes! Cuando te atacan con armas a distancia, obtienes [color=<this.Const.UI.Color.PositiveValue>]1 + 10% de tu Defensa a distancia base[/color] como Defensa a distancia adicional por cada casilla que el atacante esté alejado, y siempre al menos [color=<this.Const.UI.Color.PositiveValue>]+10[/color] a la Defensa a distancia."
    }
    {
        // HoldOut = "Keep it together! Any negative status effect with a finite duration (e.g. Bleeding, Charmed) has its duration reduced to [color=" + this.Const.UI.Color.NegativeValue + "]1[/color] turn. Status effects that have their effects grow weaker over several turns (e.g. Goblin Poison) are at their weakest state from the start.",
        mode = "pattern"
        en = "Keep it together! Any negative status effect with a finite duration (e.g. Bleeding, Charmed) has its duration reduced to [color=<this.Const.UI.Color.NegativeValue>]1[/color] turn. Status effects that have their effects grow weaker over several turns (e.g. Goblin Poison) are at their weakest state from the start."
        es = "¡Resistiré! Cualquier efecto de estado negativo con una duración finita (por ejemplo, Sangrado, Encantado) tiene su duración reducida en [color=<this.Const.UI.Color.NegativeValue>]1[/color] turno. Los efectos de estado que se debilitan con el tiempo (por ejemplo, Veneno goblin) están en su estado más débil desde el principio."
    }
    {
        // Dodge = "Too fast for you! Gain [color=" + this.Const.UI.Color.PositiveValue + "]15%[/color] of the character\'s current Initiative as a bonus to Melee and Ranged Defense.",
        mode = "pattern"
        en = "Too fast for you! Gain [color=<this.Const.UI.Color.PositiveValue>]15%[/color] of the character's current Initiative as a bonus to Melee and Ranged Defense."
        es = "¡Demasiado rápido para ti! Obtén [color=<this.Const.UI.Color.PositiveValue>]15%[/color] de la Iniciativa actual del personaje como bonificación a la Defensa cuerpo a cuerpo y Defensa a distancia."
    }
    {
        // Nimble = "Specialize in light armor! By nimbly dodging or deflecting blows, convert any hits to glancing hits. Hitpoint damage taken is reduced by up to [color=" + this.Const.UI.Color.PositiveValue + "]60%[/color], but lowered exponentially by the total penalty to Maximum Fatigue from body and head armor above [color=" + this.Const.UI.Color.PositiveValue + "]15[/color]. The lighter your armor and helmet, the more you benefit.\n\nBrawny does not affect this perk.\n\nDoes not affect damage from mental attacks or status effects, but can help to avoid receiving them.",
        mode = "pattern"
        en = "Specialize in light armor! By nimbly dodging or deflecting blows, convert any hits to glancing hits. Hitpoint damage taken is reduced by up to [color=<this.Const.UI.Color.PositiveValue>]60%[/color], but lowered exponentially by the total penalty to Maximum Fatigue from body and head armor above [color=<this.Const.UI.Color.PositiveValue>]15[/color]. The lighter your armor and helmet, the more you benefit.\n\nBrawny does not affect this perk.\n\nDoes not affect damage from mental attacks or status effects, but can help to avoid receiving them."
        es = "¡Especialízate en armaduras ligeras! Al esquivar o desviar golpes ágilmente, conviertes cualquier golpe en un golpe superficial. El daño a los puntos de vida se reduce hasta en [color=<this.Const.UI.Color.PositiveValue>]60%[/color], pero se reduce exponencialmente por la penalización total a la Fatiga máxima por armadura de cuerpo y cabeza por encima de [color=<this.Const.UI.Color.PositiveValue>]15[/color]. Cuanto más ligera sea tu armadura y casco, más te beneficiarás.\n\nLa habilidad 'Musculatura' no afecta a esta habilidad.\n\nNo afecta al daño de los ataques mentales ni a los efectos de estado, pero puede ayudar a evitar recibirlos."
    }
    {
        // BattleForged = "Specialize in heavy armor! Armor damage taken is reduced by a percentage equal to [color=" + this.Const.UI.Color.PositiveValue + "]5%[/color] of the current total armor value of both body and head armor. The heavier your armor and helmet, the more you benefit.\n\nDoes not affect damage from mental attacks or status effects, but can help to avoid receiving them.",
        mode = "pattern"
        en = "Specialize in heavy armor! Armor damage taken is reduced by a percentage equal to [color=<this.Const.UI.Color.PositiveValue>]5%[/color] of the current total armor value of both body and head armor. The heavier your armor and helmet, the more you benefit.\n\nDoes not affect damage from mental attacks or status effects, but can help to avoid receiving them."
        es = "¡Especialízate en armaduras pesadas! El daño a la armadura se reduce en un porcentaje igual al [color=<this.Const.UI.Color.PositiveValue>]5%[/color] del valor total actual de la armadura de cuerpo y cabeza. Cuanto más pesada sea tu armadura y casco, más te beneficiarás.\n\nNo afecta al daño de los ataques mentales ni a los efectos de estado, pero puede ayudar a evitar recibirlos."
    }
    {
        // Duelist = "Become one with your weapon and go for the weak spots! With the offhand free or carrying a buckler or throwable tool (e.g. throwing net), an additional [color=" + this.Const.UI.Color.PositiveValue + "]+25%[/color] of any damage ignores armor. Does not work with two-handed weapons.",
        mode = "pattern"
        en = "Become one with your weapon and go for the weak spots! With the offhand free or carrying a buckler or throwable tool (e.g. throwing net), an additional [color=<this.Const.UI.Color.PositiveValue>]+25%[/color] of any damage ignores armor. Does not work with two-handed weapons."
        es = ""
    }
    {
        // CripplingStrikes = "Cripple your enemies! Lowers the threshold to inflict injuries by [color=" + this.Const.UI.Color.NegativeValue + "]33%[/color] for both melee and ranged attacks.",
        mode = "pattern"
        en = "Cripple your enemies! Lowers the threshold to inflict injuries by [color=<this.Const.UI.Color.NegativeValue>]33%[/color] for both melee and ranged attacks."
        es = "¡Mutila a tus enemigos! Reduce el umbral mínimo para infligir lesiones en [color=<this.Const.UI.Color.NegativeValue>]33%[/color] tanto para ataques cuerpo a cuerpo como a distancia."
    }
    {
        en = "Looking for this? Swapping any item in battle except for shields becomes a free action with no Action Point cost once every turn."
        es = "¿Buscas esto? Cambiar cualquier objeto en la batalla, excepto escudos, se convierte en una acción gratuita sin costo de Puntos de Acción, una vez por turno."
    }
    {
        // Bullseye = "Nailed it! The penalty to hitchance when shooting at a target you have no clear line of fire to is reduced from [color=" + this.Const.UI.Color.NegativeValue + "]75%[/color] to [color=" + this.Const.UI.Color.NegativeValue + "]50%[/color] for ranged weapons.",
        mode = "pattern"
        en = "Nailed it! The penalty to hitchance when shooting at a target you have no clear line of fire to is reduced from [color=<this.Const.UI.Color.NegativeValue>]75%[/color] to [color=<this.Const.UI.Color.NegativeValue>]50%[/color] for ranged weapons."
        es = "¡En el blanco! La penalización a la probabilidad de golpear al disparar a un objetivo del que no tienes línea de visión clara se reduce de [color=<this.Const.UI.Color.NegativeValue>]75%[/color] a sólo [color=<this.Const.UI.Color.NegativeValue>]50%[/color] para armas a distancia."
    }
    {
        // Ballistics = "The range penalty to hitchance is reduced by [color=" + this.Const.UI.Color.NegativeValue + "]-1[/color] per tile.",
        mode = "pattern"
        en = "The range penalty to hitchance is reduced by [color=<this.Const.UI.Color.NegativeValue>]-1[/color] per tile."
        es = "La penalización a la probabilidad de golpear por la distancia se reduce en [color=<this.Const.UI.Color.NegativeValue>]-1[/color] por casilla."
    }
    {
        // Berserk = "RAAARGH! Once per turn, upon killing an enemy, [color=" + this.Const.UI.Color.PositiveValue + "]4[/color] Action Points are immediately regained. Characters can not regain more than their maximum Action Points and no more than 4 for a single attack.",
        mode = "pattern"
        en = "RAAARGH! Once per turn, upon killing an enemy, [color=<this.Const.UI.Color.PositiveValue>]4[/color] Action Points are immediately regained. Characters can not regain more than their maximum Action Points and no more than 4 for a single attack."
        es = "¡RAAARGH! Una vez por turno, al matar a un enemigo, se recuperan inmediatamente [color=<this.Const.UI.Color.PositiveValue>]4[/color] Puntos de Acción. Los personajes no pueden recuperar más de sus Puntos de Acción máximos ni más de 4 por un solo ataque."
    }
    {
        // BattleFlow = "Once per turn, killing an opponent reduces current fatigue by [color=" + this.Const.UI.Color.NegativeValue + "]-25%[/color] of the base maximum fatigue (before penalties due to armor are applied).",
        mode = "pattern"
        en = "Once per turn, killing an opponent reduces current fatigue by [color=<this.Const.UI.Color.NegativeValue>]-25%[/color] of the base maximum fatigue (before penalties due to armor are applied)."
        es = "Una vez por turno, al matar a un oponente, la Fatiga acumulada se reduce en [color=<this.Const.UI.Color.NegativeValue>]-25%[/color] de la Fatiga máxima base (antes de las penalizaciones debidas a la armadura)."
    }
    {
        // DevastatingStrikes = "All damage inflicted is increased by [color=" + this.Const.UI.Color.PositiveValue + "]+20%[/color] for any weapon used. What could stand before you now?",
        mode = "pattern"
        en = "All damage inflicted is increased by [color=<this.Const.UI.Color.PositiveValue>]+20%[/color] for any weapon used. What could stand before you now?"
        es = "Todo el daño infligido se incrementa en [color=<this.Const.UI.Color.PositiveValue>]+20%[/color] para cualquier arma utilizada. ¿Qué podría resistirse a ti ahora?"
    }
    {
        // KillingFrenzy = "Go into a killing frenzy! A kill increases all damage by [color=" + this.Const.UI.Color.PositiveValue + "]25%[/color] for 2 turns. Does not stack, but another kill will reset the timer.",
        mode = "pattern"
        en = "Go into a killing frenzy! A kill increases all damage by [color=<this.Const.UI.Color.PositiveValue>]25%[/color] for 2 turns. Does not stack, but another kill will reset the timer."
        es = "¡Entra en un trance asesino! Un asesinato aumenta todo el daño en [color=<this.Const.UI.Color.PositiveValue>]25%[/color] durante 2 turnos. No se acumula, pero otro asesinato reiniciará el temporizador."
    }
    {
        // ShieldBash = "The Knock Back skill now also inflicts [color=" + this.Const.UI.Color.DamageValue + "]10 - 25[/color] Damage (50% effective against armor) and [color=" + this.Const.UI.Color.DamageValue + "]10[/color] Fatigue in addition to its normal effect, and costs 10 Fatigue less to use.",
        mode = "pattern"
        en = "The Knock Back skill now also inflicts [color=<this.Const.UI.Color.DamageValue>]10 - 25[/color] Damage (50% effective against armor) and [color=<this.Const.UI.Color.DamageValue>]10[/color] Fatigue in addition to its normal effect, and costs 10 Fatigue less to use."
        es = "La habilidad 'Empujón' ahora también inflige un [color=<this.Const.UI.Color.DamageValue>]10 - 25[/color] de Daño (50% efectivo contra la armadura) y [color=<this.Const.UI.Color.DamageValue>]10[/color] de Fatiga además de su efecto normal, y cuesta 10 de Fatiga menos usarla."
    }
    {
        // Brawny = "The fatigue and initiative penalty from wearing armor and helmet is reduced by [color=" + this.Const.UI.Color.NegativeValue + "]30%[/color].",
        mode = "pattern"
        en = "The fatigue and initiative penalty from wearing armor and helmet is reduced by [color=<this.Const.UI.Color.NegativeValue>]30%[/color]."
        es = "Fuerte como un buey. La penalización de Fatiga máxima e Iniciativa por llevar armadura y casco se reduce en [color=<this.Const.UI.Color.NegativeValue>]30%[/color]."
    }
    {
        en = "Immunity against being knocked back or pulled up close. Applies to skills such as Knock Back, Hook and others that change a character's position."
        es = "Inmunidad contra el aturdimiento o ser atraído hacia el enemigo. Se aplica a habilidades como 'Empujón' y 'Agarre' y otras que cambian la posición de un personaje."
    }
    {
        en = "Getting hit by regular attacks does not cause a loss of fatigue anymore. Attacks that specifically target fatigue are unaffected."
        es = "Ser golpeado por ataques regulares ya no causa pérdida de fatiga. Los ataques que específicamente atacan la fatiga no se ven afectados."
    }
    {
        en = "Unlocks the 'Taunt' skill which makes the targeted opponent take offensive actions instead of defensive ones, and attack the taunting character over another, potentially more vulnerable one."
        es = "¡Peleas como una vaca! Desbloquea la habilidad 'Provocar', que hace que el oponente objetivo tome acciones ofensivas en lugar de defensivas y ataque al personaje que lo provoca en lugar de a otro más vulnerable."
    }
    {
        // Colossus = "Bring it on! Hitpoints are increased by [color=" + this.Const.UI.Color.PositiveValue + "]25%[/color], which also reduces the chance to sustain debilitating injuries when being hit.",
        mode = "pattern"
        en = "Bring it on! Hitpoints are increased by [color=<this.Const.UI.Color.PositiveValue>]25%[/color], which also reduces the chance to sustain debilitating injuries when being hit."
        es = "¡Derribame si puedes! Los puntos de vida se incrementan en [color=<this.Const.UI.Color.PositiveValue>]25%[/color], lo que también reduce la probabilidad de sufrir lesiones debilitantes al ser golpeado."
    }
    {
        // ShieldExpert = "Learn to better deflect hits to the side instead of blocking them head on.\n\nThe shield defense bonus is increased by [color=" + this.Const.UI.Color.PositiveValue + "]25%[/color]. This also applies to the additional defense bonus of the Shieldwall skill.\n\nShield damage received is reduced by [color=" + this.Const.UI.Color.NegativeValue + "]50%[/color] to a minimum of 1.\n\nThe \'Knock Back\' skill gains [color=" + this.Const.UI.Color.PositiveValue + "]+15%[/color] chance to hit.",
        mode = "pattern"
        en = "Learn to better deflect hits to the side instead of blocking them head on.\n\nThe shield defense bonus is increased by [color=<this.Const.UI.Color.PositiveValue>]25%[/color]. This also applies to the additional defense bonus of the Shieldwall skill.\n\nShield damage received is reduced by [color=<this.Const.UI.Color.NegativeValue>]50%[/color] to a minimum of 1.\n\nThe 'Knock Back' skill gains [color=<this.Const.UI.Color.PositiveValue>]+15%[/color] chance to hit."
        es = "Con tu escudo, o sobre él. Aprende a desviar mejor los golpes hacia un lado en lugar de bloquearlos de frente.\n\nEl bono de defensa con escudo se incrementa en [color=<this.Const.UI.Color.PositiveValue>]25%[/color]. Esto también se aplica al bono adicional de defensa de la habilidad 'Muro de Escudos'.\n\nEl daño recibido por el escudo se reduce en [color=<this.Const.UI.Color.NegativeValue>]50%[/color], como mínimo de 1.\n\nLa habilidad 'Golpe de escudo' gana un [color=<this.Const.UI.Color.PositiveValue>]+15%[/color] de probabilidad de golpear."
    }
    {
        en = "Once per battle, upon receiving a killing blow, survive instead with a few hitpoints left and have all damage over time effects (e.g. bleeding, poisoned) cured. The next hit is likely to kill you for good, of course, but improved defensive stats until your next turn help you to survive until then."
        es = "¡Por los pelos! Una vez por batalla, al recibir un golpe mortal, sobrevive con algunos puntos de vida restantes y cura todos los efectos de daño prolongado (por ejemplo, sangrado, envenenamiento). El siguiente golpe es probable que te mate de una vez, por supuesto, pero las estadísticas defensivas mejoradas hasta tu próximo turno te ayudarán a sobrevivir hasta entonces."
    }
    {
        en = "Immunity against being stunned."
        es = "Inmunidad contra el aturdimiento."
    }
    {
        en = "Unlock two extra bag slots to carry all your favorite things. Items placed in bags no longer give a penalty to Maximum Fatigue, except for two-handed weapons."
        es = "Armado hasta los dientes. Desbloquea dos ranuras de bolsa adicionales para llevar todas tus cosas favoritas. Los objetos colocados en bolsas ya no penalizan la Fatiga Máxima, excepto las armas de dos manos."
    }
    {
        // Student = "Everything can be learned if you put your mind to it. Gain additional [color=" + this.Const.UI.Color.PositiveValue + "]20%[/color] experience from battle. At the eleventh character level, you gain an additional perk point and this perk becomes inert.\n\nPlaying the \'Manhunters\' origin, your indebted get the perk point refunded at the seventh character level.",
        mode = "pattern"
        en = "Everything can be learned if you put your mind to it. Gain additional [color=<this.Const.UI.Color.PositiveValue>]20%[/color] experience from battle. At the eleventh character level, you gain an additional perk point and this perk becomes inert.\n\nPlaying the 'Manhunters' origin, your indebted get the perk point refunded at the seventh character level."
        es = "Todo se puede aprender si te lo propones. Gana [color=<this.Const.UI.Color.PositiveValue>]20%[/color] de experiencia adicional de las batallas. Al alcanzar el nivel de personaje once, obtienes un punto de habilidad adicional y esta habilidad se vuelve inactiva.\n\nJugando con el origen 'Cazadores de Hombres', tus deudores obtienen el punto de habilidad de nuevo en el nivel de personaje siete."
    }
    {
        en = "Mercenary life comes easy when you're naturally gifted. Instantly gain a levelup to increase this character's attributes with maximum rolls, but without talents."
        es = "La vida de mercenario es más fácil cuando eres naturalmente talentoso. Obtén instantáneamente un aumento de nivel para aumentar los atributos de este personaje con tiradas máximas, pero sin ventajas."
    }
    {
        // Zweihander = "Fatigue costs for all two-handed weapon skills are reduced by [color=" + this.Const.UI.Color.NegativeValue + "]-20%[/color].",
        mode = "pattern"
        en = "Fatigue costs for all two-handed weapon skills are reduced by [color=<this.Const.UI.Color.NegativeValue>]-20%[/color]."
        es = "Los costos de fatiga de todas las habilidades de armas de dos manos se reducen en [color=<this.Const.UI.Color.NegativeValue>]-20%[/color]."
    }
    {
        // Pathfinder = "Learn to move on difficult terrain. Action Point costs for movement on all terrain is reduced by [color=" + this.Const.UI.Color.NegativeValue + "]-1[/color] to a minimum of 2 Action Points per tile, and Fatigue cost is reduced to half. Changing height levels also has no additional Action Point cost anymore.",
        mode = "pattern"
        en = "Learn to move on difficult terrain. Action Point costs for movement on all terrain is reduced by [color=<this.Const.UI.Color.NegativeValue>]-1[/color] to a minimum of 2 Action Points per tile, and Fatigue cost is reduced to half. Changing height levels also has no additional Action Point cost anymore."
        es = "Aprende a moverte en terrenos difíciles. Los costos de Puntos de Acción para moverte en cualquier terreno se reducen en [color=<this.Const.UI.Color.NegativeValue>]-1[/color], con un mínimo de 2 Puntos de Acción por casilla, y el costo de fatiga se reduce a la mitad. Cambiar de nivel de altura ya no tiene un costo adicional de Puntos de Acción."
    }
    {
        // FortifiedMind = "An iron will is not swayed from the true path easily. Resolve is increased by [color=" + this.Const.UI.Color.PositiveValue + "]25%[/color].",
        mode = "pattern"
        en = "An iron will is not swayed from the true path easily. Resolve is increased by [color=<this.Const.UI.Color.PositiveValue>]25%[/color]."
        es = "Una voluntad de hierro no se desviará fácilmente del verdadero camino. La Resolución se incrementa en un [color=<this.Const.UI.Color.PositiveValue>]25%[/color]."
    }
    {
        // Captain = "Use a sergeant on the battlefield as an extension of your leadership and to keep everyone in line. Allies at a range of 5 tiles or less will get [color=" + this.Const.UI.Color.PositiveValue + "]15%[/color] of this character\'s Resolve as a bonus added to their own, up to a maximum of this character\'s Resolve.\n\nDoes not stack; the sergeant with the highest Resolve will apply the bonus.",
        mode = "pattern"
        en = "Use a sergeant on the battlefield as an extension of your leadership and to keep everyone in line. Allies at a range of 5 tiles or less will get [color=<this.Const.UI.Color.PositiveValue>]15%[/color] of this character's Resolve as a bonus added to their own, up to a maximum of this character's Resolve.\n\nDoes not stack; the sergeant with the highest Resolve will apply the bonus."
        es = "Usa a un sargento en el campo de batalla como una extensión de tu liderazgo y para mantener a todos en línea. Los aliados a una distancia de 5 casillas o menos obtendrán [color=<this.Const.UI.Color.PositiveValue>]15%[/color] de la Resolución de este personaje como bono agregado a la suya propia, hasta un máximo de la Resolución de este personaje.\n\nNo se acumula; el sargento con la Resolución más alta aplicará el bono."
    }
    {
        en = "A great leader of men inspires his followers to overcome their limits. Allies start every battle at confident morale unless prohibited by character traits."
        es = "Un gran líder inspira a sus seguidores a superar sus límites. Los aliados comienzan cada batalla con moral confiada a menos que esté prohibido por las características del personaje."
    }
    {
        en = "I'm used to it. The defense malus due to being surrounded by opponents no longer applies to this character. If an attacker has the Backstabber perk, the effect of that perk is negated, and the normal defense malus due to being surrounded is applied instead."
        es = "Ya estoy acostumbrado. La penalización de defensa debido a estar rodeado de oponentes ya no se aplica a este personaje. Si un atacante tiene la habilidad 'Apuñalador', se anula el efecto de esa habilidad y se aplica en su lugar la penalización normal de defensa debido a estar rodeado."
    }
    {
        // Recover = "Unlocks the \'Recover\' skill which allows for resting a turn in order to reduce accumulated Fatigue by [color=" + this.Const.UI.Color.NegativeValue + "]50%[/color].",
        mode = "pattern"
        en = "Unlocks the 'Recover' skill which allows for resting a turn in order to reduce accumulated Fatigue by [color=<this.Const.UI.Color.NegativeValue>]50%[/color]."
        es = "Toma aliento. Desbloquea la habilidad 'Recuperarse', que permite descansar un turno para reducir la Fatiga acumulada en [color=<this.Const.UI.Color.NegativeValue>]50%[/color].\n\n\x22Voy a romperte esa estúpida cara que tienes... sólo... dame un momento para tomar aire...\x22"
    }
    {
        // Backstabber = "Honor doesn\'t win you fights, stabbing the enemy where it hurts does. The bonus to hitchance in melee is doubled to [color=" + this.Const.UI.Color.PositiveValue + "]+10%[/color] for each ally surrounding and distracting your target.",
        mode = "pattern"
        en = "Honor doesn't win you fights, stabbing the enemy where it hurts does. The bonus to hitchance in melee is doubled to [color=<this.Const.UI.Color.PositiveValue>]+10%[/color] for each ally surrounding and distracting your target."
        es = "El honor no gana peleas, apuñalar al enemigo donde duele sí. El bono a la probabilidad de golpear en el combate cuerpo a cuerpo se duplica a [color=<this.Const.UI.Color.PositiveValue>]+10%[/color] por cada aliado que rodee y distraiga a tu objetivo."
    }
    {
        // LoneWolf = "I work best alone. With no ally within 3 tiles of distance, gain a [color=" + this.Const.UI.Color.PositiveValue + "]15%[/color] bonus to Melee Skill, Ranged Skill, Melee Defense, Ranged Defense, and Resolve.",
        mode = "pattern"
        en = "I work best alone. With no ally within 3 tiles of distance, gain a [color=<this.Const.UI.Color.PositiveValue>]15%[/color] bonus to Melee Skill, Ranged Skill, Melee Defense, Ranged Defense, and Resolve."
        es = "Trabajo mejor solo. Sin ningún aliado a una distancia de 3 casillas o menos, obtienes un bono de [color=<this.Const.UI.Color.PositiveValue>]15%[/color] a la Habilidad cuerpo a cuerpo, Habilidad a distancia, Defensa cuerpo a cuerpo, Defensa a distancia y Resolución."
    }
    {
        // ReachAdvantage = "Learn to use the superior reach of large weapons to keep the enemy from getting close enough to land a good hit.\n\nEach hit with a two-handed melee weapon adds a stack of Reach Advantage that increases your Melee Defense by [color=" + this.Const.UI.Color.PositiveValue + "]+5[/color], up to a maximum of 5 stacks, until this character\'s next turn. A single attack hitting multiple targets can add several stacks at once.\n\nIf you put away your weapon, you lose all stacks.",
        mode = "pattern"
        en = "Learn to use the superior reach of large weapons to keep the enemy from getting close enough to land a good hit.\n\nEach hit with a two-handed melee weapon adds a stack of Reach Advantage that increases your Melee Defense by [color=<this.Const.UI.Color.PositiveValue>]+5[/color], up to a maximum of 5 stacks, until this character's next turn. A single attack hitting multiple targets can add several stacks at once.\n\nIf you put away your weapon, you lose all stacks."
        es = "Aprende a usar el alcance superior de las armas grandes para evitar que el enemigo se acerque lo suficiente para dar un buen golpe.\n\nCada golpe con un arma de combate cuerpo a cuerpo de dos manos agrega una acumulación de Ventaja de Alcance que aumenta tu Defensa cuerpo a cuerpo en [color=<this.Const.UI.Color.PositiveValue>]+5[/color], hasta un máximo de 5 acumulaciones, hasta el próximo turno de este personaje. Un solo ataque que golpee a múltiples objetivos puede agregar varias acumulaciones a la vez.\n\nSi guardas tu arma, perderás todas las acumulaciones."
    }
    {
        // Overwhelm = "Learn to take advantage of your high Initiative and prevent the enemy from attacking effectively by overwhelming them with your attacks!\n\nWith every attack, hit or miss, against an opponent that acts after you in the current round, inflict the \'Overwhelmed\' status effect which lowers both Melee Skill and Ranged Skill by [color=" + this.Const.UI.Color.NegativeValue + "]10%[/color] for one turn.\n\nThe effect stacks with each attack, and can be applied to multiple targets at once with a single attack.",
        mode = "pattern"
        en = "Learn to take advantage of your high Initiative and prevent the enemy from attacking effectively by overwhelming them with your attacks!\n\nWith every attack, hit or miss, against an opponent that acts after you in the current round, inflict the 'Overwhelmed' status effect which lowers both Melee Skill and Ranged Skill by [color=<this.Const.UI.Color.NegativeValue>]10%[/color] for one turn.\n\nThe effect stacks with each attack, and can be applied to multiple targets at once with a single attack."
        es = "No les des respiro. Aprende a aprovechar tu alta Iniciativa y evita que el enemigo ataque eficazmente abrumándolo con tus ataques.\n\nCon cada ataque, acertado o no, contra un oponente que actúa después de ti en la ronda actual, inflige el efecto de estado 'Abrumado' que reduce tanto la Habilidad cuerpo a cuerpo como la Habilidada a distancia en [color=<this.Const.UI.Color.NegativeValue>]10%[/color] durante un turno.\n\nEl efecto se acumula con cada ataque y se puede aplicar a varios objetivos a la vez con un solo ataque."
    }
    {
        // SpecBow = "Master the art of archery and pelting your opponents with arrows from afar. Skills build up [color=" + this.Const.UI.Color.NegativeValue + "]25%[/color] less Fatigue.\n\nView range and maximum firing range with bows is increased by [color=" + this.Const.UI.Color.PositiveValue + "]+1[/color].",
        mode = "pattern"
        en = "Master the art of archery and pelting your opponents with arrows from afar. Skills build up [color=<this.Const.UI.Color.NegativeValue>]25%[/color] less Fatigue.\n\nView range and maximum firing range with bows is increased by [color=<this.Const.UI.Color.PositiveValue>]+1[/color]."
        es = "Domina el arte de la arquería y bombardea a tus oponentes con flechas desde lejos. Las habilidades acumulan [color=<this.Const.UI.Color.NegativeValue>]25%[/color] menos de Fatiga.\n\nEl rango de visión y el rango máximo de disparo con arcos se incrementa en [color=<this.Const.UI.Color.PositiveValue>]+1[/color].\n\n\x22Puedo darle a esa manzana a 100 pies... bueno quizá 95.\x22"
    }
    {
        // SpecCrossbow = "Master crossbows and firearms, and learn where to aim best. Skills build up [color=" + this.Const.UI.Color.NegativeValue + "]25%[/color] less Fatigue.\n\nAn additional [color=" + this.Const.UI.Color.PositiveValue + "]20%[/color] of damage inflicted with crossbows ignores armor.\n\nHandgonnes now require [color=" + this.Const.UI.Color.NegativeValue + "]6[/color] Action Points to reload and can be fired every turn instead of every other turn.",
        mode = "pattern"
        en = "Master crossbows and firearms, and learn where to aim best. Skills build up [color=<this.Const.UI.Color.NegativeValue>]25%[/color] less Fatigue.\n\nAn additional [color=<this.Const.UI.Color.PositiveValue>]20%[/color] of damage inflicted with crossbows ignores armor.\n\nHandgonnes now require [color=<this.Const.UI.Color.NegativeValue>]6[/color] Action Points to reload and can be fired every turn instead of every other turn."
        es = "Domina las ballestas y armas de fuego y aprende dónde apuntar mejor. Las habilidades acumulan [color=<this.Const.UI.Color.NegativeValue>]25%[/color] menos de Fatiga.\n\nUn [color=<this.Const.UI.Color.PositiveValue>]20%[/color] adicional del daño infligido con ballestas ignora la armadura.\n\nLos cañones de mano ahora requieren sólo [color=<this.Const.UI.Color.NegativeValue>]6[/color] Puntos de Acción para recargar y se pueden disparar cada turno en lugar de cada dos turnos.\n\n\x22Pocas armas han matado tantos caballeros como la ballesta... y la disentería, claro.\x22"
    }
    {
        // SpecThrowing = "Master throwing weapons to wound or kill the enemy before they even get close. Skills build up [color=" + this.Const.UI.Color.NegativeValue + "]25%[/color] less Fatigue.\n\nDamage is increased by [color=" + this.Const.UI.Color.PositiveValue + "]30%[/color] when attacking at 2 tiles of distance.\n\nDamage is increased by [color=" + this.Const.UI.Color.PositiveValue + "]20%[/color] when attacking at 3 tiles of distance.",
        mode = "pattern"
        en = "Master throwing weapons to wound or kill the enemy before they even get close. Skills build up [color=<this.Const.UI.Color.NegativeValue>]25%[/color] less Fatigue.\n\nDamage is increased by [color=<this.Const.UI.Color.PositiveValue>]30%[/color] when attacking at 2 tiles of distance.\n\nDamage is increased by [color=<this.Const.UI.Color.PositiveValue>]20%[/color] when attacking at 3 tiles of distance."
        es = "Domina las armas arrojadizas para herir o matar al enemigo antes de que se acerque. Las habilidades acumulan [color=<this.Const.UI.Color.NegativeValue>]25%[/color] menos de Fatiga.\n\nEl daño se incrementa en [color=<this.Const.UI.Color.PositiveValue>]30%[/color] al atacar a 2 casillas de distancia.\n\nEl daño se incrementa en [color=<this.Const.UI.Color.PositiveValue>]20%[/color] al atacar a 3 casillas de distancia.\n\n\x22Juguemos a lanzar dardos. Tu eres el blanco.\x22"
    }
    {
        // SpecAxe = "Master combat with axes and destroying shields. Skills build up [color=" + this.Const.UI.Color.NegativeValue + "]25%[/color] less Fatigue.\n\nSplit Shield damage to shields is increased by [color=" + this.Const.UI.Color.PositiveValue + "]50%[/color] when used with axes.\n\nRound Swing gains [color=" + this.Const.UI.Color.PositiveValue + "]+5%[/color] chance to hit.\n\nThe Longaxe no longer has a penalty for attacking targets directly adjacent.",
        mode = "pattern"
        en = "Master combat with axes and destroying shields. Skills build up [color=<this.Const.UI.Color.NegativeValue>]25%[/color] less Fatigue.\n\nSplit Shield damage to shields is increased by [color=<this.Const.UI.Color.PositiveValue>]50%[/color] when used with axes.\n\nRound Swing gains [color=<this.Const.UI.Color.PositiveValue>]+5%[/color] chance to hit.\n\nThe Longaxe no longer has a penalty for attacking targets directly adjacent."
        es = "Domina el combate con hachas y destruye escudos. Las habilidades acumulan [color=<this.Const.UI.Color.NegativeValue>]25%[/color] menos de Fatiga.\n\nEl daño a los escudos con la habilidad 'Romper escudo' se incrementa en [color=<this.Const.UI.Color.PositiveValue>]50%[/color] al usar hachas.\n\nLa habilidad 'Golpe circular' obtiene un [color=<this.Const.UI.Color.PositiveValue>]+5%[/color] de probabilidad de golpear.\n\nEl Hachalarga ya no tiene una penalización por atacar a objetivos directamente adyacentes.\n\n\x22¿Dices que luchar con un hacha es como talar árboles? Bueno, sí. Con un poco más de sangre y vísceras, pero sí.\x22"
    }
    {
        // SpecCleaver = "Master cleavers to inflict gruesome wounds. Skills build up [color=" + this.Const.UI.Color.NegativeValue + "]25%[/color] less Fatigue.\n\nBleeding damage inflicted by cleavers and whips is doubled to [color=" + this.Const.UI.Color.PositiveValue + "]10[/color] and [color=" + this.Const.UI.Color.PositiveValue + "]20[/color] per turn, respectively.\n\nDisarm only has half the penalty to hit.",
        mode = "pattern"
        en = "Master cleavers to inflict gruesome wounds. Skills build up [color=<this.Const.UI.Color.NegativeValue>]25%[/color] less Fatigue.\n\nBleeding damage inflicted by cleavers and whips is doubled to [color=<this.Const.UI.Color.PositiveValue>]10[/color] and [color=<this.Const.UI.Color.PositiveValue>]20[/color] per turn, respectively.\n\nDisarm only has half the penalty to hit."
        es = "Domina las cuchillas y látigos para infligir heridas horribles. Las habilidades acumulan un [color=<this.Const.UI.Color.NegativeValue>]25%[/color] menos de Fatiga.\n\nEl daño por sangrado infligido por cuchillas y látigos se duplica a [color=<this.Const.UI.Color.PositiveValue>]10[/color] y [color=<this.Const.UI.Color.PositiveValue>]20[/color] por turno, respectivamente.\n\n'Desarmar' solo tiene la mitad de penalización para acertar.\n\n\x22A veces, lo único que tienes que hacer, es dejar que se desangren...\x22"
    }
    {
        // SpecDagger = "Master swift and deadly daggers. Skills build up [color=" + this.Const.UI.Color.NegativeValue + "]25%[/color] less Fatigue.\n\nStab, Puncture, Deathblow, Perforate, and Skewer have a reduced Action Point cost, potentially allowing for an additional attack each turn.",
        mode = "pattern"
        en = "Master swift and deadly daggers. Skills build up [color=<this.Const.UI.Color.NegativeValue>]25%[/color] less Fatigue.\n\nStab, Puncture, Deathblow, Perforate, and Skewer have a reduced Action Point cost, potentially allowing for an additional attack each turn."
        es = ""
    }
    {
        // SpecSword = "Master the art of swordfighting and using your opponent\'s mistakes to your advantage. Skills build up [color=" + this.Const.UI.Color.NegativeValue + "]25%[/color] less Fatigue.\n\nRiposte no longer has a penalty to hitchance.\n\nGash has a [color=" + this.Const.UI.Color.NegativeValue + "]50%[/color] lower threshold to inflict injuries.\n\nSplit and Swing no longer have a penalty to hitchance and gain [color=" + this.Const.UI.Color.PositiveValue + "]+5%[/color] chance to hit.",
        mode = "pattern"
        en = "Master the art of swordfighting and using your opponent's mistakes to your advantage. Skills build up [color=<this.Const.UI.Color.NegativeValue>]25%[/color] less Fatigue.\n\nRiposte no longer has a penalty to hitchance.\n\nGash has a [color=<this.Const.UI.Color.NegativeValue>]50%[/color] lower threshold to inflict injuries.\n\nSplit and Swing no longer have a penalty to hitchance and gain [color=<this.Const.UI.Color.PositiveValue>]+5%[/color] chance to hit."
        es = "Domina el arte de la esgrima y aprovecha los errores de tu oponente a tu favor. Las habilidades acumulan un [color=<this.Const.UI.Color.NegativeValue>]25%[/color] menos de Fatiga.\n\n'Contraataque' ya no tiene penalización en la probabilidad de golpear.\n\n'Tajo debilitante' tiene un umbral un [color=<this.Const.UI.Color.NegativeValue>]50%[/color] más bajo para infligir lesiones.\n\n'Dividir' y 'Corte amplio' ya no tienen penalización en la probabilidad de golpear y ganan [color=<this.Const.UI.Color.PositiveValue>]+5%[/color] de probabilidad de acertar.\n\n\x22Una espada es tan buena como el guerrero que la empuñe.\x22"
    }
    {
        // SpecSpear = "Master fighting with spears and keeping the enemy at bay. Skills build up [color=" + this.Const.UI.Color.NegativeValue + "]25%[/color] less Fatigue.\n\nSpearwall is no longer disabled once an opponent manages to overcome it. Instead, Spearwall can still be used and continues to give free attacks on any further opponent attempting to enter the Zone of Control.\n\nThe Spetum and Warfork no longer have a penalty for attacking targets directly adjacent.",
        mode = "pattern"
        en = "Master fighting with spears and keeping the enemy at bay. Skills build up [color=<this.Const.UI.Color.NegativeValue>]25%[/color] less Fatigue.\n\nSpearwall is no longer disabled once an opponent manages to overcome it. Instead, Spearwall can still be used and continues to give free attacks on any further opponent attempting to enter the Zone of Control.\n\nThe Spetum and Warfork no longer have a penalty for attacking targets directly adjacent."
        es = "Domina la lucha con lanzas y mantén al enemigo a raya. Las habilidades acumulan [color=<this.Const.UI.Color.NegativeValue>]25%[/color] menos fatiga.\n\n'Muro de lanzas' ya no se desactiva una vez que un oponente logra superarlo y entrar al cuerpo a cuerpo. En cambio, 'Muro de lanzas' aún se puede usar y continúa brindando ataques gratuitos contra cualquier oponente que intente ingresar a la Zona de Control.\n\nEl Spetum y Horca de guerra ya no tienen una penalización por atacar objetivos directamente adyacentes.\n\n\x22Tu no lograrás pasar.\x22"
    }
    {
        // SpecPolearm = "Master polearms and keeping the enemy at bay. Skills build up [color=" + this.Const.UI.Color.NegativeValue + "]25%[/color] less Fatigue.\n\nPolearm skills have their Action Point cost reduced to [color=" + this.Const.UI.Color.NegativeValue + "]5[/color], and no longer have a penalty for attacking targets directly adjacent.",
        mode = "pattern"
        en = "Master polearms and keeping the enemy at bay. Skills build up [color=<this.Const.UI.Color.NegativeValue>]25%[/color] less Fatigue.\n\nPolearm skills have their Action Point cost reduced to [color=<this.Const.UI.Color.NegativeValue>]5[/color], and no longer have a penalty for attacking targets directly adjacent."
        es = "Domina las armas de asta y mantiene al enemigo a distancia. Las habilidades acumulan un [color=<this.Const.UI.Color.NegativeValue>]25%[/color] menos de Fatiga.\n\nLas habilidades de armas de asta tienen su costo de Puntos de Acción reducido a [color=<this.Const.UI.Color.NegativeValue>]5[/color], y ya no tienen penalización al atacar a objetivos directamente adyacentes.\n\n\x22La maestría es lo que diferencia a un sucio campesino de un alabardero.\x22"
    }
    {
        // SpecHammer = "Master hammers and fighting against heavily armored opponents. Skills build up [color=" + this.Const.UI.Color.NegativeValue + "]25%[/color] less Fatigue.\n\nDestroy Armor and Demolish Armor inflict [color=" + this.Const.UI.Color.PositiveValue + "]33%[/color] more damage against armor.\n\nShatter gains [color=" + this.Const.UI.Color.PositiveValue + "]+5%[/color] chance to hit.\n\nThe Polehammer no longer has a penalty for attacking targets directly adjacent.",
        mode = "pattern"
        en = "Master hammers and fighting against heavily armored opponents. Skills build up [color=<this.Const.UI.Color.NegativeValue>]25%[/color] less Fatigue.\n\nDestroy Armor and Demolish Armor inflict [color=<this.Const.UI.Color.PositiveValue>]33%[/color] more damage against armor.\n\nShatter gains [color=<this.Const.UI.Color.PositiveValue>]+5%[/color] chance to hit.\n\nThe Polehammer no longer has a penalty for attacking targets directly adjacent."
        es = "Domina los martillos y lucha contra oponentes fuertemente blindados. Las habilidades acumulan un [color=<this.Const.UI.Color.NegativeValue>]25%[/color] menos de Fatiga.\n\n'Destruir armadura' y 'Demoler armadura' infligen un [color=<this.Const.UI.Color.PositiveValue>]33%[/color] más de daño contra la armadura.\n\n'Destrozar' obtiene [color=<this.Const.UI.Color.PositiveValue>]+5%[/color] de probabilidad de golpear.\n\nEl Martillo enastado ya no tiene una penalización al atacar a objetivos directamente adyacentes.\n\n\x22¡Es hora del martillo!\x22"
    }
    {
        // SpecMace = "Master maces to beat your opponents into submission, armored or not. Skills build up [color=" + this.Const.UI.Color.NegativeValue + "]25%[/color] less Fatigue.\n\nKnock Out, Knock Over and Strike Down have a [color=" + this.Const.UI.Color.PositiveValue + "]100%[/color] chance to stun the target if not immune.\n\nThe Polemace no longer has a penalty for attacking targets directly adjacent.",
        mode = "pattern"
        en = "Master maces to beat your opponents into submission, armored or not. Skills build up [color=<this.Const.UI.Color.NegativeValue>]25%[/color] less Fatigue.\n\nKnock Out, Knock Over and Strike Down have a [color=<this.Const.UI.Color.PositiveValue>]100%[/color] chance to stun the target if not immune.\n\nThe Polemace no longer has a penalty for attacking targets directly adjacent."
        es = "Domina las mazas para someter a tus oponentes, con armadura o sin ella. Las habilidades acumulan un [color=<this.Const.UI.Color.NegativeValue>]25%[/color] menos de Fatiga.\n\n'Aturdir', 'Derribar' y 'Demoler' tienen una probabilidad de [color=<this.Const.UI.Color.PositiveValue>]100%[/color] de aturdir al objetivo si no es inmune.\n\nEl Mazo enastado ya no tiene penalización al atacar a objetivos directamente adyacentes.\n\n\x22Un buen mazazo siempre será un argumento de peso en cualquier discusión.\x22"
    }
    {
        // SpecFlail = "Master flails and circumvent your opponent\'s shield. Skills build up [color=" + this.Const.UI.Color.NegativeValue + "]25%[/color] less Fatigue.\n\nLash and Hail ignore the defense bonus of shields.\n\nPound ignores an additional [color=" + this.Const.UI.Color.PositiveValue + "]+10%[/color] of armor on head hits.\n\nThresh gains [color=" + this.Const.UI.Color.PositiveValue + "]+5%[/color] chance to hit."
        mode = "pattern"
        en = "Master flails and circumvent your opponent's shield. Skills build up [color=<this.Const.UI.Color.NegativeValue>]25%[/color] less Fatigue.\n\nLash and Hail ignore the defense bonus of shields.\n\nPound ignores an additional [color=<this.Const.UI.Color.PositiveValue>]+10%[/color] of armor on head hits.\n\nThresh gains [color=<this.Const.UI.Color.PositiveValue>]+5%[/color] chance to hit."
        es = "Domina los mayales y burla el escudo de tu oponente. Las habilidades acumulan un [color=<this.Const.UI.Color.NegativeValue>]25%[/color] menos de Fatiga.\n\n'Flagelar' y 'Hostigar' ignoran el bono de defensa de los escudos.\n\n'Machacar' ignora un [color=<this.Const.UI.Color.PositiveValue>]+10%[/color] adicional de la armadura en los golpes a la cabeza.\n\n'Trillar' obtiene [color=<this.Const.UI.Color.PositiveValue>]+5%[/color] de probabilidad de golpear.\n\n\x22Ese escudito no te salvará.\x22"
    }
    {
        en = "Click to focus party"
        es = "Click para enfocar el grupo"
    }
    {
        en = "Click to focus location"
        es = "Click para enfocar la ubicación"
    }
    {
        en = "Click to focus character"
        es = "Click para enfocar al personaje"
    }
    {
        en = "Can not be changed in combat"
        es = "No puede ser cambiado en combate"
    }
    {
        en = "Only the character whose turn it is right now can change items"
        es = "Sólo el personaje al que le toca ahora puede cambiar artículos"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\config\tactical.nut
    {
        // text = "[color=" + this.Const.UI.Color.NegativeValue + "]-25%[/color] Melee Skill"
        mode = "pattern"
        en = "[color=<this.Const.UI.Color.NegativeValue>]-25%[/color] Melee Skill"
        es = "[color=<this.Const.UI.Color.NegativeValue>]-25%[/color] Habilidad cuerpo a cuerpo"
    }
    {
        // text = "[color=" + this.Const.UI.Color.NegativeValue + "]-25%[/color] Melee Defense"
        mode = "pattern"
        en = "[color=<this.Const.UI.Color.NegativeValue>]-25%[/color] Melee Defense"
        es = "[color=<this.Const.UI.Color.NegativeValue>]-25%[/color] Defensa cuerpo a cuerpo"
    }
    {
        // text = "[color=" + this.Const.UI.Color.NegativeValue + "]-25%[/color] Ranged Defense"
        mode = "pattern"
        en = "[color=<this.Const.UI.Color.NegativeValue>]-25%[/color] Ranged Defense"
        es = "[color=<this.Const.UI.Color.NegativeValue>]-25%[/color] Defensa a distancia"
    }
    {
        en = "Default"
        es = ""
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\config\tip_of_the_day.nut
    {
        en = "As brothers we fight, as brothers we die!"
        es = "¡Como hermanos luchamos, como hermanos morimos!"
    }
    {
        en = "Shields can be destroyed using axes and some two-handed weapons."
        es = "Los escudos pueden ser destruidos utilizando hachas y algunas armas de dos manos."
    }
    {
        en = "Different types of shields are better suited against melee or ranged attacks."
        es = "Diferentes tipos de escudos son más adecuados contra ataques cuerpo a cuerpo o ataques a distancia."
    }
    {
        en = "Shields take minor damage each time they are used to deflect an attack."
        es = "Los escudos sufren daños menores cada vez que se utilizan para bloquear un ataque."
    }
    {
        en = "Shrubbery can hide characters from being detected from afar."
        es = "La vegetación puede ocultar a los personajes para evitar ser detectados desde lejos."
    }
    {
        en = "A character with a height level advantage over their opponent is harder to hit."
        es = "Un personaje con ventaja en altura sobre su oponente es más difícil de golpear."
    }
    {
        en = "Characters can see farther, the higher they are positioned."
        es = "Los personajes pueden ver más lejos cuanto más alto estén posicionados."
    }
    {
        en = "Having men of different backgrounds in your company may enable you to perform different actions in events."
        es = "Tener hombres de diferentes orígenes en tu compañía puede permitirte realizar diferentes acciones en eventos."
    }
    {
        en = "Surrounding an opponent from multiple sides makes it easier to score a hit."
        es = "Rodear a un oponente desde múltiples lados facilita asestarle un golpe."
    }
    {
        en = "Consider putting injured characters in reserve until their wounds have healed."
        es = "Considera poner a los personajes heridos en reserva hasta que se hayan curado."
    }
    {
        en = "Consider building up a reserve roster and rotating your men, so you can more easily deal with losses down the road."
        es = "Considera formar una reserva y rotar a tus hombres para lidiar más fácilmente con las pérdidas a largo plazo."
    }
    {
        en = "Ranged weapon accuracy drops with distance."
        es = "La precisión de las armas a distancia disminuye con la distancia."
    }
    {
        en = "You don't have to be a hero, you're running a business."
        es = "No tienes que ser un héroe, estás dirigiendo un negocio."
    }
    {
        en = "Different backgrounds may unlock additional options at handling events and contracts."
        es = "Diferentes trasfondos pueden desbloquear opciones adicionales para manejar eventos y contratos."
    }
    {
        en = "Drag and drop your men in the inventory screen to where you want them to be in your formation."
        es = "Arrastra y suelta a tus hombres en la pantalla de inventario para colocarlos en la formación deseada."
    }
    {
        en = "A missed ranged attack can hit nearby characters, especially if they are in the direct line of fire."
        es = "Un ataque a distancia fallido puede golpear a personajes cercanos, especialmente si están en la línea de fuego directa."
    }
    {
        en = "Bows can not be fired and crossbows not be reloaded while engaged in melee."
        es = "Los arcos no se pueden disparar y las ballestas no se pueden recargar mientras están en combate cuerpo a cuerpo."
    }
    {
        en = "Bows perform better against unarmored targets."
        es = "Los arcos funcionan mejor contra objetivos sin armadura."
    }
    {
        en = "Daggers can be used to attack weak spots in armor and deal damage directly to hitpoints."
        es = "Las dagas se pueden usar para atacar puntos débiles en la armadura y causar daño directamente a los puntos de vida."
    }
    {
        en = "Ranged weapons work best when firing into groups of enemies - they are bound to hit someone."
        es = "Las armas a distancia funcionan mejor cuando disparan a grupos de enemigos; seguramente alcanzarán a alguien."
    }
    {
        en = "Consider forming a shieldwall when surrounded."
        es = "Considera formar un muro de escudos cuando estés rodeado."
    }
    {
        en = "Conserve your stamina when in prolonged engagements."
        es = "Conserva tu resistencia cuando te encuentres en combates prolongados."
    }
    {
        en = "Success in Battle Brothers is also about picking the right fights."
        es = "El éxito en Battle Brothers también se trata de elegir las peleas adecuadas."
    }
    {
        en = "Undead are unaffected by fatigue and morale."
        es = "Los no muertos no se ven afectados por la fatiga y la moral."
    }
    {
        en = "Crossbows require less skill to fire accurately than bows, but are slower to use."
        es = "Las ballestas requieren menos habilidad para disparar con precisión que los arcos, pero son más lentas de usar."
    }
    {
        en = "Each type of weapon has advantages and disadvantages."
        es = "Cada tipo de arma tiene ventajas y desventajas."
    }
    {
        en = "Some difficult terrain, like swamp, gives combat penalties."
        es = "Algunos terrenos difíciles, como el pantano, penalizan en combate."
    }
    {
        en = "You can change camera height levels using the + and - keys."
        es = "Puedes cambiar los niveles de altura de la cámara usando las teclas + y -."
    }
    {
        en = "Clubs and maces can stun or incapacitate targets."
        es = "Los mazos y las mazas pueden aturdir o incapacitar a los objetivos."
    }
    {
        en = "Try to save some crowns for when things turn sour."
        es = "Intenta guardar algunas coronas para cuando las cosas se pongan difíciles."
    }
    {
        en = "Longswords and Greatswords can hit multiple targets with one strike."
        es = "Las espadas largas y los mandobles pueden golpear a múltiples objetivos con un solo golpe."
    }
    {
        en = "You can zoom in and out using the mouse wheel or Page Up and Page Down keys."
        es = "Puedes hacer zoom con la rueda del ratón o las teclas Page Up y Page Down."
    }
    {
        en = "Spears are good defensive weapons due to their Spearwall ability."
        es = "Las lanzas son buenas armas defensivas debido a su habilidad 'Muro de Lanzas'."
    }
    {
        en = "Expect to lose some men."
        es = "Espera perder a algunos hombres."
    }
    {
        en = "Losing is fun."
        es = "Perder es divertido."
    }
    {
        en = "Use terrain and chokepoints to your advantage."
        es = "Utiliza el terreno y los cuellos de botella a tu favor."
    }
    {
        en = "The higher their level, the more your men will demand in wages."
        es = "Cuanto mayor sea su nivel, más exigirán tus hombres en salarios."
    }
    {
        en = "Selling in rich and big cities will net you the most crowns for your goods."
        es = "Vender en ciudades grandes y ricas te dará más coronas por tus bienes."
    }
    {
        en = "Use throwing nets to restrict the movement of particularly dangerous enemies."
        es = "Usa redes arrojadizas para restringir el movimiento de enemigos particularmente peligrosos."
    }
    {
        en = "Use trading to supplement your income."
        es = "Usa el comercio para complementar tus ingresos."
    }
    {
        en = "Learn the 'Rotation' or 'Footwork' perks for additional mobility in battle."
        es = "Aprende las habilidades 'Rotación' o 'Juego de pies' para obtener movilidad adicional en la batalla."
    }
    {
        en = "View range is decreased at night, both in combat and on the worldmap."
        es = "La distancia de visión se reduce por la noche, tanto en combate como en el mapa mundial."
    }
    {
        en = "Skeletons are highly resistant to ranged attacks and fire."
        es = "Los esqueletos son altamente resistentes a los ataques a distancia y al fuego."
    }
    {
        en = "Heavy armor offers great protection, but also slows down the wearer and makes him tire more quickly."
        es = "La armadura pesada ofrece una gran protección, pero también ralentiza al portador y lo hace cansarse más rápido."
    }
    {
        en = "Heavy helmets can be hard to breathe in and limit the field of vision."
        es = "Los cascos pesados pueden dificultar la respiración y limitar el campo de visión."
    }
    {
        en = "Warhammers and Military Picks can make short work of heavy armor."
        es = "Los martillos de guerra y las picas militares pueden hacer un trabajo más rápido contra armaduras pesadas."
    }
    {
        en = "The Billhook, Pike and Longaxe can attack over 2 tiles, unlike most other melee weapons."
        es = "La guadaña, la pica y el hacha larga pueden atacar a más de 2 casillas, a diferencia de la mayoría de las otras armas cuerpo a cuerpo."
    }
    {
        en = "Flails ignore the defense bonus of shields."
        es = "Los flagelos ignoran el bono de defensa de los escudos."
    }
    {
        en = "Different types of enemies require different tactics to beat reliably."
        es = "Diferentes tipos de enemigos requieren tácticas diferentes para vencerlos de manera segura."
    }
    {
        en = "Every enemy in the game can be beat reliably with the right approach."
        es = "Cualquier enemigo en el juego puede ser vencido de manera segura con el enfoque adecuado."
    }
    {
        en = "A human is no match for an adult orc physically."
        es = "Un humano no es rival para un orco adulto físicamente."
    }
    {
        en = "Orcs rely on raw power and physical prowess."
        es = "Los orcos confían en la fuerza bruta y la destreza física."
    }
    {
        en = "A goblin is no match for an adult human physically, so they rely on wit and dirty tricks."
        es = "Un goblin no es rival para un humano adulto físicamente, por lo que confían en la astucia y trucos sucios."
    }
    {
        en = "Orc Berserkers gain rage and get tougher to take down, the more blood they have drawn."
        es = "Los Berserkers orcos ganan rabia y se vuelven más difíciles de derribar cuanto más sangre han derramado."
    }
    {
        en = "Geists are lost between the physical world and the world beyond, constantly shifting between the two."
        es = "Los Geists están perdidos entre el mundo físico y el mundo más allá, cambiando constantemente entre los dos."
    }
    {
        en = "Geists test the resolve of your men - the lower, the more likely they are to panic and flee."
        es = "Los Geists ponen a prueba la determinación de tus hombres; cuanto menor sea, más probabilidades tendrán de entrar en pánico y huir."
    }
    {
        en = "Two-handed axes can hit both head and body with a single hit."
        es = "Las hachas de dos manos pueden golpear tanto la cabeza como el cuerpo con un solo golpe."
    }
    {
        en = "Two-handed axes can hit up to 6 targets with a single round swing."
        es = "Las hachas de dos manos pueden golpear hasta 6 objetivos con un solo giro del hacha."
    }
    {
        en = "Roads are the fastest way to travel over land, but not always the safest."
        es = "Las carreteras son la forma más rápida de viajar por tierra, pero no siempre son las más seguras."
    }
    {
        en = "Forests can hide many dangers within."
        es = "Los bosques pueden ocultar muchos peligros."
    }
    {
        en = "Always keep a good stock of provisions - lest your men starve and desert you!"
        es = "¡Siempre mantén un buen suministro de provisiones, no sea que tus hombres pasen hambre y te abandonen!"
    }
    {
        en = "Wiedergangers are the dead walking again."
        es = "Los Wiedergangers son muertos que vuelven a caminar."
    }
    {
        en = "Difficult terrain, such as mountains and swamp, has your men use more supplies on the worldmap."
        es = "Terrenos difíciles, como montañas y pantanos, hacen que tus hombres consuman más suministros en el mapa mundial."
    }
    {
        en = "If you can not win, retreat to fight another day."
        es = "Si no puedes ganar, retírate y lucha otro día."
    }
    {
        en = "Retreat. Flee. Don't fight every battle to the death."
        es = "Retírate. Huye. No luches en cada batalla hasta la muerte."
    }
    {
        en = "Use the spacebar key to pause on the worldmap."
        es = "Usa la tecla de Espacio para pausar en el mapa mundial."
    }
    {
        en = "Elevated terrain like hills and mountains allow you to see farther on the worldmap."
        es = "Los terrenos elevados como colinas y montañas te permiten ver más lejos en el mapa mundial."
    }
    {
        en = "Not every contract is worth the risk."
        es = "No todos los contratos valen la pena."
    }
    {
        en = "Try to negotiate better payment for your contracts."
        es = "Intenta negociar un mejor pago por tus contratos."
    }
    {
        en = "Try to negotiate payment modalities that guarantee you the most money for contracts."
        es = "Intenta negociar condiciones de pago que te garanticen más dinero por los contratos."
    }
    {
        en = "Not every battle can be won."
        es = "No todas las batallas se pueden ganar."
    }
    {
        en = "A life can be worth little in this world."
        es = "Una vida puede valer poco en este mundo."
    }
    {
        en = "Betraying your employer can have repercussions in the long run."
        es = "Traicionar a tu empleador puede tener repercusiones a largo plazo."
    }
    {
        en = "Some parts of the world are more dangerous than others."
        es = "Algunas partes del mundo son más peligrosas que otras."
    }
    {
        en = "Use ports to fast travel around the world."
        es = "Usa puertos para viajar rápidamente por el mundo."
    }
    {
        en = "Some people will use you and throw you away."
        es = "Algunas personas te usarán y te desecharán."
    }
    {
        en = "Throwing weapons can be deadly on short distances, but their accuracy drops sharply the farther away the target."
        es = "Las armas arrojadizas pueden ser mortales a corta distancia, pero su precisión disminuye considerablemente a medida que el objetivo está más lejos."
    }
    {
        en = "Highly talented characters can come from all backgrounds."
        es = "Personajes altamente talentosos pueden provenir de todos los trasfondos."
    }
    {
        en = "Try the Ironman mode to experience Battle Brothers the way it's meant to be played."
        es = "Prueba el modo 'Hombre de Hierro' para experimentar Battle Brothers de la manera en que está destinado a jugarse."
    }
    {
        en = "Ranged weapons are less accurate at night - those of your enemies included."
        es = "Las armas a distancia son menos precisas por la noche, incluyendo las de tus enemigos."
    }
    {
        en = "Make camp to have your men heal and repair their equipment faster."
        es = "Acampa para que tus hombres se curen y reparen su equipo más rápido."
    }
    {
        en = "Use ALT + Right Click to mark items for repair in your stash. Items equipped by your men are repaired automatically."
        es = "Usa ALT + Clic derecho para marcar objetos para reparar en tu alijo. Los objetos equipados por tus hombres se reparan automáticamente."
    }
    {
        en = "You can have your items repaired at the smith for a fee by using ALT + Right Click."
        es = "Puedes hacer que reparen tus objetos en la herrería por una tarifa usando ALT + Clic derecho."
    }
    {
        en = "Breaking a contract will anger your employer - especially if you've received advance payment."
        es = "Romper un contrato enojará a tu empleador, especialmente si has recibido un pago por adelantado."
    }
    {
        en = "Fortifications will only offer you contracts from the noble house that owns them."
        es = "Los castillos y fortalezas solo te ofrecerán contratos de la casa noble que las posee."
    }
    {
        en = "Nobles give contracts only to mercenary companies with professional renown."
        es = "Los nobles otorgan contratos solo a compañías de mercenarios con renombre 'Profesional'."
    }
    {
        en = "If contract negotiations turn sour, it will damage your relations with your potential employer."
        es = "Si las negociaciones de contrato salen mal, dañarán tus relaciones con tu posible empleador."
    }
    {
        en = "You can find contract offers in the top left of settlement screens."
        es = "Puedes encontrar ofertas de contratos en la parte superior izquierda de las pantallas de asentamientos."
    }
    {
        en = "You may find powerful named items far away from civilization by exploring or following tavern rumors."
        es = "Puedes encontrar objetos de renombre poderosos lejos de la civilización explorando o siguiendo rumores de taberna."
    }
    {
        en = "Dying is part of a mercenary's job description."
        es = "Morir es parte de la descripción de trabajo de un mercenario."
    }
    {
        en = "Keep an eye on the mood of your men. If they are angry for too long, they may desert!"
        es = "Mantén un ojo en el estado de ánimo de tus hombres. Si están enojados durante demasiado tiempo, pueden desertar."
    }
    {
        en = "If you keep losing to an enemy, change your tactics!"
        es = "Si sigues perdiendo contra un enemigo, ¡cambia tus tácticas!"
    }
    {
        en = "The larger a party on the worldmap, the slower it moves. Yours included."
        es = "Cuanto mayor sea el grupo en el mapa mundial, más lento se moverá. El tuyo incluido."
    }
    {
        en = "Use wardogs to hunt down elusive or fleeing enemies."
        es = "Usa perros de guerra para perseguir a enemigos elusivos o en fuga."
    }
    {
        en = "Use a trained falcon to discover hidden enemies on difficult terrain."
        es = "Usa un halcón entrenado para descubrir enemigos ocultos en terrenos difíciles."
    }
    {
        en = "Cleavers can inflict bleeding wounds."
        es = "Las cuchillas pueden causar heridas sangrantes."
    }
    {
        en = "Fulfilling ambitions will raise everyone's mood and grant you renown, as well as some unique rewards."
        es = "Cumplir ambiciones elevará el estado de ánimo de todos y te otorgará renombre, así como algunas recompensas únicas."
    }
    {
        en = "Use CTRL + Left Click to attack allied parties on the worldmap. This only works if you are currently unemployed."
        es = "Usa CTRL + Clic izquierdo para atacar a los grupos aliados en el mapa mundial. Esto solo funciona si estás desempleado en ese momento."
    }
    {
        en = "Your men will interact with each other differently depending on their backgrounds and traits."
        es = "Tus hombres interactuarán entre sí de manera diferente según sus trasfondos y rasgos."
    }
    {
        en = "Stunned characters get no attack of opportunity when someone moves inside their zone of control."
        es = "Los personajes aturdidos no pueden hacer ataques de oportunidad cuando alguien se mueve dentro de su zona de control."
    }
    {
        en = "Try playing a campaign in veteran mode once you've gained some experience - it's the recommended difficulty."
        es = "Intenta jugar una campaña en modo Veterano una vez que hayas ganado algo de experiencia; es la dificultad recomendada."
    }
    {
        en = "The minimum hit chance for any attack is 5%, and the maximum hit chance for any attack is 95%."
        es = "La probabilidad mínima de asestar cualquier ataque de 5%, y la probabilidad máxima de asestarlo es del 95%."
    }
    {
        en = "Characters may sometimes be struck down during combat, but not outright killed, and will survive with a permanent injury."
        es = "A veces, los personajes pueden ser derribados durante el combate, pero no asesinados de inmediato, y sobrevivirán con una lesión permanente."
    }
    {
        en = "Learn from your mistakes. Don't just repeat them and hope you'll get lucky this time."
        es = "Aprende de tus errores. No los repitas y esperes tener suerte esta vez."
    }
    {
        en = "The natural habitat of direwolves is the forest."
        es = "El hábitat natural de los hombres lobo es el bosque."
    }
    {
        en = "You can enable faster AI turns in the options menu."
        es = "Puedes habilitar turnos de IA más rápidos en el menú de opciones."
    }
    {
        en = "Trees can be hidden in combat using the 'T' key."
        es = "Los árboles se pueden ocultar en combate usando la tecla 'T'."
    }
    {
        en = "Objects blocking tiles can be highlighted using the 'B' key."
        es = "Los objetos que bloquean las casillas se pueden resaltar usando la tecla 'B'."
    }
    {
        en = "Higher renown will unlock more difficult contracts and better pay."
        es = "Un renombre mayor desbloqueará contratos más difíciles y mejores pagos."
    }
    {
        en = "If your plan can fail with bad luck, maybe it isn't good enough of a plan."
        es = "Si tu plan puede fallar debido a la mala suerte, tal vez no sea lo suficientemente bueno."
    }
    {
        en = "Do the job. Survive. Get paid."
        es = "Trabaja. Sobrevive. Cóbra."
    }
    {
        en = "If a character waits their turn, their position in the turn order of the next round is determined with a penalty of 25% to Initiative."
        es = "Si un personaje espera su turno, su posición en el orden de turnos de la próxima ronda se determina con una penalización del 25% en su Iniciativa."
    }
    {
        en = "A 95% chance to hit is also a 5% chance to miss."
        es = "Un 95% de probabilidad de golpear también es un 5% de probabilidad de fallar."
    }
    {
        en = "The 'Lone Wolf' perk is not affected by nearby dogs or allies that are not part of your company."
        es = "La habilidad 'Lobo Solitario' no se ve afectada por perros o aliados cercanos que no forman parte de tu compañía."
    }
    {
        en = "The 'Fast Adaptation' perk reduces variance of randomness."
        es = "La habilidad 'Adaptación Rápida' reduce la variabilidad del azar."
    }
    {
        en = "Consider that enemy encampments on hills are harder to assault, especially if they are fortified."
        es = "Considera que los campamentos enemigos en colinas son más difíciles de asaltar, especialmente si están fortificados."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\config\world.nut
