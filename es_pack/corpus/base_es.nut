    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\injury\pierced_arm_muscles_injury.nut
    {
        en = "Pierced Arm Muscles"
        es = "Músculos del brazo perforados"
    }
    {
        en = "A piercing attack has punctured the arm and injured muscle tissue, limiting its mobility."
        es = "Un ataque penetrante ha perforado el brazo y lesionado el tejido muscular, limitando su movilidad."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\injury\pierced_cheek_injury.nut
    {
        en = "Pierced Cheek"
        es = "Mejilla perforada"
    }
    {
        en = "Contrary to what one might think, having an additional hole in the cheek does not help with breathing."
        es = "Al contrario de lo que podría pensarse, tener un agujero adicional en la mejilla no ayuda a respirar."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\injury\pierced_chest_injury.nut
    {
        en = "Pierced Chest"
        es = "Pecho perforado"
    }
    {
        en = "A piercing attack has punctured the chest, injured muscle tissue and grazed the ribs. Although no vital organs have been hit, it's still painful to just breathe."
        es = "Un ataque penetrante le perforó el pecho, lesionó el tejido muscular y rozó las costillas. Aunque no se ha dañado ningún órgano vital, sigue siendo doloroso simplemente respirar."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\injury\pierced_hand_injury.nut
    {
        en = "Pierced Hand"
        es = "Mano perforada"
    }
    {
        en = "Having a hole in the hand may not stop a determined fighter, but it does make handling a weapon more difficult."
        es = "Tener un agujero en la mano puede no detener a un luchador decidido, pero sí dificulta el manejo de un arma."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\injury\pierced_leg_muscles_injury.nut
    {
        en = "Pierced Leg Muscles"
        es = "Músculos de la pierna perforados"
    }
    {
        en = "Punctured leg muscles make any attempts to do quick and sudden movements a painful experience, if not outright impossible."
        es = "Tener los músculos de la pierna perforados hacen que cualquier intento de realizar movimientos rápidos y repentinos sea una experiencia dolorosa, si no completamente imposible."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\injury\pierced_lung_injury.nut
    {
        en = "Pierced Lung"
        es = "Pulmón perforado"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\injury\pierced_side_injury.nut
    {
        en = "Pierced Side"
        es = "Costado perforado"
    }
    {
        en = "A piercing attack has punctured the side, injured muscle tissue and grazed the ribs. Although no vital organs have been hit, it's still painful to just breathe."
        es = "Un ataque penetrante le perforó el costado, lesionó el tejido muscular y rozó las costillas. Aunque no se ha dañado ningún órgano vital, sigue siendo doloroso simplemente respirar."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\injury\ripped_ear_injury.nut
    {
        en = "Ripped Ear"
        es = "Oreja desgarrada"
    }
    {
        en = "This character's ear almost got torn off, sending blood down their head and neck, and making them less aware of their surroundings."
        es = "La oreja de este personaje casi se arranca, lo que hace que la sangre corra por su cabeza y cuello, haciéndolo menos consciente de su entorno."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\injury\severe_concussion_injury.nut
    {
        en = "Severe Concussion"
        es = "Conmoción cerebral grave"
    }
    {
        en = "A severe concussion makes it hard to focus, see or even walk straight. Not to mention the nausea and in some cases also amnesia."
        es = "Una conmoción cerebral grave dificulta la concentración, la visión o incluso el caminar derecho. Por no hablar de las náuseas y, en algunos casos, también de la amnesia."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\injury\sickness_injury.nut
    {
        en = "Sick"
        es = "Enfermo"
    }
    {
        en = "Struck with sickness and disease, this character isn't feeling well at all and hardly in a condition to fight. If the fever doesn't take him, it'll probably pass in time."
        es = "Golpeado por enfermedades y dolencias, este personaje no se siente nada bien y apenas está en condiciones de luchar. Si la fiebre no se lo lleva, probablemente mejorará con el tiempo."
    }
    {
        // this.Tactical.EventLog.log(this.Const.UI.getColorizedEntityName(bro) + " is now sick");
