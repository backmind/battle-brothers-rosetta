    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\armor_upgrades\armor_upgrade.nut
    {
        en = "Right-click or drag onto an armor carried by the currently selected character in order to permanently fuse. This item will be consumed in the process to give the following effects:"
        es = "Haz clic derecho o arrastra sobre una armadura que lleva el personaje actualmente seleccionado para fusionarte permanentemente. Este artículo se consumirá en el proceso para dar los siguientes efectos:"
    }
    {
