        en = "Crowns"
        es = "Coronas"
    }
    {
        // text = "The amount of [color=" + this.Const.UI.Color.PositiveValue + "]" + this.m.Amount + "[/color] crowns, the currency in these lands. Will be added to your global stock once you\'re back on the worldmap."
        mode = "pattern"
