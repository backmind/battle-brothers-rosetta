        en = "Heavy Iron Armor"
        es = "Armadura pesada de hierro"
    }
    {
        en = "This armor is made from heavy metal plates, scales and pieces of chainmal. The true armor of a northern warrior."
        es = "Esta armadura está hecha de placas de metal pesado, escamas y trozos de malla. La verdadera armadura de un guerrero del norte."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\armor\barbarians\hide_and_bone_armor.nut
    {
        en = "Hide and Bone Armor"
        es = "Armadura de piel y hueso"
    }
    {
        en = "Hide and bone are common materials in the northern regions. This armor is using both for decent protection."
        es = "La piel y el hueso son materiales comunes en las regiones del norte. Esta armadura usa ambos para una protección decente."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\armor\barbarians\reinforced_animal_hide_armor.nut
    {
        en = "Reinforced Animal Hide Armor"
        es = "Armadura reforzada de piel de animal"
    }
    {
        en = "A reinforced animal hide armor fashioned from thick leather pieces with added mail and metal scales."
        es = "Una armadura reforzada de piel de animal hecha de gruesas piezas de cuero con malla y escamas de metal añadidas."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\armor\barbarians\rugged_scale_armor.nut
