    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\effects\goblin_shaman_potion_effect.nut
    {
        en = "Hyperactive Sweat Glands"
        es = "Glándulas sudoríparas hiperactivas"
    }
    {
        en = "When in high stress situations, this character's mutated body produces a slimy, viscous substance and begins sweating it excessively. They'll have a much easier time escaping from any nets or traps in such a state. Just bring a towel."
        es = "Cuando se encuentra en situaciones de alto estrés, el cuerpo mutado de este personaje produce una sustancia viscosa y densa, y comienza a sudar excesivamente. Les resultará mucho más fácil escapar de cualquier red o trampa en ese estado... Sólo trae una toalla."
    }
    {
        en = "Always able to successfully escape from ensnaring effects, such as from nets or roots"
        es = "Siempre capaz de escapar con éxito de efectos atrapantes, como redes o enraizamiento"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\effects\grand_diviner_potion_effect.nut
    {
        en = "Cursed Sight"
        es = "Visión maldita"
    }
    {
        en = "This character has seen things not meant to be seen and draws upon an experience that is not their own. You can glimpse the unfettered terror on their face in those rare moments you catch them alone. Or maybe that's just the pressures of mercenary life finally getting to them."
        es = "Este personaje ha visto cosas inesperadas y se nutre de una experiencia que no le pertenece. Se puede vislumbrar el terror desenfrenado en su rostro en los raros momentos en que lo encuentra solo. O quizás sea simplemente la presión de la vida de mercenario que finalmente lo afecta."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\effects\greater_flesh_golem_potion_effect.nut
    {
        en = "Mutated Glands"
        es = "Glándulas mutadas"
    }
    {
        en = "This character's body has been irreversibly mutated, its chemical balance thrown into chaos by overproducing glands. By some miracle, it seems to have stabilized in a beneficial manner."
        es = "El cuerpo de este personaje ha sufrido una mutación irreversible, y su equilibrio químico se ha visto alterado por la sobreproducción de glándulas. Por algún milagro, parece haberse estabilizado de forma beneficiosa."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\effects\gruesome_feast_effect.nut
    {
        en = "Feasted"
        es = "Festín"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\effects\hex_master_effect.nut
