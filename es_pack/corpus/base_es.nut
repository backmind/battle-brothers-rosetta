    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\loot\ancient_amber_item.nut
    {
        en = "Ancient Amber"
        es = "Ámbar antiguo"
    }
    {
        en = "Particularly old schrats grow small splinters of extremely pure amber on their bark. These sell for quite a price to a trader."
        es = "Especialmente a los schrats viejos les crecen pequeñas astillas de ámbar extremadamente puro en su corteza. Estos se venden por un precio bastante alto a los comerciantes."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\loot\ancient_gold_coins_item.nut
    {
        en = "Ancient Gold Coins"
        es = "Monedas de oro antiguas"
    }
    {
        en = "Thick gold coins with various ancient imprints. Should be worth a lot if you can find a buyer."
        es = "Monedas de oro gruesas con varias huellas antiguas. Debería valer mucho si puedes encontrar un comprador.\n\n\x22¿Orens? ¿Florines? Disculpe señor, no se de que habla. Aquí sólo aceptamos coronas.\x22"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\loot\bead_necklace_item.nut
    {
        en = "Bead Necklace"
        es = "Collar de cuentas"
    }
    {
        en = "A necklace made from various beads typical of northern barbarian tribes."
        es = "Collar elaborado con varias cuentas típicas de las tribus bárbaras del norte."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\loot\bone_figurines_item.nut
    {
        en = "Bone Figurines"
        es = "Figuras de hueso"
    }
    {
        en = "Small carved figurines made from various rare bones. A collector might pay decent coin for this."
        es = "Pequeñas figuras talladas hechas de varios huesos raros. Un coleccionista podría pagar una moneda decente por esto."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\loot\deformed_valuables_item.nut
    {
        en = "Deformed Valuables"
        es = "Objetos de valor deformados"
    }
    {
        en = "Unholds are clumsy but strong creatures, and they tend to crush and mash valuables they find into a handy, twisted ball."
        es = "Los trols son criaturas torpes pero fuertes, y tienden a aplastar y deformar los objetos de valor que encuentran hasta convertirlos en una práctica bola retorcida."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\loot\gemstones_item.nut
    {
        en = "Gemstones"
        es = "Piedras preciosas"
    }
    {
        en = "Cut gemstones of various sizes. Should be worth a lot if you can find a buyer."
        es = "Piedras preciosas cortadas de varios tamaños. Debería valer mucho si puedes encontrar un comprador."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\loot\glittering_rock_item.nut
    {
        en = "Glittering Rock"
        es = "Roca brillante"
    }
    {
        en = "Among the scattered rocks that remain of a defeated Ifrit, sometimes a rock shimmering with gold can be found. It makes for a valuable trophy."
        es = "Entre las rocas dispersas que quedan de un Ifrit derrotado, a veces se puede encontrar una roca que brilla con oro. Es un trofeo valioso."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\loot\goblin_carved_ivory_iconographs_item.nut
    {
        en = "Carved Ivory Iconographs"
        es = "Iconografías de marfil tallado"
    }
    {
        en = "Artfully carved ivory iconographs depicting revered members of goblin society."
        es = "Iconografías de marfil ingeniosamente talladas que representan a miembros venerados de la sociedad de los goblins."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\loot\goblin_minted_coins_item.nut
    {
        en = "Minted Silver Coins"
        es = "Monedas de plata acuñadas"
    }
    {
        en = "Minted silver coins that goblins use as currency."
        es = "Monedas de plata acuñadas que los goblins usan como moneda."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\loot\goblin_rank_insignia_item.nut
    {
        en = "Golden Rank Insignia"
        es = "Insignia de rango dorada"
    }
    {
        en = "Golden rank insignia like these are worn by high-ranking goblin officials. Should be worth something to a collector."
        es = "Insignias de rango doradas como esta son usadas por funcionarios goblins de alto rango. Debería valer algo para un coleccionista."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\loot\golden_chalice_item.nut
    {
        en = "Golden Chalice"
        es = "Cáliz de oro"
    }
    {
        en = "A drinking cup made from massive gold. Should be worth a lot if you can find a buyer."
        es = "Un vaso para beber hecho de oro macizo. Debería valer mucho si puedes encontrar un comprador."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\loot\growth_pearls_item.nut
    {
        en = "Growth Pearls"
        es = "Perlas crecidas"
    }
    {
        en = "The fast growth of Nachzehrer tissue sometimes engulfs small particles or debris and turns them into shimmering pearls that can be found within the creatures. Should fetch a good price at the next city."
        es = "El rápido crecimiento del tejido de los Nachzehrer a veces envuelve pequeñas partículas o escombros y los convierte en perlas brillantes que se pueden encontrar dentro de las criaturas. Deberías conseguir un buen precio en la próxima ciudad."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\loot\jade_broche_item.nut
    {
        en = "Jade Brooch"
        es = "Broche de jade"
    }
    {
        en = "A finely crafted jade brooch that would surely make you a coin or two when sold."
        es = "Un broche de jade finamente elaborado que seguramente te hará ganar unas buenas monedas cuando lo vendas."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\loot\jeweled_crown_item.nut
    {
        en = "Jeweled Crown"
        es = "Corona con joyas"
    }
    {
        en = "A finely crafted golden crown beset with jewels. Should be worth a fortune if you can find a buyer."
        es = "Una corona dorada finamente elaborada y adornada con joyas. Debería valer una fortuna si puedes encontrar un comprador.\n\n\x22Una corona digna de un rey igualmente digno\x22."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\loot\lindwurm_hoard_item.nut
    {
        en = "Lindwurm's Hoard"
        es = "Tesoro de Lindwurm"
    }
    {
        en = "A collection of shimmering valuables, covered in the innards of a Lindwurm."
        es = "Una colección de objetos de valor relucientes, cubiertos por las entrañas de un Lindwurm."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\loot\looted_valuables_item.nut
    {
        en = "Looted Valuables"
        es = "Objetos de valor saqueados"
    }
    {
        en = "A pillaged pile of valuables that have been looted by the Barbarians over the years. Many pieces are broken and bent but the materials are quite exquisite."
        es = "Un montón de objetos de valor saqueados por los bárbaros a lo largo de los años. Muchas piezas están rotas y dobladas pero los materiales son bastante exquisitos."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\loot\marble_bust_item.nut
    {
        en = "Marble Bust"
        es = "Busto de mármol"
    }
    {
        en = "A beautiful marble bust of some unknown figure. The craftsmanship is superb."
        es = "Un hermoso busto de mármol de una figura desconocida. La artesanía es soberbia."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\loot\ornate_tome_item.nut
    {
        en = "Ornate Tome"
        es = "Tomo ornamentado"
    }
    {
        en = "A well preserved tome with a massive golden book cover. Should fetch a good price from the kind of people that study dusty old tomes."
        es = "Un antiguo tomo bien conservado con una enorme cubierta dorada. Deberías conseguir un buen precio entre el tipo de gente que estudia los viejos tiempos."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\loot\rainbow_scale_item.nut
    {
        en = "Rainbow Scale"
        es = "Escama arcoíris"
    }
    {
        en = "Desert serpents sometimes have particularly colorful and shiny scales embedded in their shimmering skin. These are sought after by jewelers and trophy hunters around the lands."
        es = "Las serpientes del desierto a veces tienen escamas particularmente coloridas y brillantes incrustadas en su piel reluciente. Son buscados por joyeros y cazadores de trofeos de la zona."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\loot\sabertooth_item.nut
    {
        en = "Sabertooth"
        es = "Dientes de sable"
    }
    {
        en = "An extraordinarily large tooth that can probably be sold for some crowns to people who'd want to pretend that they hunted down a fearsome beast."
        es = "Un diente extraordinariamente grande que probablemente pueda venderse por algunas coronas a personas que quieran fingir que han cazado una bestia temible.\n\n\x22Oh, ¿eso? Lo cacé yo mismo. Era ASÍ de grande.\x22"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\loot\signet_ring_item.nut
    {
        en = "Signet Ring"
        es = "Anillo con sello"
    }
    {
        en = "A jeweled signet ring. Should fetch a good price at the next city."
        es = "Un anillo con joyas con el sello de alguna casa noble menor. Deberías conseguir un buen precio en la próxima ciudad."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\loot\silver_bowl_item.nut
    {
        en = "Silver Bowl"
        es = "Cuenco de plata"
    }
    {
        en = "A large silver bowl of remarkable weight. Should fetch a good price at the next city."
        es = "Un gran cuenco de plata de notable peso. Debería conseguir un buen precio en la próxima ciudad."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\loot\silverware_item.nut
    {
        en = "Silverware"
        es = "Cubiertos de plata"
    }
    {
        en = "An accumulation of silver cutlery. Should fetch a good price at the next city."
        es = "Una colección de cubiertos de plata. Deberías conseguir un buen precio en la próxima ciudad."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\loot\soul_splinter_item.nut
    {
        en = "Soul Splinter"
        es = "Astilla de alma"
    }
    {
        en = "In the dusty remains of Alps sometimes these pitch black splinters can be found. It looks like the stars are shimmering deep within these stones."
        es = "En los restos polvorientos de los Alps a veces se pueden encontrar estas astillas de tono negro. Parece que las estrellas brillan en lo profundo de estas piedras."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\loot\valuable_furs_item.nut
    {
        en = "Valuable Furs"
        es = "Pieles valiosas"
    }
    {
        en = "A pack of valuable furs and pelts from various small animals. A very sought-after commodity, especially in larger settlements."
        es = "Un paquete de valiosas pieles y pellejos de varios animales pequeños. Un bien muy buscado, especialmente en los asentamientos más grandes."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\loot\webbed_valuables_item.nut
    {
        en = "Webbed Valuables"
        es = "Valuables cubiertos de telaraña"
    }
    {
        en = "Within the thick webs of webknechts sometimes valuables that once belonged to their unfortunate victims can be discoverd - if one is brave enough to search through the sticky deathtraps."
        es = "Dentro de las espesas redes de los webknechts a veces se pueden descubrir objetos de valor que alguna vez pertenecieron a sus desafortunadas víctimas, si uno es lo suficientemente valiente como para buscar a través de las pegajosas trampas mortales."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\loot\white_pearls_item.nut
    {
        en = "White Pearls"
        es = "Perlas blancas"
    }
    {
        en = "Rare white pearls in various sizes. Should fetch a good price at the next city."
        es = "Perlas blancas raras de varios tamaños. Deberías conseguir un buen precio en la próxima ciudad."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\acidic_saliva_item.nut
    {
        en = "Acidic Saliva"
        es = "Saliva ácida"
    }
    {
        en = "The saliva of the wild desert hyenas is priced by southern alchemists for its unique properties."
        es = "Los alquimistas del sur valoran la saliva de las hienas salvajes del desierto por sus propiedades únicas."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\adrenaline_gland_item.nut
    {
        en = "Adrenaline Gland"
        es = "Glándula de adrenalina"
    }
    {
        en = "A Direwolf's frenzy and bloodlust can be attributed to substances produced by this gland. Someone, somewhere will probably have a use for it."
        es = "El frenesí y la sed de sangre de un lobo huargo se pueden atribuir a sustancias producidas por esta glándula. Alguien, en algún lugar, probablemente lo utilizará."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\anatomist\alp_potion_item.nut
    {
        en = "Nightking's Draft"
        es = "Brebaje del rey noctucno"
    }
    {
        en = "This draft, the result of intensive study into the so-called 'Third Eye' of the Alp, allows whomever drinks it to see through the night as if it were day! Blurry vision and hallucinations are expected while the body acclimates."
        es = "Este trago, resultado de un estudio intensivo del llamado \x22Tercer Ojo\x22 de los Alps, permite a quien lo bebe ver la noche como si fuera de día. Se espera visión borrosa y alucinaciones mientras el cuerpo se aclimata."
    }
    {
        en = "Not affected by nighttime penalties"
        es = "No afectado por penalizaciones nocturnas"
    }
    {
        en = "Mutates the body, causing sickness"
        es = "Muta el cuerpo, causando enfermedades"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\anatomist\ancient_priest_potion_item.nut
    {
        en = "Dastard's Valor"
        es = "Valor del Cobarde"
    }
    {
        en = "This potion will turn into even the most yellow-bellied of men into a veritable font of courage. No matter the odds or the foe, they shall remain dauntless! Side effects may include loss of life due to being unable to back down when the situation calls for it."
        es = "Esta poción convertirá incluso al hombre más barrigón en una verdadera fuente de coraje. ¡Sin importar las probabilidades o el enemigo, permanecerán intrépidos! Los efectos secundarios pueden incluir la pérdida de vidas debido a la incapacidad de dar marcha atrás cuando la situación lo requiere."
    }
    {
        en = "Cannot be reduced to Fleeing morale, only Breaking"
        es = "No se puede reducir la moral a 'Huyendo', solo 'Quebrándose'"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\anatomist\apotheosis_potion_item.nut
    {
        en = "Apotheosis Potion"
        es = "Poción de Apoteosis"
    }
    {
        en = "This fantastic concoction is the pinnacle of what research on human anatomy has yielded. The few who know of its existence claim that to consume it is to ascend to a higher state of being, something beyond a mere human."
        es = "Este fantástico brebaje es el pináculo de lo que ha producido la investigación sobre la anatomía humana. Los pocos que conocen su existencia afirman que consumirlo es ascender a un estado superior del ser, algo más allá de lo simple humano."
    }
    {
        // text = "[color=" + this.Const.UI.Color.PositiveValue + "]+1[/color] Hitpoints"
        mode = "pattern"
        en = "[color=<this.Const.UI.Color.PositiveValue>]+1[/color] Hitpoints"
        es = "[color=<this.Const.UI.Color.PositiveValue>]+1[/color] Puntos de vida"
    }
    {
        // text = "[color=" + this.Const.UI.Color.PositiveValue + "]+1[/color] Fatigue"
        mode = "pattern"
        en = "[color=<this.Const.UI.Color.PositiveValue>]+1[/color] Fatigue"
        es = "[color=<this.Const.UI.Color.PositiveValue>]+1[/color] Fatiga máxima"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\anatomist\direwolf_potion_item.nut
    {
        en = "Potion of Blade Dancing"
        es = "Poción de Danza de Espadas"
    }
    {
        en = "This humoural concoction, borne from research into the dreaded direwolf, will turn even the clumsiest oaf into a lithe dancer of a warrior, able to gracefully move with the tides of battle long after lesser men succumb to fatigue! Mild akathisia after consuming is normal and expected."
        es = "Esta mezcla humorística, nacida de la investigación sobre el temido lobo huargo, convertirá incluso al patán más torpe en un guerrero ágil y bailarín, capaz de moverse con gracia con las mareas de la batalla mucho después de que los hombres inferiores sucumban a la fatiga. Una acatisia leve después del consumo es normal y esperada."
    }
    {
        // text = "Attacks that miss have [color=" + this.Const.UI.Color.PositiveValue + "]50%[/color] of their Fatigue cost refunded"
        mode = "pattern"
        en = "Attacks that miss have [color=<this.Const.UI.Color.PositiveValue>]50%[/color] of their Fatigue cost refunded"
        es = "Los ataques que fallan reciben un [color=<this.Const.UI.Color.PositiveValue>]50%[/color] de reembolso de fatiga utilizada"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\anatomist\fallen_hero_potion_item.nut
    {
        en = "Elixir of Perseverance"
        es = "Elixir de Perseverancia"
    }
    {
        en = "This serum, developed from a substance found within certain extraordinary specimens of Wiederganger, allows a living man to gain some of the indefatigable perseverance of the loathsome undead warriors - with no loss of life! Some minor joint stiffness is to be expected."
        es = "Este suero, desarrollado a partir de una sustancia encontrada en ciertos ejemplares extraordinarios de Wiederganger, permite a un hombre vivo adquirir algo de la incansable perseverancia de los detestables guerreros no muertos, ¡sin pérdida de vida! Se espera cierta rigidez en las articulaciones, no obstante."
    }
    {
        en = "Accumulate no Fatigue from enemy attacks, whether they hit or miss"
        es = "No acumula fatiga por los ataques enemigos, ya sea que acierten o fallen"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\anatomist\geist_potion_item.nut
    {
        en = "Deadman's Drink"
        es = "Bebida del Hombre Muerto"
    }
    {
        en = "This draft, synthesized from the faint ectoplasmic remnants of a 'slain' Geist, alters the body of whoever imbibes it to take on a similar ghostly aspect. Any weapons wielded by such a warrior will surely gain some of the creature's ability to bypass armor! Auditory hallucinations are an expected side effect of consuming the draft and will likely cease after a while. Hopefully, anyway."
        es = "Este brebaje, sintetizado a partir de los tenues restos ectoplásmicos de un Geist 'abatido', altera el cuerpo de quien lo consume para adquirir un aspecto similar al de un espectro. ¡Cualquier arma empuñada por un guerrero así seguramente obtendrá la capacidad de atravesar la armadura del enemigo! Las alucinaciones auditivas son un efecto secundario esperado de consumir el brebaje y probablemente cesarán con el tiempo. ¡Esperemos que sí!"
    }
    {
        // text = "An additional [color=" + this.Const.UI.Color.PositiveValue + "]5%[/color] of damage ignores armor when using melee weapons"
        mode = "pattern"
        en = "An additional [color=<this.Const.UI.Color.PositiveValue>]5%[/color] of damage ignores armor when using melee weapons"
        es = "Un [color=<this.Const.UI.Color.PositiveValue>]5%[/color] de daño adicional ignora armadura cuando usa arma cuerpo a cuerpo"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\anatomist\goblin_grunt_potion_item.nut
    {
        en = "Potion of Fleetfoot"
        es = "Poción de pies ligeros"
    }
    {
        en = "Developed from drugs found on goblin frontline troops, this concoction can grant a man the celerity typically found in the diminutive greenskins. May result in minor skin discoloration."
        es = "Desarrollado a partir de drogas encontradas en las tropas de primera línea de los goblins, esta poción puede otorgar a un hombre la celeridad que normalmente se encuentra en los verdes y pequeños diablillos. Puede causar una leve decoloración de la piel."
    }
    {
        // text = "The Action Point costs of the Rotation and Footwork skills are reduced to [color=" + this.Const.UI.Color.PositiveValue + "]2[/color]"
        mode = "pattern"
        en = "The Action Point costs of the Rotation and Footwork skills are reduced to [color=<this.Const.UI.Color.PositiveValue>]2[/color]"
        es = "Los costos de Puntos de acción de las habilidades 'Rotación' y 'Juego de pies' se reducen en [color=<this.Const.UI.Color.PositiveValue>]2[/color]"
    }
    {
        // text = "The Fatigue costs of the Rotation and Footwork skills are reduced by [color=" + this.Const.UI.Color.PositiveValue + "]50%[/color]"
        mode = "pattern"
        en = "The Fatigue costs of the Rotation and Footwork skills are reduced by [color=<this.Const.UI.Color.PositiveValue>]50%[/color]"
        es = "Los costos de Fatiga de las habilidades 'Rotación' y 'Juego de pies' se reducen en [color=<this.Const.UI.Color.PositiveValue>]50%[/color]"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\anatomist\goblin_overseer_potion_item.nut
    {
        en = "Deadeye's Draught"
        es = "Poción de Ojo Muerto"
    }
    {
        en = "Equal parts terrifying and annoying, the uncanny marksmanship of upper caste goblins has long been thought unobtainable by ordinary, self-respecting humans. With this wondrous potion, however, the discerning warrior can harness some of that latent skill for himself at minor cosmetic cost!"
        es = "Igualmente aterrador y molesto, la destreza sobrenatural de los goblins de casta alta ha sido considerada durante mucho tiempo inalcanzable por los humanos comunes y respetuosos. Sin embargo, con esta maravillosa poción, el guerrero perspicaz puede aprovechar algo de esa habilidad latente para sí mismo, ¡a un costo cosmético menor!"
    }
    {
        // text = "An additional [color=" + this.Const.UI.Color.PositiveValue + "]5%[/color] of damage ignores armor when using bows or crossbows"
        mode = "pattern"
        en = "An additional [color=<this.Const.UI.Color.PositiveValue>]5%[/color] of damage ignores armor when using bows or crossbows"
        es = "Un [color=<this.Const.UI.Color.PositiveValue>]5%[/color] adicional del daño ignora la armadura usando arcos o ballestas"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\anatomist\goblin_shaman_potion_item.nut
    {
        en = "Greasejar Potion"
        es = "Poción de tarro de grasa"
    }
    {
        en = "While the phrase 'slippery as a goblin' hasn't quite caught on in the common vernacular, anyone who has fought the hateful greenskins knows its truth. With this amazing potion, however, anyone can take on this loathsome aspect!"
        es = "Aunque la frase \x22escurridizo como un goblin\x22 no ha terminado de ser aceptada en el lenguaje común, cualquiera que haya luchado contra los odiosos verdes conoce su verdad. ¡Con esta asombrosa poción, cualquiera puede adoptar esta características detestable!"
    }
    {
        en = "Always successfully able to escape from ensnarement, such as from nets or roots"
        es = "Siempre capaz de escapar con éxito de trampas, como redes o raíces."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\anatomist\grand_diviner_potion_item.nut
    {
        en = "Elixir of Enlightenment"
        es = "Elixir de iluminación"
    }
    {
        en = "They say the difference between poison and medicine is in the dosage, and perhaps nowhere is this more true than the unusual substance found in the Grand Diviner's censer and, more curiously, bloodstream. Whoever drinks this elixir, brewed from that substance, will surely gain his same otherwordly vision!"
        es = "Dicen que la diferencia entre veneno y medicina radica en la dosis, y quizás en ningún otro lugar esto sea más cierto que en la inusual sustancia hallada en el incensario del Gran Adivino y, curiosamente, en el torrente sanguíneo. Quien beba este elixir, elaborado con esa sustancia, ¡sin duda experimentará la misma visión sobrenatural!"
    }
    {
        en = "Immediately gain 10 levels worth of XP"
        es = "Obtén inmediatamente 10 niveles de EXP"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\anatomist\greater_flesh_golem_potion_item.nut
    {
        en = "Potion of Progress"
        es = "Potion de progreso"
    }
    {
        en = "This serum, extracted from the bone marrow of the so-called 'greater' flesh golems, can fashion even the most infirm into the pinnacle of physical health. Behold, the twisted vision of the Grand Diviner, untangled and made reality!"
        es = "Este suero, extraído de la médula ósea de los llamados gólems de carne \x22mayores\x22, puede transformar incluso a los más débiles en la cima de la salud física. ¡Contempla la visión retorcida del Gran Adivino, desenredada y hecha realidad!"
    }
    {
        en = "Gain two random positive traits"
        es = "Obtén dos rasgos positivos aleatorios"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\anatomist\hexe_potion_item.nut
    {
        en = "Potion of Malevolence"
        es = "Poción de Malevolencia"
    }
    {
        en = "The label on this bottle reads: 'DANGER! FURTHER RESEARCH REQUIRED BEFORE CONSUMPTION.' Eh, you're sure it's fine."
        es = "La etiqueta de esta botella dice: '¡PELIGRO! SE REQUIERE INVESTIGACIÓN ADICIONAL ANTES DEL CONSUMO. Eh, estás seguro de que está bien."
    }
    {
        // text = "Reflect [color=" + this.Const.UI.Color.PositiveValue + "]100%[/color] of hitpoint damage received back at the attacker"
        mode = "pattern"
        en = "Reflect [color=<this.Const.UI.Color.PositiveValue>]100%[/color] of hitpoint damage received back at the attacker"
        es = "Refleja [color=<this.Const.UI.Color.PositiveValue>]100%[/color] del daño recibido a los Puntos de vida hacia el atacante"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\anatomist\honor_guard_potion_item.nut
    {
        en = "Elixir of Boneflesh"
        es = "Elixir de carne de hueso"
    }
    {
        en = "The undead are rightly feared for their unflagging purpose and their unbreakable will, but any experienced warrior knows of a third horror, the dread creatures resistance to spears and arrows. With this concoction, the living may obtain such an aegis as well!"
        es = "Los no muertos son temidos con razón por su propósito incansable y su voluntad inquebrantable, pero cualquier guerrero experimentado conoce un tercer horror, la resistencia de estas criaturas a las lanzas y flechas. ¡Con esta poción, los vivos pueden obtener un escudo similar!"
    }
    {
        // text = "Take between [color=" + this.Const.UI.Color.PositiveValue + "]25%[/color] and [color=" + this.Const.UI.Color.PositiveValue + "]50%[/color] less damage from piercing attacks, such as those from bows or spears"
        mode = "pattern"
        en = "Take between [color=<this.Const.UI.Color.PositiveValue>]25%[/color] and [color=<this.Const.UI.Color.PositiveValue>]50%[/color] less damage from piercing attacks, such as those from bows or spears"
        es = "Toma entre [color=<this.Const.UI.Color.PositiveValue>]25%[/color] y [color=<this.Const.UI.Color.PositiveValue>]50%[/color] menos daño por ataques penetrantes, como los de arcos o lanzas"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\anatomist\hyena_potion_item.nut
    {
        en = "Bloodgate Brew"
        es = "Brebaje Puerta de sangre"
    }
    {
        en = "Brewed with a previously unknown gland from the savage desert hyena, this hearty brew transforms even the frailest man into a font of endurance. Even the most grievous of wounds will stop bleeding and close in a fraction of the time."
        es = "Elaborada con una glándula desconocida previamente de la hiena salvaje del desierto, esta robusta preparación transforma incluso al hombre más frágil en una fuente de resistencia. Incluso las heridas más graves dejarán de sangrar y se cerrarán en una fracción del tiempo."
    }
    {
        // text = "Damage received from the Bleeding status effect is reduced by [color=" + this.Const.UI.Color.NegativeValue + "]50%[/color]"
        mode = "pattern"
        en = "Damage received from the Bleeding status effect is reduced by [color=<this.Const.UI.Color.NegativeValue>]50%[/color]"
        es = ""
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\anatomist\ifrit_potion_item.nut
    {
        en = "Potion of Stoneskin"
        es = "Poción de Piel de piedra"
    }
    {
        en = "With this potion, a common man may take on the aspect of that most frightful of foes, the Ifrit of the southern deserts! Gain the devils' stone skin and laugh at your foes as they break their weapons upon you! Side effects may include itchiness."
        es = "Con esta poción, un hombre común puede asumir el aspecto del más aterrador de los enemigos, el Ifrit de los desiertos del sur. ¡Obtén la piel de piedra de los demonios y ríete de tus enemigos mientras rompen sus armas contra ti! Los efectos secundarios pueden incluir picazón."
    }
    {
        // text = "Turns skin hard and stone-like, granting [color=" + this.Const.UI.Color.PositiveValue + "]25[/color] points of natural armor"
        mode = "pattern"
        en = "Turns skin hard and stone-like, granting [color=<this.Const.UI.Color.PositiveValue>]25[/color] points of natural armor"
        es = "Vuelve la piel dura y parecida a una piedra, otorgando [color=<this.Const.UI.Color.PositiveValue>]25[/color] Puntos de armadura natural"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\anatomist\ijirok_potion_item.nut
    {
        en = "Elixir of the Mad God"
        es = "Elixir del Dios Loco"
    }
    {
        en = "The main label on this elixir is illegible, written in hastily scrawled sigils in some foreign or fake language. Underneath, written in a tidy, small script: 'SIDE EFFECTS: MANY'. Thrilling!"
        es = "La etiqueta principal de este elixir es ilegible, escrita en sigilos garabateados apresuradamente en algún idioma extranjero o falso. Debajo, escrito en un guión pequeño y ordenado: 'EFECTOS SECUNDARIOS: MUCHOS'. ¡Emocionante!"
    }
    {
        // text = "[color=" + this.Const.UI.Color.PositiveValue + "]50%[/color] chance to resist any status effect, like Dazed or Stunned"
        mode = "pattern"
        en = "[color=<this.Const.UI.Color.PositiveValue>]50%[/color] chance to resist any status effect, like Dazed or Stunned"
        es = "[color=<this.Const.UI.Color.PositiveValue>]50%[/color] de posibilidades de resistir cualquier efecto de estado, como Aturdido o Atontado"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\anatomist\kraken_potion_item.nut
    {
        en = "Bog King's Draught"
        es = "Brebaje del Rey del pantano"
    }
    {
        en = "Take on the aspect of the beast of beasts! With this miracle draught, a cripple becomes as a strongman, and a strongman becomes as a god! Known side effects include an increased appetite and some minor hallucinations."
        es = "¡Adquiere el aspecto de la bestia de las bestias! ¡Con este trago milagroso, un lisiado se convierte en un hombre fuerte, y un hombre fuerte se convierte en un dios! Los efectos secundarios conocidos incluyen aumento del apetito y algunas alucinaciones menores."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\anatomist\lesser_flesh_golem_potion_item.nut
    {
        en = "Potion of Change"
        es = "Poción de cambio"
    }
    {
        en = "This vile tasting concoction, distilled from the remains of a flesh golem, promises to cure joint pain, grow muscle mass, and even sharpen vision! Results not guaranteed."
        es = "Este brebaje de sabor repugnante, destilado de los restos de un gólem de carne, promete curar el dolor articular, aumentar la masa muscular e incluso agudizar la vista. Resultados no garantizados."
    }
    {
        en = "Gain a random positive trait"
        es = "Obtén un rasgo positivo aleatorio"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\anatomist\lindwurm_potion_item.nut
    {
        en = "Tincture of Emberblood"
        es = "Tintura de Sangre de ascuas"
    }
    {
        en = "Feel your blood boil! Or, more to the point, don't! With this tincture, the burning blood of a lindwurm will flow through decidedly human veins, with the lucky subject none the wiser. Until they start bleeding, of course."
        es = "¡Siente cómo hierve tu sangre! O, más bien, ¡no! Con esta tintura, la sangre ardiente de un lindwurm fluirá por venas decididamente humanas, y el afortunado sujeto ni siquiera se dará cuenta. Hasta que empiece a sangrar, por supuesto.."
    }
    {
        en = "Makes a character's blood burn with acid, damaging attackers in melee range whenever they deal hitpoint damage"
        es = "Hace que la sangre de este personaje arda con ácido, dañando a los atacantes en el cuerpo a cuerpo cada vez que infligen daño de Puntos de vida"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\anatomist\lorekeeper_potion_item.nut
    {
        en = "Potion of Inner Sanctum"
        es = "Poción del Santuario Interior"
    }
    {
        en = "Held within this vial is a powerful sedative that will induce a deep sleep, unbreakable by pain. This is needed to keep the subject under long enough to graft another row of ribs, the bones themselves recovered from one of the Lorekeeper's more ordinary phylacteries."
        es = "Dentro de este frasco se encuentra un sedante poderoso que inducirá un sueño profundo, inquebrantable por el dolor. Esto es necesario para mantener al sujeto bajo lo suficiente como para injertar otra hilera de costillas, los propios huesos recuperados de uno de los filacterios más comunes del Cronista."
    }
    {
        en = "Once per battle, upon receiving a killing blow, survive instead and regain full health"
        es = "Una vez por batalla, al recibir un golpe mortal, sobrevive y recupera toda tu salud"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\anatomist\nachzehrer_potion_item.nut
    {
        en = "Potion of Flesh Knitting"
        es = "Poción de Tejido de carne"
    }
    {
        en = "If one divorces the horror of the act from its utility, there are few phenomena more marvelous in nature than the Nachzehrer's ability to recover by eating the flesh of the dead. No longer! Now man himself may take on such qualities, and without committing crimes of conscience, to boot!"
        es = "Si uno se desvincula del horror del acto por su utilidad, hay pocos fenómenos más maravillosos en la naturaleza que la capacidad del Nachzehrer de recuperarse al comer la carne de los muertos. ¡Ahora el hombre mismo puede adquirir tales cualidades, y sin cometer crímenes de conciencia!"
    }
    {
        en = "Reduces the time it takes to heal from any injury by one day, down to a mininum of one day"
        es = "Reduce en un día el tiempo que lleva curarse de cualquier lesión, hasta un mínimo de un día"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\anatomist\necromancer_potion_item.nut
    {
        en = "The King in Chains"
        es = "El Rey Encadenado"
    }
    {
        en = "Of the many weapons at a man's disposal, the most deadly is surely his mind, and in no figure is this more apparent than the dreaded necromancer. With this mixture, that frightful intellect can descend to the grasp of even the common man!"
        es = "De las muchas armas a disposición de un hombre, la más mortal es sin duda su mente, y en ninguna figura esto es más evidente que en el temible nigromante. ¡Con esta mezcla, ese intelecto aterrador puede descender al alcance incluso del hombre común!"
    }
    {
        // text = "[color=" + this.Const.UI.Color.PositiveValue + "]+20%[/color] Experience Gain"
        mode = "pattern"
        en = "[color=<this.Const.UI.Color.PositiveValue>]+20%[/color] Experience Gain"
        es = "[color=<this.Const.UI.Color.PositiveValue>]+20%[/color] Experiencia ganada"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\anatomist\necrosavant_potion_item.nut
    {
        en = "Potion of the Nightstalker"
        es = "Poción del Acechador Nocturno"
    }
    {
        en = "Whoever drinks this incredible potion, produced with the ash of a Necrosavant, will find themselves in possession of the miraculous healing powers of the undead creatures! It does not grant the extended lifespan associated with the abominations, however - quite the opposite, in fact. This may be considered a feature should the imbiber get a bit too comfortable drinking blood."
        es = "Quien beba esta increíble poción, producida con las cenizas de un Necrosavant, se encontrará en posesión de los asombrosos poderes curativos de las criaturas no muertas. Sin embargo, no otorga la esperanza de vida extendida asociada con las abominaciones; de hecho, es todo lo contrario. Esto se puede considerar una característica si el bebedor se vuelve demasiado cómodo bebiendo sangre."
    }
    {
        // text = "Heal [color=" + this.Const.UI.Color.PositiveValue + "]25%[/color] of hitpoint damage inflicted on adjacent enemies that have blood"
        mode = "pattern"
        en = "Heal [color=<this.Const.UI.Color.PositiveValue>]25%[/color] of hitpoint damage inflicted on adjacent enemies that have blood"
        es = "Sana [color=<this.Const.UI.Color.PositiveValue>]25%[/color] de daño de Puntos de vida infligido a enemigos adyacentes que tienen sangre"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\anatomist\orc_berserker_potion_item.nut
    {
        en = "Rose Philter"
        es = "Filtro rosa"
    }
    {
        en = "Developed from the adrenal glands of so called Orc 'Berserkers', this concoction is so named for the heightened emotional state and reddened hue of whoever drinks it."
        es = "Desarrollada a partir de las glándulas suprarrenales de los llamados Orcos 'Berserkers', esta poción recibe su nombre por el estado emocional exaltado y el tono enrojecido de quien la bebe."
    }
    {
        en = "Gain stacks of Rage upon taking hitpoint damage, which increases Resolve, Initiative and damage dealt, and reduces damage taken"
        es = "Gana acumulaciones de Ira al recibir daño a los Puntos de vida, lo que aumenta la Resolución, Iniciativa, Daño infligido y reduce el Daño recibido."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\anatomist\orc_warlord_potion_item.nut
    {
        en = "Font of Strength"
        es = "Fuente de Fuerza"
    }
    {
        en = "Many a general has wished orcs might be tamed, for if one could control the greenskins and direct their strength with the intellect of man, they would surely control an unstoppable force. With this, such fantasies are within reach!"
        es = "Más de un general ha deseado poder domesticar a los orcos, ya que si uno pudiera controlar a los verdes y dirigir su fuerza con la inteligencia de un humano, seguramente tendría un poder imparable. ¡Con esto, tales fantasías están al alcance!"
    }
    {
        en = "No longer suffer any additional fatigue penalty for using orc weapons"
        es = "Ya no sufrirás ninguna penalización de fatiga adicional por usar armas orcas."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\anatomist\orc_warrior_potion_item.nut
    {
        en = "Ironhead Potion"
        es = "Poción 'Cabeza de Hierro'"
    }
    {
        en = "As any veteran of the Battle of Many Names can attest, to fight an orc warrior is to fight a veritable wall of metal and flesh, seemingly impervious to even the most debilitating of blows. With this potion, now you can be that wall!"
        es = "Como cualquier veterano de la Batalla de los Muchos Nombres puede atestiguar, luchar contra un guerrero orco es como luchar contra un muro de metal y carne, aparentemente impermeable incluso a los golpes más debilitantes. ¡Con esta poción, ahora tú puedes ser ese muro!"
    }
    {
        // text = "[color=" + this.Const.UI.Color.PositiveValue + "]33%[/color] to resist the Dazed, Staggered, Stunned, Distracted, and Withered status effects"
        mode = "pattern"
        en = "[color=<this.Const.UI.Color.PositiveValue>]33%[/color] to resist the Dazed, Staggered, Stunned, Distracted, and Withered status effects"
        es = "[color=<this.Const.UI.Color.PositiveValue>]33%[/color] de probabilidades de resistir los efectos de estado Atontado, Tambaleante, Aturdido, Distraído y Marchito"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\anatomist\orc_young_potion_item.nut
    {
        en = "Kineticist's Draft"
        es = "Brebaje Cinético"
    }
    {
        en = "Feel the strength of an orc flow through your veins! Imbibing this draft will infuse even the meekest man's blows with the intense destructive power of a hulking greenskin, guaranteed!"
        es = "¡Siente la fuerza de un orco fluir por tus venas! ¡Beber este brebaje infundirá incluso los golpes del hombre más débil con el poder destructivo intenso de un verde grandullón, garantizado!"
    }
    {
        // text = "Attacks have [color=" + this.Const.UI.Color.PositiveValue + "]+10%[/color] effectiveness against armor"
        mode = "pattern"
        en = "Attacks have [color=<this.Const.UI.Color.PositiveValue>]+10%[/color] effectiveness against armor"
        es = "Los ataques tienen [color=<this.Const.UI.Color.PositiveValue>]+10%[/color] de efectividad contra armaduras"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\anatomist\rachegeist_potion_item.nut
    {
        en = "Knife Edge Potion"
        es = "Poción de Última Resistencia"
    }
    {
        en = "Few creatures defy understanding like the so-called Rachegeist. Through meticulous examination of its meager remains, however, this miraculous potion was created! Now even mortal men may bring out the power of undeath itself!"
        es = "Pocos seres desafían la comprensión como el llamado Rachegeist. ¡A través del examen meticuloso de sus escasos restos, sin embargo, se creó esta milagrosa poción! ¡Ahora, incluso los hombres mortales pueden desatar el poder de la misma muerte!"
    }
    {
        // text = "Deal [color=" + this.Const.UI.Color.PositiveValue + "]+25%[/color] damage and receive only [color=" + this.Const.UI.Color.PositiveValue + "]75%[/color] of any damage if hitpoints are below [color=" + this.Const.UI.Color.NegativeValue + "]50%[/color]"
        mode = "pattern"
        en = "Deal [color=<this.Const.UI.Color.PositiveValue>]+25%[/color] damage and receive only [color=<this.Const.UI.Color.PositiveValue>]75%[/color] of any damage if hitpoints are below [color=<this.Const.UI.Color.NegativeValue>]50%[/color]"
        es = "Causa [color=<this.Const.UI.Color.PositiveValue>]+25%[/color] Daño y recibe sólo [color=<this.Const.UI.Color.PositiveValue>]75%[/color] de cualquier daño si los puntos de vida están debajo de los [color=<this.Const.UI.Color.NegativeValue>]50%[/color]"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\anatomist\research_notes_beasts_item.nut
    {
        en = "Tome of Beasts"
        es = "Tomo de las Bestias"
    }
    {
        en = "A treatise on the beasts of the world. Coded notes fill the margins in sections on the most interesting - and real - creatures."
        es = "Un tratado sobre las bestias del mundo. Las notas codificadas llenan los márgenes de las secciones sobre las criaturas más interesantes - y reales."
    }
    {
        en = "Tracks your research on the beasts of the world"
        es = "Sigue tu investigación sobre las bestias del mundo"
    }
    {
        en = "Draught of Godtree Roots"
        es = "Tintura de raíces del Árbol de los dioses"
    }
    {
        en = "Fool's Treasure Potion"
        es = "Poción Tesoro del tonto"
    }
    {
        en = "Venomblood Potion"
        es = "Poción de Sangre venenosa"
    }
    {
        en = "Quickfang Potion"
        es = "Poción de Colmillo Rápido"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\anatomist\research_notes_greenskins_item.nut
    {
        en = "Greenskin Research Notes"
        es = "Notas de investigación de pieles verdes"
    }
    {
        en = "A tidy collection of eyewitness reports, experiment logs, and research diaries detailing the anatomy of various greenskin specimens."
        es = "Una colección ordenada de informes de testigos presenciales, registros de experimentos y diarios de investigación que detallan la anatomía de varios especímenes de piel verde."
    }
    {
        en = "Tracks your study of orc and goblin anatomy"
        es = "Realiza un seguimiento de tu estudio de la anatomía de los orcos y los goblins"
    }
    {
        en = "Goblin"
        es = ""
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\anatomist\research_notes_legendary_item.nut
    {
        en = "Book of Legends"
        es = "Libro de Leyendas"
    }
    {
        en = "A slim journal bound in fine leather, containing your meager scientific notes on creatures of myth and legend."
        es = "Un diario delgado encuadernado en cuero fino, que contiene sus escasas notas científicas sobre criaturas de mitos y leyendas."
    }
    {
        en = "Tracks your research into mythical creatures, should you discover any"
        es = "Realiza un seguimiento de tu investigación sobre criaturas míticas, en caso de que descubras alguna"
    }
    {
        en = "Ijirok"
        es = ""
    }
    {
        en = "Potion of Inner Phylactery"
        es = "Poción de Filacteria Interior"
    }
    {
        en = "Lesser Flesh Golem"
        es = "Golem de carne"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\anatomist\research_notes_undead_item.nut
    {
        en = "Ledger of the Dead"
        es = "Libro mayor de los Muertos"
    }
    {
        en = "A ledger stuffed full of folktales, post-mortems, autopsy notes, and the mad scribblings of a supposed necromancer that collectively contain your knowledge of the undead."
        es = "Un libro de contabilidad repleto de cuentos populares, post-mortems, notas de autopsias y los garabatos locos de un supuesto nigromante que, en conjunto, contienen tu conocimiento de los no muertos."
    }
    {
        en = "Tracks your findings on the undead"
        es = "Realiza un seguimiento de tus hallazgos sobre los no-muertos"
    }
    {
        en = "Ancient Skeleton"
        es = "Esqueleto antiguo"
    }
    {
        en = "Potion of the Sleepless"
        es = "Poción de los Insomnes"
    }
    {
        en = "Potion of Leather Skin"
        es = "Poción de Piel de cuero"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\anatomist\schrat_potion_item.nut
    {
        en = "With this wondrous concoction, mere mortal men shall take on an aspect of the gods themselves! Any who consume it can become rooted as solidly as the great godtrees of legend."
        es = "¡Con esta maravillosa poción, los simples mortales adoptarán un aspecto de los propios dioses! Cualquiera que la consuma podrá arraigarse tan firmemente como los grandes árboles divinos de la leyenda."
    }
    {
        en = "Immune to being knocked back or grabbed"
        es = "Inmune a ser Derribado o agarrado"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\anatomist\serpent_potion_item.nut
    {
        en = "With this potion, the feared guile and precision of the hateful desert serpent is within any warrior's grasp!"
        es = "¡Con esta poción, la temida astucia y precisión de la odiosa serpiente del desierto está al alcance de cualquier guerrero!"
    }
    {
        // text = "Gain an additional [color=" + this.Const.UI.Color.PositiveValue + "]+3%[/color] chance to hit in melee for every ally adjacent to your target"
        mode = "pattern"
        en = "Gain an additional [color=<this.Const.UI.Color.PositiveValue>]+3%[/color] chance to hit in melee for every ally adjacent to your target"
        es = "Obtiene una probabilidad adicional de [color=<this.Const.UI.Color.PositiveValue>]+3%[/color] de golpear cuerpo a cuerpo por cada aliado adyacente a tu objetivo."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\anatomist\skeleton_warrior_potion_item.nut
    {
        en = "By drinking this, even the feeblest sellsword will gain a shield arm that rivals even that of the ceaseless dead! Almost guaranteed to not turn them undead, either!"
        es = "¡Al beber esto, incluso el mercenario más débil obtendrá un brazo de escudo que rivaliza incluso con el de los muertos incesantes! ¡'Casi' garantizado que tampoco los convertirá en muertos vivientes!"
    }
    {
        // text = "The Fatigue cost of the \'Shieldwall\' skill is reduced by [color=" + this.Const.UI.Color.PositiveValue + "]" + 100 * (1 - this.Const.Combat.WeaponSpecFatigueMult) + "%[/color]"
        mode = "pattern"
        en = "The Fatigue cost of the 'Shieldwall' skill is reduced by [color=<this.Const.UI.Color.PositiveValue>]<100*1-this.Const.Combat.WeaponSpecFatigueMult>%[/color]"
        es = "El coste de Fatiga de la habilidad 'Muro de escudos' se reduce un [color=<this.Const.UI.Color.PositiveValue>]<100*1-this.Const.Combat.WeaponSpecFatigueMult>%[/color]"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\anatomist\unhold_potion_item.nut
    {
        en = "Ignore the name, this potion will grant near immortality to whomever drinks it! That's right, just like the dreaded Unhold, any lucky enough to consume this will have their wounds close mere moments after opening! Take it! Quickly! Don't think, act!"
        es = "¡Ignora el nombre, esta poción otorgará casi inmortalidad a quien la beba! ¡Así es, al igual que el temido Trol, cualquiera lo suficientemente afortunado para consumirla verá cómo sus heridas se cierran apenas momentos después de abrirse! ¡Tómala! ¡Rápido! ¡No pienses, actúa!"
    }
    {
        // text = "Regenerate [color=" + this.Const.UI.Color.PositiveValue + "]10[/color] Hitpoints each turn"
        mode = "pattern"
        en = "Regenerate [color=<this.Const.UI.Color.PositiveValue>]10[/color] Hitpoints each turn"
        es = "Regenera [color=<this.Const.UI.Color.PositiveValue>]10[/color] Puntos de vida por turno"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\anatomist\webknecht_potion_item.nut
    {
        en = "As any experienced beast hunter could tell you, what makes the overgrown arachnids known as Webknechts truly fearsome is their vicious poison. Well, no longer! Whoever drinks this potion need not fear the creatures' venom again!"
        es = "Como podría decirte cualquier cazador de bestias experimentado, lo que hace que los arácnidos crecidos conocidos como Webknechts sean realmente temibles es su veneno feroz. ¡Pues ya no! ¡Quien beba esta poción no volverá a temer el veneno de las criaturas!"
    }
    {
        en = "Immune to poison effects, including those of Webknechts and Goblins"
        es = "Inmune a los efectos del veneno, incluidos los de Webknechts y Goblin."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\anatomist\wiederganger_potion_item.nut
    {
        en = "When consumed, this powerful concoction alters the flesh to react immediately to sudden blows, protecting the body from severe injury! Don't mind the smell, that's just a sign of its potency."
        es = "Cuando se consume, este poderoso brebaje altera la carne para que reaccione inmediatamente a golpes repentinos, ¡protegiendo el cuerpo de lesiones graves! No te preocupes por el olor, eso es sólo una señal de su potencia."
    }
    {
        // text = "The threshold to sustain injuries on getting hit is increased by [color=" + this.Const.UI.Color.PositiveValue + "]33%[/color]"
        mode = "pattern"
        en = "The threshold to sustain injuries on getting hit is increased by [color=<this.Const.UI.Color.PositiveValue>]33%[/color]"
        es = "El umbral para sufrir lesiones al ser golpeado se incrementa en [color=<this.Const.UI.Color.PositiveValue>]33%[/color]"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\ancient_wood_item.nut
    {
        en = "Ancient Wood"
        es = "Madera ancestral"
    }
    {
        en = "Ancient pieces of wood carved from the remains of a living tree."
        es = "Piezas antiguas de madera talladas a partir de restos de un árbol vivo."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\frost_unhold_fur_item.nut
    {
        en = "Thick White Fur"
        es = "Pelaje blanco grueso"
    }
    {
        en = "Thick white fur formerly belonging to an Unhold of the frozen north."
        es = "Pelaje espeso y blanco que antiguamente perteneció a un trol helado del norte."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\ghoul_brain_item.nut
    {
        en = "Nachzehrer Brain"
        es = "Cerebro de Nachzehrer"
    }
    {
        en = "The greasy brain of a slain Nachzehrer. What could you possibly want with this?"
        es = "El cerebro grasiento de un Nachzehrer asesinado. ¿Qué podrías querer con esto?"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\ghoul_horn_item.nut
    {
        en = "Nachzehrer Horn"
        es = "Cuerno de Nachzehrer"
    }
    {
        en = "Nachzehrers can grow impressive horns, and these in turn make for impressive trophies."
        es = "A los Nachzehrers les pueden crecer cuernos impresionantes, que a su vez sirven para obtener trofeos impresionantes."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\ghoul_teeth_item.nut
    {
        en = "Jagged Fangs"
        es = "Colmillos dentados"
    }
    {
        en = "A handful of jagged fangs taken from a Nachzehrer. Infected with rot but hard enough to chew through any bone. Might fetch some coin from alchemists on the market place."
        es = "Un puñado de colmillos dentados extraídos de un Nachzehrer. Infectado con podredumbre pero lo suficientemente duro como para masticar cualquier hueso. Podrías conseguir algunas monedas de los alquimistas en el mercado."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\glistening_scales_item.nut
    {
        en = "Glistening Scales"
        es = "Escamas relucientes"
    }
    {
        en = "These scales are shimmering and glistening beautifully in all the colors as you turn them towards the sun."
        es = "Estas escamas brillan y destellan maravillosamente en todos los colores cuando las giras hacia el sol."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\glowing_resin_item.nut
    {
        en = "Glowing Resin"
        es = "Resina resplandeciente"
    }
    {
        en = "These amber resin shards have a light orange hue to them. If melted, the material makes for a strong adhesive."
        es = "Estos fragmentos de resina de color ámbar tienen un tono naranja claro. Si se derrite, el material se convierte en un adhesivo fuerte."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\happy_powder_item.nut
    {
        en = "Happy Powder"
        es = "Polvo Feliz"
    }
    {
        en = "This miraculous powder instantly turns a grumpy, ill-tempered mercenary into an happy and energetic one. Do not operate heavy machinery while under the influence."
        es = "Este polvo milagroso convierte instantáneamente a un mercenario gruñón y de mal humor en uno feliz y enérgico. No operar equipo peligroso o maquinaria pesada mientras esté bajo su influencia."
    }
    {
        en = "Right-click or drag onto the currently selected character in order to snort. This item will be consumed in the process."
        es = ""
    }
    {
        en = "Fear and loathing along the road"
        es = ""
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\heart_of_the_forest_item.nut
    {
        en = "Heart of the Forest"
        es = "Corazón del bosque"
    }
    {
        en = "A thorny plant part, resembling in shape a human heart."
        es = "Parte de una planta espinosa, cuya forma se asemeja a un corazón humano."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\hyena_fur_item.nut
    {
        en = "Raging Hyena Fur"
        es = "Piel de hiena furiosa"
    }
    {
        en = "The colorful fur of a desert hyena makes for an impressive and exotic addition to any mercenary armor, if not a sophisticated one."
        es = "El colorido pelaje de una hiena del desierto constituye una impresionante, exótica, si no sofisticada, adición a cualquier armadura mercenaria."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\kraken_horn_plate_item.nut
    {
        en = "Taken from the head of the legendary kraken, this large and hard horn plate is a trophy few in this world can claim."
        es = "Tomada de la cabeza del legendario kraken, esta placa de cuerno grande y dura es un trofeo que pocos en este mundo pueden reclamar."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\kraken_tentacle_item.nut
    {
        en = "Severed Tentacle"
        es = "Tentáculo cortado"
    }
    {
        en = "The shriveled remains of a legendary kraken's tentacle, slimy and squishy but highly sought-after by alchemists for its supposed rare properties."
        es = "Los restos arrugados del tentáculo de un kraken legendario, viscosos y blandos pero muy buscados por los alquimistas por sus supuestas propiedades raras."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\lindwurm_blood_item.nut
    {
        en = "Lindwurm Blood"
        es = "Sangre de Lindwurm"
    }
    {
        en = "The corroding blood of a Lindwurm that eats away at metal in no time. Luckily it can be safely transported in glass vials."
        es = "La sangre corrosiva de un Lindwurm que devora el metal en un instante. Por suerte, se puede transportar de forma segura en viales de vidrio."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\lindwurm_bones_item.nut
    {
        en = "Lindwurm Bones"
        es = "Huesos de Lindwurm"
    }
    {
        en = "The bones of the Lindwurm are mostly hollow from the inside, making them an easy to carry trophy despite their size."
        es = "Los huesos del Lindwurm son en su mayoría huecos por dentro, lo que los convierte en un trofeo fácil de transportar a pesar de su tamaño."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\lindwurm_scales_item.nut
    {
        en = "The shimmering green scales of a Lindwurm are among the most reputable trophies a beast hunter can bring home from his adventures."
        es = "Las brillantes escamas verdes de un Lindwurm se encuentran entre los trofeos más reputados que un cazador de bestias puede llevarse a casa después de sus aventuras."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\manhunters_ledger_item.nut
    {
        en = "Company Ledger"
        es = "Libro mayor de la compañía"
    }
    {
        en = "A ledger detailing the members and contract terms of the company."
        es = "Un libro de contabilidad que detalla los miembros y los términos de los 'contratos' de la compañía."
    }
    {
        // text = indebted + " Indebted in the company"
        mode = "pattern"
        en = "<indebted> Indebted in the company"
        es = "<indebted> Endeudados en la compañía"
    }
    {
        // text = nonIndebted + " Manhunters in the company"
        mode = "pattern"
        en = "<nonIndebted> Manhunters in the company"
        es = "<nonIndebted> Esclavistas en la compañía"
    }
    {
        // text = "[color=" + this.Const.UI.Color.PositiveValue + "]+10%[/color] Experience Gain for Indebted"
        mode = "pattern"
        en = "[color=<this.Const.UI.Color.PositiveValue>]+10%[/color] Experience Gain for Indebted"
        es = "[color=<this.Const.UI.Color.PositiveValue>]+10%[/color] Experiencia ganada por Endeudados"
    }
    {
        // text = "[color=" + this.Const.UI.Color.NegativeValue + "]-10%[/color] Experience Gain for Manhunters"
        mode = "pattern"
        en = "[color=<this.Const.UI.Color.NegativeValue>]-10%[/color] Experience Gain for Manhunters"
        es = "[color=<this.Const.UI.Color.NegativeValue>]-10%[/color] Experiencia ganada por Esclavistas"
    }
    {
        en = "There are too few Indebted in the company! The Manhunters will become dissatisfied if this continues!"
        es = "¡Hay muy pocos endeudados en la compañía! ¡Los Esclavistas quedarán insatisfechos si esto continúa!"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\miracle_drug_item.nut
    {
        en = "Apothecary's Miracle"
        es = "Milagro del Boticario"
    }
    {
        en = "A powerful remedy against many common illnesses and diseases, to reduce inflammation, and to support the body's natural healing.\n\nCharacters treated with this drug will recover faster from injuries, just like if they've been treated at a temple."
        es = "Un poderoso remedio contra muchas enfermedades y dolencias comunes, para reducir la inflamación y apoyar la curación natural del cuerpo.\n\nLos personajes tratados con este medicamento se recuperarán más rápido de las lesiones, como si hubieran sido tratados en un templo."
    }
    {
        en = "Right-click or drag onto the currently selected character in order to swallow. This item will be consumed in the process."
        es = "Haga clic derecho o arrastre sobre el personaje seleccionado actualmente para tragar. Este artículo se consumirá en el proceso. "
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\mysterious_herbs_item.nut
    {
        en = "Mysterious Herbs"
        es = "Hierbas misteriosas"
    }
    {
        en = "These herbs do not look or smell like any known to you. Their scent is intriguing and appalling at the same time."
        es = "Estas hierbas no se parecen ni huelen a ninguna que conozcas. Su olor es intrigante y espantoso al mismo tiempo."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\paint_black_item.nut
    {
        en = "Black Paint"
        es = "Pintura negra"
    }
    {
        en = "A bucket of black paint. Can be used to paint many common helmets."
        es = "Un cubo de pintura negra. Se puede utilizar para pintar muchos cascos comunes."
    }
    {
        en = "Right-click or drag onto a helmet carried by the currently selected character in order to paint it. This item will be consumed in the process."
        es = "Haz clic derecho o arrastra sobre el casco que lleva el personaje actualmente seleccionado para pintarlo. Este artículo se consumirá en el proceso."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\paint_orange_red_item.nut
    {
        en = "Orange and Red Paint"
        es = "Pintura roja y naranja"
    }
    {
        en = "Buckets of yellow and red paint. Can be used to paint many common helmets."
        es = "Cubos de pintura roja y naranja. Se puede utilizar para pintar muchos cascos comunes."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\paint_red_item.nut
    {
        en = "Red Paint"
        es = "Pintura roja"
    }
    {
        en = "A bucket of red paint. Can be used to paint many common helmets."
        es = "Un cubo de pintura roja. Se puede utilizar para pintar muchos cascos comunes."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\paint_remover_item.nut
    {
        en = "Paint Remover"
        es = "Removedor de pintura"
    }
    {
        en = "A bucket of paint remover. Can be used to remove paint from many common helmets."
        es = "Un cubo de removedor de pintura. Se puede utilizar para quitar pintura de muchos cascos comunes."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\paint_set_item.nut
    {
        en = "Paint Set"
        es = "Equipo de pintura"
    }
    {
        en = "A palette of several vibrant colors and a set of brushes. Can be used to paint common shields in your company's colors."
        es = "Una paleta de varios colores vibrantes y un juego de pinceles. ¡Se puede utilizar para pintar escudos comunes con los colores de tu compañía!\n\n\x22Píntame un caballero montado perforando el corazón de un dragón con una lanza. Así, bien molón.\x22"
    }
    {
        en = "Right-click or drag onto a shield carried by the currently selected character in order to paint it. This item will be consumed in the process."
        es = "Haz clic derecho o arrastra sobre el casco que lleva el personaje actualmente seleccionado para pintarlo. Este artículo se consumirá en el proceso."
    }
    {
        en = "AColorfulBand"
        es = ""
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\paint_white_blue_item.nut
    {
        en = "White and Blue Paint"
        es = "Pintura azul y blanca"
    }
    {
        en = "Buckets of white and blue paint. Can be used to paint many common helmets."
        es = "Cubos de pintura azul y blanca. Se puede utilizar para pintar muchos cascos comunes.\n\n\x22Oíd mortales el grito sagrado...\x22"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\paint_white_green_yellow_item.nut
    {
        en = "White, Green and Yellow Paint"
        es = "Pintura amarilla, verde y blanca"
    }
    {
        en = "Buckets of white, green and yellow paint. Can be used to paint many common helmets."
        es = "Cubos de pintura amarilla, verde y blanca. Se puede utilizar para pintar muchos cascos comunes."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\parched_skin_item.nut
    {
        en = "Parched Skin"
        es = "Piel reseca"
    }
    {
        en = "This skin taken from an Alp is paperthin and glitters in the sunlight."
        es = "Esta piel extraída de un Alp es fina como el papel y brilla bajo la luz del sol."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\petrified_scream_item.nut
    {
        en = "Petrified Scream"
        es = "Grito petrificado"
    }
    {
        en = "An eerie artifact found among the remains of an Alp. Carrying this around may cause bad dreams and bad night's rest."
        es = "Un misterioso artefacto encontrado entre los restos de un Alp. Llevar esto encima puede provocar malos sueños y un mal descanso nocturno."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\poison_gland_item.nut
    {
        en = "Poison Gland"
        es = "Glándula venenosa"
    }
    {
        en = "The poison gland of a Webknecht. Should not be carried close to any food or drink."
        es = "La glándula venenosa de un webknecht. No debe llevarse cerca de ningún alimento o bebida."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\poisoned_apple_item.nut
    {
        en = "Poisoned Apple"
        es = "Manzana envenenada"
    }
    {
        en = "Looks delicious!"
        es = "\x22¡Luce deliciosa!\x22\n\x22No se te ocurra morderla\x22"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\potion_of_knowledge_item.nut
    {
        en = "Potion of Knowledge"
        es = "Poción de conocimiento"
    }
    {
        en = "Knowledge of the world, arcane and mundane, is said to be distilled into this potion. Upon drinking it, lessons are more easily learned."
        es = "Se dice que el conocimiento del mundo, arcano y mundano, se destila en esta poción. Al beberlo, las lecciones se aprenden más fácilmente."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\potion_of_oblivion_item.nut
    {
        en = "Potion of Oblivion"
        es = "Poción del Olvido"
    }
    {
        en = "Better not ask how this concoction of the rarest and most bizarre ingredients tastes! Anybody who drinks this is said to be able to relive his life, changing the decisions he made along the way."
        es = "¡Mejor no preguntes cómo sabe esta mezcla de los ingredientes más raros y extraños! Se dice que quien bebe esto puede revivir su vida, cambiando las decisiones que tomó en el camino."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\serpent_skin_item.nut
    {
        en = "Serpent Skin"
        es = "Piel de serpiente"
    }
    {
        en = "The scaly skin of a large serpent. A skilled craftsman could turn this into something useful."
        es = "La piel escamosa de una gran serpiente. Un artesano experto podría convertir esto en algo útil."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\snake_oil_item.nut
    {
        en = "Snake Oil"
        es = "Aceite de serpiente"
    }
    {
        en = "A mysterious concoction said to help against hair loss, syphilis, deafness, impotence, skin rash, pox and writer's block. A true miracle potion if only you believe in it. Can be sold everywhere for a tidy sum."
        es = "Un brebaje misterioso que se dice ayudar contra la caída del cabello, la sífilis, la sordera, la impotencia, las erupciones cutáneas, la viruela y el bloqueo del escritor. Una verdadera poción milagrosa, si crees en ella. Se puede vender en todas partes por una buena suma.\n\n\x22¡Además, sirve para destapar letrinas!\x22"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\spider_silk_item.nut
    {
        en = "Gossamer"
        es = "Telaraña"
    }
    {
        en = "Gossamer gathered from the remains of a Webknecht. Light and strong, it is superior to most common materials. If only it weren't so sticky..."
        es = "Telaraña recogida de los restos de un webknecht. Ligera y resistente, es superior a los materiales más comunes. Si tan solo no fuera tan pegajoso..."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\sulfurous_rocks_item.nut
    {
        en = "Sulfurous Rocks"
        es = "Rocas sulfurosas"
    }
    {
        en = "An offensive stench is emitted by these brittle rocks, which are prized highly by alchemists."
        es = "Estas rocas quebradizas, muy apreciadas por los alquimistas, emiten un hedor desagradable."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\third_eye_item.nut
    {
        en = "Third Eye"
        es = "Tercer ojo"
    }
    {
        en = "Alps have no eyes, yet this eye-like organ can be retrieved from inside their skulls."
        es = "Los Alps no tienen ojos, pero este órgano parecido a un ojo se puede recuperar del interior de sus cráneos."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\unhold_bones_item.nut
    {
        en = "Giant Skull and Bones"
        es = "Calavera y huesos gigantes"
    }
    {
        en = "These large bones taken from an Unhold are a valued trophy among beast hunters."
        es = "Estos grandes huesos extraídos de un trol son un valioso trofeo entre los cazadores de bestias."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\unhold_heart_item.nut
    {
        en = "Unhold's Heart"
        es = "Corazón de trol"
    }
    {
        en = "The large and heavy heart of an Unhold. Rumored to have magical properties, alchemists are prepared to pay a tidy sum to get it into their hands."
        es = "El corazón grande y pesado de un trol. Se rumorea que tiene propiedades mágicas, pero los alquimistas están dispuestos a pagar una buena suma para tenerlo en sus manos."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\unhold_hide_item.nut
    {
        en = "Unhold Hide"
        es = "Pellejo de trol"
    }
    {
        en = "Hide is the basis of most armors, and this thick hide taken from an Unhold is especially sturdy."
        es = "La piel es la base de la mayoría de las armaduras, y esta gruesa piel extraída de un trol es especialmente resistente."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\vampire_dust_item.nut
    {
        en = "Shimmering Ashes"
        es = "Cenizas relucientes"
    }
    {
        en = "A small heap of ashes shimmering in many facets of blue. Allegedly it's the remains of a powerful undead creature, but few people would believe a claim like this."
        es = "Un pequeño montón de cenizas que brillan en muchas facetas de azul. Supuestamente son los restos de una poderosa criatura no-muerta, pero pocas personas creerían una afirmación como esta."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\wardog_armor_upgrade_item.nut
    {
        en = "A simple leather coat that can be donned by any wardog to give it some protection in combat."
        es = "Un sencillo abrigo de cuero que cualquier perro de guerra puede usar para brindarle cierta protección en combate."
    }
    {
        en = "Right-click or drag onto a wardog equipped by the currently selected character in order to use. This item will be consumed in the process."
        es = "Haz clic derecho o arrastra sobre un perro de guerra equipado por el personaje actualmente seleccionado para usarlo. Este artículo se consumirá en el proceso."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\wardog_heavy_armor_upgrade_item.nut
    {
        en = "A heavy hide coat that can be donned by any wardog to give it protection in combat."
        es = "Un abrigo de piel pesado y resistente que puede ponerse cualquier perro de guerra para protegerlo en combate."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\werewolf_pelt_item.nut
    {
        en = "Unusually Large Wolf Pelt"
        es = "Piel de lobo inusualmente grande"
    }
    {
        en = "A thick and unusually large wolf pelt that should fetch a decent price at the market."
        es = "Una piel de lobo gruesa e inusualmente grande que debería alcanzar un precio decente en el mercado."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\misc\witch_hair_item.nut
    {
        en = "Witch Hair"
        es = "Cabello de bruja"
    }
    {
        en = "Long and brittle strands of greyish hair taken from a Hexe. Their hair is said to have powerful properties in creating potions and elixirs. But then again, it's also said that Hexen keep the genitals of their victims as pets, so information attained from the peasantry might not be especially reliable."
        es = "Mechones largos y quebradizos de cabello grisáceo tomados de una Hexen. Se dice que su cabello tiene poderosas propiedades para crear pociones y elixires. Pero claro, también se dice que las Hexens mantienen los genitales de sus víctimas como mascotas, por lo que la información obtenida del campesinado podría no ser especialmente confiable."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\shields\ancient\auxiliary_shield.nut
    {
        en = "Ancient Auxiliary Shield"
        es = "Escudo auxiliar antiguo"
    }
    {
        en = "A wooden light shield in oval shape. The wood seems brittle and old, making it less durable."
        es = "Un escudo ligero de madera de forma ovalada. La madera parece quebradiza y vieja, lo que la hace menos duradera."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\shields\ancient\coffin_shield.nut
    {
        en = "Ancient Coffin Shield"
        es = "Escudo de ataúd antiguo"
    }
    {
        en = "An octagonal shield made of wood and reinforced with bronze. Time has taken its toll and the wood has become brittle."
        es = "Escudo octogonal fabricado en madera y reforzado con bronce. El tiempo ha pasado factura y la madera se ha vuelto quebradiza."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\shields\ancient\tower_shield.nut
    {
        en = "Ancient Tower Shield"
        es = "Escudo de torre antiguo"
    }
    {
        en = "A tall and heavy tower shield that offers good protection, but is very bulky to handle. It appears to be old and worn down."
        es = "Una escudo de torre alto y pesado que ofrece buena protección, pero es muy voluminoso de manejar. Parece viejo y desgastado."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\shields\beasts\schrat_shield.nut
    {
        en = "Schrat's Shield"
        es = "Corteza de Schrat"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\shields\buckler_shield.nut
    {
        en = "Buckler"
        es = "Rodela"
    }
    {
        en = "A small but sturdy shield gripped in the fist. Offers poor protection against ranged attacks but can be useful in deflecting blows in melee."
        es = "Un escudo pequeño pero resistente agarrado en el puño. Ofrece poca protección contra ataques a distancia, pero puede ser útil para desviar golpes cuerpo a cuerpo."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\shields\faction_heater_shield.nut
    {
        en = "Heater Shield"
        es = "Escudo calentador"
    }
    {
        en = "A triangular wooden shield covered with leather and canvas."
        es = "Escudo triangular de madera recubierto de cuero y pintura."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\shields\faction_kite_shield.nut
    {
        en = "Kite Shield"
        es = "Escudo de cometa"
    }
    {
        en = "An elongated wooden shield covered in leather that offers good protection also to the lower body. Somewhat bulky to handle in close combat engagements."
        es = "Un escudo alargado de madera recubierto de cuero que ofrece una buena protección también a la parte inferior del cuerpo. Algo voluminoso para manejar en combates cuerpo a cuerpo."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\shields\faction_wooden_shield.nut
    {
        en = "Wooden Shield"
        es = "Escudo de madera"
    }
    {
        en = "A round wooden shield."
        es = "Un escudo de madera redondo. Simple. Y efectivo."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\shields\greenskins\goblin_heavy_shield.nut
    {
        en = "Reinforced Skirmisher Shield"
        es = "Escudo de hostigador reforzado"
    }
    {
        en = "A reinforced wooden shield made by goblins. Light but also small, offering little protection for a human using it."
        es = "Un escudo de madera reforzado hecho por goblins. Ligero pero también pequeño, y ofrece poca protección para un ser humano que lo utilice."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\shields\greenskins\goblin_light_shield.nut
    {
        en = "Wooden Skirmisher Shield"
        es = "Escudo de hostigador de madera"
    }
    {
        en = "A wooden shield made by goblins. Light but also small, offering little protection against attacks for a human using it."
        es = "Un escudo de madera hecho por goblins. Ligero pero también pequeño, ofrece poca protección contra ataques para un humano que lo use."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\shields\greenskins\orc_heavy_shield.nut
    {
        en = "Heavy Metal Shield"
        es = "Escudo de metal pesado"
    }
    {
        en = "A massive metal shield that is almost impossible to destroy but very heavy and fatiguing to wear for any human."
        es = "Un enorme escudo de metal que es casi imposible de destruir pero muy pesado y fatigante de llevar para cualquier ser humano."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\shields\greenskins\orc_light_shield.nut
    {
        en = "Feral Shield"
        es = "Escudo tosco"
    }
    {
        en = "A light wooden shield covered in leather. Offers good protection against ranged attacks due to its size, but is quite fragile."
        es = "Un escudo de madera ligera revestido de cuero. Ofrece buena protección contra ataques a distancia debido a su tamaño, pero es bastante frágil."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\shields\legendary\gilders_embrace_shield.nut
    {
        en = "An ornate metal shield with a bright gilded shine that reflects even the tiniest ray of light with the power of the sun itself."
        es = "Un escudo de metal adornado con un brillante y deslumbrante dorado que refleja hasta el más mínimo rayo de luz con el poder del sol mismo."
    }
    {
        // text = "Melee Defense [color=" + this.Const.UI.Color.PositiveValue + "]+" + this.m.MeleeDefense + "[/color]"
