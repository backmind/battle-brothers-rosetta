    {
        // text = "Lord of " + s.getName()
        mode = "pattern"
        en = "Lord of <s.getName()>"
        es = "Señor de <s.getName()>"
    }
    {
        en = "The amount of coin your mercenary company has. Used to pay every man daily at noon, as well as to hire new people and purchase equipment.\n\nYou currently don't pay anyone."
        es = "La cantidad de monedas que tiene tu compañía de mercenarios. Se usa para pagar a cada hombre diariamente al mediodía, así como para contratar personal y comprar equipo.\n\nActualmente no pagas a nadie."
    }
    {
        // text = "The amount of coin your mercenary company has. Used to pay every man daily at noon, as well as to hire new people and purchase equipment.\n\nYou pay out [color=" + this.Const.UI.Color.PositiveValue + "]" + dailyMoney + "[/color] crowns per day. Your [color=" + this.Const.UI.Color.PositiveValue + "]" + money + "[/color] crowns will last you for [color=" + this.Const.UI.Color.PositiveValue + "]" + time + "[/color] more days."
        mode = "pattern"
        en = "The amount of coin your mercenary company has. Used to pay every man daily at noon, as well as to hire new people and purchase equipment.\n\nYou pay out [color=<this.Const.UI.Color.PositiveValue>]<dailyMoney>[/color] crowns per day. Your [color=<this.Const.UI.Color.PositiveValue>]<money>[/color] crowns will last you for [color=<this.Const.UI.Color.PositiveValue>]<time>[/color] more days."
        es = "Las monedas que posee tu compañía de mercenarios. Se utilizan para pagar salarios a los hombres a mediodía, además de reclutar más gente y comprar equipamento.\n\nPagas [color=<this.Const.UI.Color.PositiveValue>]<dailyMoney>[/color] coronas diarias. Tus [color=<this.Const.UI.Color.PositiveValue>]<money>[/color] coronas te alcanzarán para [color=<this.Const.UI.Color.PositiveValue>]<time>[/color] días más."
    }
    {
        // text = "The amount of coin your mercenary company has. Used to pay every man daily, as well as to hire new men and purchase equipment.\n\nYou pay out [color=" + this.Const.UI.Color.PositiveValue + "]" + dailyMoney + "[/color] crowns per day.\n\n[color=" + this.Const.UI.Color.NegativeValue + "]You have no more crowns to pay your men with! Earn some crowns fast or let some people go before they desert you one by one.[/color]"
        mode = "pattern"
        en = "The amount of coin your mercenary company has. Used to pay every man daily, as well as to hire new men and purchase equipment.\n\nYou pay out [color=<this.Const.UI.Color.PositiveValue>]<dailyMoney>[/color] crowns per day.\n\n[color=<this.Const.UI.Color.NegativeValue>]You have no more crowns to pay your men with! Earn some crowns fast or let some people go before they desert you one by one.[/color]"
        es = "Las monedas que posee tu compañía de mercenarios. Se utilizan para pagar salarios a los hombres a mediodía, además de reclutar más gente y comprar equipamento.\n\nPagas [color=<this.Const.UI.Color.PositiveValue>]<dailyMoney>[/color] coronas diarias.\n\n[color=<this.Const.UI.Color.NegativeValue>]¡No tienes suficientes coronas para pagar a tus hombres! Gana algunas coronas rápido o despide a algunos hombres antes que te abandonen uno por uno.[/color]]"
    }
    {
        en = "Hiring Fee"
        es = "Costo de reclutamiento"
    }
    {
        en = "The hiring fee will be paid immediately on hiring a man for signing up and proving you can back up your words with coin."
        es = "El costo de reclutamiento será pagado inmediatamente al reclutar a un hombre y probando que puedes respaldar tus palabras con monedas."
    }
    {
        en = "Up Front Costs"
        es = "Costos iniciales"
    }
    {
        en = "This fee will have to be paid up front for services to be rendered."
        es = "Muestra la lista de hombres combatientes de tu compañía mercenaria."
    }
    {
        en = "Tryout Fee"
        es = "Costo de prueba"
    }
    {
        en = "This fee will be paid immediately on giving this recruit a proper inspection to reveal his character traits, if any."
        es = "Este costo será pagado inmediatamente al darle una inspección de prueba apropiada a este recluta para revelar sus rasgos, de tenerlos."
    }
    {
        en = "Daily Wage"
        es = "Salario diario"
    }
    {
        en = "The daily wage will be paid every single day as payment for serving under your command. The wage is increased automatically by a cumulative 10% per level until the 11th, and then 3% afterwards."
        es = "Los puntos de acción (PA) se gastan por cada acción, como moverse o usar una habilidad. Una vez que se gastan todos los puntos, el turno del personaje actual termina automáticamente. Los PA se actualizan por completo en cada turno."
    }
    {
        en = "Provisions"
        es = "Raciones"
    }
    {
        // text = "The total amount of provisions you carry. The average man requires 2 provisions per day and more on difficult terrain. Your men will eat the provisions closest to expiring first. Running out of provisions will lower morale and will eventually lead to your people deserting you before dying of starvation.\n\nYou use [color=" + this.Const.UI.Color.PositiveValue + "]" + dailyFood + "[/color] provisions per day. Your [color=" + this.Const.UI.Color.PositiveValue + "]" + food + "[/color] provisions will last you for [color=" + this.Const.UI.Color.PositiveValue + "]" + time + "[/color] more days at most. Keep in mind that individual provisions will eventually turn bad!"
        mode = "pattern"
        en = "The total amount of provisions you carry. The average man requires 2 provisions per day and more on difficult terrain. Your men will eat the provisions closest to expiring first. Running out of provisions will lower morale and will eventually lead to your people deserting you before dying of starvation.\n\nYou use [color=<this.Const.UI.Color.PositiveValue>]<dailyFood>[/color] provisions per day. Your [color=<this.Const.UI.Color.PositiveValue>]<food>[/color] provisions will last you for [color=<this.Const.UI.Color.PositiveValue>]<time>[/color] more days at most. Keep in mind that individual provisions will eventually turn bad!"
        es = "La cantidad total de raciones que llevas. El hombre promedio necesita dos raciones por día y más en terreno difícil. Tus hombres se comerán las raciones que estén más cercanas a pudrirse. Quedarse sin raciones bajará la moral de los hombres y eventualmente hará que tu gente te abandone antes de morir de hambre.\n\nUsas [color=<this.Const.UI.Color.PositiveValue>]<dailyFood>[/color] raciones al día. Tus [color=<this.Const.UI.Color.PositiveValue>]<food>[/color] raciones te alcanzarán para [color=<this.Const.UI.Color.PositiveValue>]<time>[/color] días más a lo sumo. ¡Ten en cuenta que las raciones individuales se pudrirán eventualmente!"
    }
    {
        // text = "The total amount of provisions you carry. The average man requires 2 provisions per day and more on difficult terrain. Your men will eat the provisions closest to expiring first. Running out of provisions will lower morale and will eventually lead to your people deserting you before dying of starvation.\n\nYou use [color=" + this.Const.UI.Color.PositiveValue + "]" + dailyFood + "[/color] provisions per day.\n\n[color=" + this.Const.UI.Color.NegativeValue + "]You are almost out of provisions to feed your men! Buy new provisions as fast as possible or your men will desert you one by one before they starve![/color]"
        mode = "pattern"
        en = "The total amount of provisions you carry. The average man requires 2 provisions per day and more on difficult terrain. Your men will eat the provisions closest to expiring first. Running out of provisions will lower morale and will eventually lead to your people deserting you before dying of starvation.\n\nYou use [color=<this.Const.UI.Color.PositiveValue>]<dailyFood>[/color] provisions per day.\n\n[color=<this.Const.UI.Color.NegativeValue>]You are almost out of provisions to feed your men! Buy new provisions as fast as possible or your men will desert you one by one before they starve![/color]"
        es = "La cantidad total de raciones que llevas. El hombre promedio necesita dos raciones por día y más en terreno difícil. Tus hombres se comerán las raciones que estén más cercanas a pudrirse. Quedarse sin raciones bajará la moral de los hombres y eventualmente hará que tu gente te abandone antes de morir de hambre.\n\nUsas [color=<this.Const.UI.Color.PositiveValue>]<dailyFood>[/color] raciones al día.\n\n[color=<this.Const.UI.Color.NegativeValue>]¡Ya casi te quedas sin raciones para alimentar a tus hombres! ¡Compra más raciones tan rápido como puedas o tus hombres te abandonarán uno por uno antes de morir de hambre![/color]"
    }
    {
        // text = "The total amount of provisions you carry. The average man requires 2 provisions per day and more on difficult terrain. Your men will eat the provisions closest to expiring first. Running out of provisions will lower morale and will eventually lead to your people deserting you before dying of starvation.\n\nYou use [color=" + this.Const.UI.Color.PositiveValue + "]" + dailyFood + "[/color] provisions per day.\n\n[color=" + this.Const.UI.Color.NegativeValue + "]You have no more provisions to feed your men! Buy new provisions as fast as possible or your men will desert you one by one before they starve![/color]"
        mode = "pattern"
        en = "The total amount of provisions you carry. The average man requires 2 provisions per day and more on difficult terrain. Your men will eat the provisions closest to expiring first. Running out of provisions will lower morale and will eventually lead to your people deserting you before dying of starvation.\n\nYou use [color=<this.Const.UI.Color.PositiveValue>]<dailyFood>[/color] provisions per day.\n\n[color=<this.Const.UI.Color.NegativeValue>]You have no more provisions to feed your men! Buy new provisions as fast as possible or your men will desert you one by one before they starve![/color]"
        es = "La cantidad total de raciones que llevas. El hombre promedio necesita dos raciones por día y más en terreno difícil. Tus hombres se comerán las raciones que estén más cercanas a pudrirse. Quedarse sin raciones bajará la moral de los hombres y eventualmente hará que tu gente te abandone antes de morir de hambre.\n\nUsas [color=<this.Const.UI.Color.PositiveValue>]<dailyFood>[/color] raciones al día.\n\n[color=<this.Const.UI.Color.NegativeValue>]¡Ya no tienes raciones para alimentar a tus hombres! ¡Compra más raciones tan rápido como puedas o tus hombres te abandonarán uno por uno antes de morir de hambre![/color]"
    }
    {
        en = "Daily Provisions"
        es = "Raciones diarias"
    }
    {
        en = "The amount of provisions a man requires each day. Running out of provisions will lower morale and will eventually lead to your men deserting you before dying of starvation."
        es = "La cantidad de raciones que un hombre necesita al día. Quedarse sin raciones bajará la moral y eventualmente llevará a que tus hombres te abandonen antes de morir de hambre."
    }
    {
        // text = "Assorted arrows, bolts and throwing weapons used to automatically refill quivers after battle. Replacing one arrow or bolt will take up one point of ammunition, replacing one shot of a Handgonne will take up two points, and replacing one throwing weapon or charge of a Fire Lance will take up three. Running out of ammunition will leave your quivers empty and your people with nothing to shoot with. You can carry no more than " + (this.Const.Difficulty.MaxResources[this.World.Assets.getEconomicDifficulty()].Ammo + this.World.Assets.m.AmmoMaxAdditional) + " units at a time."
        mode = "pattern"
        en = "Assorted arrows, bolts and throwing weapons used to automatically refill quivers after battle. Replacing one arrow or bolt will take up one point of ammunition, replacing one shot of a Handgonne will take up two points, and replacing one throwing weapon or charge of a Fire Lance will take up three. Running out of ammunition will leave your quivers empty and your people with nothing to shoot with. You can carry no more than <this.Const.Difficulty.MaxResources[this.World.Assets.getEconomicDifficulty()].Ammo + this.World.Assets.m.AmmoMaxAdditional> units at a time."
        es = "Flechas, pernos, armas arrojadizas y balas de todo tipo utilizadas para rellenar los carcaj de forma automática después de un combate. Reemplazar una flecha o perno costará un punto de munición, reemplazar una bala de Handgonne costará dos puntos, y reemplazar un arma arrojadiza o una carga de la Lanza de Fuego costará tres. Quedarse sin munición dejará tus carcaj vacíos y a tus hombres sin objetos con los que disparar. No puedes llevar más de <this.Const.Difficulty.MaxResources[this.World.Assets.getEconomicDifficulty()].Ammo + this.World.Assets.m.AmmoMaxAdditional> unidades a la vez."
    }
    {
        en = "Assorted tools and supplies to keep your weapons, armor, helmets and shields in good condition. One point is required to repair 15 points of item condition. Running out of supplies may result in weapons breaking in combat and will leave your armor damaged and useless."
        es = "Herramientas y suministros variados para mantener tus armas, armadura, cascos y escudos en buen estado. Un punto se necesita para reparar quince puntos de durabilidad. Quedarte sin herramientas y suministros puede resultar en que las armas se rompan en combate, además de dejar tu armadura dañada e inútil."
    }
    {
        // desc = desc + ("\n\nRepairing all your equipment will take [color=" + this.Const.UI.Color.PositiveValue + "]" + repair.Hours + "[/color] hours and requires ");
        mode = "pattern"
        en = "<desc>\n\nRepairing all your equipment will take [color=<this.Const.UI.Color.PositiveValue>]<repair.Hours>[/color] hours and requires "
        es = "<desc>\n\nReparar todo tu equipamento tomará [color=<this.Const.UI.Color.PositiveValue>]<repair.Hours>[/color] horas y requerirá "
    }
    {
        // desc = desc + (repair.ArmorParts + "[/color] tools and supplies.");
        mode = "pattern"
        en = "<desc + repair.ArmorParts>[/color] tools and supplies."
        es = "<desc + repair.ArmorParts>[/color] herramientas y suministros."
    }
    {
        // desc = desc + ("  You can carry " + (this.Const.Difficulty.MaxResources[this.World.Assets.getEconomicDifficulty()].ArmorParts + this.World.Assets.m.ArmorPartsMaxAdditional) + " units at most.");
        mode = "pattern"
        en = "<desc>  You can carry <this.Const.Difficulty.MaxResources[this.World.Assets.getEconomicDifficulty()].ArmorParts + this.World.Assets.m.ArmorPartsMaxAdditional> units at most."
        es = "<desc>  Puedes llevar hasta <this.Const.Difficulty.MaxResources[this.World.Assets.getEconomicDifficulty()].ArmorParts + this.World.Assets.m.ArmorPartsMaxAdditional> unidades como máximo."
    }
    {
        en = "Medical supplies consist of bandages, herbs, salves and the like, and are used to heal the more severe injuries sustained by your men in battle. One point of medical supplies is required each day for every injury to improve and ultimately heal. Lost hitpoints heal on their own.\n\nRunning out of medical supplies will leave your men unable to recover from severe injuries."
        es = "Suministros médicos que consisten en vendas, hierbas, ungüentos y demás, y son utilizados para curar las heridas más graves sufridas por tus hombres en combate. Un punto de suministros médicos se necesita cada día por cada herida para que mejore y eventualmente sea curada. Los puntos de vida se curan por sí mismos.\n\nQuedarse sin suministros médicos dejará a tus hombres incapaces de recuperarse de heridas graves."
    }
    {
        // desc = desc + ("\n\nHealing up all your men will take between [color=" + this.Const.UI.Color.PositiveValue + "]" + heal.DaysMin + "[/color] and [color=" + this.Const.UI.Color.PositiveValue + "]" + heal.DaysMax + "[/color] days and requires between ");
        mode = "pattern"
        en = "<desc>\n\nHealing up all your men will take between [color=<this.Const.UI.Color.PositiveValue>]<heal.DaysMin>[/color] and [color=<this.Const.UI.Color.PositiveValue>]<heal.DaysMax>[/color] days and requires between "
        es = "<desc>\n\nPara curar a todos tus hombres se utilizarán alrededor de [color=<this.Const.UI.Color.PositiveValue>]<heal.DaysMin>[/color] y [color=<this.Const.UI.Color.PositiveValue>]<heal.DaysMax>[/color] días y se requerirán entre "
    }
    {
        // desc = desc + (heal.MedicineMin + "[/color] and ");
        mode = "pattern"
        en = "<desc + heal.MedicineMin>[/color] and "
        es = "<desc + heal.MedicineMin>[/color] y "
    }
    {
        // desc = desc + (heal.MedicineMax + "[/color] Medical Supplies.");
        mode = "pattern"
        en = "<desc + heal.MedicineMax>[/color] Medical Supplies."
        es = "<desc + heal.MedicineMax>[/color] suministros médicos."
    }
    {
        // desc = desc + ("  You can carry " + (this.Const.Difficulty.MaxResources[this.World.Assets.getEconomicDifficulty()].Medicine + this.World.Assets.m.MedicineMaxAdditional) + " units at most.");
        mode = "pattern"
        en = "<desc>  You can carry <this.Const.Difficulty.MaxResources[this.World.Assets.getEconomicDifficulty()].ArmorParts + this.World.Assets.m.ArmorPartsMaxAdditional> units at most."
        es = "<desc>  Puedes llevar hasta <this.Const.Difficulty.MaxResources[this.World.Assets.getEconomicDifficulty()].ArmorParts + this.World.Assets.m.ArmorPartsMaxAdditional> unidades como máximo."
    }
    {
        en = "Roster (I, C)"
        es = "Herramientas y suministros"
    }
    {
        en = "Show the roster of the fighting force of your mercenary company."
        es = "Muestra la carga actual y máxima del inventario, tu inventario global."
    }
    {
        // text = "Renown: " + this.World.Assets.getBusinessReputationAsText() + " (" + this.World.Assets.getBusinessReputation() + ")"
        mode = "pattern"
        en = "Renown: <this.World.Assets.getBusinessReputationAsText()> (<this.World.Assets.getBusinessReputation()>)"
        es = "Renombre: <this.World.Assets.getBusinessReputationAsText()> (<this.World.Assets.getBusinessReputation()>)"
    }
    {
        en = "Your renown is your repute as a professional mercenary company and reflects how reliable and competent people judge you to be. The higher your renown, the higher-paid and more difficult contracts people will entrust you with. Renown increases on successfully completing ambitions and contracts, and winning battles, and decreases on failing to do so."
        es = "Tu renombre es tu reputación como una companía mercenaria profesional y refleja cuán confiable y competente la gente la juzga de ser. Entre más renombre tengas, te será brindada mayor remuneración y contratos de mayor dificultad por parte de la gente. El renombre aumenta al completar ambiciones y contratos exitosamente, además de ganar combates, y disminuirá al fracasarlos o abandonarlos."
    }
    {
        // text = "Reputation: " + this.World.Assets.getMoralReputationAsText()
        mode = "pattern"
        en = "Reputation: <this.World.Assets.getMoralReputationAsText()>"
        es = "Reputación: <this.World.Assets.getMoralReputationAsText()>"
    }
    {
        en = "Your reputation reflects how people in the world judge your mercenary company to conduct itself based on past actions. Do you show mercy to your enemies? Do you burn down farmsteads and massacre the peasantry? Based on your reputation, people may offer you different kinds of contracts, and both contracts and events may play out differently."
        es = "Tu reputación refleja cómo la gente en el mundo juzga la conducta de tu compañía mercenaria basándose en acciones pasadas. ¿Muestras misericordia con tus enemigos? ¿Quemas granjas y masacras al campesinado? Según tu reputación, las personas pueden ofrecerte diferentes tipos de contratos, y tanto los contratos como los eventos pueden desarrollarse de manera diferente."
    }
    {
        en = "Cancel Ambition"
        es = "Cancelar ambición"
    }
    {
        en = "Ambition"
        es = "Ambición"
    }
    {
        en = "You have not announced any ambition for your company to pursue. You'll be asked to do so as the game progresses."
        es = "No has anunciado ninguna ambición que tu compañía pueda perseguir. Se te pedirá que lo hagas a medida que avanza el juego."
    }
    {
        en = "Capacity"
        es = "Capacidad"
    }
    {
        en = "Shows the current and maximum load of the stash, your global inventory."
        es = "Este costo deberá ser pagado inmediatamente para que acceder a los servicios de este recluta."
    }
    {
        en = "Men in formation"
        es = "Hombres en formación"
    }
    {
        en = "Shows the current and maximum number of men placed in formation to fight in the next battle.\n\nDrag and drop your men to where you want them to be; the top row is the front facing the enemy, the second row is your back row, and the bottom row is your reserves of characters not taking part in battle."
        es = "Muestra el número actual y máximo de hombres colocados en formación para luchar en la próxima batalla.\n\nArrastra y suelta a tus hombres donde quieras que estén; la fila superior es la que mira al enemigo, la segunda fila es la fila trasera y la fila inferior son las reservas de personajes que no participan en la batalla."
    }
    {
        en = "Ground"
        es = "Suelo"
    }
    {
        en = "Shows the current items laying on the ground."
        es = "Muestra los objetos actuales que se encuentran en el suelo."
    }
    {
        en = "Action Points"
        es = "Puntos de acción"
    }
    {
        en = "Action Points (AP) are spent for every action, like moving or using a skill. Once all points are spent, the current character's turn ends automatically. AP are fully refreshed each turn."
        es = "El salario será pagado todos los días como pago por estar bajo tu comando. Éste incrementa automáticamente en un 10% por nivel hasta el onceavo nivel, y un 3% en adelante por nivel."
    }
    {
        en = "Hitpoints"
        es = "Puntos de vida"
    }
    {
        en = "Hitpoints represent the damage a character can take before dying. Once these reach zero, the character is considered dead. The higher the maximum hitpoints, the less likely it is a character will suffer debilitating injuries when hit."
        es = "Los puntos de vida representan el daño que un personaje puede recibir antes de morir. Una vez que llegan a cero, el personaje se considera muerto. Cuanto mayor sea el máximo de puntos de vida, menor será la probabilidad de que un personaje sufra lesiones debilitantes al ser golpeado."
    }
    {
        en = "Morale"
        es = "Moral"
    }
    {
        en = "Morale is one of five states and represents the mental condition of combatants and their effectiveness in battle. At the lowest state, fleeing, a character will be outside your control - although they may eventually rally again. Morale changes as the battle unfolds, with characters that have high resolve less likely to fall to low morale states. Many of your opponents are affected by morale as well.\n\nMorale checks trigger on these occasions:\n- Killing an enemy\n- Seeing an enemy be killed\n- Seeing an ally be killed\n- Seeing an ally flee\n- Being hit for 15 or more damage to hitpoints\n- Being engaged by more than one opponent\n- Using certain skills, like 'Rally'"
        es = "La moral es uno de cinco estados y representa la condición mental de los combatientes y su eficacia en la batalla. En el estado más bajo, Huyendo, un personaje estará fuera de tu control, aunque eventualmente puede recuperarse nuevamente. La moral cambia a medida que se desarrolla la batalla, y los personajes que tienen una gran resolución tienen menos probabilidades de caer en estados de moral bajos. Muchos de tus oponentes también se ven afectados por la moral.\n\nLas comprobaciones de moral se activan en estas ocasiones:\n- Matar a un enemigo\n- Ver cómo matan a un enemigo\n- Ver cómo matan a un aliado\n- Ver a un aliado huir \n- Ser golpeado por 15 o más daños a los puntos de vida\n- Ser atacado/rodeado por más de un oponente\n- Usar ciertas habilidades, como 'Reunir a las tropas'"
    }
    {
        en = "Fatigue"
        es = "Fatiga"
    }
    {
        en = "Fatigue is gained for every action, like moving or using skills, and when being hit in combat or dodging in melee. It is reduced at a fixed rate of 15 each turn or as much as necessary for a character to start every turn with 15 less than his maximum fatigue. If a character accumulates too much fatigue they may need to rest a turn (i.e. do nothing) before being able to use more specialized skills again."
        es = "La fatiga aumenta con cada acción, como moverse o usar habilidades, y al recibir un golpe en combate o esquivar cuerpo a cuerpo. Se reduce a un ritmo fijo de 15 por turno o tanto como sea necesario para que un personaje comience cada turno con 15 menos que su fatiga máxima. Si un personaje acumula demasiada fatiga, es posible que necesite descansar un turno (es decir, no hacer nada) antes de poder volver a utilizar habilidades más especializadas."
    }
    {
        en = "Maximum Fatigue"
        es = "Fatiga máxima"
    }
    {
        en = "Maximum Fatigue is the amount of fatigue a character can accumulate before being unable to take any more actions and having to recuperate. It is reduced by wearing heavy equipment, especially armor."
        es = "La fatiga máxima es la cantidad de fatiga que un personaje puede acumular antes de no poder realizar más acciones y tener que recuperarse. Se reduce usando equipo pesado, especialmente armaduras."
    }
    {
        en = "Head Armor"
        es = "Armadura de Cabeza"
    }
    {
        en = "Head Armor protects, surprisingly, the head, which is harder to hit than the body, but more vulnerable to damage. The more head armor, the less damage will be applied to hitpoints on taking a hit to the head."
        es = "La armadura de cabeza protege, sorprendentemente, la cabeza, que es más difícil de golpear que el cuerpo, pero más vulnerable a sufrir daños. Cuanta más armadura haya en la cabeza, menos daño se aplicará a los puntos de vida al recibir un golpe en la cabeza."
    }
    {
        en = "Body Armor"
        es = "Armadura corporal"
    }
    {
        en = " The more body armor, the less damage will be applied to hitpoints on taking a hit to the body."
        es = "Cuanta más armadura corporal, menos daño se aplicará a los puntos de vida al recibir un golpe en el cuerpo."
    }
    {
        en = "Melee Skill"
        es = "Habilidad a cuerpo a cuerpo"
    }
    {
        en = "Determines the base probability of hitting a target with a melee attack, such as with swords and spears. Can be increased as the character gains experience."
        es = "Determina la probabilidad base de alcanzar un objetivo con un ataque cuerpo a cuerpo, como con espadas y lanzas. Se puede aumentar a medida que el personaje gana experiencia."
    }
    {
        en = "Ranged Skill"
        es = "Habilidad a distancia"
    }
    {
        en = "Determines the base probability of hitting a target with a ranged attack, such as with bows and crossbows. Can be increased as the character gains experience."
        es = "Determina la probabilidad base de alcanzar un objetivo con un ataque a distancia, como arcos, ballestas y jabalinas. Se puede aumentar a medida que el personaje gana experiencia."
    }
    {
        en = "Melee Defense"
        es = "Defensa cuerpo a cuerpo"
    }
    {
        en = "A higher melee defense reduces the probability of being hit with a melee attack, such as the thrust of a spear. It can be increased as the character gains experience and by equipping a good shield."
        es = "Una defensa cuerpo a cuerpo más alta reduce la probabilidad de ser golpeado con un ataque cuerpo a cuerpo, como el golpe de una lanza. Se puede incrementar a medida que el personaje gana experiencia y equipando un buen escudo."
    }
    {
        en = "Ranged Defense"
        es = "Defensa a distancia"
    }
    {
        en = "A higher ranged defense reduces the probability of being hit with a ranged attack, such as an arrow shot from afar. It can be increased as the character gains experience and by equipping a good shield."
        es = "Una mayor defensa a distancia reduce la probabilidad de ser alcanzado con un ataque a distancia, como una flecha disparada desde lejos. Se puede incrementar a medida que el personaje gana experiencia y equipando un buen escudo."
    }
    {
        en = "Vision"
        es = "Visión"
    }
    {
        en = "Vision, or view range, determines how far a character can see to uncover the fog of war, discover threats and hit with ranged attacks. Heavier helmets and night time can reduce vision."
        es = "La visión, o rango de visión, determina hasta dónde puede ver un personaje para descubrir la niebla de la guerra, descubrir amenazas y atacar con ataques a distancia. Los cascos más pesados y el horario nocturno pueden reducir la visión."
    }
    {
        en = "Damage"
        es = "Daño"
    }
    {
        en = "The base damage the currently equipped weapon does. Will be applied in full against hitpoints if no armor is protecting the target. If the target is protected by armor, the damage is applied to armor instead based on the weapon's effectiveness against armor. The actual damage done is modified by the skill used and the target hit."
        es = "El daño base que causa el arma actualmente equipada. Se aplicará en su totalidad contra los puntos de vida si no hay armadura protegiendo al objetivo. Si el objetivo está protegido por una armadura, el daño se aplica a la armadura en función de la efectividad del arma contra la armadura. El daño real causado se modifica según la habilidad utilizada y el objetivo alcanzado."
    }
    {
        en = "Effectiveness against Armor"
        es = "Efectividad contra armadura"
    }
    {
        en = "The base percentage of damage that will be applied when hitting a target protected by armor. Once the armor is destroyed, the weapon damage applies at 100% to hitpoints. The actual damage done is modified by the skill used and the target hit."
        es = "El porcentaje base de daño que se aplicará al golpear a un objetivo protegido por armadura. Una vez que se destruye la armadura, el daño del arma se aplica al 100% de los puntos de vida. El daño real causado se modifica según la habilidad utilizada y el objetivo alcanzado."
    }
    {
        en = "Chance to hit head"
        es = "Prob. de acertar a la cabeza"
    }
    {
        en = "The base percentage chance to hit a target's head for increased damage. The final chance can be modified by the skill used."
        es = "El porcentaje base de probabilidad de golpear la cabeza de un objetivo para aumentar el daño. La oportunidad final puede verse modificada por la habilidad utilizada."
    }
    {
        en = "Initiative"
        es = "Iniciativa"
    }
    {
        en = "The higher this value, the earlier the position in the turn order. Initiative is reduced by the current fatigue, as well as any penalty to maximum fatigue (such as from heavy armor). In general, someone in light armor will act before someone in heavy armor, and someone fresh will act before someone fatigued."
        es = "Cuanto mayor sea este valor, más temprana será la posición en el orden de turno. La iniciativa se reduce por la fatiga actual, así como por cualquier penalización a la fatiga máxima (como la de una armadura pesada). En general, alguien con armadura ligera actuará antes que alguien con armadura pesada, y alguien fresco actuará antes que alguien fatigado."
    }
    {
        en = "Resolve"
        es = "Resolución"
    }
    {
        en = "Resolve represents the willpower and bravery of characters. The higher, the less likely that characters fall to lower morale states at negative events, and the more likely that characters gain confidence from positive events. Resolve also acts as defense against certain mental attacks that inflict panic, fear or mind control. See also: Morale."
        es = "La resolución representa la fuerza de voluntad y la valentía de los personajes. Cuanto más alto, es menos probable que los personajes caigan en estados de moral más bajos ante eventos negativos, y más probable es que los personajes ganen confianza a partir de eventos positivos. Resolución también actúa como defensa contra ciertos ataques mentales que causan pánico, miedo o control mental. Ver también: Moral"
    }
    {
        en = "Talent"
        es = "Talento"
    }
    {
        en = "UNDEFINED"
        es = "Alto nivel"
    }
    {
        en = "Higher Level"
        es = "Este personaje ya tiene experiencia en combate y comienza con un nivel superior."
    }
    {
        en = "This character already has experience in combat and starts with a higher level."
        es = "Desplácese por la pantalla moviendo el cursor del mouse hasta el borde de la pantalla."
    }
    {
        en = "Load Campaign"
        es = "Cargar campaña"
    }
    {
        en = "Load the selected campaign."
        es = "Carga la campaña seleccionada."
    }
    {
        en = "Return to the main menu."
        es = "Regresar al menú principal."
    }
    {
        en = "Delete Campaign"
        es = "Borrar campaña"
    }
    {
        // text = "[color=" + this.Const.UI.Color.NegativeValue + "]WARNING:[/color] Deletes the selected campaign without any further warning."
        mode = "pattern"
        en = "[color=<this.Const.UI.Color.NegativeValue>]WARNING:[/color] Deletes the selected campaign without any further warning."
        es = "[color=<this.Const.UI.Color.NegativeValue>]CUIDADO:[/color] Elimina la campaña seleccionada sin previo aviso."
    }
    {
        en = "Save Campaign"
        es = "Guardar campaña"
    }
    {
        en = "Save campaign at the selected slot."
        es = "Guarda la campaña en el espacio seleccionado."
    }
    {
        en = "Company Name"
        es = "Nombre de compañía"
    }
    {
        en = "The name your mercenary company will be known by throughout the lands."
        es = "Todas las crisis se elegirán aleatoriamente entre las siguientes opciones."
    }
    {
        en = "Map Seed"
        es = "Semilla del mapa"
    }
    {
        en = "A map seed is a unique string that determines how the world in your campaign will look like. You can see the seed of ongoing campaigns in the game menu accessible by pressing the Escape key, and then share it with friends to have them play in the same world."
        es = "Una semilla de mapa es una cadena única que determina cómo se verá el mundo en su campaña. Puedes ver la semilla de las campañas en curso en el menú del juego, al que se puede acceder presionando la tecla Esc, y luego compartirla con amigos para que jueguen en el mismo mundo."
    }
    {
        en = "Beginner Difficulty"
        es = "Dificultad principiante"
    }
    {
        en = "You'll face fewer and less challenging opponents, your men gain experience slightly faster, and retreating from battle is easier.\n\nYour men get a small bonus to hit chance, and the enemy gets a small penalty, to ease you into the game.\n\nRecommended for players new to the game."
        es = "Te enfrentarás a oponentes menos desafiantes y menos numerosos, tus hombres ganarán experiencia un poco más rápido y retirarse de la batalla será más fácil.\n\nTus hombres obtienen una pequeña bonificación a la probabilidad de acertar y el enemigo recibe una pequeña penalización para facilitarte la adaptación al juego.\n\nRecomendado para jugadores nuevos en el juego."
    }
    {
        en = "Veteran Difficulty"
        es = "Dificultad veterano"
    }
    {
        en = "Provides for a balanced playing experience that can be quite challenging.\n\nRecommended for veterans of the game or the genre."
        es = "Proporciona una experiencia de juego equilibrada que puede resultar bastante desafiante.\n\nRecomendado para veteranos del juego o del género."
    }
    {
        en = "Expert Difficulty"
        es = "Dificultad experto"
    }
    {
        en = "Your opponents will be more challenging and numerous.\n\nRecommended for experts in the game who want an even deadlier challenge."
        es = "Tus oponentes serán más desafiantes y numerosos.\n\nRecomendado para expertos en el juego que quieran un desafío aún más letal."
    }
    {
        en = "Contracts will pay more, and you'll be able to carry more resources at once.\n\nRecommended for players new to the game."
        es = "Cambia para ver las ventajas del personaje seleccionado actualmente.\n\nEl número entre llaves, si lo hay, es el número de puntos de habilidad disponibles."
    }
    {
        en = "Contracts will pay less, and deserters will take their equipment with them.\n\nRecommended for experts in the game who want more of a challenge managing the company's funds and supplies."
        es = "Los contratos pagarán menos y los desertores se llevarán su equipo.\n\nRecomendado para expertos en el juego que quieran un desafío mayor al administrar los fondos y suministros de la compañía."
    }
    {
        en = "High Starting Funds"
        es = "Fondos iniciales altos"
    }
    {
        en = "You'll start with more crowns and resources.\n\nRecommended for new players."
        es = "Comenzarás con más coronas y recursos.\n\nRecomendado para nuevos jugadores."
    }
    {
        en = "Medium Starting Funds"
        es = "Fondos iniciales medianos"
    }
    {
        en = "Recommended for a balanced experience."
        es = "Recomendado para una experiencia equilibrada."
    }
    {
        en = "Low Starting Funds"
        es = "Fondos iniciales bajos"
    }
    {
        en = "You'll start with fewer crowns and resources.\n\nRecommended for expert players."
        es = "Empezarás con menos coronas y recursos.\n\nRecomendado para jugadores expertos."
    }
    {
        en = "Starting Scenario"
        es = "Escenario inicial"
    }
    {
        en = "Choose how your company starts out in the world. Depending on your choice, you'll start with different men, equipment, resources, and special rules."
        es = "Elige cómo comienza tu compañía en el mundo. Dependiendo de tu elección, comenzarás con diferentes hombres, equipos, recursos y reglas especiales."
    }
    {
        en = "Ironman"
        es = "Hombre de Hierro (Ironman)"
    }
    {
        en = "Ironman mode disables manual saving. Only a single save will exist for the company, and the game is automatically saved during the game and on exiting it. Losing the whole company means losing the save. Recommended for the best experience once you've learned the game.\n\nNote that on weaker computers autosaves may result in the game pausing for a few seconds."
        es = "El modo Hombre de Hierro desactiva el guardado manual. Solo existirá un guardado para la compañía, y el juego se guarda automáticamente durante el juego y al salir del mismo. Perder toda la compañía significa perder el guardado. Recomendado para disfrutar de la mejor experiencia una vez que hayas aprendido el juego.\n\nTen en cuenta que, en computadoras más débiles, el guardado automático puede hacer que el juego se detenga durante unos segundos."
    }
    {
        en = "Unexplored Map"
        es = "Mapa inexplorado"
    }
    {
        en = "An optional way to play the game where the map is entirely unexplored and not visible to you at the start of your campaign. You'll have to discover everything on your own, which makes your campaign more difficult, but potentially also more exciting.\n\nRecommended only for experienced players that know what they're doing."
        es = "Una forma opcional de jugar donde el mapa está completamente inexplorado y no es visible para ti al comienzo de tu campaña. Tendrás que descubrirlo todo por tu cuenta, lo que hace que tu campaña sea más difícil, pero potencialmente también más emocionante.\n\nRecomendado solo para jugadores experimentados que saben lo que están haciendo."
    }
    {
        en = "Random Late Game Crisis"
        es = "Crisis aleatoria"
    }
    {
        en = "All crises will be randomly chosen between the options below."
        es = "Cambie la escala de la interfaz de usuario, es decir, menús y textos."
    }
    {
        en = "No Crisis"
        es = "Sin crisis"
    }
    {
        en = "There will be no late game crisis, and you can keep on playing the sandbox experience forever. Note that with this option selected, a significant part of the game's content and late game challenge won't be accessible. Not recommended for the best experience."
        es = "No habrá crisis al final del juego y podrás seguir jugando la experiencia de caja de arena para siempre. Tenga en cuenta que con esta opción seleccionada, no se podrá acceder a una parte importante del contenido del juego ni al desafío final del juego. No recomendado para la mejor experiencia."
    }
    {
        en = "Permanent Destruction"
        es = "Destrucción permanente"
    }
    {
        en = "Cities, towns and castles can be permanently destroyed during a late game crisis, and having the world go down in flames is one of the many ways you can lose your campaign."
        es = "Las ciudades, pueblos y castillos pueden quedar destruidos permanentemente durante una crisis tardía del juego, y hacer que el mundo se incendie es una de las muchas formas en que puedes perder tu campaña."
    }
    {
        en = "War"
        es = "Guerra de casas nobles"
    }
    {
        en = "The first late game crisis will be a ruthless war for power between noble houses. If you survive for long enough, the following ones will be chosen at random."
        es = "La primera crisis del final del juego será una guerra despiadada por el poder entre casas nobles. Si sobrevives el tiempo suficiente, las siguientes serán elegidas al azar."
    }
    {
        en = "Greenskin Invasion"
        es = "Invasión de Pieles Verdes"
    }
    {
        en = "The first late game crisis will be an invasion of greenskin hordes threatening to sweep away the world of man. If you survive for long enough, the following ones will be chosen at random."
        es = "La primera crisis del final del juego será una invasión de hordas de pieles verdes que amenazarán con arrasar el mundo del hombre. Si sobrevives el tiempo suficiente, las siguientes serán elegidas al azar."
    }
    {
        en = "Undead Scourge"
        es = "Plaga de No-muertos"
    }
    {
        en = "The first late game crisis will be the ancient dead arising again to take back what was once theirs. If you survive for long enough, the following ones will be chosen at random."
        es = "La primera crisis tardía del juego será cuando los antiguos muertos resurjan para recuperar lo que alguna vez fue suyo. Si sobrevives el tiempo suficiente, las siguientes serán elegidas al azar."
    }
    {
        en = "Holy War"
        es = "Guerra Santa"
    }
    {
        en = "The first late game crisis will be a holy war between northern and southern cultures. If you survive for long enough, the following ones will be chosen at random."
        es = "La primera crisis tardía del juego será una guerra santa entre las culturas del norte y del sur. Si sobrevives el tiempo suficiente, las siguientes serán elegidas al azar."
    }
    {
        en = "Depth of Field"
        es = "Profundidad de campo"
    }
    {
        en = "Enabling the Depth of Field effect will render height levels below the camera in tactical combat slightly out of focus (i.e. blurry), giving more of a miniature vibe and making it easier to differentiate heights, but potentially at the expense of some detail."
        es = "Habilitar el efecto de profundidad de campo hará que los niveles de altura debajo de la cámara en el combate táctico estén ligeramente desenfocados (es decir, borrosos), dando una sensación más de miniatura y facilitando la diferenciación de alturas, pero potencialmente a expensas de algunos detalles."
    }
    {
        en = "UI Scale"
        es = "Tamaño de interfaz"
    }
    {
        en = "Change the scale of the user interface, i.e. menus and texts."
        es = "La cantidad de oponentes actualmente en el campo de batalla."
    }
    {
        en = "Scene Scale"
        es = "Tamaño de escena"
    }
    {
        en = "Change the scale of the scene, i.e. everything that isn't the user interface, such as the characters shown on the battlefield."
        es = "Cambia la escala de la escena, es decir, todo lo que no sea la interfaz de usuario, como los personajes que se muestran en el campo de batalla."
    }
    {
        en = "Edge of Screen"
        es = "Borde de la pantalla"
    }
    {
        en = "Scroll the screen by moving the mouse cursor to the edge of the screen."
        es = "Mantenga siempre la cámara centrada en cualquier movimiento de la iA visible para usted."
    }
    {
        en = "Drag with Mouse"
        es = "Arrastrar con el ratón"
    }
    {
        en = "Scroll the screen by pressing the left mouse button and dragging it (default)."
        es = "Desplácese por la pantalla presionando el botón izquierdo del mouse y arrastrándolo (predeterminado)."
    }
    {
        en = "Use Hardware Cursor"
        es = "Usar cursor del sistema"
    }
    {
        en = "Using the hardware cursor minimizes input lag when moving the mouse in the game. Disable this if you experience problems with the mouse cursor."
        es = "El uso del cursor de hardware minimiza el retraso de entrada al mover el mouse en el juego. Desactívelo si tiene problemas con el cursor del ratón."
    }
    {
        en = "Use Hardware Sound"
        es = "Usar sonido del sistema"
    }
    {
        en = "Use hardware-accelerated sound playback for better performance. Disable this if you experience any issues related to sound."
        es = "Utilice la reproducción de sonido acelerada por hardware para obtener un mejor rendimiento. Desactívelo si experimenta algún problema relacionado con el sonido."
    }
    {
        en = "Always Focus AI Movement"
        es = "Enfoca siempre el movimiento de la IA"
    }
    {
        en = "Always have the camera centered on any AI movement visible to you."
        es = "Sube el nivel de la cámara para ver las partes más elevadas del mapa."
    }
    {
        en = "Auto-Adjust Height Levels"
        es = "Auto-ajustar niveles de altura"
    }
    {
        en = "Automatically adjust the camera's height level to see the currently active character in combat. Disabling this will prevent the camera from changing height levels when it isn't strictly necessary, but will also require manual adjustment of height levels when characters happen to be obstructed by terrain."
        es = "Ajusta automáticamente el nivel de altura de la cámara para ver el personaje actualmente activo en combate. Deshabilitar esto evitará que la cámara cambie los niveles de altura cuando no sea estrictamente necesario, pero también requerirá el ajuste manual de los niveles de altura cuando los personajes estén obstruidos por el terreno."
    }
    {
        en = "Always Show Hitpoint Bars"
        es = "Siempre mostrar barras de vida"
    }
    {
        en = "Always show bars for hitpoints and armor floating above characters in combat, as opposed to only when characters get hit."
        es = "Muestra siempre barras de puntos de vida y armaduras flotando sobre los personajes en combate, en lugar de solo cuando los personajes son golpeados."
    }
    {
        en = "Show Orientation Icons"
        es = "Mostrar iconos de orientación"
    }
    {
        en = "Show icons at the edges of your screen indicating the direction in which any characters currently outside the screen are on the map."
        es = "Muestra iconos en los bordes de la pantalla que indican la dirección en la que se encuentran en el mapa los personajes que se encuentran actualmente fuera de la pantalla."
    }
    {
        en = "Faster Player Movement"
        es = "Movimiento rápido de jugador"
    }
    {
        en = "Speed up the movement of any characters controlled by you in combat significantly. Does not affect movement-related skills."
        es = "Acelera significativamente el movimiento de cualquier personaje controlado por ti en combate. No afecta las habilidades relacionadas con el movimiento."
    }
    {
        en = "Faster AI Movement"
        es = "Movimiento rápido de la IA"
    }
    {
        en = "Speed up the movement of any characters controlled by the AI in combat significantly.  Does not affect movement-related skills."
        es = "Acelera significativamente el movimiento de cualquier personaje controlado por la IA en combate. No afecta las habilidades relacionadas con el movimiento."
    }
    {
        en = "Always and automatically loot everything found after combat once you close the loot screen - as long as you have the space to carry it."
        es = "Saquea siempre y automáticamente todo lo que encuentres después del combate una vez que cierres la pantalla de botín, siempre que tengas espacio para llevarlo."
    }
    {
        en = "Reset Equipment After Battle"
        es = "Restablecer el equipo inicial después de la batalla"
    }
    {
        en = "Automatically place equipment back into the inventory slot it was in before battle, if possible. For example, if a character starts battle with a crossbow, but changes to a pike during battle, they'll automatically have the crossbow in hand again when the battle is concluded."
        es = "Si es posible, coloca automáticamente el equipo nuevamente en la ranura del inventario en la que se encontraba antes de la batalla. Por ejemplo, si un personaje comienza la batalla con una ballesta, pero cambia a una pica durante la batalla, automáticamente tendrá la ballesta en la mano nuevamente cuando la batalla concluya."
    }
    {
        en = "Auto-Pause After Leaving City"
        es = "Pausa automática después de salir de la ciudad"
    }
    {
        en = "Automatically pause the game after leaving a city so that you don't waste any time - but at the expense of having to manually unpause each time."
        es = "Pausa automáticamente el juego después de salir de una ciudad para no perder tiempo, pero a costa de tener que reanudarlo manualmente cada vez."
    }
    {
        en = "Always Hide Trees"
        es = "Siempre esconder árboles"
    }
    {
        en = "Always render the top of trees and other large map objects semi-transparent, as opposed to only when they're actually occluding something."
        es = "Siempre haga semitransparentes las copas de los árboles y otros objetos grandes del mapa, en lugar de hacerlo solo cuando en realidad estén ocluyendo algo."
    }
    {
        en = "Auto-End Turns"
        es = "Finalizar turnos automáticamente"
    }
    {
        en = "Automatically end turns of characters controlled by you once you don't have any Action Points left to perform any action."
        es = "Finaliza automáticamente los turnos de los personajes controlados por ti una vez que no te queden puntos de acción para realizar ninguna acción."
    }
    {
        en = "Expands or retracts the Combat Event Log."
        es = "Expande o retrae el registro de eventos de combate."
    }
    {
        en = "Allies"
        es = "Aliados"
    }
    {
        en = "The number of Battle Brothers controlled by you and allies controlled by the AI on the battlefield."
        es = "La cantidad de hermanos de batalla controlados por ti y los aliados controlados por la IA en el campo de batalla."
    }
    {
        en = "Opponents"
        es = "Oponentes"
    }
    {
        en = "The number of opponents currently on the battlefield."
        es = "El número de rondas jugadas desde que comenzó la batalla."
    }
    {
        en = "Round"
        es = "Ronda"
    }
    {
        en = "The number of rounds played since the battle began."
        es = "Centra la cámara en el personaje que actúa actualmente."
    }
    {
        en = "Center Camera (Shift)"
        es = "Centar cámara (Shift)"
    }
    {
        en = "Center the camera on the currently acting character."
        es = "Baje el nivel de la cámara y oculte partes elevadas del mapa."
    }
    {
        en = "Toggle between showing and hiding red overlays that indicate tiles blocked with environmental objects (such as trees) that characters can not move onto."
        es = "Alterna entre mostrar y ocultar superposiciones rojas que indican mosaicos bloqueados con objetos ambientales (como árboles) a los que los personajes no pueden moverse."
    }
    {
        en = "Raise Camera Level (+)"
        es = "Elevar nivel de cámara (+)"
    }
    {
        en = "Raise camera level to see the more elevated parts of the map."
        es = "Alterna entre mostrar y ocultar árboles y otros objetos grandes en el mapa."
    }
    {
        en = "Lower Camera Level (-)"
        es = "Bajar nivel de cámara (-)"
    }
    {
        en = "Lower camera level and hide elevated parts of the map."
        es = "La cantidad de muertes que causó este personaje durante la batalla."
    }
    {
        en = "Toggle between showing and hiding armor and hitpoint bars, as well as status effect icons, ontop every visible character."
        es = "Alterna entre mostrar y ocultar armaduras y barras de puntos de vida, así como íconos de efectos de estado, encima de cada personaje visible."
    }
    {
        en = "Toggle between showing and hiding trees and other large objects on the map."
        es = "Finaliza el turno del personaje activo y haz que actúe el siguiente personaje de la fila."
    }
    {
        en = "Retreat from combat"
        es = "Retirarse del combate"
    }
    {
        en = "Retreat from combat and run for your lives. Better to fight another day than to die here pointlessly."
        es = "Retírate del combate y corre para salvar tu vida. Es mejor luchar otro día que morir aquí sin sentido."
    }
    {
        en = "You cannot retreat from this particular fight"
        es = "No puedes retirarte de esta pelea en particular."
    }
    {
        en = "Open Menu (Esc)"
        es = "Abrir menú (Esc)"
    }
    {
        en = "Open menu to adjust game options."
        es = "Deja el combate y regresa al mapa mundial."
    }
    {
        en = "End Turn (Enter, F)"
        es = "Finalizar turno (Enter, F)"
    }
    {
        en = "End the active character's turn and have the next character in line act."
        es = "Abre la pantalla del personaje y el inventario del hermano de batalla activo."
    }
    {
        en = "Wait Turn (Spacebar, End)"
        es = "Esperar turno (Espacio, End)"
    }
    {
        en = "Pause the active character's turn and move them to the end of the queue. Waiting this turn will also have you act later next round."
        es = "Pausa el turno del personaje activo y muévelo al final de la cola. Esperar este turno también te hará que actues más tarde en la siguiente ronda."
    }
    {
        en = "End Round (R)"
        es = "Terminar ronda (R)"
    }
    {
        en = "End the current round and have all your men skip their turn until the next round starts."
        es = "Finaliza la ronda actual y haz que todos tus hombres se salten su turno hasta que comience la siguiente ronda."
    }
    {
        en = "Open Inventory (I, C)"
        es = "Abrir inventario (I, C)"
    }
    {
        en = "Open the character screen and inventory for the active Battle Brother."
        es = "Saquea todos los objetos encontrados hasta que el alijo esté lleno."
    }
    {
        en = "Leave tactical combat and return to the world map."
        es = "Abre el menú para ajustar las opciones del juego."
    }
    {
        en = "Leveled Up"
        es = "Subida de nivel"
    }
    {
        en = "This character just leveled up! Find him in your roster, accessible on the worldmap, to raise his attributes and select a perk."
        es = "¡Este personaje acaba de subir de nivel! Encuéntralo en tu lista, accesible en el mapa mundial, para mejorar sus atributos y seleccionar una habilidad."
    }
    {
        en = "Light Wounds"
        es = "Heridas leves"
    }
    {
        en = "Light bruises, flesh wounds, loss of blood and similar that caused this character to lose hitpoints without impairing their abilities."
        es = "Contusiones leves, heridas superficiales, pérdida de sangre y similares que hicieron que este personaje perdiera puntos de vida sin afectar sus habilidades."
    }
    {
        // text = "Will heal in [color=" + this.Const.UI.Color.NegativeValue + "]" + entity.getDaysWounded() + "[/color] days"
        mode = "pattern"
        en = "Will heal in <ht.Min> days"
        es = "Sanará en <ht.Min> días"
    }
    {
        en = "Kills"
        es = "Muertes"
    }
    {
        en = "The number of kills this character had during the battle."
        es = "El número de enemigos que este personaje ha matado durante la batalla."
    }
    {
        en = "Experience Gained"
        es = "Experiencia obtenida"
    }
    {
        en = "The number of experience points gained during the battle from fighting and killing opponents. Gaining enough experience points will allow this man to level up, increase attributes and gain new perks."
        es = "La cantidad de puntos de experiencia obtenidos durante la batalla al luchar y matar oponentes. Obtener suficientes puntos de experiencia le permitirá a este hombre subir de nivel, aumentar atributos y obtener nuevas ventajas."
    }
    {
        en = "Damage Dealt"
        es = "Daño infligido"
    }
    {
        en = "The damage dealt by this character during battle, against hitpoints and against armor."
        es = "El daño infligido por este personaje durante la batalla, contra puntos de vida y contra armadura."
    }
    {
        // text = "Dealt [color=" + this.Const.UI.Color.PositiveValue + "]" + combatStats.DamageDealtHitpoints + "[/color] damage to hitpoints"
        mode = "pattern"
        en = "Dealt [color=<this.Const.UI.Color.PositiveValue>]<combatStats.DamageDealtHitpoints>[/color] damage to hitpoints"
        es = "Infligió [color=<this.Const.UI.Color.PositiveValue>]<combatStats.DamageDealtHitpoints>[/color] de daño a la armadura"
    }
    {
        // text = "Dealt [color=" + this.Const.UI.Color.PositiveValue + "]" + combatStats.DamageDealtArmor + "[/color] damage to armor"
        mode = "pattern"
        en = "Dealt [color=<this.Const.UI.Color.PositiveValue>]<combatStats.DamageDealtArmor>[/color] damage to armor"
        es = "Infligió [color=<this.Const.UI.Color.PositiveValue>]<combatStats.DamageDealtArmor>[/color] de daño a la armadura "
    }
    {
        en = "Damage Received"
        es = "Daño recibido"
    }
    {
        en = "The damage received by this character, split into damage to hitpoints and damage to armor. The value is after any possible damage reduction."
        es = "El daño recibido por este personaje se divide en daño a los puntos de vida y daño a la armadura. El valor es después de cualquier posible reducción de daños."
    }
    {
        // text = "Received [color=" + this.Const.UI.Color.NegativeValue + "]" + combatStats.DamageReceivedHitpoints + "[/color] hitpoint damage"
        mode = "pattern"
        en = "Received [color=<this.Const.UI.Color.NegativeValue>]<combatStats.DamageReceivedHitpoints>[/color] hitpoint damage"
        es = "Recibió [color=<this.Const.UI.Color.NegativeValue>]<combatStats.DamageReceivedHitpoints>[/color] de daño a los puntos de vida"
    }
    {
        // text = "Received [color=" + this.Const.UI.Color.NegativeValue + "]" + combatStats.DamageReceivedArmor + "[/color] armor damage"
        mode = "pattern"
        en = "Received [color=<this.Const.UI.Color.NegativeValue>]<combatStats.DamageReceivedArmor>[/color] armor damage"
        es = "Recibió [color=<this.Const.UI.Color.NegativeValue>]<combatStats.DamageReceivedArmor>[/color] de daño a la armadura"
    }
    {
        en = "Loot all Items"
        es = "Saquear todo"
    }
    {
        en = "Loot all items found until the stash is full."
        es = "Muestra sólo armas, herramientas ofensivas y accesorios."
    }
    {
        en = "Change Name & Title"
        es = "Cambiar nombre y título"
    }
    {
        en = "Click here to change the character's name and title."
        es = "Muestra sólo suministros, comida, tesoros y misceláneos."
    }
    {
        en = "Experience"
        es = "Experiencia"
    }
    {
        en = "Characters gain experience as they or their allies slay enemies in battles. If a character has accumulated sufficient experience, he'll level up and be able to increase his attributes and pick a perk that grants a unique bonus.\n\nBeyond the 11th character level, characters are veterans and will no longer gain perk points, but can still continue to improve."
        es = "Los personajes ganan experiencia a medida que ellos o sus aliados matan enemigos en batallas. Si un personaje ha acumulado suficiente experiencia, subirá de nivel y podrá aumentar sus atributos y elegir una habilidad pasiva o activa que le otorga una bonificación única.\n\nMás allá del nivel 11, los personajes son veteranos y ya no obtendrán puntos de habilidad, pero aún puede seguir mejorando."
    }
    {
        en = "Level"
        es = "Nivel"
    }
    {
        en = "The character's level measures experience in battle. Characters rise in levels as they gain experience and are able to increase their attributes and gain perks that make them better at the mercenary profession.\n\nBeyond the 11th character level, characters are veterans and will no longer gain perk points, but can still continue to improve."
        es = "El nivel del personaje mide la experiencia en batalla. Los personajes suben de nivel a medida que ganan experiencia y pueden aumentar sus atributos y obtener habilidades pasivas o activas que los hacen mejores en la profesión de mercenario.\n\nMás allá del nivel 11, los personajes son veteranos y ya no obtendrán puntos de habilidad, pero aún pueden seguir mejorando."
    }
    {
        en = "This character has leveled up. Increase his attributes and select a perk!"
        es = "Este personaje ha subido de nivel. ¡Aumenta sus atributos y selecciona una habilidad!"
    }
    {
        en = "Dismiss"
        es = "Despedir"
    }
    {
        en = "Dismiss this character from your roster to save daily wage and make room for someone else. Indebted characters will be freed from slavery and leave your company."
        es = "Elimina a este personaje de tu lista para ahorrar el salario diario y dejar espacio para alguien más. Los personajes endeudados serán liberados de la esclavitud y abandonarán tu compañía."
    }
    {
        en = "Switch to viewing the global stash of your mercenary company, or the ground beneath the currently selected character while in combat."
        es = "Cambia para ver el alijo global de tu compañía de mercenarios o el suelo debajo del personaje seleccionado actualmente mientras estás en combate."
    }
    {
        en = "Perks"
        es = "Habilidades"
    }
    {
        en = "Switch to viewing the perks of the currently selected character.\n\nThe number in braces, if any, is the number of available perk points."
        es = "Los contratos pagarán más y podrás llevar más recursos a la vez.\n\nRecomendado para jugadores nuevos en el juego."
    }
    {
        en = "Close (ESC)"
        es = "Cerrar (ESC)"
    }
    {
        en = "Close this screen."
        es = "Cerrar esta ventana."
    }
    {
        en = "Sort Items"
        es = "Ordenar artículos"
    }
    {
        en = "Sort items by type."
        es = "Ordenar artículos por tipo."
    }
    {
        en = "Filter items by type"
        es = "Filtrar artículos por tipos"
    }
    {
        en = "Show all items."
        es = "Mostrar todos los artículos."
    }
    {
        en = "Show only weapons, offensive tools and accessories."
        es = "Alterna entre mostrar y ocultar el estado de ánimo de tus hombres."
    }
    {
        en = "Show only armor, helmets and shields."
        es = "Muestra sólo armaduras, cascos y escudos."
    }
    {
        en = "Show only supplies, food, treasure and miscellaneous."
        es = "Establezca el tiempo para que transcurra normalmente."
    }
    {
        en = "Show only items usable in inventory mode, like paint or armor upgrades."
        es = "Bloquea o desbloquea la cámara para estar siempre centrado en tu compañía mercenaria."
    }
    {
        en = "Toggle between showing and hiding the mood of your men."
        es = "Establece que el tiempo pase más rápido de lo normal."
    }
    {
        en = "Start Battle"
        es = "Empezar batalla"
    }
    {
        en = "Start the battle using the selected equipment."
        es = "Comienza la batalla usando el equipo seleccionado."
    }
    {
        en = "Attribute Points"
        es = "Puntos de atributo"
    }
    {
        en = "Spend these points to increase any 3 out of 8 attributes per levelup by a random amount. A single attribute can only be increased once per levelup.\n\nStars mean that a character is especially talented with a specific attribute, resulting in consistently better dice rolls."
        es = "Gasta estos puntos para aumentar 3 de 8 atributos por nivel en una cantidad aleatoria. Un atributo solo se puede aumentar una vez por nivel.\n\nLas estrellas significan que un personaje tiene un talento especial con un atributo específico, lo que resulta en tiradas de dados consistentemente mejores."
    }
    {
        en = "Compensation"
        es = "Compensación"
    }
    {
        en = "Paying a compensation, gratuity or pension for the time spent with the company will allow the dismissed to leave with dignity and something to start a new life with, and it will prevent others in the company from reacting with anger over the dismissal.\n\nIndebted characters are paid reparations instead for their time with the company. Other indebted will appreciate it if you pay these, but no one will react with anger if you don't."
        es = "Pagar una compensación, gratificación o pensión por el tiempo pasado en la compañía permitirá que el despedido se vaya con dignidad y algo con qué empezar una nueva vida, y evitará que otros en la compañía reaccionen con ira ante el despido.\n\nLos personajes endeudados reciben compensaciones por su tiempo en la compañía. Otros endeudados apreciarán que los pagues, pero nadie reaccionará con ira si no lo haces."
    }
    {
        en = "Pause (Spacebar)"
        es = "Pausar el juego."
    }
    {
        en = "Pause the game."
        es = "Pausa (Espacio)"
    }
    {
        en = "Normal Speed (1)"
        es = "Velocidad normal (1)"
    }
    {
        en = "Set time to pass normally."
        es = "Velocidad rápida (2)"
    }
    {
        en = "Fast Speed (2)"
        es = "Contrato activo"
    }
    {
        en = "Set time to pass faster than normal."
        es = "Muestra detalles de tu contrato activo."
    }
    {
        en = "Very Fast Speed (3)"
        es = ""
    }
    {
        en = "Set time to pass even faster than normal. Use judiciously."
        es = ""
    }
    {
        en = "Active Contract"
        es = "Cancelar contrato"
    }
    {
        en = "Show details of your active contract."
        es = "Sal de esta pantalla y vuelve a la anterior."
    }
    {
        en = "Show Factions & Relations (R)"
        es = "Mostrar facciones y relaciones (R)"
    }
    {
        en = "See all factions known to you and your relation to them."
        es = "Vea todas las facciones que conoce y su relación con ellas."
    }
    {
        en = "Center Camera (Return, Shift)"
        es = "Centrar cámara (Return, Shift)"
    }
    {
        en = "Move the camera to center and zoom in on your mercenary company."
        es = "Mueve la cámara al centro y haz zoom en tu compañía mercenaria."
    }
    {
        en = "Toggle Lock Camera (X)"
        es = "Alternar bloquear cámara (X)"
    }
    {
        en = "Lock or unlock the camera to always be centered on your mercenary company."
        es = "El número de días que el personaje sirvió en la empresa hasta su fallecimiento."
    }
    {
        en = "Toggle Tracking Footprints (F)"
        es = "Alternar seguimiento de huellas (F)"
    }
    {
        en = "Show or hide the footprints left by other parties roaming the world so you can follow or avoid them more easily."
        es = "Muestra u oculta las huellas dejadas por otros grupos que deambulan por el mundo para que puedas seguirlas o evitarlas más fácilmente."
    }
    {
        en = "Camp (T)"
        es = "Acampar (T)"
    }
    {
        en = "Make or break camp. While encamped, time will go faster and your men will heal and repair their equipment at a faster rate. However, you're also more vulnerable to being caught in a surprise attack."
        es = "Hacer o deshacer el campamento. Mientras estés acampado, el tiempo pasará más rápido y tus hombres curarán y repararán su equipo a un ritmo más rápido. Sin embargo, también eres más vulnerable a quedar atrapado en un ataque sorpresa."
    }
    {
        // text = "[color=" + this.Const.UI.Color.NegativeValue + "]Unable to camp while travelling with other parties[/color]"
        mode = "pattern"
        en = "[color=<this.Const.UI.Color.NegativeValue>]Unable to camp while travelling with other parties[/color]"
        es = "[color=<this.Const.UI.Color.NegativeValue>]No se puede acampar mientras se viaja con otros grupos[/color]"
    }
    {
        en = "Retinue (P)"
        es = "Séquito (P)"
    }
    {
        en = "See your retinue of non-combat followers that grant various advantages outside combat, and upgrade your cart for more inventory space."
        es = "Vea su séquito de seguidores fuera del combate que otorgan diversas ventajas fuera del combate y actualice su carrito para obtener más espacio en el inventario."
    }
    {
        en = "Obituary (O)"
        es = "Obituario (O)"
    }
    {
        en = "See the obituary which lists those who have fallen in service to the company since you took command."
        es = "Vea el obituario que enumera aquellos que han caído al servicio de la compañía desde que asumió el mando."
    }
    {
        en = "Open menu to save or load your game, adjust game options or quit the campaign and return to the main menu."
        es = "Abre el menú para guardar o cargar tu juego, ajustar las opciones del juego o salir de la campaña y volver al menú principal."
    }
    {
        en = "Cancel Contract"
        es = "Contratar recluta"
    }
    {
        en = "Cancel the current contract."
        es = "Cancelar el contrato actual."
    }
    {
        en = "The character's name."
        es = "El nombre del personaje."
    }
    {
        en = "Days"
        es = "Días"
    }
    {
        en = "The number of days that the character served in the company until their demise."
        es = "El número de muertes que el personaje ocasionó en la batalla hasta su muerte."
    }
    {
        en = "Battles"
        es = "Batallas"
    }
    {
        en = "The number of battles that the character fought in until their demise."
        es = "El número de batallas en las que luchó el personaje hasta su muerte."
    }
    {
        en = "The number of kills that the character scored in battle until their demise."
        es = "Un flechero que ofrece todo tipo de armamento a distancia elaborado por expertos."
    }
    {
        en = "Demise"
        es = "Fallecimiento"
    }
    {
        en = "How the character ultimately died."
        es = "Cómo murió finalmente el personaje."
    }
    {
        en = "Leave and return to the world map."
        es = "Rasgos del personaje desconocidos"
    }
    {
        en = "Contract available"
        es = "Contrato disponible"
    }
    {
        en = "Someone is looking to hire mercenaries."
        es = "Alguien está buscando contratar mercenarios."
    }
    {
        en = "The terms of this contract have been negotiated. All that's left is for you to sign it."
        es = "Los términos de este contrato han sido negociados. Lo único que queda es que lo firmes."
    }
    {
        en = "You already have a contract!"
        es = "¡Ya tienes contrato!"
    }
    {
        en = "You can only have one contract active at a time. Contract offers will remain while you fulfill your current contract, as long as the problem doesn't go away in the meantime."
        es = "Sólo puedes tener un contrato activo a la vez. Las ofertas de contrato permanecerán mientras cumplas con tu contrato actual, siempre y cuando el problema no desaparezca mientras tanto."
    }
    {
        en = "Contracts locked"
        es = "Contratos bloqueados"
    }
    {
        en = "Only contracts by the noble house owning this fortification are available here, but they don't recognize you as worthy of their attention. Increase your renown and fulfill the ambition of noble houses to take notice of the company in order to unlock new contracts!"
        es = "Aquí sólo están disponibles los contratos de la casa noble propietaria de esta fortificación, pero no te reconocen como digno de su atención. ¡Aumenta tu renombre y cumple la ambición de las casas nobles de prestar atención a la compañía para desbloquear nuevos contratos!"
    }
    {
        en = "Hire new men for your mercenary company. The quality and quantity of volunteers depends on the size and type of settlement, as well as your reputation here. Every few days, new people will arrive, and others will travel on."
        es = "Contrata nuevos hombres para tu compañía mercenaria. La calidad y cantidad de voluntarios depende del tamaño y tipo de asentamiento, así como de tu reputación aquí. Cada pocos días llegará gente nueva y otros seguirán viajando."
    }
    {
        en = "A large tavern filled with patrons from all over the lands, offering beverages, food and a lively atmosphere in which to share news and rumors."
        es = "Una gran taberna llena de clientes de todas partes del país, que ofrece bebidas, comida y un ambiente animado en el que compartir noticias y rumores."
    }
    {
        en = "A refuge from the harsh world outside. You can seek healing here for your wounded and pray for salvation of your eternal soul."
        es = "Un refugio del duro mundo exterior. Puedes buscar aquí la curación de tus heridos y orar por la salvación de tu alma eterna."
    }
    {
        en = "A meeting point for those of the fighting profession. Have your men train with and learn from experienced fighters here, so you can mold them faster into hardened mercenaries."
        es = "Un punto de encuentro para los profesionales de la lucha. Haz que tus hombres entrenen y aprendan de luchadores experimentados aquí, para que puedas convertirlos más rápido en mercenarios endurecidos."
    }
    {
        en = "For the right price, a taxidermist can create useful items from all kinds of trophies you bring him."
        es = "Por el precio justo, un taxidermista puede crear objetos útiles a partir de todo tipo de trofeos que le lleves."
    }
    {
        en = "A kennel where strong and fast dogs are bred for war."
        es = "Una perrera donde se crían perros fuertes y rápidos para la guerra."
    }
    {
        en = "Customize the appearance of your men at the barber. Have their hair cut and their beards trimmed or buy dubious potions to lose weight."
        es = "Personaliza la apariencia de tus hombres en la barbería. Córtate el pelo, recorta la barba o compra dudosas pociones para adelgazar."
    }
    {
        en = "A fletcher offering all kinds of expertly crafted ranged weaponry."
        es = "Un alquimista que ofrece artilugios exóticos y bastante peligrosos por una buena suma."
    }
    {
        en = "An alchemist offering exotic and quite dangerous contraptions for a tidy sum."
        es = "Dale al recluta seleccionado una prueba adecuada para revelar sus rasgos ocultos, si los hay."
    }
    {
        en = "The arena offers an opportunity to earn gold and fame in fights that are to the death, and in front of crowds that cheer for the most gruesome manner in which lives are dispatched."
        es = "La arena ofrece la oportunidad de ganar oro y fama en peleas a muerte y frente a multitudes que aplauden la forma más espantosa en la que se despachan las vidas."
    }
    {
        en = "No more matches take place here today. Come back tomorrow!"
        es = "Hoy no se disputarán más peleas aquí. ¡Vuelve mañana!"
    }
    {
        en = "You cannot fight in the arena while contracted to do other work"
        es = "No puedes pelear en la arena mientras estás contratado para realizar otro trabajo."
    }
    {
        en = "You need at least 5 empty inventory slots to fight in the ongoing tournament"
        es = "Necesitas al menos 5 espacios de inventario vacíos para luchar en el torneo en curso."
    }
    {
        en = "You need at least 3 empty inventory slots to fight in the arena"
        es = "Necesitas al menos 3 espacios de inventario vacíos para luchar en la arena."
    }
    {
        en = "A harbor that serves both foreign trading ships and local fishermen. You'll likely be able to book passage by sea to other parts of the continent here."
        es = "Un puerto que sirve tanto a barcos mercantes extranjeros como a pescadores locales. Es probable que aquí puedas reservar pasajes por mar a otras partes del continente."
    }
    {
        en = "You cannot use the harbor while contracted to escort a caravan"
        es = "No puedes utilizar el puerto mientras estés contratado para escoltar una caravana."
    }
    {
        en = "A lively market offering all sorts of goods common in the region. New wares will be on offer every few days, and when trading caravans reach this settlement."
        es = "Un mercado animado que ofrece todo tipo de productos comunes en la región. Se ofrecerán nuevos productos cada pocos días y cuando las caravanas comerciales lleguen a este asentamiento."
    }
    {
        en = "A weapon smith's workshop displaying all kinds of well crafted weapons. Damaged equipment can also be repaired here for a price."
        es = "Un taller de herrería que exhibe todo tipo de armas bien elaboradas. Los equipos dañados también se pueden reparar aquí por un precio."
    }
    {
        en = "This armorer's workshop is the right place to look for well-made and durable protection. Damaged equipment can also be repaired here for a price."
        es = "El taller de este armero es el lugar adecuado para buscar una protección duradera y bien hecha. Los equipos dañados también se pueden reparar aquí por un precio."
    }
    {
        en = "Leave this screen and return to the previous one."
        es = "Contrata al recluta seleccionado y haz que se una a tu lista."
    }
    {
        en = "Hire Recruit"
        es = "Probar recluta"
    }
    {
        en = "Hire the selected recruit and have him join your roster."
        es = "Reserva un pasaje para su empresa y viaje rápido al destino seleccionado."
    }
    {
        en = "Try Out Recruit"
        es = "Salir de la tienda"
    }
    {
        en = "Give the selected recruit a proper tryout to reveal his hidden character traits, if any."
        es = "Este personaje puede tener rasgos desconocidos. Puedes pagar una prueba para revelarlos."
    }
    {
        en = "Unknown Character Traits"
        es = "Filtrar artículos por tipo"
    }
    {
        en = "This character may have unknown traits. You can pay for a tryout to reveal these."
        es = "Paga la tarifa indicada y entrega los componentes necesarios para recibir a cambio el artículo elaborado."
    }
    {
        en = "Craft"
        es = "Elaborar"
    }
    {
        en = "Pay the indicated fee, and hand over the necessary components, to receive the crafted item in return."
        es = "Muestra solo elementos que se pueden utilizar en el modo inventario, como mejoras de pintura o armadura."
    }
    {
        en = "Travel"
        es = "Viajar"
    }
    {
        en = "Book passage for your company and fast travel to the selected destination."
        es = "Sal de la partida y regresa al menú principal. El progreso no guardado se perderá."
    }
    {
        en = "Leave Shop"
        es = "Pelea de entrenamiento"
    }
    {
        en = "Sparring Fight"
        es = "Haz que tu hombre participe en una pelea con oponentes experimentados y varios estilos de lucha. Los moretones recogidos y las lecciones aprendidas darán como resultado [color=<this.Const.UI.Color.PositiveValue>]+50%[/color] ganancia de experiencia para la próxima batalla."
    }
    {
        // text = "Have your man participate in a sparring fight with experienced opponents and various fighting styles. The bruises collected and lessons learned will result in [color=" + this.Const.UI.Color.PositiveValue + "]+50%[/color] Experience Gain for the next battle."
        mode = "pattern"
        en = "Have your man participate in a sparring fight with experienced opponents and various fighting styles. The bruises collected and lessons learned will result in [color=<this.Const.UI.Color.PositiveValue>]+50%[/color] Experience Gain for the next battle."
        es = "Haz que tu hombre aprenda valiosas lecciones y conocimientos de un verdadero veterano del oficio. El conocimiento impartido dará como resultado [color=<this.Const.UI.Color.PositiveValue>]+35%[/color] ganancia de experiencia durante tres batallas."
    }
    {
        en = "Veteran's Lessons"
        es = "Lecciones de veteranos"
    }
    {
        // text = "Have your man learn valuable lessons and insights from a true veteran of the trade. The knowledge imparted will result in [color=" + this.Const.UI.Color.PositiveValue + "]+35%[/color] Experience Gain for the duration of three battles."
        mode = "pattern"
        en = "Have your man learn valuable lessons and insights from a true veteran of the trade. The knowledge imparted will result in [color=<this.Const.UI.Color.PositiveValue>]+35%[/color] Experience Gain for the duration of three battles."
        es = "Haz que tu hombre se someta a un riguroso régimen de entrenamiento para convertirlo en un luchador experto. La sangre y el sudor gastados hoy lo beneficiarán a largo plazo con [color=<this.Const.UI.Color.PositiveValue>]+20%[/color] ganancia de experiencia durante cinco batallas."
    }
    {
        en = "Rigorous Schooling"
        es = "Enseñanza rigurosa"
    }
    {
        // text = "Have your man undergo a rigorous training regimen to shape him into a skilled fighter. The blood and sweat spent today will benefit him in the long run with [color=" + this.Const.UI.Color.PositiveValue + "]+20%[/color] Experience Gain for the duration of five battles."
        mode = "pattern"
        en = "Have your man undergo a rigorous training regimen to shape him into a skilled fighter. The blood and sweat spent today will benefit him in the long run with [color=<this.Const.UI.Color.PositiveValue>]+20%[/color] Experience Gain for the duration of five battles."
        es = "El nombre con el que se conocerá a tu compañía mercenaria en todo el continente (RECOMENDACIÓN: pon un artículo antes del nombre, ya que la traducción fue hecha pensando en que el nombre llevaría uno, Ej: \x22Los Segundos Hijos\x22, \x22Los Centinelas del Alba\x22, \x22La Escuela del Lobo\x22)."
    }
    {
        en = "Quit Game"
        es = "Salir del juego"
    }
    {
        en = "Quit this game and return to the main menu. Your progress here will not be saved."
        es = "TODO"
    }
    {
        en = "Relations"
        es = "Relaciones"
    }
    {
        en = "Your relations with a faction determine whether they'll fight or deal peacefully with you, their willingness to hire you for contracts, as well as the prices they give you and the number of recruits available to you at their settlements.\n\nRelations increase when working successfully for factions, and decrease on failing to do so, betraying or attacking them. Over time, relations slowly trend back towards neutral."
        es = "Tus relaciones con una facción determinan si lucharán o negociarán pacíficamente contigo, su disposición a contratarte para contratos, así como los precios que te darán y la cantidad de reclutas disponibles para ti en sus asentamientos.\n\nLas relaciones aumentan cuando trabajas con éxito para las facciones, y disminuye cuando no logras hacerlo, los traicionas o los atacas. Con el tiempo, las relaciones tienden lentamente a volverse neutrales."
    }
    {
        en = "A mercenary company has to carry a lot of equipment and supplies. By using carts and wagons, you can expand your available inventory space and carry even more."
        es = "Una compañía mercenaria tiene que transportar una gran cantidad de equipo y suministros. Al utilizar carros y carretas, puede ampliar el espacio de inventario disponible y transportar aún más."
    }
    {
        // text = this.Const.Strings.InventoryUpgradeHeader[this.World.Retinue.getInventoryUpgrades()] + " for [img]gfx/ui/tooltips/money.png[/img]" + this.Const.Strings.InventoryUpgradeCosts[this.World.Retinue.getInventoryUpgrades()]
        mode = "pattern"
        en = "<this.Const.Strings.InventoryUpgradeHeader[this.World.Retinue.getInventoryUpgrades()]> for [img]gfx/ui/tooltips/money.png[/img]<this.Const.Strings.InventoryUpgradeCosts[this.World.Retinue.getInventoryUpgrades()]>"
        es = "<this.Const.Strings.InventoryUpgradeHeader[this.World.Retinue.getInventoryUpgrades()]> por [img]gfx/ui/tooltips/money.png[/img]<this.Const.Strings.InventoryUpgradeCosts[this.World.Retinue.getInventoryUpgrades()]>"
    }
    {
        en = "The free Lindwurm DLC adds a challenging new beast, a new player banner, as well as a new famed armor, helmet and shield."
        es = "El DLC gratuito \x22Lindwurm\x22 agrega una nueva bestia desafiante, un nuevo estandarte de jugador, así como una nueva armadura, casco y escudo famosos."
    }
    {
        // ret[1].text += "\n\n[color=" + this.Const.UI.Color.PositiveValue + "]This DLC has been installed.[/color]";
        mode = "pattern"
        en = "\n\n[color=<this.Const.UI.Color.PositiveValue>]This DLC has been installed.[/color]"
        es = "\n\n[color=<this.Const.UI.Color.PositiveValue>]Este DLC ha sido instalado.[/color]"
    }
    {
        // ret[1].text += "\n\n[color=" + this.Const.UI.Color.NegativeValue + "]This DLC is missing. It\'s available for free on Steam and GOG![/color]";
        mode = "pattern"
        en = "\n\n[color=<this.Const.UI.Color.NegativeValue>]This DLC is missing. It's available for free on Steam and GOG![/color]"
        es = "\n\n[color=<this.Const.UI.Color.NegativeValue>]Falta este DLC. ¡Está disponible gratis en Steam y GOG![/color]"
    }
    {
        en = "Open store page in browser"
        es = "Abrir la página de la tienda en el navegador"
    }
    {
        en = "Beasts & Exploration"
        es = "Bestias y Exploración"
    }
    {
        en = "The Beasts & Exploration DLC adds a variety of new beasts roaming the wilds, a new crafting system to create items from trophies, legendary locations with unique rewards to discover, many new contracts and events, a new system of armor attachments, new weapons, armor and usable items, and more."
        es = "El DLC \x22Beasts & Exploration\x22 (Bestias y Exploración) agrega una variedad de nuevas bestias que deambulan por la naturaleza, un nuevo sistema de creación para crear elementos a partir de trofeos, ubicaciones legendarias con recompensas únicas para descubrir, muchos contratos y eventos nuevos, un nuevo sistema de accesorios de armadura, nuevas armas, armaduras, artículos utilizables, y más."
    }
    {
        // ret[1].text += "\n\n[color=" + this.Const.UI.Color.NegativeValue + "]This DLC is missing. It\'s available for purchase on Steam and GOG![/color]";
        mode = "pattern"
        en = "\n\n[color=<this.Const.UI.Color.NegativeValue>]This DLC is missing. It's available for purchase on Steam and GOG![/color]"
        es = ""
    }
    {
        en = "Warriors of the North"
        es = "Guerreros del Norte"
    }
    {
        en = "The Warriors of the North DLC adds a new human faction of northern barbarians with their own fighting style and equipment, different starting scenarios for your company, new nordic and rus inspired equipment, as well as new contracts and events."
        es = "El DLC \x22Warriors of the North\x22 (Guerreros del Norte) agrega una nueva facción humana de bárbaros del norte con su propio estilo de lucha y equipo, diferentes escenarios iniciales para tu compañía, nuevo equipo inspirado en los nórdicos y rusos, así como nuevos contratos y eventos."
    }
    {
        en = "Blazing Deserts"
        es = "Desiertos Abrasadores"
    }
    {
        en = "The Blazing Deserts DLC adds a new desert region to the south inspired by medieval Arabic and Persian cultures, a new late game crisis involving a holy war, a retinue of non-combat followers with which to customize your company, alchemical contraptions and primitive firearms, new human and beastly opponents, new contracts and events, and more."
        es = "El DLC \x22Blazing Deserts\x22 (Desiertos Abrasadores) añade una nueva región desértica al sur inspirada en las culturas medievales árabe y persa, una nueva crisis tardía que involucra una guerra santa, la posibilidad de tener un séquito de seguidores no combatientes con los que personalizar tu compañía, artilugios alquímicos, armas de fuego primitivas, nuevos oponentes humanos y bestiales, nuevos contratos y eventos, y más."
    }
    {
        en = "Of Flesh and Faith"
        es = "De Carne y Fe"
    }
    {
        en = "The free Of Flesh and Faith DLC adds two new and very unique origins for you to play as: The Anatomists and the Oathtakers. In addition, there's two new banners, new equipment, new backgrounds to hire and lots of new events."
        es = "El DLC gratuito \x22Of Flesh and Faith\x22 (De Carne y Fe) agrega dos orígenes nuevos y únicos para que juegues como: Los Anatomistas y los Juramentados. Además, hay dos nuevos estandartes, nuevos equipos, nuevos trasfondos para contratar y muchos eventos nuevos."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\ui\screens\world\modules\topbar\world_screen_topbar_ambition_module.nut
    {
        en = "Cancelling an ambition will allow you to choose a new one, but it will also leave your men disappointed in you as a leader.\n\nAre you sure you want to cancel?"
        es = "Cancelar una ambición te permitirá elegir una nueva, pero también dejará a tus hombres decepcionados de ti como líder.\n\n¿Estás seguro de que deseas cancelarla?"
    }
