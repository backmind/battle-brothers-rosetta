        es = "Tiene un accesorio de armadura que puede ser reemplazado, pero será destruido en el proceso."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\armor_upgrades\barbarian_horn_upgrade.nut
    {
        en = "Horn and Bone"
        es = "Cuerno y hueso"
    }
    {
        en = "The ceremonial adornment of a self-proclaimed barbarian king. The rare and durable horns act as an suprisingly effective armor."
        es = "El adorno ceremonial de un autoproclamado rey bárbaro. Los raros y duraderos cuernos actúan como una armadura sorprendentemente eficaz."
    }
    {
        en = "This armor has been adorned with ceremonial horns by barbarian craftsmen."
        es = "Esta armadura ha sido adornada con cuernos ceremoniales por artesanos bárbaros."
    }
    {
        // text = "[color=" + this.Const.UI.Color.PositiveValue + "]+40[/color] Durability"
