        es = "[color=<this.Const.UI.Color.PositiveValue>]+40[/color] Durabilidad"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\armor_upgrades\bone_platings_upgrade.nut
    {
        en = "Bone Plating"
        es = "Placas de hueso"
    }
    {
        en = "Crafted from strong but surprisingly light bones, these ornate platings make for an ablative armor to be worn ontop of regular armor."
        es = "Elaborados a partir de huesos fuertes pero sorprendentemente ligeros, estos revestimientos ornamentados crean una armadura ablativa que se puede usar sobre una armadura normal."
    }
    {
        en = "A layer of ornate bone plates is attached to this armor."
        es = "Una capa de placas de hueso ornamentadas está adherida a esta armadura."
    }
    {
        en = "Completely absorbs the first hit of every combat encounter which doesn't ignore armor"
        es = "Absorbe completamente el primer golpe de cada combate que no ignore la armadura"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\armor_upgrades\direwolf_pelt_upgrade.nut
    {
        en = "Direwolf Pelt Mantle"
        es = "Manto de piel de lobo huargo"
    }
    {
        en = "Pelts taken from ferocious direwolves, cured and sewn together to be worn as a beast hunter's trophy around the neck. Donning the skin of a beast like this can turn one into an imposing figure."
        es = "Pieles tomadas de feroces lobos huargos, curadas y cosidas para ser usadas como trofeo de cazador de bestias alrededor del cuello. Ponerse la piel de una bestia como esta puede convertir a uno en una figura imponente."
    }
    {
        en = "A mantle of direwolf pelts has been attached to this armor, which transforms the wearer into an imposing figure."
        es = "A esta armadura se le ha añadido un manto de piel de lobo huargo, que transforma al portador en una figura imponente."
