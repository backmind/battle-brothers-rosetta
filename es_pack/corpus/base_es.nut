        en = "Disloyal"
        es = "Desleal"
    }
    {
        en = "I have to put myself first! This character is rather disloyal and will be fast to leave should you ever run out of crowns or provisions."
        es = "¡Tengo que ponerme a mí primero! Este personaje es bastante desleal y se marchará rápidamente si alguna vez te quedas sin coronas o provisiones."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\traits\drunkard_trait.nut
