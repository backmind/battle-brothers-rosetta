        es = "Se echará a perder en [color=<this.Const.UI.Color.NegativeValue>]<this.getSpoilInDays()>[/color] días."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\supplies\goat_cheese_item.nut
    {
        en = "Goat Cheese"
        es = "Queso de cabra"
    }
    {
        en = "Provisions. Goat cheese is a tasty and rich food that is common and popular especially in the colder regions of the north."
        es = "Provisiones. El queso de cabra es un alimento rico y sabroso, común y popular especialmente en las regiones más frías del norte."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\supplies\ground_grains_item.nut
    {
        en = "Ground Grains"
        es = "Cereales molidos"
    }
    {
        en = "Provisions. Various kinds of grounded grain that will be cooked up with water or milk for a daily meal. It is satiating but tasteless."
        es = "Provisiones. Diversos tipos de cereales y granos molidos que se cocinarán con agua, leche o miel para la comida diaria. Es saciante pero insípido."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\supplies\mead_item.nut
    {
        en = "Mead"
        es = "Aguamiel"
    }
    {
        en = "Provisions. An alcoholic beverage made from honey. Both durable and tasty while also being much safer to drink than unpurified water."
        es = "Provisiones. Bebida alcohólica elaborada a base de miel. Es duradero y sabroso, además de ser mucho más seguro para beber que el agua sin purificar."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\supplies\medicine_item.nut
    {
        en = "Medical Supplies"
        es = "Suministros médicos"
    }
    {
        // text = "A good [color=" + this.Const.UI.Color.PositiveValue + "]" + this.m.Amount + "[/color] units of herbs, salves, bandages and the like to help your mercenaries recover from injuries sustained in battle. Will be added to your global stock once you\'re back on the worldmap."
        mode = "pattern"
        en = "A good [color=<this.Const.UI.Color.PositiveValue>]<this.m.Amount>[/color] units of herbs, salves, bandages and the like to help your mercenaries recover from injuries sustained in battle. Will be added to your global stock once you're back on the worldmap."
        es = "Unas buenas [color=<this.Const.UI.Color.PositiveValue>]<this.m.Amount>[/color] unidades de hierbas, ungüentos, vendajes y similares para ayudar a tus mercenarios a recuperarse de las lesiones sufridas en batalla. Se agregará a tu stock global una vez que regreses al mapa mundial."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\supplies\money_item.nut
