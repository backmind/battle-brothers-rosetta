        en = "Mouldered"
        es = "Agrietada"
    }
    {
        en = "This armor has been exposed to the elements for a long time. Leather is falling apart, cloth is rotten, metal is rusty and perforated."
        es = "Esta armadura ha estado expuesta a los elementos durante mucho tiempo. El cuero se está desmoronando, la tela está podrida, el metal está oxidado y perforado."
