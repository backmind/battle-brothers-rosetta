        es = "<this.World.FactionManager.getFaction(this.m.Faction).addPlayerRelation(this.Const.World.Assets.RelationContractCancel, Romper un contrato)>"
    }
    {
        en = "[img]gfx/ui/events/event_45.png[/img]\x7bYou took far too long to complete the patrol you've been tasked with. Consider the contract failed. | A man in the employ of %employer% approaches with a notice. It states that your patrol was meant to be quick, not a merry little walk for yourself. Consider the contract failed. | What were you trying to do, collect as many heads as possible? It's doubtful that your employer, %employer%, would buy such a ruse. There's a reason he only gave you a few days to complete this task. Consider it failed.\x7d"
        es = "[img]gfx/ui/events/event_45.png[/img]\x7bHas tardado demasiado en completar la patrulla que te encomendaron. Considera el contrato fallido. | Un hombre al servicio de %employer% se acerca con una notificación. Indica que tu patrulla debía ser rápida, no un agradable paseo para ti. Considera el contrato fallido. | ¿Qué estabas intentando hacer? ¿Recolectar la mayor cantidad de cabezas posible? Es dudoso que tu empleador, %employer%, crea esa excusa. Hay una razón por la que solo te dio unos pocos días para completar esta tarea. Considera el contrato fallido.\x7d"
    }
    {
        en = "Damn this contract!"
        es = "¡Maldito sea este contrato!"
    }
