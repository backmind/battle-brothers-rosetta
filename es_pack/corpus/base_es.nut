        en = "Grazed Eye Socket"
        es = "Cuenca del ojo rozada"
    }
    {
        en = "A blow grazed and ripped the tissue close to the eye, causing it to fill with blood and swell shut."
        es = "Un golpe rozó y desgarró el tejido cercano al ojo, lo que provocó que se llenara de sangre y se cerrara con hinchazón."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\injury\grazed_kidney_injury.nut
    {
        en = "Grazed Kidney"
        es = "Riñón rozado"
    }
    {
        en = "Abdominal pain, blood in the urine and always the danger of infection. A grazed kidney is a severe risk to the life of any character, draining their constitution."
        es = "Dolor abdominal, sangre en la orina y siempre peligro de infección. Un riñón rozado supone un grave riesgo para la vida de cualquier personaje, agotando su constitución."
