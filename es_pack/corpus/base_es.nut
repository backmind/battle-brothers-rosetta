        en = "Lorekeeper's Rib Bone"
        es = "Costilla del Cronista"
    }
    {
        en = "This character has had part of the Lorekeeper's skeleton fused into their body, and as a result possesses the ability to rapidly recover when delivered seemingly fatal wounds. Now if they could just make it through the night without screaming in their sleep..."
        es = "Este personaje ha tenido parte del esqueleto del Cronista fusionado en su cuerpo y, como resultado, posee la capacidad de recuperarse rápidamente cuando recibe heridas aparentemente mortales. Ahora, si tan solo pudiera pasar la noche sin gritar en sueños..."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\effects\nachzehrer_potion_effect.nut
    {
        en = "Hyperactive Tissue Growth"
        es = "Crecimiento hiperactivo del tejido"
    }
    {
        en = "This character's body has mutated to regrow skin and muscle tissue much more quickly than normal. Deep injuries heal much faster than normal as a result. They also seem to have developed a strong taste for red meat, but that's probably unrelated."
        es = "El cuerpo de este personaje ha mutado para que la piel y el tejido muscular vuelvan a crecer mucho más rápido de lo normal. Como resultado, las lesiones profundas sanan mucho más rápido de lo normal. También parecen haber desarrollado un fuerte gusto por la carne roja, pero probablemente eso no esté relacionado."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\effects\necromancer_potion_effect.nut
    {
        en = "Visions"
        es = "Visiones"
    }
    {
        en = "This character has strange visions of things that have been and things to come. While less than cheery around the campfire, it does seem to give them a certain ability to connect and internalize new experiences faster."
        es = "Este personaje tiene extrañas visiones de cosas que han sido y de lo que está por venir. Si bien no son muy alegres alrededor de la fogata, parece darles cierta capacidad para conectarse e internalizar nuevas experiencias más rápido."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\effects\necrosavant_potion_effect.nut
    {
        en = "Parasitic Blood"
        es = "Sangre parásita"
    }
    {
        en = "This character's body has the incredible ability to incorporate different blood types - or indeed, blood from entirely different creatures - into itself. This grants them remarkable healing via absorption of blood through skin pores (or more dramatically by drinking it directly)."
        es = "El cuerpo de este personaje tiene la increíble habilidad de incorporar diferentes tipos de sangre, o incluso sangre de criaturas completamente diferentes - a sí mismo. Esto le otorga una notable capacidad de curación mediante la absorción de sangre a través de los poros de la piel (o de manera más dramática al beberla directamente)."
    }
    {
        // this.Tactical.EventLog.log(this.Const.UI.getColorizedEntityName(actor) + " heals for " + this.Math.min(actor.getHitpointsMax() - actor.getHitpoints(), hitpointsHealed) + " points");
        mode = "pattern"
        en = "<actor:str_tag> heals for <hp:int> points"
        es = "<actor> sana <hp> puntos de vida"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\effects\net_effect.nut
    {
        en = "Trapped in Net"
        es = "Atrapado en una red"
    }
    {
        en = "A large net holds this character in place and hampers their ability to defend themself. To break free, the net will have to be cut."
        es = "Una gran red mantiene a este personaje en su lugar y obstaculiza su capacidad para defenderse. Para liberarse, habrá que cortar la red."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\effects\night_vision_effect.nut
    {
        en = "Night Vision"
        es = "Visión Nocturna"
    }
    {
        en = "Thanks to an alchemical marvel, the night is as bright as day for this character."
        es = "Gracias a una maravilla alquímica, la noche es tan luminosa como el día para este personaje."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\effects\nightmare_effect.nut
    {
        en = "Died in his sleep"
        es = "Murió mientras dormía"
    }
    {
        // return "This character is consumed by unnatural nightmares and is unable to act. As the horrors eat away at his sanity, he\'ll take [color=" + this.Const.UI.Color.PositiveValue + "]" + this.getDamage() + "[/color] damage based on his resolve each turn. The character can be forcibly awoken from these nightmares by a nearby ally, but he won\'t wake up on his own.";
