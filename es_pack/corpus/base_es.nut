        es = "Fanático de Davkul"
    }
    {
        en = "This character is a fanatic follower of Davkul, believing that Davkul embraces man in death."
        es = "Este personaje es un seguidor fanático de Davkul, creyendo que Davkul abraza al hombre en la muerte."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\traits\cultist_prophet_trait.nut
    {
        en = "Prophet of Davkul"
        es = "Profeta de Davkul"
    }
    {
        en = "This character is a prophet of Davkul, the fleshen conduit of his will and the earthen voice speaking his truth. Other believers listen to his every word and feel compelled to go above and beyond their physical limits on his behest."
        es = "Este personaje es un profeta de Davkul, el conducto carnal de su voluntad y la voz terrenal que dice su verdad. Otros creyentes escuchan cada una de sus palabras y se sienten obligados a ir más allá de sus límites físicos por orden suya."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\traits\cultist_zealot_trait.nut
    {
        en = "Zealot of Davkul"
        es = "Zelote de Davkul"
    }
    {
        en = "This character is a zealous follower of Davkul, so much so that he has come to embrace physical pain as bringing him closer to salvation."
        es = "Este personaje es un celoso seguidor de Davkul, hasta el punto de que ha llegado a aceptar el dolor físico como algo que lo acerca a la salvación."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\traits\dastard_trait.nut
    {
        en = "Dastard"
        es = "Canalla"
    }
    {
        en = "This character will turn tail on the first possible occasion. Better have an eye on him!"
        es = "Este personaje dará media vuelta en la primera ocasión posible. ¡Será mejor que le eches un ojo!"
    }
    {
        en = "the Chicken"
        es = "el Gallina"
    }
    {
        en = "Will start combat at wavering morale"
        es = "Comenzará la batalla con moral 'Vacilante'"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\traits\deathwish_trait.nut
    {
        en = "Deathwish"
        es = "Temerario"
    }
    {
        en = "I'm not dead yet! This character doesn't care about receiving injuries and will fight on regardless."
        es = "¡No estoy muerto aún! A este personaje no le importa recibir lesiones y seguirá luchando de todos modos."
    }
    {
        en = "the Fearless"
        es = "el Intrépido"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\traits\determined_trait.nut
    {
        en = "Determined"
        es = "Determinado"
    }
    {
        en = "Don't worry, I got this. This character shows a formidable amount of self-confidence."
        es = "No te preocupes, puedo con esto. Este personaje muestra una cantidad formidable de confianza en sí mismo."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\traits\dexterous_trait.nut
    {
        en = "Dexterous"
        es = "Diestro"
    }
    {
        en = "A dexterous character has an easier time hitting his opponent in melee."
        es = "A un personaje diestro le resultará más fácil golpear a su oponente cuerpo a cuerpo."
