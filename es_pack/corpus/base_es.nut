        es = "Tiene un [color=<this.Const.UI.Color.DamageValue>]33%[/color] de probabilidades de afectar a los adyacentes a la misma altura o altura inferior"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\tools\daze_bomb_item.nut
