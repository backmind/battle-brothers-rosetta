    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\injury\cut_leg_muscles_injury.nut
    {
        en = "Cut Leg Muscles"
        es = "Músculos de la pierna cortados"
    }
    {
        en = "A cut into the muscles of the leg makes any quick and sudden movements impossible."
        es = "Un corte en los músculos de la pierna imposibilita cualquier movimiento rápido y repentino."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\injury\cut_throat_injury.nut
    {
        en = "Cut Neck Vein"
        es = "Vena de la garganta cortada"
    }
    {
        en = "A vein on the throat has been cut, leading to massive hemorrhaging and ultimately death if not treated out of combat. If survived, it is followed by a period of severely lowered constitution due to loss of blood, and will leave a menacing scar."
        es = "Le han cortado una vena en la garganta, lo que provoca una hemorragia masiva y, en última instancia, la muerte si no se trata fuera de combate. Si se sobrevive, le seguirá un período de constitución gravemente debilitada debido a la pérdida de sangre y dejará una cicatriz amenazadora."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\injury\deep_abdominal_cut_injury.nut
    {
        en = "Deep Abdominal Cut"
        es = "Corte abdominal profundo"
    }
    {
        en = "A deep cut at the abdomen has injured the muscle and makes it painful to move or even stand upright, reducing the constitution of this character."
        es = "Un corte profundo en el abdomen ha lesionado el músculo y hace que sea doloroso moverse o incluso mantenerse erguido, reduciendo la constitución de este personaje."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\injury\deep_chest_cut_injury.nut
    {
        en = "Deep Chest Cut"
        es = "Corte profundo en el torso"
    }
    {
        en = "A deep, bleeding cut into the chest and pectoral muscle makes it hard to keep standing, let alone use a weapon."
        es = "Un corte profundo y sangrante en el pecho y el músculo pectoral dificulta mantenerse de pie, y mucho menos usar un arma."
