    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\tools\player_banner.nut
    {
        en = "A company standard to take into battle. Held high, allies will rally around it with renewed resolve, and enemies will know well who is about to crush them."
        es = "Un estandarte de la compañía para llevar a la batalla. Si se mantiene en alto, los aliados se unirán a su alrededor con renovada determinación, y los enemigos sabrán bien quién está a punto de aplastarlos."
    }
    {
        en = "Polearm, Two-Handed"
