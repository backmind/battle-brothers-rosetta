        es = "Maza con púas a dos manos"
    }
    {
        en = "A huge club fitted with a skull for good measure. Receiving a blow from this weapon will leave anyone dazed and gasping for air, no matter their armor."
        es = "Un garrote enorme equipado con una calavera, por si acaso. Recibir un golpe de esta arma dejará a cualquiera aturdido y sin aliento, sin importar su armadura."
