    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\contracts\contracts\arena_contract.nut
    {
        en = "The Arena"
        es = "La Arena"
    }
    {
        en = "Equip up to three of your men with arena collars"
        es = "Equipa a hasta tres de tus hombres con collares de la arena"
    }
    {
        en = "Enter the arena again to start the fight"
        es = "Ingresa nuevamente a la arena para comenzar la pelea"
    }
    {
        en = "The fight will be to the death and you won't be able to retreat or loot afterwards"
        es = "La pelea será a muerte y no podrás retirarte ni saquear después"
    }
    {
        // "Get " + this.Contract.m.Payment.getOnCompletion() + " crowns for your victory"
        mode = "pattern"
        en = "Get <n:int> crowns for your victory"
        es = "Obtendrás <n> coronas por tu victoria"
    }
    {
        en = "Win a piece of gladiator gear"
        es = ""
    }
    {
        en = "Task"
        es = ""
    }
    {
        en = "Overview"
        es = ""
    }
    {
        en = "Running"
        es = ""
    }
    {
        en = "Success"
        es = ""
    }
    {
        en = "Failure1"
        es = ""
    }
    {
        en = "At the Arena"
        es = "En la Arena"
    }
    {
        en = "\x7bWe shall turn the sand red with blood! | I want to hear the crowd chant our names! | We'll slaughter them like lambs!\x7d"
        es = "\x7b¡Convertiremos la arena en un mar de sangre roja! | ¡Quiero escuchar a la multitud corear nuestros nombres! | ¡Los masacraremos como corderos!\x7d"
    }
    {
        en = "\x7bThis isn't what I had in mind. | I'll sit this one out. | I'll wait for the next fight.\x7d"
        es = "\x7bEsto no es lo que tenía en mente. | Me abstendré de pelear esta. | Esperaré a la próxima pelea.\x7d"
    }
    {
        en = "[img]gfx/ui/events/event_155.png[/img]Dozens of men mingle about the arena's entrance. Some stand stoically, not wishing to give any hint of their capabilities. Others, however, boast and brag with aplomb, either sincerely confident in their martial skills or hoping their bravado masks any holes in their game.\n\n"
        es = "[img]gfx/ui/events/event_155.png[/img]Docenas de hombres se mezclan cerca de la entrada de la arena. Algunos permanecen estoicos, sin querer dar ninguna pista de sus habilidades. Otros, en cambio, presumen y fanfarronean con aplomo, ya sea sinceramente confiados en sus habilidades marciales o esperando que su bravuconería oculte cualquier debilidad.\n\n"
    }
    {
        en = "A grizzled man, the master of the arena, holds up a scroll and taps it with a hook for a hand."
        es = "Un hombre curtido, el Maestro de la Arena, sostiene un pergamino y lo golpea con el garfio que le hace de mano."
    }
    {
        en = "Enter the arena again to start the fight against one Swordmaster"
        es = "Ingresa nuevamente a la arena para comenzar la pelea contra un Maestro de la Espada."
    }
    {
        en = "Enter the arena again to start the fight against one Swordmaster and %amount% raiders"
        es = "Ingresa nuevamente a la arena para comenzar la pelea contra un Maestro de la Espada y %amount% saqueadores."
    }
    {
        en = "%SPEECH_ON%They put a star beside his name, the mark of the Gilder. That means his path is a gilded one. What you need to know is that he is a swordmaster. You may find some comfort in that he is an elder man, but you'd not be the first I have said that to, understand? May your path be as Gilded, because this swordmaster's certainly was.%SPEECH_OFF%"
        es = "%SPEECH_ON%Le pusieron una estrella junto a su nombre, la marca del Dorado. Eso significa que su camino es un sendero empedrado en oro. Lo que necesitas saber es que es un maestro de la espada. Puede que encuentres cierto consuelo en que es un hombre mayor, pero no serías el primero a quien se lo he dicho, ¿entiendes? Que tu camino sea dorado, porque ciertamente el del maestro de la espada lo fue.%SPEECH_OFF%"
    }
    {
        en = "Enter the arena again to start the fight against one Hedge Knight"
        es = "Ingresa nuevamente a la arena para comenzar la pelea contra un Caballero Errante."
    }
    {
        en = "Enter the arena again to start the fight against one Hedge Knight and %amount% raiders"
        es = "Ingresa nuevamente a la arena para comenzar la pelea contra un Caballero Errante y %amount% saqueadores."
    }
    {
        en = "%SPEECH_ON%I believe northerners refer to him as a 'hate knight.' Might have that wrong. Don't tell the other arena masters I said this about northern trash, but this knight is one of the most dangerous men I've seen come through here and if you wish your path to continue being gilded then I suggest you make sharp preparations and get a good rest before the fight.%SPEECH_OFF%"
        es = "%SPEECH_ON%Creo que los del norte lo llaman un 'caballero del odio'. Puede que me equivoque. No le digas a los otros maestros de la arena que dije esto sobre la basura del norte, pero este caballero es uno de los hombres más peligrosos que he visto pasar por aquí, y si deseas que tu camino continúe siendo dorado, te sugiero que te prepares bien y descanses antes de la pelea.%SPEECH_OFF%"
    }
    {
        en = "Enter the arena again to start the fight against one Blade Dancer"
        es = "Ingresa nuevamente a la arena para comenzar la pelea contra un Bailarín de Espadas."
    }
    {
        en = "Enter the arena again to start the fight against one Blade Dancer and %amount% nomads"
        es = "Ingresa nuevamente a la arena para comenzar la pelea contra un Bailarín de Espadas y %amount% nómadas"
    }
    {
        en = "The arena master holds up a scroll and taps it with a hook for a hand.%SPEECH_ON%A blade dancer of the nomad tribes is on the docket. Now, he might look a bit foppish, but to get the title of 'blade dancer' you must be as articulate with the blade as a bird is with the wind. Dancing expertise is optional, but they're all pretty good at that, too.%SPEECH_OFF%"
        es = "El Maestro de la Arena sostiene un pergamino y lo golpea con el garfio que le hace de mano.%SPEECH_ON%En la lista está un Bailarín de Espadas de las tribus nómadas. Puede que parezca un poco extravagante, pero para obtener el título de 'bailarín de espadas' debes ser tan hábil con la espada como un ave lo es con el viento. La destreza en la danza es opcional, pero todos son bastante buenos en eso también.%SPEECH_OFF%"
    }
    {
        en = "Enter the arena again to start the fight against %amount% ifrits"
        es = "Ingresa nuevamente a la arena para comenzar la pelea contra %amount% Ifrits."
    }
    {
        en = "%SPEECH_ON%There's nothing on the page because I fear the desert's wrath if I dare to illuminate its most ferocious presence. You're fighting %number% ifrits. I do not know how they managed to get them here, I just know it was the doing of alchemists. If you ask me, I'd rather you fight them than the ifrits.%SPEECH_OFF%"
        es = "%SPEECH_ON%No hay nada escrito en la página porque temo la ira del desierto si me atrevo a revelar su presencia. Estarás luchando contra %number% Ifrits. No sé cómo lograron traerlos aquí, solo sé que fue obra de alquimistas. Si me preguntas, prefiero que luches contra ellos en lugar de los Ifrits.%SPEECH_OFF%"
    }
    {
        en = "Enter the arena again to start the fight against %amount% nachzehrers"
        es = "Ingresa nuevamente a la arena para comenzar la pelea contra %amount% Nachzehrers."
    }
    {
        en = "%SPEECH_ON%The alchemists call them, well, I can't even pronounce it. My tongue simply cannot shape itself to the word for it requires specialized northern lexicography and I've no time to narrow northern verbiage in a fruitless matter of mundane minutiae. Do I look like a phonetician to you? Let's just call them 'gnashslashers.' They're ghoulish cretins, it's %number% of them, and I've seen them eat men alive, so you'd best hope the Gilder is watching - I don't think He'll have any light for you in the belly of one of those beasts!%SPEECH_OFF%"
        es = "%SPEECH_ON%Los alquimistas los llaman... bueno, ni siquiera puedo pronunciarlo. Mi lengua simplemente no puede dar forma a esa palabra, requiere un conocimiento del lexico norteño y no tengo tiempo para farfullar un vocabulario barbaro en una cuestión de minucias mundanas. ¿Acaso parezco un foneticista? Digamos que los llamaremos 'gnashslashers'. Son criaturas espeluznantes, hay %number% de ellos, y los he visto devorar hombres vivos, así que es mejor que esperes que el Dorado te esté observando. No creo que Él tenga luz para ti en el vientre de una de esas bestias.%SPEECH_OFF%"
    }
    {
        en = "Enter the arena again to start the fight against one unhold"
        es = "Ingresa nuevamente a la arena para comenzar la pelea contra un Trol"
    }
    {
        en = "Enter the arena again to start the fight against %amount% unholds"
        es = "Ingresa nuevamente a la arena para comenzar la pelea contra %amount% Trols"
    }
    {
        en = "%SPEECH_ON%You're against %number% of what the northern scum refer to as an 'unhold.' The Vizier pays a proper pile of coin to get them here, and the masses love the giant bastards. They do a good job smashing fighters and, on occasion, heaving a warrior clear into the crowds. It's quite wonderful. I think some of the unholds even learn to enjoy it the longer they stay here, like they learn what spurs the mob to cheers and jeer. The brutality is something else. Anyway, may the Gilder watch over you.%SPEECH_OFF%"
        es = "%SPEECH_ON%Te enfrentarás a %number% de lo que la escoria del norte llama un 'Unhold', trol o gigante. El Visir paga una buena cantidad de monedas para traerlos aquí, y a las masas les encantan esos gigantescos retorcidos. Hacen un buen trabajo destrozando a los luchadores e incluso en ocasiones lanzando a un guerrero directamente entre la multitud. Es realmente maravilloso. Creo que algunos de los trols incluso aprenden a disfrutarlo mientras más tiempo permanecen aquí, como si supieran qué anima a la multitud a aplaudir o abuchear. La brutalidad es algo sin igual. En fin, que el Dorado te proteja.%SPEECH_OFF%"
    }
    {
        en = "Enter the arena again to start the fight against %amount% nomads"
        es = "Ingresa nuevamente a la arena para comenzar la pelea contra %amount% nómadas"
    }
    {
        en = "%SPEECH_ON%Your opponents will be %number% recently retired desert bandits. And by retired, I mean taken by the Vizier's lawmen, of course. No bandit willingly steps foot in here, haghaghagh!%SPEECH_OFF%"
        es = "%SPEECH_ON%Tus oponentes serán %number% bandidos del desierto recién retirados. Y por retirados, quiero decir capturados por los agentes del Visir, por supuesto. Ningún bandido pone voluntariamente un pie aquí dentro, ¡jojojojo!%SPEECH_OFF%"
    }
    {
        en = "Enter the arena again to start the fight against %amount% gladiators"
        es = "Ingresa nuevamente a la arena para comenzar la pelea contra %amount% gladiadores"
    }
    {
        en = "%SPEECH_ON%Well, heh, the Gilder must have a sense of humor. You'll be facing %number% gladiators. May your path be ever Gilded, but to be honest, I said that to the gladiators. And I've been saying it to them every day. Understand? You should prepare to the best of your abilities.%SPEECH_OFF%"
        es = "%SPEECH_ON%Bueno, jeje, el Dorado debe tener un sentido del humor. Te enfrentarás a %number% gladiadores. Que tu camino siempre sea dorado, pero para ser honesto, también se lo dije a los gladiadores. Y se lo he estado diciendo todos los días. ¿Entiendes? Deberías prepararte lo mejor que puedas.%SPEECH_OFF%"
    }
    {
        en = "Enter the arena again to start the fight against %amount% webknechts"
        es = "Ingresa nuevamente a la arena para comenzar la pelea contra %amount% Webknechts"
    }
    {
        en = "%SPEECH_ON%That is not a fig tree, it's a spider. The alchemists, bless their learned hearts, call them webknechts which is a silly northern name, in truth they're spiders. Unfortunately for you a boot will not be sufficient this time around for %number% of them.%SPEECH_OFF%"
        es = "%SPEECH_ON%Esa no es una planta retocida, es una araña. Los alquimistas, benditos sean sus sabios corazones, los llaman webknechts, que es un nombre tonto del norte, en realidad son arañas. Desafortunadamente para ti, una bota no será suficiente esta vez contra %number% de ellas.%SPEECH_OFF%"
    }
    {
        en = "Enter the arena again to start the fight against %amount% serpents"
        es = "Ingresa nuevamente a la arena para comenzar la pelea contra %amount% serpientes"
    }
    {
        en = "%SPEECH_ON%What do you mean you don't understand? Huh, it's just a squiggly line? No. Look, this is its tail, and that's the head. It's a snake. You're fighting %number% snakes. 'Serpents' the alchemists like to call them, but if I wanted to draw a serpent I'd just draw an alchemist haghaghagh!%SPEECH_OFF%"
        es = "%SPEECH_ON%¿Qué quieres decir con que no entiendes? ¿Eh? ¿Solo ves una línea ondulada? No. Mira, esto es la cola, y eso es la cabeza. Es una serpiente. Estarás luchando contra %number% serpientes. A los alquimistas les gusta escribir la palabra 'serpiente', pero yo creo que es más fácil dibujarlas. Aunque si quisiera dibujar una víbora de verdad, simplemente dibujaría a un alquimista, ¡jojojo!%SPEECH_OFF%"
    }
    {
        en = "Enter the arena again to start the fight against %amount% hyenas"
        es = "Ingresa nuevamente a la arena para comenzar la pelea contra %amount% hienas"
    }
    {
        en = "%SPEECH_ON%Hyenas. Heeheehee. Hyenas. %numberC% of the giggling mutts, to be exact. Good luck, and may the Gilder watch over you.%SPEECH_OFF%"
        es = "%SPEECH_ON%Hienas. Jejeje. Hienas. %numberC% de esos perros risueños, para ser exactos. Buena suerte, y que el Dorado te proteja.%SPEECH_OFF%"
    }
    {
        en = "Enter the arena again to start the fight against %amount% frenzied hyenas"
        es = "Ingresa nuevamente a la arena para comenzar la pelea contra %amount% hienas frenéticas"
    }
    {
        en = "Enter the arena again to start the fight against one lindwurm"
        es = "Ingresa nuevamente a la arena para comenzar la pelea contra un Lindwurm"
    }
    {
        en = "Enter the arena again to start the fight against two lindwurms"
        es = "Ingresa nuevamente a la arena para comenzar la pelea contra dos Lindwurms"
    }
    {
        en = "%SPEECH_ON%Your opponent is a... a... what is this? A worm? It's green. Never seen a worm that col- oh! A wyrm! No wait, 'wurm.' Wurm? A lindwurm! I gots'ta be honest with ya, I don't know what the hell this is, but I imagine our dear matchmakers won't be having you fightin' a worm of the regular sort. Or maybe they is. Maybe they'll just have ye eat it for our entertainment. Maybe they ain't matchmakers, but tastemakers! Herghgheeagghheeehoogh. Ha.%SPEECH_OFF%"
        es = "%SPEECH_ON%Tu oponente es... ¿un qué? ¿Un gusano? Es verde. Nunca he visto un gusano de ese color... ¡oh! ¡Un wyrm! No, espera, wurm. ¿Wurm? ¡Un lindwurm! Debo ser honesto contigo, no sé qué demonios es esto, pero imagino que nuestros queridos emparejadores no te harán pelear contra un simple gusano. O tal vez sí lo harán. ¡Quizás te lo hagan comer para nuestro entretenimiento! ¡Tal vez no sean emparejadores, sino creadores de sabores! ¡Muajajajajajaja!. Ais.%SPEECH_OFF%"
    }
    {
        en = "Enter the arena again to start the fight against %amount% mercenaries"
        es = "Ingresa nuevamente a la arena para comenzar la pelea contra %amount% mercenarios"
    }
    {
        en = "%SPEECH_ON%Crownlings like you have ventured down from the north. Up there, they call them 'sellswords.' Hagh! What sort of attempt at poetry is that? Don't they know not every man even uses a sword? They ain't the brightest up there. That's why I like it in the south. The sun is bright, and thus so are we.%SPEECH_OFF%"
        es = "%SPEECH_ON%'Buscadores de fortuna' como tú han venido desde el norte. Allá arriba, los llaman 'espadas a sueldo'. Ja. ¿Qué tipo de intento de poesía es este? ¿No saben que no todos los hombres usan espada? No son los más brillantes allá arriba. Por eso me gusta el sur. El sol es brillante, y por ende, también lo somos nosotros.%SPEECH_OFF%"
    }
    {
        en = "Enter the arena again to start the fight against %champion1% and %amount% gladiators"
        es = "Ingresa nuevamente a la arena para comenzar la pelea contra %champion1% y %amount% gladiadores"
    }
    {
        en = "%SPEECH_ON%Recognize this face? There's a reason the artists spent time on this here pamphlet and then handed them out to every set of eyes settin' in those seats upstairs. It's %champion1%, one of the greatest fighters in this land. Maybe some day they'll make yer face look so pretty, if the Vizier could ever find someone so talented to salvage, well, whatever ye got there between the ears, hegheghegh.%SPEECH_OFF%"
        es = "%SPEECH_ON%¿Reconoces esta cara? Hay una razón por la que los artistas dedicaron tiempo a este panfleto y luego los reparten a cada par de ojos que están sentados en esos asientos de arriba. Es %champion1%, uno de los mejores luchadores de estas tierras. Tal vez algún día hagan que tu cara luzca tan bonita, si el Visir puede encontrar a alguien tan talentoso para sacar algo de, bueno, lo que sea que tengas ahí entre oreja y oreja, ¡jajajaja!%SPEECH_OFF%"
    }
    {
        en = "Enter the arena again to start the fight against %champion1% and %amount% mercenaries"
        es = "Ingresa nuevamente a la arena para comenzar la pelea contra %champion1% y %amount% mercenarios."
    }
    {
        en = "Enter the arena again to start the fight against %champion1% and %amount% nomads"
        es = "Ingresa nuevamente a la arena para comenzar la pelea contra %champion1% y %amount% nómadas"
    }
    {
        en = "He pauses.%SPEECH_ON%We expect important guests for this bout, so everything is set up for you to die proper bloody this time, got it? And if you can't do that, then have your lot dispatch their opponents in the most spectacular way to please the crowd. Do that, and I'll hand you a proper piece of gladiator gear ontop of the coin.%SPEECH_OFF%"
        es = "Se detiene.%SPEECH_ON%Esperamos invitados importantes para esta pelea, así que todo está preparado para que mueras de manera adecuadamente sangrienta esta vez, ¿entendido? Y si no puedes hacer eso, entonces haz que tu grupo derrote a sus oponentes de la manera más espectacular para complacer a la multitud. Hazlo, y te entregaré un auténtico equipo de gladiador además de las monedas.%SPEECH_OFF%"
    }
    {
        en = "He points to some strange looking collars and continues.%SPEECH_ON%When you're ready, put these on the three men who'll be doing the fighting. This lets us know who to take into the pits. Anyone not wearing these will not be allowed in, not you, not the Vizier, dare I say even the Gilder may be turned down.%SPEECH_OFF%"
        es = "Señala unos collares de aspecto extraño y continúa.%SPEECH_ON%Cuando estéis listos, colocad estos collares en los tres hombres que participarán en la pelea. Esto nos permitirá saber a quiénes llevar a las fosas. Cualquier persona que no lleve uno de estos collares no será permitida entrar, ni tú, ni el Visir, me atrevo a decir que incluso el Dorado podría ser rechazado.%SPEECH_OFF%"
    }
    {
        en = "This arena fight works as follows. Do you agree to the terms?"
        es = "Esta pelea de arena funciona de la siguiente manera. ¿Estás de acuerdo con los términos?"
    }
    {
        en = "I accept."
        es = "Acepto."
    }
    {
        en = "I'll have to think it over."
        es = "Tendré que pensarlo."
    }
    {
        en = "Start"
        es = ""
    }
    {
        en = "[img]gfx/ui/events/event_155.png[/img]\x7bAs you wait your turn, the crowd's bloodlust crawls through the dark, sheets of dust falling from above, the stomps of feet thunderous. They murmur in anticipation, and roar at killings. The quiet between battles is mere moments, and this silence is snatched away as the rusted gate lurches upward, chains rankling, the crowd abuzz once more. You step out into the light and so thunderous is the noise against your heart it could surely yet spur a dead man forth... | The arena's crowd is shoulder to shoulder, most blathering drunk. They scream and shout, their languages a mix of local and foreign, though the appeal to their bloodlust needs little articulation beyond their maddened faces and pumping fists. Now, the %companyname%'s men will satiate these mad fools... | Cleaners hurry about the arena. They drag away the bodies, collect what's worth collecting, and occasionally throw a trophy into the crowds, eliciting a moblike rendition of the arena's battles in the stands themselves. The %companyname% is now a part of this affair. | The arena awaits, the crowd alight, and the %companyname%'s turn to gain glory is at hand! | The crowd booms as the %companyname%'s men stride into its bloody pit. Despite the mindless bloodlust of the peoples, you can't help but feel a beat of pride in your chest, knowing that it is your company ready to put on a show. | The gate rises. Nothing is heard save the rattle of chains, the creak of pulleys, the grunts of slaves at work. When the men of the %companyname% step out of the arena's bowels they can hear the crunch of sand underfoot until they come to stand in the center of the pit. A strange voice screams from the tops of the stadium, some lost language beyond your knowing, but the words echo just once before the crowd erupts with cheers and roaring. Now is the time your men shall prove themselves before the watchful eye of the commoner. | The %companyname%'s business is rarely done before the eyes of those who would prefer themselves distantly separated from such violence. But in the arena, the commoner greedily awaits death and suffering, and it growls with bloodlust as your men enter the pits, and roars as the sellswords draw their weapons and ready for battle. | The arena is shaped like the pit of some sore, its ceiling torn away by the gods, revealing the vanity, bloodlust, and savagery of man. And it is man there, yelling and screaming, and if the blood sprays hit them, they wash their faces in the gore and grin at one another as though it were a joke. They fight one another for trophies and relish in the pain of others. And it is before these peoples that the %companyname% will fight, and for them they shall entertain and entertain well. | The arena's crowd is a mash of classes, rich and poor, for only the Viziers separate themselves out into stations above all. Briefly unified, the peoples of %townname% have graciously come together to watch men and monsters murder one another. With pleasure, the %companyname% seeks to do its part. | Boys sitting on the shoulders of fathers, young girls throwing flowers to the gladiators, women fanning themselves, men wondering if they could do it. These are the peoples of the arena - and the rest are all drunk out of their gourd and screaming nonsense. You hope the %companyname% can contribute to at least an hour or two to entertaining this mad lot. | The crowd roars as the %companyname%'s men step into the pit. One would be dumb to confuse excitement for desire, for as soon as the applause ends there is a smattering of empty beer mugs and rotten tomatoes and the general giggling delight of those watching the matter. You wonder if the %companyname%'s men are really best spent here, but then think hard on the gold and glory to be won, and that at the end of the day these mongrels in the stands will go home to their shit lives, and you'll go home to your shit life as well, but at least your pockets will be a bit deeper.\x7d"
        es = "[img]gfx/ui/events/event_155.png[/img]\x7bMientras esperas tu turno, notas las láminas de polvo cayendo desde arriba por los estruendosos golpes de pies, como si la sed de sangre de la multitud se arrastrara en la oscuridad. Murmuran en anticipación y rugen ante las muertes. El silencio entre las batallas dura apenas un momento, y este silencio es arrebatado cuando la puerta oxidada se levanta, las cadenas chirriando, la multitud zumbando una vez más. Sales a la luz y el estruendo es tan atronador contra tu corazón que seguramente podría impulsar a un hombre muerto... | La multitud de la arena está hombro con hombro, la mayoría de ellos embriagados y balbuceantes. Gritan y vociferan en una mezcla de idiomas locales y extranjeros, aunque el llamado a su sed de sangre no necesita más que sus rostros enloquecidos y puños agitados. Ahora, los hombres de %companyname% saciarán a estos locos insensatos... | Los limpiadores se apresuran por la arena. Arrastran los cuerpos, recogen lo que vale la pena y ocasionalmente arrojan un trofeo a la multitud, provocando una versión casi caótica de las batallas de la arena en las gradas. %companyname% ahora forma parte de este espectáculo. | La arena espera, la multitud emocionada y el turno de %companyname% para ganar gloria está a la mano. | La multitud estalla en aplausos cuando los hombres de %companyname% avanzan hacia su sangriento foso. A pesar de la sed de sangre sin sentido de la gente, no puedes evitar sentir un latido de orgullo en tu pecho, sabiendo que es tu compañía la que está lista para ofrecer un espectáculo. | La puerta se levanta. Nada se escucha, solo el tintineo de cadenas, el crujido de poleas y los gruñidos de esclavos trabajando. Cuando los hombres de %companyname% salen de las entrañas del coliseo, pueden escuchar el crujir de la arena bajo sus pies hasta que llegan al centro del foso. Una extraña voz grita desde lo más alto del estadio, en un idioma perdido que desconoces, pero las palabras resuenan una sola vez antes de que la multitud estalle en vítores y rugidos. Ahora es el momento en que tus hombres demostrarán su valía ante el ojo vigilante del populacho. | Los negocios de %companyname% rara vez se llevan a cabo ante los ojos de aquellos que preferirían mantenerse distantes de tanta violencia. Pero en la arena, el populacho espera ávidamente la muerte y el sufrimiento, y ruge con sed de sangre cuando tus hombres entran a los fosos, y aplaude mientras los mercenarios sacan sus armas y se preparan para la batalla. | La arena tiene la forma del tajo de una herida, su techo desgarrado por los dioses, revelando la vanidad, la sed de sangre y la barbarie del ser humano. Y está el populacho allí, gritando y vociferando, esperando ver la sangre correr y regar la tierra, mientras se sonríen entre ellos como si fuera un simple juego. Los hombres lucharan entre ellos por trofeos mientras otros disfrutan del dolor ajeno. Y es ante este gentio que %companyname% luchará, y será a ellos a quien entretendrán. Lo harán bien. | La multitud de la arena es una mezcla de clases, ricos y pobres, porque solo los Vizires se separan en palcos por encima de todos. Brevemente unidos, el pueblo de %townname% se han reunido para presenciar cómo hombres y monstruos se asesinan entre sí. Con placer, %companyname% se dispone a hacer su parte. | Niños sentados sobre los hombros de sus padres, niñas jóvenes arrojando flores a los gladiadores, mujeres abanicándose, hombres preguntándose si podrían hacerlo. Estos son los pueblos de la arena, y el resto están todos borrachos y vociferando sin sentido. Esperas que %companyname% pueda contribuir al menos una hora o dos para entretener a esta loca multitud. | La multitud ruge mientras los hombres de %companyname% entran en el foso. Sería una tontería confundir la emoción con el deseo, porque tan pronto como los aplausos terminan, hay una lluvia de jarras de cerveza vacías y tomates podridos, y la alegría generalizada de aquellos que observan el asunto. Te preguntas si los hombres de %companyname% realmente deben gastar su tiempo aquí, pero luego piensas en el oro y la gloria que pueden obtener, y que al final del día, esta chusma en las gradas regresará a sus miserables vidas, al igual que tú, pero al menos tus bolsillos estarán un poco más llenos.\x7d"
    }
    {
        en = "Let's give the crowd something to cheer for!"
        es = "¡Demos a la multitud algo por lo que animarse!"
    }
    {
        en = "Arena"
        es = ""
    }
    {
        en = "We're not doing this. I don't want to die!"
        es = "No vamos a hacer esto. ¡No quiero morir!"
    }
    {
        en = "[img]gfx/ui/events/event_147.png[/img]\x7bThe arena master talks as if he doesn't even remember your face, then again he probably doesn't.%SPEECH_ON%Here's your pay, please come again.%SPEECH_OFF%The arena will be closed for the day, but you could return as early as tomorrow. | Without even raising his head from a rag of papyrus, the arena master throws you a purse of coin.%SPEECH_ON%I heard the crowds, and so here are your crowns. May you come visit the pits again.%SPEECH_OFF%The arena will be closed for the day, but you could return as early as tomorrow. | The arena master is waiting for you.%SPEECH_ON%That was a mighty fine show, Crownling. Would not mind it in the slightest if you come back again.%SPEECH_OFF%The arena will be closed for the day, but you could return as early as tomorrow.\x7d"
        es = "[img]gfx/ui/events/event_147.png[/img]\x7bEl Maestro de la Arena habla como si ni siquiera recordara tu rostro, y probablemente no lo haga.%SPEECH_ON%Aquí está tu paga, por favor vuelve otra vez.%SPEECH_OFF%La arena estará cerrada el resto del día, pero podrías regresar mañana mismo. | Sin siquiera levantar la cabeza de un trozo de papiro, el Maestro de la Arena te arroja una bolsa de monedas.%SPEECH_ON%Escuché a la multitud, así que aquí tienes tus coronas. Espero que vuelvas a visitar los fosos pronto.%SPEECH_OFF%La arena estará cerrada el resto del día, pero podrías regresar mañana mismo. | El Maestro de la Arena está esperándote.%SPEECH_ON%Eso fue un gran espectáculo, Buscador de Fortuna. No me importaría en lo más mínimo que volvieras de nuevo.%SPEECH_OFF%La arena estará cerrada el resto del día, pero podrías regresar mañana mismo.\x7d"
    }
    {
        en = "\x7bVictory! | Are you not entertained?! | Killed it. | A bloody spectacle.\x7d"
        es = "\x7b¡Victoria! | ¿No querías entretenimiento? | Lo matamos. | Un espectáculo sangriento.\x7d"
    }
    {
        // text = bro.getName() + " is now " + this.Const.Strings.getArticle(skill.getName()) + skill.getName()
        mode = "pattern"
        en = "<bro.getName()> is now <this.Const.Strings.getArticle(skill.getName()) + skill.getName()>"
        es = "<bro.getName()> es ahora <this.Const.Strings.getArticle(skill.getName()) + skill.getName()>"
    }
    {
        // text = "You gain a " + a.getName()
        mode = "pattern"
        en = "You gain a <a.getName()>"
        es = "Obtienes un <a.getName()>"
    }
    {
        en = "[img]gfx/ui/events/event_147.png[/img]\x7bThe %companyname%'s men have been defeated, either dead or, perhaps worse, badly mangled. At least the crowds are happy. In the pits, any showing, even that which ends in demise, is a good showing.\x7d"
        es = "[img]gfx/ui/events/event_147.png[/img]\x7bLos hombres de %companyname% han sido derrotados, algunos muertos y otros, tal vez peor, gravemente heridos. Al menos la multitud está contenta. En los fosos, cualquier exhibición, incluso aquella que termina en la muerte, es considerada una buena exhibición.\x7d"
    }
    {
        en = "Disaster!"
        es = "¡Que desastre!"
    }
    {
        en = "\x7b[img]gfx/ui/events/event_155.png[/img]The time for your arena match has come and passed, but you didn't show up there. Perhaps something more important came up, or perhaps you've just been hiding like cowards. Either way, your reputation will suffer because of this."
        es = "\x7b[img]gfx/ui/events/event_155.png[/img]El momento de tu combate en la arena llegó y pasó, pero no te presentaste. Tal vez surgió algo más importante, o tal vez te has estado escondiendo como cobardes. De cualquier manera, tu reputación sufrirá por esto."
    }
    {
        en = "But..."
        es = "Pero..."
    }
    {
        en = "Collars"
        es = ""
    }
    {
        en = "\x7b[img]gfx/ui/events/event_155.png[/img]The time for your arena match has come, but none of your men bear the arena collars, and so they aren't let in.\n\nYou should decide on who is to fight by equipping them with the arena collars that you've been given, and the match will start once you enter the arena again."
        es = "\x7b[img]gfx/ui/events/event_155.png[/img]Ha llegado el momento de tu combate en la arena, pero ninguno de tus hombres porta los collares de la arena, por lo que no se les permite entrar.\n\nDebes decidir quiénes pelearán equipándolos con los collares de la arena que te han dado, y la pelea comenzará una vez que entres nuevamente en la arena."
    }
    {
        en = "Oh, right!"
        es = "¡Oh, cierto!"
    }
    {
        en = "\x7b[img]gfx/ui/events/event_85.png[/img]The fight over, you find a few women sauntering upon you and the gladiators. They are practically swooning, faces blushed, and the men take special care of them. A little tired yourself, you have one of the fans help you count inventory. | [img]gfx/ui/events/event_147.png[/img]The battle's over, but a shadow suddenly crosses the ground. In a flash, you unsheathe and slash the sky. Flower petals shower your glistening body and you catch the rest of the bouquet in your teeth. A woman stands there fanning herself.%SPEECH_ON%I wondered why you didn't fight.%SPEECH_OFF%She says. You sheathe your blade and tie the bouquet to your belt. You tell her that if you fought, it wouldn't be a 'fight' at all. The fan goes weak at the knees and finds comfort on the ground. Before leaving, you tell her to drink plenty of water and make sure she stretches in the mornings. | [img]gfx/ui/events/event_97.png[/img]%SPEECH_START%Can I learn to fight like you men?%SPEECH_OFF%The voices catches you off guard and before you know it you have your blade an inch from a little boy's face. His eyes are shut, and he slowly opens one. You sheathe the sword and laugh.%SPEECH_ON%No. What I am cannot be learned.%SPEECH_OFF%You use a bit of ash and blood from the field to sign the kid's shirt and then make your leave. | [img]gfx/ui/events/event_97.png[/img]%SPEECH_START%Are you... are you gladiators?%SPEECH_OFF%You look to see a boy standing there with awe on his face. He almost cries he's so giddy.%SPEECH_ON%You're amazing!%SPEECH_OFF%Tussling the boy's hair, you tell him thanks, and make your leave. | [img]gfx/ui/events/event_97.png[/img]%SPEECH_START%H-how did you get so good?%SPEECH_OFF%You turn to see a boy nervously staring at you. Smiling, you give him the truth.%SPEECH_ON%When I was your age, I was killing men my age.%SPEECH_OFF%Grinning back, he asks if he works on it, can he be like you. Nodding, you answer.%SPEECH_ON%You can't know until you try, kid. Now go on home.%SPEECH_OFF%The boy brandishes a butter knife and fiendishly turns and sprints away. He's a good lad.\x7d"
        es = "\x7b[img]gfx/ui/events/event_85.png[/img]La pelea ha terminado y unas cuantas mujeres se acercan coqueteando a ti y a los gladiadores. Prácticamente están desmayándose, con las caras sonrojadas, y los hombres las cuidan con especial atención. Un poco cansado, haces que una de las admiradoras te ayude a contar el inventario. | [img]gfx/ui/events/event_147.png[/img]La batalla ha terminado, pero de repente una sombra cruza el suelo. En un instante, desenvainas y cortas el aire. Pétalos de flores caen sobre tu brillante cuerpo y coges el resto del ramo con los dientes. Una mujer está allí, abanicándose.%SPEECH_ON%Me preguntaba por qué no peleaste.%SPEECH_OFF%Guardas la espada y atas el ramo a tu cinturón. Le dices que si pelearas, no sería una 'pelea' en absoluto. La admiradora se siente débil de rodillas y encuentra consuelo en el suelo. Antes de irte, le dices que beba mucha agua y que se estire por las mañanas. | [img]gfx/ui/events/event_97.png[/img]%SPEECH_START%¿Puedo aprender a pelear como vosotros?%SPEECH_OFF%La voz te toma desprevenido y, antes de darte cuenta, tienes tu espada a solo un centímetro de la cara de un niño. Sus ojos están cerrados y poco a poco abre uno. Envainas la espada y te ríes.%SPEECH_ON%No. Lo que soy no se puede aprender.%SPEECH_OFF%Usas un poco de ceniza y sangre del campo para firmar la camiseta del niño y luego te marchas. | [img]gfx/ui/events/event_97.png[/img]%SPEECH_START%¿Vosotros... Vosotros sois gladiadores?%SPEECH_OFF%Te giras y ves a un niño parado allí con asombro en su rostro. Casi está llorando de emoción.%SPEECH_ON%¡Eres increíble!%SPEECH_OFF%Revuelves el cabello del niño y le agradeces, luego te marchas. | [img]gfx/ui/events/event_97.png[/img]%SPEECH_START%¿C-cómo llegaste a ser tan bueno?%SPEECH_OFF%Te das vuelta y ves a un niño mirándote nerviosamente. Sonriendo, le dices la verdad.%SPEECH_ON%Cuando tenía tu edad, estaba matando ya a hombres hechos y derechos.%SPEECH_OFF%Sonriendo de vuelta, te pregunta si él puede llegar a ser como tú si trabaja en ello. Asientes y respondes.%SPEECH_ON%No puedes saberlo hasta que lo intentes, chico. Ahora vete a casa.%SPEECH_OFF%El niño desenvaina un cuchillo de mantequilla y se aleja corriendo diabólicamente. Es un buen chico.\x7d"
    }
    {
        en = "\x7bDamn, we're good. | We're the best.\x7d"
        es = "\x7bMaldición, somos buenos. | Somos los mejores.\x7d"
    }
    {
        en = "number"
        es = ""
    }
    {
        en = "amount"
        es = ""
    }
    {
        en = "champion1"
        es = ""
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\contracts\contracts\arena_tournament_contract.nut
    {
        en = "The Arena Tournament"
        es = "El Torneo de la Arena"
    }
    {
        en = "Equip up to five of your men with arena collars"
        es = "Equipa hasta cinco de tus hombres con collares de la arena"
    }
    {
        en = "Enter the arena again to start the first round"
        es = "Entra nuevamente en la arena para comenzar la primera ronda"
    }
    {
        en = "Each round will be to the death and you won't be able to retreat or loot afterwards"
        es = "Cada ronda será a muerte y no podrás retirarte ni saquear después"
    }
    {
        en = "After each round you can elect to drop out for some consolation pay or start the next round right away"
        es = "Después de cada ronda, puedes optar por abandonar y recibir un pago de consolación o empezar la siguiente ronda de inmediato"
    }
    {
        en = "Get a famed %prizetype% called %prizename% for winning all three rounds"
        es = "Obtén un objeto célebre de tipo %prizetype% llamado %prizename% por ganar las tres rondas"
    }
    {
        // this.Contract.setScreen("Won" + this.Flags.get("Round"));
        mode = "pattern"
        en = "Won<this.Flags.get(Round)>"
        es = ""
    }
    {
        en = "\x7bWe shall win the grand prize!\x7d"
        es = "\x7b¡Ganaremos el gran premio!\x7d"
    }
    {
        en = "\x7bWe are not ready for this.\x7d"
        es = "\x7bNo estamos listos para esto.\x7d"
    }
    {
        en = "The arena master, typically the most disinterested man you've ever met to have an interesting job, is actually rather lively today. He presents you with a scroll in one hand and three fingers held up in the other.%SPEECH_ON%Three rounds! Three rounds, one after the other and each harder than the last. Win all three with the same five men to earn the grand prize of a famed %prizetype% called %prizename%! It'sahtournamentah! You want in or not-ah?%SPEECH_OFF%"
        es = "El Maestro de la Arena, normalmente el hombre más indiferente que has conocido incluso teniendo un trabajo tan interesante, está bastante animado hoy. Te presenta un pergamino en una mano y tres dedos levantados en la otra.%SPEECH_ON%¡Tres rondas! ¡Tres rondas, una tras otra, cada una más difícil que la anterior! ¡Gana las tres rondas con los mismos cinco hombres para ganar el gran premio de un famoso %prizetype% llamado %prizename%! ¡Es un torneo, ¿quieres participar o no?!%SPEECH_OFF%"
    }
    {
        en = "The arena master continues.%SPEECH_ON%When you're ready, have the men who'll be doing the fighting put on the arena collars we'll give you.%SPEECH_OFF%"
        es = "El Maestro de la Arena continúa.%SPEECH_ON%Cuando estéis listos, haz que los hombres que vayan a luchar se pongan los collares de la arena que os daremos.%SPEECH_OFF%"
    }
    {
        en = "This arena tournament works as follows. Do you agree to the terms?"
        es = "El torneo de la arena funciona de la siguiente manera. ¿Estás de acuerdo con los términos?"
    }
    {
        en = "We enter the tournament!"
        es = "¡Nosotros entramos en el torneo!"
    }
    {
        en = "Let's win us that prize!"
        es = "¡Vamos a ganar ese premio!"
    }
    {
        en = "Won2"
        es = ""
    }
    {
        en = "[img]gfx/ui/events/event_147.png[/img]\x7bThe first of the three battles is over. You'll have to make a careful assessment of your men and if they can continue to the next round, which will only be harder than the last. Just as you'll find no pride in the grave, there's no shame in leaving. You'd still get some coin, but you'd also forfeit any chance to win the grand prize.\x7d"
        es = "[img]gfx/ui/events/event_147.png[/img]\x7bLa primera de las tres batallas ha terminado. Tendrás que hacer una evaluación cuidadosa de tus hombres y determinar si pueden continuar a la siguiente ronda, que será aún más difícil que la anterior. Así como no encontrarás orgullo en la tumba, tampoco hay vergüenza en retirarse. Aún recibirías algunas monedas, pero también perderías cualquier oportunidad de ganar el gran premio.\x7d"
    }
    {
        en = "We'll win the next round as well!"
        es = "¡Ganaremos la siguiente ronda también!"
    }
    {
        en = "Time for us to drop out of this tournament."
        es = "Es hora de que abandonemos este torneo."
    }
    {
        en = "The next round will start automatically"
        es = "TLa siguiente ronda comenzará automáticamente"
    }
    {
        en = "After each round you can elect to drop out or start the next round right away"
        es = "Después de cada ronda, puedes optar por abandonar o comenzar la siguiente ronda de inmediato"
    }
    {
        en = "[img]gfx/ui/events/event_147.png[/img]The penultimate battle is won, leaving you with the choice to drop out now or take on the final fight to win the grand prize."
        es = "[img]gfx/ui/events/event_147.png[/img]La penúltima batalla ha sido ganada, dejándote con la opción de retirarte ahora o enfrentar la batalla final para ganar el gran premio."
    }
    {
        en = "On to the final round!"
        es = "¡A por la ronda final!"
    }
    {
        en = "[img]gfx/ui/events/event_147.png[/img]The combat is over, and the dull warbling in your ear is the roar of the crowd, overwhelming all senses in an explosion of celebratory ecstasy. You are but an avatar for the people, a totem through which they can vicariously electrify their own vanity and vacant heroism. Alongside the adoration of the mob, you are rewarded the grand prize: %prizename%!"
        es = "[img]gfx/ui/events/event_147.png[/img]La batalla ha terminado, y el monótono zumbido en tu oído es el rugido de la multitud, abrumando todos los sentidos en una explosión de éxtasis por la victoria. Eres solo un avatar para la gente, un tótem a través del cual pueden reflejar su propia vanidad y heroísmo vacío. Junto con la adoración de la multitud, se te concede el gran premio: ¡%prizename%!"
    }
    {
        // text = "You gain " + item.getName()
        mode = "pattern"
        en = "You gain <this.Const.Strings.getArticle(item.getName()) + item.getName()>"
        es = "Ganas <this.Const.Strings.getArticle(item.getName()) + item.getName()>"
    }
    {
        en = "[img]gfx/ui/events/event_147.png[/img]\x7bYou decide to depart the tournament and preserve your men to fight another day. No boos or hisses are heard as this is done in the belly of the arena. It is a bureaucratic affair at best, a small exchange of monetary compensation and you are sent on your way. No grief is given, especially not from fellow gladiators who understand the point of the decision better than anyone. And the crowd? They just want blood, they'll never even notice which bodies carrying it are gone.\x7d"
        es = "[img]gfx/ui/events/event_147.png[/img]\x7bDecides partir del torneo y preservar a tus hombres para luchar otro día. No se escuchan abucheos ni silbidos, ya que esto se realiza en lo más profundo de la arena. Es un asunto burocrático en el mejor de los casos; una pequeña compensación monetaria y te dejan partir. No se muestra ninguna pena, especialmente no por parte de los compañeros gladiadores que comprenden mejor que nadie el propósito de la decisión. ¿Y la multitud? Solo quieren sangre, nunca notarán que tu abandono siemrpe que haya carne fresca para saciar sus ansias.\x7d"
    }
    {
        en = "Maybe next time."
        es = "Tal vez la próxima vez."
    }
    {
        // text = "You gain [color=" + this.Const.UI.Color.PositiveEventValue + "]" + money + "[/color] Crowns"
        mode = "pattern"
        en = "You gain <v:val_tag> Crowns"
        es = "Obtienes <v> Coronas"
    }
    {
        en = "prizename"
        es = ""
    }
    {
        en = "prizetype"
        es = ""
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\contracts\contracts\barbarian_king_contract.nut
    {
        en = "The Barbarian King"
        es = "El Rey en el Norte"
    }
    {
        en = "Hunt down the Barbarian King and his warhost"
        es = "Da caza al Rey Bárbaro y su hueste"
    }
    {
        en = "He was last reported to be in the region of %region%, %direction% from you"
        es = "La última información lo situaba en la región de %region%, al %direction% de tu posición"
    }
    {
        en = "Intro"
        es = ""
    }
    {
        en = "A mighty warhost of barbarian tribes, united by a self-proclaimed barbarian king."
        es = "Un poderoso ejército de tribus bárbaras, unidas bajo el mando de un autoproclamado rey bárbaro."
    }
    {
        en = "His warhost was last spotted around %region%, %terrain% %direction% from you, near %nearest_town%"
        es = "Su ejército fue visto por última vez cerca de %region%, en %terrain% al %direction% de tu ubicación actual, cerca de %nearest_town%"
    }
    {
        en = "Return"
        es = ""
    }
    {
        en = "Directions"
        es = ""
    }
    {
        en = "AGreaterThreat1"
        es = ""
    }
    {
        en = "Approach"
        es = ""
    }
    {
        en = "Travel with the Barbarian King to face a greater threat together"
        es = "Acompaña al Rey norteño para enfrentar juntos una amenaza aún mayor"
    }
    {
        // this.World.FactionManager.getFaction(this.Contract.getFaction()).addPlayerRelation(this.Const.World.Assets.RelationNobleContractFail, "Company broke a contract");
        mode = "pattern"
        en = "<this.World.FactionManager.getFaction(this.m.Faction).addPlayerRelation(this.Const.World.Assets.RelationContractCancel, Broke a contract)>"
        es = "<this.World.FactionManager.getFaction(this.m.Faction).addPlayerRelation(this.Const.World.Assets.RelationContractCancel, Romper un contrato)>"
    }
    {
        // "Return to " + this.Contract.m.Home.getName()
        mode = "pattern"
        en = "Return to <this.Contract.m.Home.getName()>"
        es = "Regresa a <this.Contract.m.Home.getName()>"
    }
    {
        en = "Success2"
        es = ""
    }
    {
        en = "Negotiations"
        es = "Negociaciones"
    }
    {
        en = "[img]gfx/ui/events/event_45.png[/img]\x7b%employer% is swinging a thin crown around his finger. It is a cheap looking piece of metal, but no doubt a crown from somewhere. He looks you up and down as the tin scrapes and skitters over his fingernail and back again.%SPEECH_ON%I suspect I should have seen this coming. Men seek power, and those cut from the barbarian cloth are no different.%SPEECH_OFF%He lets the crown slide down to his knuckles where it hangs limply.%SPEECH_ON%The barbarians to the %direction% in the region of %region% are uniting under a so-called king. A savage so strong and nasty he threatens to get a horde and after that, well, I suspect he'll want to expand his realm south. I need you to go to this region, find this man, and cut him down.%SPEECH_OFF% | One of %employer%'s servants fetches you to a garden where you find the man tending to a tomato plant. He's pruning it with goat shears and nodding to his own handiwork. He talks loosely.%SPEECH_ON%My scouts tell me that a northern savage in %region% is gathering an army. A gathering of idiots is not too out of the ordinary for those primitives, but I do believe this one is proclaiming himself king. And kings, well, they wish to be suzerain over more than just what they got. They want what everyone else has got. What I got.%SPEECH_OFF%The man pauses and nods to you.%SPEECH_ON%I need you to go to the region of %region%, find this so-called savage king, and kill him. It will not be easy, but you will be paid quite well.%SPEECH_OFF% | %employer% is surrounded by his lieutenants. They regard you with sneers, but %employer% ignores their judgments and makes his own.%SPEECH_ON%Ah, sellsword, I do believe a man of your chops is just the one I'm looking for. A barbarian in %region% has ordained himself king. He even wears a crown of some sort, probably of bone and antler, but it is the shape and purpose that matters. Not only matters to him, but to us. We can't allow him to live. I need you to go find this primitive and end him before he gathers an army too big for my fellow lieutenants here to deal with.%SPEECH_OFF% | %employer% welcomes you with a mug of ale. He himself enjoys a goblet of wine.%SPEECH_ON%I've brought you here because there is a certain primitive in the region of %region% that I need killing. He is calling himself king, heh, suzerain over the savages. Well, while I don't respect his royal authority in the slightest, I know a budding threat when I see one. I can't wait around for this barbarian to round up the villages and gather an army. I need you to find him and kill him. It won't be easy, but you'll be paid well.%SPEECH_OFF%You now wonder if he's slipping you ale to loosen you into accepting this absurd task. | %employer% is holding a pair of deer antlers with the crown still at the base. When he puts it on his desk it stands upright as though still attached to its authorship.%SPEECH_ON%Word on the wind is that a savage in %region% is gathering an army. He is proclaiming himself king and if he can wrangle those primitives under his banner then that no doubt makes him a strong sonuvabitch. It also means we may be in a heap of shit here real soon if he isn't taken care of.%SPEECH_OFF%The man knocks the antlers over and they fall upon their tips with hollow clacks.%SPEECH_ON%So that's what you're here for, sellsword. I need you to find this barbarian and put an end to him before he gets any wise ideas about what he is and isn't suzerain over.%SPEECH_OFF% | %employer%'s sitting in his chair with pursed lips. He's thumbing a dagger around, the tip of it auguring a divot into his desk.%SPEECH_ON%My scouts to the %direction% started disappearing a little while ago. And then the survivors trickled in and with them tales of a barbarian proclaiming himself king of %region%. Now, do I need to conjure what the issue is with a savage ordaining himself ruler of a horde of primitives?%SPEECH_OFF%You tell him you can imagine it keeps him up at night. %employer% grins.%SPEECH_ON%Aye, that it does. So I need a man such as yourself, a strapping, nice, civilized sellsword. I need you to go and find this so-called king and kill him before he's got all those damn idiots marching under his banner.%SPEECH_OFF%\x7d"
        es = "[img]gfx/ui/events/event_45.png[/img]\x7b%employer% está balanceando una fina corona alrededor de su dedo. Es una pieza de metal de aspecto barato, pero sin duda una corona de algún lugar. Te mira de arriba abajo mientras el trozo de metal raspa y se desliza sobre su uña una y otra vez.%SPEECH_ON%Sospecho que debería haber visto esto venir. Los hombres buscan poder, y los primitivos barbaros no son diferentes.%SPEECH_OFF%Deja que la corona se deslice hasta sus nudillos donde cuelga lánguidamente.%SPEECH_ON%Los bárbaros al %direction% en la región de %region% se están uniendo bajo un autoproclamado rey. Un salvaje tan fuerte y desagradable que amenaza con reunir una horda y después de eso, bueno, sospecho que querrá expandir su reino hacia el sur. Necesito que vayas a esta región, encuentres a este hombre y lo derrotes.%SPEECH_OFF% | Uno de los sirvientes de %employer% te lleva a un jardín donde encuentras al hombre cuidando de una planta exótica. Está podándola con unas tijeras y al terminar asiente al contemplar su propia obra. Habla despreocupadamente.%SPEECH_ON%Mis exploradores me dicen que un salvaje del norte en %region% está reuniendo un ejército. Una reunión de idiotas no es demasiado fuera de lo común para esos salvajes, pero creo que este se está proclamando a sí mismo rey. Y los reyes, bueno, quieren ser tener más de lo que ya poseen. Quieren lo que todos los demás tienen. Lo que yo tengo.%SPEECH_OFF%El hombre se detiene y se gira hacia ti.%SPEECH_ON%Necesito que vayas a la región de %region%, encuentres a este llamado rey salvaje y lo mates. No será fácil, pero se te pagará adecuadamente.%SPEECH_OFF% | %employer% está rodeado por sus comandantes. Te miran con desprecio, pero %employer% ignora sus prejuicios y hace los suyos propios.%SPEECH_ON%Ah, mercenario, creo que un hombre de tus habilidades es justo lo que estoy buscando. Un bárbaro en %region% se ha autoproclamado rey. Incluso lleva una corona de algún tipo, probablemente de hueso y asta, pero no es la forma sino el propósito lo que importa. No solo le importa a él, sino a nosotros. No podemos permitir que viva. Necesito que vayas a encontrar a este primitivo y lo elimines antes de que reúna un ejército demasiado grande para que mis comandantes aquí puedan lidiar con él.%SPEECH_OFF% | %employer% te da la bienvenida con una jarra de cerveza. Él mismo disfruta de un cáliz de vino.%SPEECH_ON%Te he traído aquí porque hay un cierto salvaje en la región de %region% que necesito que mates. Se hace llamar rey, je, suzerain de los salvajes. Bueno, aunque no respeto en lo más mínimo su autoridad real, sé intuir una amenaza incipiente cuando la veo. No puedo quedarme esperando a que este bárbaro reúna a las tribus y forme un ejército. Necesito que lo encuentres y lo mates. No será fácil, pero se te pagará bien.%SPEECH_OFF%Ahora te preguntas si te está ofreciendo cerveza para persuadirte y aceptar esta absurda tarea. | %employer% sostiene un par de astas de ciervo con la corona todavía en la base. Cuando lo pone sobre su escritorio, se mantiene erguido como si aún estuviera unido a su portador.%SPEECH_ON%Las palabras que arrastra el viento dicen que un salvaje en %region% está reuniendo un ejército. Se proclama a sí mismo rey y si puede reunir a esos primitivos bajo su bandera, eso sin duda lo convierte en un tipo fuerte. También significa que podemos estar en un montón de problemas muy pronto si no nos ocupamos de él.%SPEECH_OFF%El hombre golpea las astas y caen sobre sus puntas con un sonido hueco.%SPEECH_ON%Entonces, eso es por lo que estás aquí, mercenario. Necesito que encuentres a este bárbaro y le pongas fin antes de que tenga ideas demasiado sabias sobre lo que es y no es ser rey.%SPEECH_OFF% | %employer% está sentado en su silla con los labios fruncidos. Está jugando con una daga, la punta de la misma haciendo un agujero en su escritorio.%SPEECH_ON%Hace un tiempo, mis exploradores al %direction% comenzaron a desaparecer. Y luego las granjas y aldeas fronterizas fueron asaltadas, llenando los caminos de refugiados, y con ellos llegaron historias de un bárbaro que se proclamaba rey de %region%. Ahora, ¿necesito explicarte cuál es el problema con un salvaje que se autoproclama gobernante de una horda de primitivos?%SPEECH_OFF%Le dices que puedes imaginarte que eso lo mantiene despierto por la noche. %employer% sonríe.%SPEECH_ON%Sí, eso es cierto. Así que necesito a un hombre como tú, un vigoroso mercenario civilizado. Necesito que vayas y encuentres a este autoproclamado rey y lo mates antes de que tenga a todos esos malditos idiotas marchando bajo su estandarte.%SPEECH_OFF%\x7d"
    }
    {
        en = "\x7bHow many crowns are we talking about here? | That's no small feat to ask. | I could be persuaded for the right price. | A task like this better pay well.\x7d"
        es = "\x7b¿De cuántas coronas estamos hablando? | No es poca cosa lo que me estás pidiendo. | Podría ser persuadido por el precio correcto. | Para una tarea como esta, será mejor que pagues bien.\x7d"
    }
    {
        en = "Negotiation"
        es = ""
    }
    {
        en = "\x7bWe're not about to engage an army. | That's not the kind of work we're looking for. | I won't risk the company against an enemy such as this.\x7d"
        es = "\x7bNo vamos a enfrentarnos a un maldito ejército. | Esto no parece ser nuestro tipo de trabajo. | No arriesgaré a la compañía contra un enemigo como este.\x7d"
    }
    {
        en = "Along the way..."
        es = "Durante el camino..."
    }
    {
        en = "\x7b[img]gfx/ui/events/event_59.png[/img]A throng of refugees passes the company by. Rumors abound that the barbarian king is %distance% to the %direction%. Many of the people on the road are from %nearest_town% and seem to have no interest in waiting around for a sea of savages to descend upon them. | [img]gfx/ui/events/event_41.png[/img]A trader with an empty merchant cart crosses paths with the company. Though he has nothing to peddle, he does state that the roads are flowing with rumors of a savage calling himself king. He states that the barbarian is somewhere %direction% of where you stand, around %region%. He regards the path of your journey with a nod.%SPEECH_ON%If you're keen on going that way, well, give them primitive bastards all the hell they deserve.%SPEECH_OFF% | [img]gfx/ui/events/event_94.png[/img]A half-naked man is found sitting cross-legged to the side of the road. He states that a primitive with an army burned his farmstead, wronged the women, and slew every swinging dick.%SPEECH_ON%I survived hiding in a brush pile with my hands wrapped over my mouth.%SPEECH_OFF%The man wipes his nose.%SPEECH_ON%I seen you with your weapons. If you seek this barbarian then I can tell ya it seemed they was heading %direction% of here, down %terrain% %distance% aways to %region%.%SPEECH_OFF% | [img]gfx/ui/events/event_94.png[/img]You find the burnt remains of a small hamlet. A few of its survivors linger, their shapes about as present as the smoke drifting off their destroyed homes. One states that a man posturing like a king came and killed everyone they got their hands on before heading %direction%. | [img]gfx/ui/events/event_60.png[/img]You've come across a number of flipped carts or burning wagons. They're barren, all the goods gone, only the corpses of their owners remain. A few children are picking through the rubble of one such ruin. When you ask them who did this, a cheeky boy speaks up.%SPEECH_ON%Savages from the north, but they headin' %direction% now. I seen them. They is %terrain%, %distance% I wager. %SPEECH_OFF%He picks his nose.%SPEECH_ON%They is killers, by the way. Kinda look your sort, but larger. Probably stronger.%SPEECH_OFF% | [img]gfx/ui/events/event_76.png[/img]A scout of %employer% meets you on the road. He reports that the barbarian king was sighted around %region% to the %direction% %terrain%. He is %distance%. You ask the scout if he'd join you for the fight and the man laughs.%SPEECH_ON%No sir, I'm quite alright. I run about, see things, and report them. In between I fark a whore or two. It's a good life and I don't need your sellsword ways ruinin' it!%SPEECH_OFF%Fair enough. | [img]gfx/ui/events/event_132.png[/img]%randombrother% spots them first. Signs of a skirmish, charred corpses, faded footprints and wagon tracks, so many that it is clear an army passed through here.%SPEECH_ON%Looks like they was headin' %direction% after the battle, captain.%SPEECH_OFF%\x7d"
        es = "\x7b[img]gfx/ui/events/event_59.png[/img]Una multitud de refugiados pasa junto a la compañía. Los rumores apuntan de que el rey bárbaro está a %distance% al %direction%. Muchas de las personas en el camino vienen de %nearest_town% y parecen no tener interés en esperar a que un mar de salvajes caiga sobre ellos. | [img]gfx/ui/events/event_41.png[/img]Un comerciante con un carro de mercancías vacío se cruza con la compañía. Aunque no tiene nada que vender, dice que los caminos están llenos de rumores sobre un salvaje que se autodenomina rey. Afirma que el bárbaro está en algún lugar al %direction% de donde estáis, alrededor de %region%. Observa el camino de tu viaje con un asentimiento.%SPEECH_ON%Si tienes ganas de ir en esa dirección, bueno, dales a esos bastardos salvajes todo el infierno que se merecen.%SPEECH_OFF% | [img]gfx/ui/events/event_94.png[/img]Un hombre medio desnudo está sentado en posición de loto al lado del camino. Afirma que un salvaje con un ejército quemó su granja, hizo daño a las mujeres y mató a todos los que se interpusieron en su camino.%SPEECH_ON%Sobreviví escondido en un montón de maleza con las manos sobre la boca.%SPEECH_OFF%El hombre se limpia la nariz.%SPEECH_ON%Te he visto con tus armas. Si buscas a este bárbaro, puedo decirte que parecía que se dirigían al %direction% de aquí, por %terrain% a %distance% de distancia, hacia %region%.%SPEECH_OFF% | [img]gfx/ui/events/event_94.png[/img]Encuentras los restos quemados de una pequeña aldea. Algunos de sus sobrevivientes aún deambulan por el lugar; su ánimo apenas esta presente, como el humo que se desvanece de sus hogares destruidos. Uno de ellos dice que un hombre que se hacía pasar por rey llegó y mató a todos los que cayeron en sus manos antes de dirigirse al %direction%. | [img]gfx/ui/events/event_60.png[/img]Has encontrado varios carros volcados o carros ardiendo. Están vacíos, todos los bienes se han ido, solo quedan los cadáveres de sus dueños. Algunos niños están rebuscando entre los escombros de una de los despojos. Cuando les preguntas quién hizo esto, un niño travieso habla.%SPEECH_ON%Salvajes del norte, pero ahora se dirigen al %direction%. Los he visto. Están en %terrain%, a %distance% supongo.%SPEECH_OFF%Se frota la nariz.%SPEECH_ON%Son asesinos, por cierto. Se parecen a los tuyos, pero más grandes. Probablemente más fuertes.%SPEECH_OFF% | [img]gfx/ui/events/event_76.png[/img]Un explorador de %employer% te encuentra en el camino. Informa que se avistó al rey bárbaro alrededor de %region% al %direction% de %terrain%. Está a %distance%. Le preguntas al explorador si se uniría a ti para la pelea y el hombre se ríe.%SPEECH_ON%No, señor, estoy muy bien. Corro por ahí, veo cosas y las informo. En el camino, también me divierto en alguna taberna. Es una buena vida y no necesito que tus ideas de mercenario la arruinen.%SPEECH_OFF%Está bien. | [img]gfx/ui/events/event_132.png[/img]%randombrother% los avista primero. Señales de un enfrentamiento, cadáveres carbonizados, huellas difuminadas de pies y rastros de carros, tantos que está claro que un ejército pasó por aquí.%SPEECH_ON%Parece que se dirigían al %direction% después de la batalla, capitán.%SPEECH_OFF%\x7d"
    }
    {
        en = "We're on his trail."
        es = "Estamos tras su rastro."
    }
    {
        en = "[img]gfx/ui/events/event_45.png[/img]\x7bThere's no doubt now. With all the signs you've encountered, and all the reports that people have given you, you finally know exactly where the Barbarian King and his warhost is headed. The only thing left is to confront him.\x7d"
        es = "[img]gfx/ui/events/event_45.png[/img]\x7bNo hay duda ahora. Con todas las señales que has encontrado y todos los informes que te han dado las personas, finalmente sabes exactamente hacia dónde se dirige el Rey Bárbaro y su hueste. Lo único que queda es enfrentarlo.\x7d"
    }
    {
        en = "We should make haste."
        es = "Deberíamos darnos prisa."
    }
    {
        en = "As you approach..."
        es = "Después de la batalla..."
    }
    {
        en = "[img]gfx/ui/events/event_135.png[/img]\x7bThe Barbarian King comes to the field with his warhost, a party of oversized miscreants, growling warriors, sheepish slaves, and howling women. It is the army of a man who has collected from the land every scrap of resource, every inch of advantage, and will surely collect civilization itself as surely as a simple snowball may become the avalanche. You prepare the men for battle. | The Barbarian King's warband trundles across the land with no hint of training or even semblance of formation. But you know that with the mere wave of the savage's hand he may set upon his enemies a horde of killers who have more than ample supply of carnage to overcome any lack of cohesion. You prepare the men for battle. | The warband of savages is like that of a fever dream, taking shape across the horizon like travelers from every corner of the earth, dressed not in any uniform or armor, but in mockeries of those they have conquered. Warriors with wedding dresses wrapped about their arms, long coats of royal color adorned upon men of no status, some wearing ribs and clattering bones as though they got the last of the pillaging. They were but farmers of horror, villages their crop, and war but a harvest for all seasons.\n\nYou shake your head at the sight and prepare the men for battle.\x7d"
        es = "[img]gfx/ui/events/event_135.png[/img]\x7bEl Rey Bárbaro llega al campo de batalla con su hueste, un grupo de malhechores sobredimensionados, guerreros gruñones, esclavos tímidos y mujeres aulladoras. Es el ejército de un hombre que ha recolectado de la tierra hasta el último pedazo de recurso, cada ventaja posible, y seguramente recolectará la civilización misma, tan seguro como una simple bola de nieve se convierte en una avalancha. Preparas a los hombres para la batalla. | La hueste del Rey Bárbaro avanza por la tierra sin ningún indicio de entrenamiento o incluso de formación. Pero sabes que con un simple gesto de la mano del salvaje, puede lanzar sobre sus enemigos una horda de asesinos que tienen más que suficientes para superar cualquier falta de cohesión. Preparas a los hombres para la batalla. | La horda de salvajes es como un sueño febril, tomando forma en el horizonte como viajeros de cada rincón de la tierra, vestidos no con uniformes ni armaduras, sino con burlas de aquellos que han conquistado. Guerreros con vestidos de novia envueltos alrededor de sus brazos, largos abrigos de colores reales adornados en hombres de ningún estatus, algunos llevando costillas y huesos que chocan como si hubieran obtenido el último botín de saqueo. Eran simplemente campesinos del horror, los pueblos su cosecha, y la guerra una prodcción fertil en todas las estaciones.\n\nSacudes la cabeza ante la vista y preparas a los hombres para la batalla.\x7d"
    }
    {
        en = "To arms!"
        es = "¡A las armas!"
    }
    {
        en = "Victory"
        es = ""
    }
    {
        en = "After the battle..."
        es = "A medida que te acercas..."
    }
    {
        en = "[img]gfx/ui/events/event_145.png[/img]\x7bThe Barbarian King is dead. Though he adorned himself the title of royalty, he lies amongst the dead like any other of his people. A savage. A primitive. With a slightly hardier body and some accoutrements native to his warring and pillaging and ravaging. Little else distinguishes him. You chop into his neck with your sword and put your boot to his face as you cut him clean off the shoulders. %randombrother% 2takes the heavy head and drops it into a knapsack. You order the men to scavenge what they can before preparing a return to %employer%.\x7d"
        es = "[img]gfx/ui/events/event_145.png[/img]\x7bEl Rey Bárbaro está muerto. Aunque se adornó con el título de realeza, yace entre los muertos como cualquier otro de su pueblo. Un salvaje. Un primitivo. Con un cuerpo ligeramente más robusto y algunos accesorios nativos de su guerra, saqueo y devastación. Poco más lo distingue. Haces un corte en su cuello con tu espada y pones tu bota en su rostro mientras separas su cabeza limpiamente de sus hombros. %randombrother% toma la pesada cabeza y la deja caer en una mochila. Ordenas a los hombres que recojan lo que puedan antes de emprender el regreso con %employer%\x7d"
    }
    {
        en = "\x7bThe %companyname% prevailed! | Victory!\x7d"
        es = "\x7b¡%companyname% ha prevalecido! | ¡Victoria!\x7d"
    }
    {
        en = "[img]gfx/ui/events/event_136.png[/img]\x7bYou find the Barbarian King, but a parlay is made. The Barbarian King and an elder step across the field to meet you personally. Against better judgment, you go out to see them. The Barbarian King speaks and the elder translates.%SPEECH_ON%We are not here to conquer, but to defeat the Great Untoward.%SPEECH_OFF%Suspecting a loss of translation, you ask them to explain. The King and elder continue.%SPEECH_ON%Death has left this land, and in its absence a man slain becomes lost between worlds and will rise again. A horde of Untoward, the Undead, are on the march. We are not here for you or your nobles. If you help us destroy them we will depart the land and trouble your people no more. Only the Untoward.%SPEECH_OFF%%randombrother% leans in and whispers.%SPEECH_ON%We could join them, sure, but we could also just go ahead and attack them now. They're clearly not at full strength and whatever they say here the fact is they've been ravaging the lands anyway, because they're primitive savages, sir, and raping and pillaging is just what they got in their blood.%SPEECH_OFF%\x7d"
        es = "[img]gfx/ui/events/event_136.png[/img]\x7bEncuentras al Rey Bárbaro, pero se establece un parlamento. El Rey Bárbaro y un anciano cruzan el campo para encontrarse contigo personalmente. Contratodo juicio, sales a encontrarlos. El Rey Bárbaro habla y el anciano traduce.%SPEECH_ON%No estamos aquí para conquistar, sino para derrotar a los Desventurados.%SPEECH_OFF%Sospechando que hay una mala traducción, les pides que se expliquen. El Rey y el anciano continúan.%SPEECH_ON%La muerte ha dejado esta tierra y, en su ausencia, un hombre asesinado queda perdido entre ambos mundos y resurgirá. Una horda de Desventurados, los No Vivos, está en marcha. No estamos aquí por ti ni por tus nobles. Si nos ayudas a destruirlos, partiremos de esta tierra y no causaremos más problemas a tu pueblo. Solo los Despropósitos.%SPEECH_OFF%%randombrother% se acerca y susurra.%SPEECH_ON%Podríamos unirnos a ellos, claro, pero también podríamos atacarlos ahora mismo. Claramente no están a plena fuerza y pase lo que pase aquí, el hecho es que han estado devastando las tierras de todos modos, porque son salvajes primitivos, señor, y violar y saquear es lo que llevan en la sangre.%SPEECH_OFF%\x7d"
    }
    {
        en = "We'll attack them and rid the north of this so-called king."
        es = "Nos uniremos a ellos para marchar contra los 'Desventurados'."
    }
    {
        en = "We will join with them to march against the Untoward."
        es = "Atacaremos y libraremos al norte de este supuesto rey."
    }
    {
        en = "[img]gfx/ui/events/event_136.png[/img]\x7bYou spit and nod toward the elder.%SPEECH_ON%We walked past burned homes, raped women, and slain men just to find your sorry lot, and now you want to band together? We ain't allies. We ain't friends. Tell your so-called 'King' to pray to whatever shit gods you...%SPEECH_OFF%The elder holds his hand up and talks with the king in their native tongue. The two men nod, turn, and leave. %randombrother% laughs.%SPEECH_ON%Brevity is the soul of scorn, captain.%SPEECH_OFF%You tell the man to get back to the battle line and prepare for the fight ahead.\x7d"
        es = "[img]gfx/ui/events/event_136.png[/img]\x7bEscupes y niegas hacia el anciano.%SPEECH_ON%Hemos pasado por casas incendiadas, mujeres violadas y hombres asesinados solo para encontrarnos con tu miserable grupo, ¿y ahora queréis que nos unamos? No somos aliados. No somos amigos. Dile a tu llamado 'Rey' que rece a los dioses de mierda que...%SPEECH_OFF%El anciano levanta la mano y habla con el rey en su lengua nativa. Los dos hombres asienten, se giran y se van. %randombrother% se ríe.%SPEECH_ON%La brevedad es el alma del desprecio, capitán.%SPEECH_OFF%Le dices al hombre que vuelva a la línea de batalla y se prepare para la lucha que se avecina.\x7d"
    }
    {
        en = "Prepare for battle."
        es = "Prepárense para marchar."
    }
    {
        en = "[img]gfx/ui/events/event_136.png[/img]\x7bYou nod toward the elder.%SPEECH_ON%Alright, we'll work with you to see to this greater threat.%SPEECH_OFF%The elder smiles and rubs his thumbs together and speaks a few phrases in his native tongue. The Barbarian King slams his chest with his fist and then slugs you in the shoulder with it, before arcing the hand across the sky. Laughing, the elder explains.%SPEECH_ON%So we fight together, but if we shall fall, he will not fight with you as an undead. If slain, the King shall find Death himself and bring his scythe upon his own neck.%SPEECH_OFF%\x7d"
        es = "[img]gfx/ui/events/event_136.png[/img]\x7bAsientes hacia el anciano.%SPEECH_ON%Está bien, trabajaremos contigo para enfrentar esta amenaza mayor.%SPEECH_OFF%El anciano sonríe y frota sus pulgares juntos, luego pronuncia algunas frases en su lengua. El Rey Bárbaro golpea su pecho con el puño y luego te da un golpe en el hombro con él, antes de trazar un arco en el aire con la mano. Riéndose, el anciano explica.%SPEECH_ON%Así que lucharemos juntos, pero si caemos, él no luchará contigo como un no-muerto. Si es abatido, el Rey buscará a la Muerte misma y traerá su guadaña sobre su propio cuello.%SPEECH_OFF%\x7d"
    }
    {
        en = "Prepare to march."
        es = "¡Prepárense para luchar!"
    }
    {
        // local party = this.World.FactionManager.getFaction(nearest_undead.getFaction()).spawnEntity(tile, "The Untoward", false, this.Const.World.Spawn.UndeadArmy, 260 * this.Contract.getDifficultyMult() * this.Contract.getScaledDifficultyMult(), this.Contract.getMinibossModifier());
        mode = "pattern"
        en = "<this.World.FactionManager.getFaction(this.m.Faction).addPlayerRelation(this.Const.World.Assets.RelationContractCancel, Broke a contract)>"
        es = "<this.World.FactionManager.getFaction(this.m.Faction).addPlayerRelation(this.Const.World.Assets.RelationContractCancel, Romper un contrato)>"
    }
    {
        en = "[img]gfx/ui/events/event_73.png[/img]\x7bThe savages were not lying: the ancients have put forth an army. It is a warband of decayed faces and rusted armor, a host of groaning, moaning monsters upon which light falls and instantly seeps away. It is surely an army of darkness. Were you or the barbarians to fight it alone you would surely lose, but together you may have a chance yet!\x7d"
        es = "[img]gfx/ui/events/event_73.png[/img]\x7bLos salvajes no estaban mintiendo: los antiguos han convocado un ejército. Es una hueste de rostros descompuestos y armaduras oxidadas, un grupo de monstruos gemidores y quejumbrosos sobre los cuales la luz cae y se desvanece instantáneamente. Es sin duda un ejército de la oscuridad. Si tú o los bárbaros lucharais solos contra él, seguramente perderíais, ¡pero juntos aún podéis tener una oportunidad!\x7d"
    }
    {
        en = "[img]gfx/ui/events/event_136.png[/img]\x7bThe ancient dead have been slain to the last. As your men and the primitives pick the field, the Barbarian King and the elder come to you. The large warrior nods and grunts, and the elder translates.%SPEECH_ON%He says you did well, very well, and that he wishes men such as yourself and your company would fight alongside him, but he understand that cannot happen. We live in a maze of many worlds and in that maze we all shall stay, lost, sometimes hearing one another's shouts, never having enough time to know each other. He says thanks. And he wishes you well.%SPEECH_OFF%You turn to the elder and ask if he got all that from a simple grunt. The elder smiles.%SPEECH_ON%A grunt, aye, and a lifelong friendship. Travel well, man of the sword.%SPEECH_OFF%The elder hands you a horned helmet, the very one you'd seen the Barbarian King himself wearing at times. He says nothing, only hits his chest and points to the sky and that's all there is.\x7d"
        es = "[img]gfx/ui/events/event_136.png[/img]\x7bLos antiguos muertos han sido eliminados hasta el último de ellos. Mientras tus hombres y los salvajes recogéis el campo, el Rey Bárbaro y el anciano se acercan a ti. El guerrero grande asiente y gruñe, y el anciano traduce.%SPEECH_ON%Él dice que lo hiciste bien, muy bien, y que le gustaría que hombres como tú y tu compañía lucharan a su lado, pero entiende que eso no puede suceder. Vivimos en un laberinto de muchos mundos y en ese laberinto todos nos quedaremos, perdidos, a veces escuchando los gritos de los demás, sin tener tiempo suficiente para conocernos. Él dice gracias. Y te desea lo mejor.%SPEECH_OFF%Te vuelves hacia el anciano y le preguntas si logró entender todo eso de un simple gruñido. El anciano sonríe.%SPEECH_ON%Un gruñido, sí, y una amistad de toda la vida. Ten un buen viaje, espada a sueldo.%SPEECH_OFF%El anciano te entrega un casco con cuernos, el mismo que habías visto al Rey Bárbaro usando en ocasiones. Él no dice nada, solo golpea su pecho y señala al cielo, y eso es todo.\x7d"
    }
    {
        en = "Farewell, king."
        es = "Adiós, rey."
    }
    {
        en = "On your return..."
        es = "As you approach..."
    }
    {
        en = "[img]gfx/ui/events/event_31.png[/img]\x7b%employer% takes the Barbarian King's head and rolls it out of the sack. It tumbles freely, knocking over a tray of goblets which go scattering and clattering about. Even in death the savage is a purveyor of chaos.%SPEECH_ON%Thank you, sellsword.%SPEECH_OFF%Your employer says, nodding to himself as he rights the head and tilts it onto the flap of neck.%SPEECH_ON%He is an ugly mutt, isn't he? Look at those teeth. Look at them! There's holes in those teeth. Absolutely disgusting.%SPEECH_OFF%You tell the man to pay you and he does so as agreed. But he keeps shaking his head and he bares his own teeth and mimics picking at them.%SPEECH_ON%How do you clean teeth like that? With a rope?%SPEECH_OFF%Shrugging, you head out the door, not bothering to tell %employer% that the first thing your men did to that godforsaken head is knife the gold out of its mouth. | You dump the Barbarian King's head onto %employer%'s table. He stares at it, then at you.%SPEECH_ON%That's the biggest fucking head I've ever seen.%SPEECH_OFF%Nodding, you ask for your pay and it is delivered in appropriate sum. Your employer starts pushing the savage's face around, as though he were a sorcerer looking to steal its secrets.%SPEECH_ON%I'd wager this is where tales of ogres come from, yeah? Like a child sees this ugly thing and there it is, his imagination is set alight, and so the monster is born.%SPEECH_OFF%If only things were that simple. | Even without its massive body the head of the Barbarian King makes quite the splash when shown to %employer%. A host of nobles and servants ooh and ahh at the size of it. A man in a black robe is quick to pay you what you're owed. %employer% himself picks the head up and tosses it into the air as to weigh it.%SPEECH_ON%By the old gods, it is truly heavy! Oy %randomname%.%SPEECH_OFF%A servant steps forward. Your employer grins.%SPEECH_ON%Fetch me a pike. We're going to hoist this horror head high into the heavens.%SPEECH_OFF%A suitable stop for a savage. | Mere moments after giving %employer% the head of the Barbarian King it is being used as a plaything. Children of noblemen roll it back and forth across the stone floor, the savage's head knocking over walls of goblets and fortresses of dinner trays. A dog barks as it tracks the head back and forth. %employer% claps you on the shoulder.%SPEECH_ON%Outstanding work, sellsword. Truly. My scouts tell me it was a hell of a fight, that you were almost like a primitive yourself. But I suppose that's what it had to take, right? A savage to fight a savage? Spirit of such primacy can't be contained by our civilized ways!%SPEECH_OFF%One of the kids kicks the King in the face, breaking its jaw and cutting the child's foot on the teeth. The kid screams for help and, perhaps defending its owner, the dog sets upon the head and starts dragging it around by the flap of neck. %employer% smiles again.%SPEECH_ON%Your pay is waiting for you outside. It is in full, as promised.%SPEECH_OFF% | A man in knight's armor takes the Barbarian King's head from you. Immediately, you draw your sword, but %employer% leaps in to end any start to violence.%SPEECH_ON%Oy, sellsword, it is quite alright. Your pay, as promised.%SPEECH_OFF%The man hands you a satchel of crowns, but behind him you see the head being given to a man in a black cloak. You nod and ask what they intend to do with it. %employer% grins.%SPEECH_ON%Frankly, steins await me, sellsword, and I'm quite thirsty.%SPEECH_OFF%The man quickly walks past you. You do not see any ale, or any drink at all, he simply follows the man in the cloak. | %employer% stares at the Barbarian King's head like a cat would meanly stare at anything not its own self.%SPEECH_ON%Interesting. I think I'll have it stuffed and put upon my mantle.%SPEECH_OFF%Speaking slightly out of turn, you remind your employer that it is the head of a man he is referring to. %employer% shrugs.%SPEECH_ON%So? It is a monstrosity. There cannot be coexistence between the civilized and the savage. By having it properly taken care of I will ruminate on that reality. What will you do? Advise me again?%SPEECH_OFF%Pursing your lips, you ask for your pay. The man points toward the corner.%SPEECH_ON%In the satchel there. You did well, sellsword, but don't speak to me in such a manner again. Good day.%SPEECH_OFF%\x7d"
        es = "[img]gfx/ui/events/event_31.png[/img]\x7b%employer% toma la cabeza del Rey Bárbaro y la hace rodar fuera del saco. Gira libremente, derribando una bandeja de copas que se esparcen y chocan. Incluso en la muerte, el salvaje es un promotor del caos.%SPEECH_ON%Gracias, mercenario.%SPEECH_OFF%Tu empleador dice, asintiendo para sí mismo mientras endereza la cabeza y la coloca sobre la solapa del cuello.%SPEECH_ON%Es un perro feo, ¿verdad? Mira esos dientes. ¡Míralos! Hay agujeros en esos dientes. Absolutamente repugnante.%SPEECH_OFF%Le dices al hombre que te pague y él lo hace según lo acordado. Pero él sigue sacudiendo la cabeza y muestra sus propios dientes mientras los recorre con su lengua.%SPEECH_ON%¿Cómo se limpian los dientes? ¿Con una cuerda?%SPEECH_OFF%Encogiéndote de hombros, te diriges hacia la puerta, sin molestarte en decirle a %employer% que lo primero que hicieron tus hombres con esa maldita cabeza fue arrancarle el oro de la boca. | Dejas caer la cabeza del Rey Bárbaro en la mesa de %employer%. Él la mira y luego te mira a ti.%SPEECH_ON%Es la cabeza más grande que he visto en mi vida.%SPEECH_OFF%Asintiendo, pides tu paga y esta se te entrega en la cantidad acordada. Tu empleador comienza a mover la cara del salvaje, como si fuera un hechicero buscando robar sus secretos.%SPEECH_ON%Apostaría a que de aquí vienen los cuentos de ogros, ¿no crees? Como un niño ve esta cosa fea y allí está, su imaginación se enciende, y así nace el monstruo.%SPEECH_OFF%Si tan solo las cosas fueran tan simples. | Incluso sin su cuerpo masivo, la cabeza del Rey Bárbaro hace un gran impacto cuando se la muestras a %employer%. Una multitud de nobles y sirvientes exclaman asombrados por su tamaño. Un hombre con una túnica negra te paga lo que se te debe. %employer% mismo levanta la cabeza y la lanza al aire como para pesarla.%SPEECH_ON%¡Por los antiguos dioses, es realmente pesada! Oye, %randomname%.%SPEECH_OFF%Un sirviente se adelanta. Tu empleador sonríe.%SPEECH_ON%Tráeme una lanza. Vamos a elevar esta horrible cabeza hasta los cielos.%SPEECH_OFF%Un final adecuado para un salvaje. | Apenas momentos después de entregarle la cabeza del Rey Bárbaro a %employer%, esta es utilizada como un juguete. Los hijos de los nobles la ruedan de un lado a otro por el suelo de piedra, derribando torres de copas y fortalezas de bandejas de la cena. Un perro ladra mientras sigue la cabeza de un lado a otro. %employer% te da una palmada en el hombro.%SPEECH_ON%Un trabajo sobresaliente, mercenario. Verdaderamente. Mis exploradores me dicen que fue una pelea infernal, que casi eras como un salvaje tú mismo. Pero supongo que eso era lo que se necesitaba, ¿verdad? ¡Un salvaje para luchar contra un salvaje! ¡El espíritu de tanta primacía no puede ser contenido por nuestras formas civilizadas!%SPEECH_OFF%Uno de los niños le da una patada al Rey en la cara, rompiéndole la mandíbula y cortándose el pie con los dientes. El niño grita pidiendo ayuda y, quizás en defensa de su dueño, el perro se lanza sobre la cabeza y comienza a arrastrarla por el pelo. %employer% sonríe de nuevo.%SPEECH_ON%Tu paga te espera afuera. Está completa, como se prometió.%SPEECH_OFF% | Un hombre en armadura de caballero te arrebata la cabeza del Rey Bárbaro. Inmediatamente, desenvainas tu espada, pero %employer% salta para poner fin a cualquier inicio de violencia.%SPEECH_ON%Vamos, mercenario, está todo bien. Tu paga, como se te prometió.%SPEECH_OFF%El hombre te entrega una bolsa de monedas, pero detrás de él ves que la cabeza se la entregan a un hombre con una capa negra. Asientes y preguntas qué pretenden hacer con ella. %employer% sonríe.%SPEECH_ON%Honestamente, me esperan jarras de cerveza, mercenario, y tengo mucha sed.%SPEECH_OFF%El hombre pasa rápidamente junto a ti. No ves ninguna cerveza, ni ninguna bebida en absoluto, simplemente sigue al hombre de la capa. | %employer% mira la cabeza del Rey Bárbaro como un gato miraría maliciosamente cualquier cosa que no fuera él mismo.%SPEECH_ON%Interesante. Creo que la haré rellenar y la pondré sobre la repisa de la chimenea.%SPEECH_OFF%Hablando un poco fuera de lugar, le recuerdas a tu empleador que se trata de la cabeza de un hombre a la que se refiere. %employer% encoge los hombros.%SPEECH_ON%¿Y qué? Es una monstruosidad. No puede haber coexistencia entre lo civilizado y lo salvaje. Al tenerlo debidamente cuidado, reflexionaré sobre esa realidad. ¿Qué harás tú? ¿Me aconsejarás de nuevo?%SPEECH_OFF%Frunciendo los labios, pides tu paga. El hombre señala hacia la esquina.%SPEECH_ON%Ahí, en la bolsa. Lo hiciste bien, mercenario, pero no vuelvas a hablarme de esa manera. Buen día.%SPEECH_OFF%\x7d"
    }
    {
        en = "Well deserved."
        es = "Supongo que ahora deberían llamarme 'el Matarreyes'."
    }
    {
        // this.World.FactionManager.getFaction(this.Contract.getFaction()).addPlayerRelation(this.Const.World.Assets.RelationNobleContractSuccess, "Killed a self-proclaimed barbarian king");
        mode = "pattern"
        en = "<this.World.FactionManager.getFaction(this.m.Faction).addPlayerRelation(this.Const.World.Assets.RelationContractCancel, Broke a contract)>"
        es = "<this.World.FactionManager.getFaction(this.m.Faction).addPlayerRelation(this.Const.World.Assets.RelationContractCancel, Romper un contrato)>"
    }
    {
        en = "[img]gfx/ui/events/event_31.png[/img]\x7b%employer% welcomes you reluctantly.%SPEECH_ON%You realize I have scouts and spies everywhere, don't you?%SPEECH_OFF%Holding up your empty hands, you tell him you had no intent on lying. The 'barbarian king' will bother the lands no more. Your employer taps his fingers together a few times then nods.%SPEECH_ON%Your honesty is refreshing, though I must say it is quite unfortunate the man and his warband still live. That said, all reports suggest they are moving away so I suppose your work is done all the same, a fat pagan head or not. Your pay, as agreed upon.%SPEECH_OFF%\x7d"
        es = "[img]gfx/ui/events/event_31.png[/img]\x7b%employer% te recibe a regañadientes.%SPEECH_ON%¿Te das cuenta de que tengo exploradores y espías por todas partes, verdad?%SPEECH_OFF%Levantando las manos vacías, le dices que no tenías intención de mentir. El 'rey bárbaro' ya no molestará más sus tierras. Tu empleador junta los dedos unas cuantas veces y luego asiente.%SPEECH_ON%Tu honestidad es refrescante... aunque debo decir que es bastante desafortunado que el hombre y su hueste sigan con vida. Dicho esto, todos los informes sugieren que se están alejando, así que supongo que tu trabajo está hecho de todos modos, con su cabeza pagana o no. Tu paga, como se acordó.%SPEECH_OFF%\x7d"
    }
    {
        // this.World.FactionManager.getFaction(this.Contract.getFaction()).addPlayerRelation(this.Const.World.Assets.RelationNobleContractSuccess, "Resolved the threat of a self-proclaimed barbarian king");
        mode = "pattern"
        en = "<this.World.FactionManager.getFaction(this.m.Faction).addPlayerRelation(this.Const.World.Assets.RelationContractCancel, Broke a contract)>"
        es = "<this.World.FactionManager.getFaction(this.m.Faction).addPlayerRelation(this.Const.World.Assets.RelationContractCancel, Romper un contrato)>"
    }
    {
        en = "region"
        es = ""
    }
