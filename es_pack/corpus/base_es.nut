        en = "Padded Nasal Helmet"
        es = "Yelmo nasal acolchado"
    }
    {
        en = "A metal helmet with added noseguard and a padded coif underneath."
        es = "Un yelmo de metal con protección nasal adicional y una cofia acolchada debajo."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\helmets\physician_mask.nut
    {
        en = "Physician's Mask"
        es = "Máscara del médico"
    }
    {
        en = "A thick leather hood with a distinctive, bird-like mask. The beak acts as a ventilator, containing sweet-smelling herbs to ward away sickness and disease."
        es = "Una gruesa capucha de cuero con una distintiva máscara parecida a un pájaro. El pico actúa como un ventilador y contiene hierbas aromáticas para protegerse de enfermedades y plagas que se transmiten por el aire."
    }
    {
        // text = "Only take [color=" + this.Const.UI.Color.PositiveValue + "]50%[/color] of damage inflicted by harmful miasmas"
        mode = "pattern"
        en = "Only take [color=<this.Const.UI.Color.PositiveValue>]50%[/color] of damage inflicted by harmful miasmas"
        es = "Solo toma [color=<this.Const.UI.Color.PositiveValue>]50%[/color] del daño infligido por miasmas nocivos"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\helmets\reinforced_mail_coif.nut
    {
        en = "Reinforced Mail Coif"
        es = "Cota de malla reforzada"
    }
    {
        en = "A mail coif with additional metal noseguard."
        es = "Una cofia de malla con protector nasal de metal adicional."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\helmets\rusty_mail_coif.nut
    {
        en = "Rusty Mail Coif"
        es = "Cofia de malla oxidada"
    }
    {
        en = "A rusty mail coif that still offers good protection - it leaves horrible stains though."
        es = "Una cofia de malla oxidada que aún ofrece buena protección, aunque deja manchas horribles."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\helmets\sallet_helmet.nut
    {
        en = "Sallet Helmet"
        es = "Yelmo celada"
    }
    {
        en = "A metal sallet helmet with an extended neckguard, a design uncommon in these lands. It is well crafted to offer maximum protection with minimum weight, and without impairing vision."
        es = "Una celada de metal con salvacuellos extendido, un diseño poco común en estas tierras. Su fabricación es impecable para ofrecer la máxima protección con un peso mínimo y sin afectar la visión."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\helmets\steppe_helmet_with_mail.nut
    {
        en = "Steppe Helmet with Mail"
        es = "Yelmo estepario con malla"
    }
    {
        en = "A nasal helmet witch an attached mail neck guard fashioned in the way of the steppe folks."
        es = "Un casco nasal con un protector de cota de malla adjunto diseñado a la manera de las gentes de la estepa."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\helmets\straw_hat.nut
    {
        en = "Straw Hat"
        es = "Sombrero de paja"
    }
    {
        en = "A crude straw hat to protect against the sun."
        es = "Un tosco sombrero de paja para protegerse del sol."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\helmets\undertaker_hat.nut
    {
        en = "Undertaker's Hat"
        es = "Sombrero del sepulturero"
    }
    {
        en = "A wide-brimmed feathered hat with a scarf to cover the mouth. Durable enough to protect against weather and scratches."
        es = "Sombrero de ala ancha y plumas con pañuelo para tapar la boca. Lo suficientemente resistente como para proteger contra la intemperie y los arañazos."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\helmets\witchhunter_hat.nut
    {
        en = "Witchhunter's Hat"
        es = "Sombrero del cazador de brujas"
    }
    {
        en = "A tough leather hat that provides decent protection against scratches."
        es = "Un sombrero de cuero resistente que brinda una protección decente contra rasguños."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\helmets\wizard_hat.nut
    {
        en = "Wizard's Hat"
        es = "Sombrero de hechicero"
    }
    {
        en = "A pointy hat with a broad rim."
        es = "Un sombrero puntiagudo con ala ancha. Usada por magos y hechiceros."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\item.nut
    {
