    }
    {
        en = "Bricks made from dried peat, usually used as fuel. Traders will pay good coin for this."
        es = "Ladrillos elaborados con turba seca, habitualmente utilizados como combustible. Los comerciantes pagarán buenas monedas por esto."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\trade\quality_wood_item.nut
    {
        en = "Quality Wood"
        es = "Madera de calidad"
    }
    {
        en = "High quality wood with no knotholes or other flaws. Traders will pay good coin for this."
        es = "Madera de alta calidad sin nudos ni otros defectos. Los comerciantes pagarán buenas monedas por esto."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\trade\salt_item.nut
    {
        en = "Salt"
        es = "Sal"
    }
    {
        en = "Rock salt used for cooking and curing food. Traders will pay good coin for this."
        es = "Sal de roca utilizada para cocinar y curar alimentos. Los comerciantes pagarán una buena moneda por esto.."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\trade\silk_item.nut
    {
        en = "Silk"
        es = "Seda"
    }
    {
        en = "These smooth silk cloth pieces are very hard to come by. Only the most wealthy and noble can afford to get their garments tailored from it, and they fetch good prices especially in the north."
        es = "Estas piezas de tela de seda suave son muy difíciles de conseguir. Sólo los más ricos y nobles pueden permitirse el lujo de confeccionar sus prendas con él, y alcanzan buenos precios, especialmente en el norte."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\trade\spices_item.nut
    {
        en = "Spices"
        es = "Especias"
    }
    {
        en = "Various flavorful and rare spices heeding from the southern realms. These ingredients are highly sought after in the north."
        es = "Varias especias raras y sabrosas procedentes de los reinos del sur. Estos ingredientes son muy buscados en el norte."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\trade\uncut_gems_item.nut
    {
        en = "Uncut Gems"
        es = "Gemas sin cortar"
    }
    {
        en = "Rough gemstones waiting to be cut and polished. Traders will pay good coin for this."
        es = "Piedras preciosas en bruto esperando a ser cortadas y pulidas. Los comerciantes pagarán buenas monedas por esto."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\ancient\ancient_spear.nut
    {
        en = "Ancient Spear"
        es = "Lanza antigua"
    }
    {
