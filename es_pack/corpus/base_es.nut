    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\ammo\legendary\quiver_of_coated_arrows.nut
    {
        en = "Bloodletter's Reach"
        es = "Alcance del sangriento"
    }
    {
        en = "This strange quiver holds mundane arrows and is meant to be used with bows of all kinds. At the bottom is some sort of mechanism that releases a strange material from a hidden reservoir, coating arrowheads and causing them to inflict particularly grievous serrations. Investigation reveals no obvious explanation to the coating's source, or a way to extract it without disassembling the quiver entirely. Is automatically refilled after each battle if you have enough ammunition."
        es = "Este extraño carcaj contiene flechas comunes y está diseñado para usarse con arcos de todo tipo. En la base hay un mecanismo que libera un material extraño de un depósito oculto, recubriendo las puntas de flecha y provocando dentados particularmente graves. La investigación no revela ninguna explicación obvia sobre el origen del recubrimiento ni una forma de extraerlo sin desmontar el carcaj por completo. Se rellena automáticamente después de cada batalla si se tiene suficiente munición."
    }
    {
        // text = "Inflicts additional stacking [color=" + this.Const.UI.Color.DamageValue + "]" + this.m.BleedDamage + "[/color] bleeding damage per turn, for 2 turns"
        mode = "pattern"
        en = "Inflicts additional stacking [color=<this.Const.UI.Color.DamageValue>]<this.m.BleedDamage>[/color] bleeding damage per turn, for 2 turns"
        es = "Inflige [color=<this.Const.UI.Color.DamageValue>]<this.m.BleedDamage>[/color] daño de sangrado acumulable adicional por turno, durante 2 turnos"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\ammo\powder_bag.nut
