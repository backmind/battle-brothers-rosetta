    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\config\item_names.nut
    {
        en = "Shield"
        es = "Escudo"
    }
    {
        en = "Bulwark"
        es = "Baluarte"
    }
    {
        en = "Protector"
        es = "Fuerte"
    }
    {
        en = "Board"
        es = "Muralla"
    }
    {
        en = "Wall"
        es = "Cobertura"
    }
    {
        en = "Cover"
        es = "Salvaguardia"
    }
