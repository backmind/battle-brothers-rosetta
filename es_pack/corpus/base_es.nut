    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\effects\orc_berserker_potion_effect.nut
    {
        en = "Berserker Rage"
        es = "Furia berserker"
    }
    {
        en = "This character's adrenaline and hormonal glands have mutated, causing a constant heightened emotional state. They can mostly keep this under control in camp, but in high-stress situations the effect is much stronger and fills them with an intense, unconsolable rage."
        es = "Las glándulas de adrenalina y hormonales de este personaje han mutado, lo que provoca un estado emocional constantemente elevado. En su mayoría, pueden mantener esto bajo control en el campamento, pero en situaciones de alto estrés, el efecto es mucho más fuerte y lo llena de una rabia intensa e incontrolable."
    }
    {
        en = "This character gains two stacks of Rage each time they take hitpoint damage, and loses one stack at the end of each turn."
        es = "Este personaje obtiene dos acumulaciones de Furia cada vez que recibe daño en los Puntos de vida y pierde una acumulación al final de cada turno."
    }
    {
        // text = "[color=" + this.Const.UI.Color.PositiveValue + "]+" + (100 - this.Math.maxf(0.3, 1.0 - 0.02 * this.m.RageStacks) * 100) + "%[/color] damage reduction"
        mode = "pattern"
        en = "[color=<this.Const.UI.Color.PositiveValue>]+<100-this.Math.maxf(0.3, 1.0-0.02*this.m.RageStacks)*100>%[/color] damage reduction"
        es = "[color=<this.Const.UI.Color.PositiveValue>]+<100-this.Math.maxf(0.3, 1.0-0.02*this.m.RageStacks)*100>%[/color] menos de daño recibido"
    }
    {
