    {
        en = "Fearless"
        es = "Intrépido"
    }
    {
        en = "There are a lot of old friends to meet in the afterlife. This character is not afraid of death."
        es = "Hay muchos viejos amigos que reencontrar en el más allá. Este personaje no le teme a la muerte."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\traits\fragile_trait.nut
