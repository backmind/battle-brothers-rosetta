        mode = "pattern"
        en = "[color=<this.Const.UI.Color.PositiveValue>]+<1*this.m.RageStacks>[/color] Initiative"
        es = "[color=<this.Const.UI.Color.PositiveValue>]+<1*this.m.RageStacks>[/color] Iniciativa"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\effects\orc_warlord_potion_effect.nut
    {
        en = "This character's limbic system has been altered with an additional substance that allows them to sustain particularly strenuous anaerobic activity for longer. Their skin seems vaguely greener than you remember, too, but you're sure that's a coincidence."
        es = "El sistema límbico de este personaje ha sido modificado con una sustancia adicional que le permite realizar actividades anaeróbicas especialmente intensas durante más tiempo. Su piel parece vagamente más verdosa de lo que recuerdas, pero seguramente es una coincidencia."
    }
    {
        en = "Using orc weapons no longer imposes additional fatigue costs"
        es = "Usar armas orcas ya no impone costos de Fatiga adicionales."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\effects\orc_warrior_potion_effect.nut
    {
        en = "Sensory Redundancy"
        es = "Redundancia sensorial"
    }
    {
        en = "This character's body has mutated to develop a number of redundant synapses, allowing them to maintain a degree of control over sight, hearing, and muscle control even when struck with debilitating blows."
        es = "El cuerpo de este personaje ha mutado para desarrollar una serie de sinapsis redundantes, lo que les permite mantener cierto grado de control sobre la vista, el oído y el control muscular incluso cuando recibe golpes debilitantes."
    }
    {
        // text = "[color=" + this.Const.UI.Color.PositiveValue + "]33%[/color] chance to resist the Dazed, Staggered, Stunned, Distracted, and Withered status effects"
        mode = "pattern"
        en = "[color=<this.Const.UI.Color.PositiveValue>]33%[/color] chance to resist the Dazed, Staggered, Stunned, Distracted, and Withered status effects"
        es = "[color=<this.Const.UI.Color.PositiveValue>]33%[/color] de probabilidad de resistir los efectos de estado Atontado, Tambaleante, Aturdido, Distraído, y Marchito"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\effects\orc_young_potion_effect.nut
    {
        en = "Kinetic Blows"
        es = "Golpes cinéticos"
    }
    {
        en = "This character's wrists have mutated in such a way that the they dampen the initial shock of opposing forces. In more practical terms, they reduce the protective qualities of an enemy's armor when struck. They can also make some pretty outlandish shadow puppets."
        es = "Las muñecas de este personaje han mutado de tal manera que amortiguan el impacto inicial de las fuerzas opuestas. En términos más prácticos, reducen las cualidades protectoras del blindaje del enemigo cuando es golpeado. Sus muñecas también le permiten hacer algunos títeres de sombras bastante extravagantes."
    }
    {
