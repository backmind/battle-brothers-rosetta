        es = "Una pica con hoja y punta rota. No todas las armas resisten la prueba del tiempo. Alguna vez se usó para atacar a cierta distancia y mantener al enemigo a raya."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\ancient\crypt_cleaver.nut
