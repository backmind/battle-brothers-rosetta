        es = "Una hoja recta de origen antiguo. La empuñadura está cubierta de extrañas ornamentaciones, lo que puede hacerla valiosa para los historiadores y otras personas con mentalidad académica."
    }
    {
        en = "Sword, One-Handed"
        es = "Espada, Una mano"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\ancient\bladed_pike.nut
