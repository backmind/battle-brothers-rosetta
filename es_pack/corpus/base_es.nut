        es = "Unas [color=<this.Const.UI.Color.PositiveValue>]<this.m.Amount>[/color] coronas, la moneda de estas tierras. Se agregará a tu stock global una vez que regreses al mapa mundial."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\supplies\pickled_mushrooms_item.nut
    {
        en = "Mushrooms"
        es = "Champiñones"
    }
    {
        en = "Provisions. Swampy regions offer little food, but pickled mushrooms are a favoured provision for travelers in these areas."
        es = "Provisiones. Las regiones pantanosas ofrecen poca comida, pero las setas encurtidas son un alimento favorito para los viajeros en estas zonas."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\supplies\preserved_mead_item.nut
    {
        en = "Preserved Mead"
        es = "Hidromiel conservado"
    }
    {
        en = "Provisions. This ashen liquid has small sparkles of silver swirrling about. The taste is off, but it hardly ever spoils."
        es = "Provisiones. Este líquido ceniciento tiene pequeños destellos plateados arremolinándose. El sabor es desagradable, pero casi nunca se estropea."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\supplies\rice_item.nut
    {
        en = "Rice"
        es = "Arroz"
    }
    {
        en = "Provisions. Rice is cheap and readily available in the south. Spiced up with various herbs it becomes a tasty dish."
        es = "Provisiones. El arroz es barato y se consigue fácilmente en el sur. Condimentado con diversas hierbas, se convierte en un plato sabroso."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\supplies\roots_and_berries_item.nut
    {
        en = "Roots and Berries"
        es = "Raíces y bayas"
    }
    {
        en = "Provisions. Dried roots and berries are not the most exciting of rations but easy to come by and durable."
        es = "Provisiones. Las raíces y bayas secas no son las raciones más interesantes, pero son duraderas y fáciles de conseguir."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\supplies\smoked_ham_item.nut
    {
        en = "Smoked Ham"
        es = "Jamón ahumado"
    }
    {
        en = "Provisions. There are many ways to preserve food. This piece of ham has been treated in a smoking hut."
        es = "Provisiones. Hay muchas formas de conservar los alimentos. Esta pieza de jamón ha sido tratada en una caseta de ahumado."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\supplies\strange_meat_item.nut
    {
        en = "Strange Meat"
        es = "Carne extraña"
    }
    {
        en = "Provisions. Meat of indefinable origin. Eating this may seem risky, but is preferable to starving."
        es = "Provisiones. Carne de origen indefinible. Comer esto puede parecer arriesgado, pero es preferible a pasar hambre. El hambre es el mejor condimento."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\supplies\wine_item.nut
    {
        en = "Wine"
        es = "Vino"
    }
    {
        en = "Provisions. Wine made from squashed and fermented grapes. Both elaborate to produce and expensive to buy."
        es = "Provisiones. Vino elaborado con uvas prensadas y fermentadas. Ambos son complicados de producir y caros de comprar."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\tools\acid_flask_item.nut
    {
        en = "Acid Flask"
        es = "Frasco de ácido"
    }
    {
        en = "A flask filled with the concentrate of a Lindwurm's acidic blood. It is highly corrosive to many materials and burns through armor quickly. Can be thrown at short ranges."
        es = "Un matraz lleno del concentrado de sangre ácida de Lindwurm. Es altamente corrosivo para muchos materiales y quema rápidamente la armadura. Se puede lanzar a distancias cortas."
    }
    {
        en = "Worn in Offhand"
        es = "Usado en la mano izquierda"
