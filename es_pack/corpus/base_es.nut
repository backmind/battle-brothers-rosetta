    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\effects\geist_potion_effect.nut
    {
        en = "Kinetic Coating"
        es = "Recubrimiento cinético"
    }
    {
        en = "This character is able to secrete a substance that vibrates rapidly when stimulated. When applied to weapons, this creates a strong kinetic force that aids in armor penetration."
        es = "Este personaje es capaz de secretar una sustancia que vibra rápidamente cuando se estimula. Cuando se aplica a armas, esto crea una fuerte fuerza cinética que ayuda a penetrar la armadura."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\effects\goblin_grunt_potion_effect.nut
    {
        en = "Reactive Leg Muscles"
        es = "Músculos de pierna reactivos"
    }
    {
        en = "This character's legs have been mutated, allowing them to make swift, complex movements more smoothly and with greater rapidity. When at rest, the muscles can still occasionally be seen twitching underneath the skin."
        es = "Las piernas de este personaje han sido mutadas, permitiéndole realizar movimientos veloces y complejos con mayor fluidez y rapidez. Cuando está en reposo, ocasionalmente todavía se pueden ver los músculos contrayéndose debajo de la piel."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\effects\goblin_overseer_potion_effect.nut
    {
        en = "Mutated Cornea"
        es = "Córnea mutada"
    }
    {
        en = "This character's eyes have been permanently mutated and are now capable of detecting the subtlest movements of wind and air. While minor on its own, this allows them to better predict the trajectory of projectile attacks and better land hits on vulnerable parts of a target."
        es = "Los ojos de este personaje han sido mutados permanentemente y ahora son capaces de detectar los movimientos más sutiles del viento y el aire. Si bien es menor por sí solo, esto les permite predecir mejor la trayectoria de los ataques de proyectiles y lograr mejores impactos en partes vulnerables de un objetivo."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\effects\goblin_poison_effect.nut
    {
        en = "Poisoned"
        es = "Envenedado"
    }
    {
        // return "This character has poison running through his veins. His vision is blurred, his speech slurred and it takes a great deal of effort for him to move in a coordinated fashion. The effect will slowly wear off over [color=" + this.Const.UI.Color.NegativeValue + "]" + this.m.TurnsLeft + "[/color] more turn(s).";
        mode = "pattern"
        en = "This character has poison running through his veins. His vision is blurred, his speech slurred and it takes a great deal of effort for him to move in a coordinated fashion. The effect will slowly wear off over [color=<this.Const.UI.Color.NegativeValue>]<this.m.TurnsLeft>[/color] more turn(s)."
        es = "Este personaje tiene veneno corriendo por sus venas. Su visión es borrosa, habla confusamente y le cuesta mucho esfuerzo moverse de manera coordinada. El efecto desaparecerá lentamente a lo largo de [color=<this.Const.UI.Color.NegativeValue>]<this.m.TurnsLeft>[/color] turno(s) más."
