    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\helmets\oriental\wrapped_southern_helmet.nut
    {
        en = "Wrapped Southern Helmet"
        es = "Yelmo sureño con turbante"
    }
    {
        en = "This metal helmet is wrapped in cloth to protect against the blazingly hot sun of the southern deserts."
