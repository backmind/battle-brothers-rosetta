        es = "Las manos quemadas reducen gravemente la capacidad de realizar movimientos rápidos y precisos. Además, duele muchísimo."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\injury\burnt_legs_injury.nut
    {
        en = "Burnt Leg"
        es = "Pierna quemada"
    }
    {
        en = "Burn wounds on the legs limit mobility and make it painful to move quickly."
        es = "Las quemaduras en las piernas limitan la movilidad y hacen que sea doloroso moverse rápidamente."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\injury\crushed_finger_injury.nut
    {
        en = "Crushed Finger"
        es = "Dedo aplastado"
    }
    {
        en = "An unlucky hit crushed a finger, making it painful to maintain a firm grip."
        es = "Un golpe desafortunado aplastó un dedo, haciendo doloroso mantener un agarre firme."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\injury\crushed_windpipe_injury.nut
    {
        en = "Crushed Windpipe"
        es = "Tráquea aplastada"
    }
    {
        en = "A blow to the neck injured the windpipe, making it very hard and painful to draw breath, let alone to keep fighting."
        es = "Un golpe en el cuello le lesionó la tráquea, lo que hizo que fuera muy difícil y doloroso respirar, y mucho menos seguir luchando."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\injury\cut_achilles_tendon_injury.nut
