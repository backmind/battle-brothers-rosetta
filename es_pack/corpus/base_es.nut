    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\winged_mace.nut
    {
        en = "Winged Mace"
        es = "Maza alada"
    }
    {
        en = "A full-metal mace with a short shaft and attached blades."
        es = "Una maza totalmente metálica con un mango corto y bordes afilados en la punta."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\wonky_bow.nut
    {
        en = "Wonky Bow"
        es = "Arco torcido"
    }
    {
        en = "An ill-conceived bow if you ever saw one. The wood cricks and cracks when bent, the string frizzes and goes wiry every time you draw it back."
        es = "Un arco mal concebido si alguna vez viste uno. La madera cruje y se agrieta cuando se dobla, la cuerda se encrespa y se vuelve áspera cada vez que la tensas."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\woodcutters_axe.nut
    {
        en = "Woodcutter's Axe"
        es = "Hacha de leñador"
    }
    {
        en = "A long, two-handed axe that bears down heavy with every swing. Held with both hands it is used to cut down large trees, but will cut down men just as well."
        es = "Un hacha larga de dos manos que asesta pesado golpes. Sostenido con ambas manos se usa para talar árboles grandes, pero también puede talar hombres."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\wooden_flail.nut
    {
        en = "Wooden Flail"
        es = "Mayal de madera"
    }
    {
        en = "Two large sticks attached with a short chain, the Wooden Flail is an agricultural tool used to strike piles of grain to loosen the husks. As an improvised weapon it's rather unpredictable but useful to strike over or around shield cover."
        es = "El mayal de madera, dos palos grandes unidos con una cadena corta, es una herramienta agrícola que se utiliza para golpear montones de grano y aflojar las cáscaras. Como arma improvisada, es bastante impredecible pero útil para atacar por encima o alrededor de la cobertura del escudo."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\wooden_stick.nut
    {
        en = "Wooden Stick"
        es = "Garrote de madera"
    }
    {
        en = "A simple wooden stick, usually an improvised weapon."
        es = "Un simple palo de madera, normalmente un arma improvisada."
    }
