    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\actives\rally_the_troops.nut
    {
        en = "Raaaaally! Use this character's inspirational resolve to rally nearby fleeing allies and push everyone to go the extra mile. A single character can only be rallied once per round."
        es = "¡Reeeeuníos! Usa la determinación inspiradora de este personaje para reunir a los aliados cercanos que huyen y empujar a todos a hacer un esfuerzo adicional. Cada personaje sólo puede arengarse una vez por ronda."
    }
    {
        // text = "Triggers a morale check to rally fleeing allies within 4 tiles distance, with a bonus to Resolve of [color=" + this.Const.UI.Color.PositiveValue + "]+" + bravery + "[/color] based on this character\'s Resolve"
        mode = "pattern"
        en = "Triggers a morale check to rally fleeing allies within 4 tiles distance, with a bonus to Resolve of [color=<this.Const.UI.Color.PositiveValue>]+<bravery>[/color] based on this character's Resolve"
        es = "Activa un chequeo de moral para reunir a los aliados que están Huyendo dentro de una distancia de 4 casillas, con un bono a la Resolución de [color=<this.Const.UI.Color.PositiveValue>]+<bravery>[/color] basado en la Resolución de este personaje"
    }
    {
        // text = "Triggers a morale check to raise the morale of anyone wavering or worse within 4 tiles distance, with a bonus to Resolve of [color=" + this.Const.UI.Color.PositiveValue + "]+" + bravery + "[/color] based on this character\'s Resolve, but lowered by [color=" + this.Const.UI.Color.NegativeValue + "]-10[/color] per tile distance"
        mode = "pattern"
        en = "Triggers a morale check to raise the morale of anyone wavering or worse within 4 tiles distance, with a bonus to Resolve of [color=<this.Const.UI.Color.PositiveValue>]+<bravery>[/color] based on this character's Resolve, but lowered by [color=<this.Const.UI.Color.NegativeValue>]-10[/color] per tile distance"
        es = "Activa un chequeo de moral para elevar la moral de cualquiera que esté Vacilante o peor. dentro de una distancia de 4 casillas, con un bono a la Resolución de [color=<this.Const.UI.Color.PositiveValue>]+<bravery>[/color] basado en la Resolución de este personaje, pero disminuyendo [color=<this.Const.UI.Color.NegativeValue>]-10[/color] por casilla de distancia"
    }
    {
        en = "Removes the Sleeping status effect of allies within 4 tiles distance"
        es = "Elimina el efecto de estado de Durmiendo de los aliados dentro de una distancia de 4 casillas"
    }
    {
        // text = "[color=" + this.Const.UI.Color.NegativeValue + "]Can not rally others the same turn as being rallied himself[/color]"
        mode = "pattern"
        en = "[color=<this.Const.UI.Color.NegativeValue>]Can not rally others the same turn as being rallied himself[/color]"
        es = "[color=<this.Const.UI.Color.NegativeValue>]No puede arengar a otros más de una vez por turno[/color]"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\actives\reap_skill.nut
    {
        en = "Reap"
        es = "Segar"
    }
    {
        en = "A sweeping strike in a wide arc that hits three adjacent tiles in counter-clockwise order over some distance. Be careful around your own men unless you want to relieve your payroll!"
        es = "Un corte de barrido en un arco amplio que golpea tres fichas adyacentes en sentido antihorario a cierta distancia. ¡Ten cuidado con tus propios hombres a menos que quieras reducir tu nómina!"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\skills\actives\recover_skill.nut
    {
        en = "Take a deep breath and rest for a turn in order to recover your strength."
        es = "Respira hondo y descansa un rato para recuperar fuerzas."
    }
    {
        en = "Current Fatigue is reduced by half"
        es = "La Fatiga actual se reduce a la mitad"
    }
