    }
    {
        en = "Bow, Two-Handed"
        es = "Arco, Dos manos"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\greenskins\goblin_crossbow.nut
    {
        en = "Spiked Impaler"
        es = "Empalador puntiagudo"
    }
    {
        en = "A large and heavy crossbow with menacing spikes in front. More like a minitature ballista, it shoots stakes with enough force to knock back a target hit."
        es = "Una ballesta grande y pesada con púas amenazadoras al frente. Más bien una balista en miniatura, dispara estacas con suficiente fuerza para derribar a un caballero, o un gigante."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\greenskins\goblin_falchion.nut
    {
        en = "Cruel Falchion"
        es = "Bracamarte cruel"
    }
    {
        en = "A lightweight goblin falchion made for cutting."
        es = "Una hoja curva goblin ligera, hecha para cortar."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\greenskins\goblin_heavy_bow.nut
    {
        en = "Reinforced Boondock Bow"
        es = "Arco Boondock reforzado"
    }
    {
        en = "A light, yet powerful bow made from various woods."
        es = "Un arco ligero pero potente fabricado con varias maderas."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\greenskins\goblin_notched_blade.nut
    {
        en = "Notched Blade"
        es = "Hoja mellada"
    }
    {
        en = "A long curved knife with a one sided blade used for slashing, hacking and stabbing at weak spots."
        es = "Un cuchillo largo y curvo con una hoja de un solo filo que se utiliza para cortar, tajear y apuñalar en los puntos débiles."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\greenskins\goblin_pike.nut
    {
        en = "Jagged Pike"
        es = "Pica dentada"
    }
    {
        en = "A long jagged pike that can tear bleeding wounds and keep enemies at bay with its long reach."
        es = "Una pica larga y dentada que puede desgarrar heridas sangrantes y mantener a raya a los enemigos con su largo alcance."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\greenskins\goblin_spear.nut
    {
        en = "Goblin Skewer"
        es = "Escarbadientes goblin"
    }
    {
        en = "A long shaft with a sharp metal tip at the top."
        es = "Un bastón largo con una punta metálica afilada en la parte superior."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\greenskins\goblin_spiked_balls.nut
    {
        en = "Bundle of Spiked Bolas"
        es = "Bolsa de bolas con pinchos"
    }
    {
        en = "Small and heavy iron balls with metal spikes to be hurled at a target."
        es = "Pequeñas y pesadas bolas de hierro con púas de metal que se lanzan al objetivo."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\greenskins\goblin_staff.nut
    {
        en = "Gnarly Staff"
        es = "Palo retorcido"
    }
    {
        en = "A gnarly staff carved from old and hard wood, adorned with bones and feathers. May be of interest to collectors."
        es = "Un bastón retorcido tallado en madera vieja y dura, adornado con huesos y plumas. Puede ser de interés para los coleccionistas."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\greenskins\orc_axe.nut
    {
        en = "Head Splitter"
        es = "Partecabezas"
    }
    {
        en = "A heavy piece of metal with a sharp head. Not made for human hands."
        es = "Una pesada pieza de metal con una cabeza afilada. No hecho para manos humanas."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\greenskins\orc_axe_2h.nut
    {
        en = "Man Splitter"
        es = "Partehombres"
    }
    {
        en = "A huge and crudely built double headed battleaxe too heavy to be used effectively by the average human."
        es = "Un hacha de batalla de dos cabezas, enorme y de construcción tosca, demasiado pesada para ser utilizada eficazmente por un humano promedio."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\greenskins\orc_cleaver.nut
    {
        en = "Head Chopper"
        es = "Cortacabezas"
    }
    {
        en = "A sharp and crude shard of metal with a wrapped grip resembling a sword but a lot heavier. Not made for human hands."
        es = "Un fragmento de metal tosco y afilado con una empuñadura envuelta que se asemeja a una espada pero mucho más pesada. No hecho para manos humanas."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\greenskins\orc_flail_2h.nut
    {
        en = "Berserk Chain"
        es = "Cadena de Berserk"
    }
    {
        en = "A massive iron chain with a spiked full metal head at the end. Too heavy to be used effectively by the average human."
        es = "Una enorme cadena de hierro con una cabeza de metal con púas en el extremo. Demasiado pesado para ser utilizado eficazmente por el ser humano promedio."
    }
    {
        en = "Flail, Two-Handed"
        es = "Mayal, Dos manos"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\greenskins\orc_javelin.nut
    {
        en = "Bundle of Crude Javelins"
        es = "Carcaj de jabalinas toscas"
    }
    {
        en = "A bunch of crudely made javelins intended for throwing at targets. Have limited range and are exhausting to throw, but may inflict devastating injuries."
        es = "Un montón de jabalinas toscamente diseñadas para ser lanzadas a objetivos. Tienen un alcance limitado y son agotadores de lanzar, pero pueden causar lesiones devastadoras. También puede infligir daños menores a los escudos si estos son golpeados."
    }
    {
        en = "Bundle of Crude Javelins (Empty)"
        es = "Carcaj de jabalinas toscas (vacío)"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\greenskins\orc_metal_club.nut
    {
        en = "A massive wooden club studded with metal plates. Not made for human hands."
        es = "Un enorme garrote de madera tachonado de placas de metal. No hecho para manos humanas."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\greenskins\orc_wooden_club.nut
    {
        en = "Tree Limb"
        es = "Rama de árbol"
    }
    {
        en = "A big and heavy branch torn from a tree. Not well suited for human hands."
        es = "Una rama grande y pesada arrancada de un árbol. No muy adecuado para manos humanas."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\hand_axe.nut
    {
        en = "Handaxe"
        es = "Hacha de mano"
    }
    {
        en = "A one-handed axe with a medium long shaft and a refined head."
        es = "Un hacha de una mano con un mango de longitud media y una cabeza refinada. Muy utilizada por saqueadores y asaltantes marinos."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\hatchet.nut
    {
        en = "Hatchet"
        es = "Hachuela"
    }
    {
        en = "A crude axe with a short shaft and an iron head."
        es = "Un hacha tosca con un mango corto y una cabeza de hierro."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\heavy_crossbow.nut
    {
        en = "Heavy Crossbow"
        es = "Ballesta pesada"
    }
    {
        en = "A heavy crossbow with a crank that can propel bolts over medium distances and is effective even against heavily armored targets. Requires almost a full turn to reload."
        es = "Una ballesta pesada con manivela que puede impulsar virotes a distancias medias y es eficaz incluso contra objetivos fuertemente blindados. Los nobles y caballeros intentaron prohibir esta arma llamándola \x22injusta, cobarde y profana\x22. Demás está decir, que su intento fue infructuoso."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\hooked_blade.nut
    {
        en = "An agricultural tool adapted for use in battle, this polearm has a hooked blade for striking over some distance and pulling in targets."
        es = "Esta arma de asta, una herramienta agrícola adaptada para su uso en la batalla, tiene una hoja en forma de gancho para atacar a cierta distancia y atraer objetivos."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\hunting_bow.nut
    {
        en = "Hunting Bow"
        es = "Arco de caza"
    }
    {
        en = "A refined bow usually used for hunting down animals. Deadly against unarmored targets, but requires some expertise to use effectively."
        es = "Un arco refinado que suele utilizarse para cazar animales. Mortal contra objetivos no blindados, pero requiere cierta experiencia para usarlo de manera efectiva."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\javelin.nut
    {
        en = "Bundle of Javelins"
        es = "Bolsa de javalinas"
    }
    {
        en = "A couple of light throwing spears usually carried by skirmishers. Have limited range and are exhausting to throw, but may inflict devastating injuries."
        es = "Un par de lanzas arrojadizas ligeras que suelen llevar los hostigadores. Tienen un alcance limitado y son agotadoras de lanzar, pero pueden causar lesiones devastadoras."
    }
    {
        en = "Bundle of Javelins (Empty)"
        es = "Bolsa de javalinas (vacía)"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\knife.nut
    {
        en = "Knife"
        es = "Cuchillo"
    }
    {
        en = "A short knife, not made for combat."
        es = "Un cuchillo corto, no hecho para el combate."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\legendary\lightbringer_sword.nut
    {
        en = "The crepuscular sword bends purples and oranges until it seemingly carries twilight itself in its fuller. Held to the touch, one cannot tell if they are being burned or chilled. Magic or well-crafted, whatever the weapon is it vibrates as though it were fighting off power immense and you need only swing it to find the steel's true charge."
        es = "La espada crepuscular se dobla en tonos morados y naranjas hasta que parece que lleva el propio crepúsculo en su hoja. Al sostenerla, uno no puede decir si se está quemando o enfriando. Ya sea magia o artesanía magistralmente elaborada, lo que sea que sea esta arma, vibra como si estuviera luchando contra un poder inmenso y solo necesitas blandirla para descubrir la verdadera carga del acero."
    }
    {
        // text = "Inflicts an additional [color=" + this.Const.UI.Color.DamageValue + "]10[/color] - [color=" + this.Const.UI.Color.DamageValue + "]20[/color] damage that ignores armor to up to three targets"
        mode = "pattern"
        en = "Inflicts an additional [color=<this.Const.UI.Color.DamageValue>]10[/color] - [color=<this.Const.UI.Color.DamageValue>]20[/color] damage that ignores armor to up to three targets"
        es = "Inflige un daño adicional de [color=<this.Const.UI.Color.DamageValue>]10[/color] - [color=<this.Const.UI.Color.DamageValue>]20[/color] que ignora la armadura de hasta tres objetivos"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\legendary\miasma_flail.nut
    {
        en = "Censer of the Diviner"
        es = "Incensario del Gran Avidino"
    }
    {
        en = "A heavy censer, repurposed into a vicious flail-head, on a long handle. You know not what incense the Grand Diviner used to fuel his mad visions, but it burns like poison and the weapon produces it from some unknown, inexorable source."
        es = "Un pesado incensario, reconvertido en un feroz mayal, con un mango largo. No sabes qué incienso usaba el Gran Adivino para alimentar sus visiones demenciales, pero arde como veneno y el arma lo produce de una fuente desconocida e inexorable."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\legendary\obsidian_dagger.nut
    {
        en = "Obsidian Dagger"
        es = "Daga de obsidiana"
    }
    {
        en = "A hermit witch gave you this stone dagger after tempering it with your blood. Reflections in its glass seem to move on their own, but this is clearly a trick of the eye. Very curiously, however, blood never seems to dry if it rests upon the obsidian."
        es = "Una bruja ermitaña te dio esta daga de piedra después de templarla con tu sangre. Los reflejos en su cristal parecen moverse por sí solos, pero esto es claramente un truco de la vista. Sin embargo, es muy curioso que la sangre nunca parezca secarse si reposa sobre la obsidiana."
    }
    {
        en = "Resurrects any human killed with it as a Wiederganger fighting for you"
        es = "Resucita a cualquier humano asesinado con ella como un Wiederganger que lucha por ti."
    }
    {
        // if (!this.isKindOf(_target, "player") && !this.isKindOf(_target, "human"))
        mode = "pattern"
        en = "<this.World.FactionManager.getFaction(this.m.Faction).addPlayerRelation(this.Const.World.Assets.RelationContractCancel, Broke a contract)>"
        es = "<this.World.FactionManager.getFaction(this.m.Faction).addPlayerRelation(this.Const.World.Assets.RelationContractCancel, Romper un contrato)>"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\light_crossbow.nut
    {
        en = "Light Crossbow"
        es = "Ballesta ligera"
    }
    {
        en = "A lighter variant of a pull-lever crossbow that can propel bolts over medium distances. Effective even in the hands of laymen, but requires almost a full turn to reload."
        es = "Una variante más ligera de una ballesta de palanca que puede impulsar proyectiles a distancias medias. Efectivo incluso en manos de profanos, pero requiere casi un giro completo para recargar."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\longaxe.nut
    {
        en = "A relatively thin blade on a very long shaft used for devastating cutting attacks over some distance, and to render shields unusable from behind the frontline."
        es = "Una hoja relativamente delgada en un eje muy largo que se usa para ataques cortantes devastadores a cierta distancia y para inutilizar escudos detrás de la línea del frente."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\longsword.nut
    {
        en = "Longsword"
        es = "Espada larga"
    }
    {
        en = "A long two-handed blade that makes for a versatile weapon."
        es = "Una hoja larga a dos manos que la convierte en un arma versátil."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\lute.nut
    {
        en = "Lute"
        es = "Laud"
    }
    {
        en = "A musical instrument that, if in the right hands, is capable of producing pleasant sounds with its vibrating strings."
        es = "Un instrumento musical que, en las manos adecuadas, es capaz de producir sonidos agradables con sus cuerdas vibrantes."
    }
    {
        en = "Musical Instrument, Two-Handed"
        es = "Instrumento musical, Dos manos"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\masterwork_bow.nut
    {
        en = "Masterwork Bow"
        es = "Arco magistralmente elaborado"
    }
    {
        en = "A finely crafted bow, light in grip and perfectly balanced for accuracy. Constructed from different woods, it has colors of this tree and that spiral through the curve of the weapon, looking arboreally damascened. Truly the work of a master bowyer."
        es = "Un arco finamente elaborado, de agarre ligero y perfectamente equilibrado para mayor precisión. Construido con diferentes maderas, tiene los colores de este árbol y gira en espiral a lo largo de la curva del arma, luciendo arbóreamente damasquinado. Verdaderamente, el trabajo de un constructor de arcos maestro."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\military_cleaver.nut
    {
        en = "Military Cleaver"
        es = "Cuchilla militar"
    }
    {
        en = "A large, sharpened metal blade designed to deal devastating blows."
        es = "Una hoja de metal grande y afilada diseñada para asestar golpes devastadores."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\military_pick.nut
    {
        en = "Military Pick"
        es = "Pico militar"
    }
    {
        en = "A wooden shaft with a long and pointy metal head designed to puncture the sturdiest of armors."
        es = "Un mango de madera con una cabeza de metal larga y puntiaguda diseñada para perforar las armaduras más resistentes."
    }
    {
        en = "Hammer, One-Handed"
        es = "Martillo, Una mano"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\militia_spear.nut
    {
        en = "Militia Spear"
        es = "Lanza de milicia"
    }
    {
        en = "A simple wooden spear with a metal tip."
        es = "Una simple lanza de madera con punta de metal."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\morning_star.nut
    {
        en = "Morning Star"
        es = "Lucero del alba"
    }
    {
        en = "A wooden shaft with a spiked metal head used to deliver a combination of blunt-force and puncturing blows."
        es = "Un mango de madera unido a una cabeza de metal con púas que se utiliza para asestar una combinación de golpes contundentes y punzantes."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_axe.nut
    {
        en = "A well-crafted and rare variant of an axe explicitly designed for fighting armored opponents."
        es = "Una variante rara y bien elaborada de un hacha diseñada explícitamente para luchar contra oponentes blindados."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_bardiche.nut
    {
        en = "This heavy bardiche made from a rare alloy is vastly superior to similar weapons."
        es = "Esta pesada bardiche fabricada con una rara aleación es muy superior a armas similares."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_battle_whip.nut
    {
        en = "A whip is quite the peculiar weapon, but this piece has been crafted by a true master. It is more durable and balanced than any other you've seen."
        es = "Un látigo es un arma peculiar, pero este en particular ha sido creado por un auténtico maestro. Está mejor balanceado y es más duradero que cualquier otro que hayas visto."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_billhook.nut
    {
        en = "A pike-like weapon with a blade for striking over some distance and a hook attached for pulling in targets. The smith who forged this weapon certainly knew what he was doing."
        es = "Un arma parecida a una pica con una hoja para golpear a cierta distancia y un gancho para atraer objetivos. El herrero que forjó esta arma ciertamente sabía lo que estaba haciendo."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_bladed_pike.nut
    {
        en = "This pike with a swerved blade hails from the legions of the ancient empire. Very few weapons have been preserved as well as this piece."
        es = "Esta pica con hoja desviada proviene de las legiones del antiguo imperio. Se han conservado muy pocas armas tan bien como esta pieza."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_cleaver.nut
    {
        en = "A masterful smith managed to create this military cleaver in a way that it handles almost like a regular sword but loses nothing of its devastating power."
        es = "Un maestro herrero logró crear esta cuchilla militar de una manera que se maneja casi como una espada normal, pero no pierde nada de su poder devastador."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_crossbow.nut
    {
        en = "A pull-lever crossbow that can propel bolts over medium distances. Effective even in the hands of laymen, but requires almost a full turn to reload. Well balanced and with extraordinarily strong sinews, this weapon is truly the work of a master craftsman."
        es = "Una arbalesta que puede impulsar virotes a distancias medias. Efectivo incluso en manos de profanos, pero requiere casi un giro completo para recargar. Bien equilibrada y con tendones extraordinariamente fuertes, esta arma es verdaderamente obra de un maestro artesano."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_crypt_cleaver.nut
    {
        en = "A massive cleaver that can cut through flesh and armor alike. This piece is in good condition despite its old age."
        es = "Una enorme cuchilla que puede cortar carne y armaduras por igual. Esta pieza está en buen estado a pesar de su antigüedad."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_dagger.nut
    {
        en = "A short and hardened dagger, masterfully crafted with a pointed blade for piercing through the smallest gaps in armor."
        es = "Una daga corta y endurecida, magistralmente elaborada con una hoja puntiaguda para atravesar los huecos más pequeños de la armadura."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_estoc.nut
    {
        en = "Crafting the swift piercing blade of any estoc is no small feat, yet this piece stands as exceptional even amongst its peers."
        es = ""
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_exesword.nut
    {
        en = "An expertly honed executioner's sword that ensures a painless demise. The ornately decorated blade suggests it has been used to sever many a noble neck."
        es = ""
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_fencing_sword.nut
    {
        en = "Crafting a proper fencing sword, both delicate and flexible, is no less difficult than wielding it. The smith that brought this particular weapon into existence must have been among the best in his trade."
        es = "Elaborar una espada de esgrima adecuada, delicada y flexible, no es menos difícil que empuñarla. El herrero que creó esta arma en particular debe haber estado entre los mejores en su oficio. Un arma elegante y hermosa."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_flail.nut
    {
        en = "A separate striking head attached to a handle by a chain. A rather unpredictable weapon, but useful to strike over or around shield cover. This particular flail seems even more terrifying due to its unique characteristics."
        es = "Una cabeza contundente de acero unida a un mango mediante una cadena. Un arma bastante impredecible, pero útil para atacar por encima o alrededor de la cobertura del escudo. Este mayal en particular parece aún más aterrador debido a sus características únicas."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_goblin_falchion.nut
    {
        en = "Fashioned from sharpened black rock, this cruel blade can tear wounds faster than the eye can see. A truly remarkable piece."
        es = "Fabricada con roca negra afilada, esta cruel espada puede desgarrar heridas más rápido de lo que el ojo puede ver. Una pieza verdaderamente notable."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_goblin_heavy_bow.nut
    {
        en = "Goblins know how to craft efficient and light bows. This piece, made from some unknown pale wood, has surprising pulling power despite its small size."
        es = "Los goblins saben cómo fabricar arcos ligeros y eficientes. Esta pieza, realizada con una madera pálida desconocida, tiene un poder de tensión sorprendente a pesar de su pequeño tamaño."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_goblin_pike.nut
    {
        en = "A goblin pike with its jagged tips can tear terrible, bleeding wounds. This piece is particularly well-crafted."
        es = "Una pica goblin con sus puntas dentadas puede provocar heridas terribles y sangrantes. Esta pieza está particularmente bien elaborada."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_goblin_spear.nut
    {
        en = "A masterfully crafted goblin spear. Accurate, fast and deadly in the hands of any skilled fighter."
        es = "Una lanza goblin magistralmente elaborada. Precisa, rápida y mortal en manos de cualquier luchador experto."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_greataxe.nut
    {
        en = "A long, two-handed axe designed for battle that bears down heavy with every swing and can easily cut a man in two."
        es = "Un hacha larga y pesada de dos manos diseñada para la batalla que aplasta con cada golpe y puede cortar fácilmente a un hombre en dos."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_greatsword.nut
    {
        en = "This greatsword is a true masterpiece, with a blade that is both flexible yet extremely durable."
        es = "Esta gran espada es una verdadera obra maestra, con una hoja que es a la vez flexible pero extremadamente duradera. El sueño de todo esgrimista o caballero."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_handgonne.nut
    {
        en = "An expertly-cast iron barrel with a long wooden handle. It fires shrapnel in a cone and can hit multiple targets with one shot. Can not be used while engaged in melee."
        es = "Un cañón de hierro fundido por expertos con un largo mango de madera. Dispara metralla en un cono y puede alcanzar múltiples objetivos con un solo disparo. No se puede utilizar mientras se está en combate cuerpo a cuerpo."
    }
    {
        en = "Firearm, Two-Handed"
        es = "Arma de fuego, Dos manos"
    }
    {
        // return this.getRandomCharacterName(this.Const.Strings.SouthernNamesLast) + "\'s " + this.m.NameList[this.Math.rand(0, this.m.NameList.len() - 1)];
        mode = "pattern"
        en = "<_event.m.Bowyer.getNameOnly()>'s <item.m.Name>"
        es = "<item.m.Name> de <_event.m.Bowyer.getNameOnly()>"
    }
    {
        // return this.getRandomCharacterName(this.Const.Strings.NomadChampionStandalone) + "\'s " + this.m.NameList[this.Math.rand(0, this.m.NameList.len() - 1)];
        mode = "pattern"
        en = "<_event.m.Bowyer.getNameOnly()>'s <item.m.Name>"
        es = "<item.m.Name> de <_event.m.Bowyer.getNameOnly()>"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_heavy_rusty_axe.nut
    {
        en = "This heavy and ornated axe belonged to a valued member of a barbarian tribe. Its decorations and relatively high craftsmanship are a rare find among the wild warriors of the north."
        es = "Esta hacha pesada y ornamentada pertenecía a un valioso miembro de una tribu bárbara. Sus decoraciones y su artesanía relativamente soberbia son un hallazgo raro entre los guerreros salvajes del norte."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_javelin.nut
    {
        en = "A couple of light throwing spears that are skillfully balanced to fly as straight as possible. Have limited range and are exhausting to throw, but may inflict devastating injuries."
        es = "Un par de lanzas ligeras que están hábilmente equilibradas para volar lo más rectas posible. Tienen un alcance limitado y son agotadoras de lanzar, pero pueden causar lesiones devastadoras."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_khopesh.nut
    {
        en = "An elegant curved blade that is fitted on a richly ornated grip. Pieces like this have been lost for centuries and are said to date back to the height of the empire."
        es = "Una elegante hoja curva montada sobre una empuñadura ricamente decorada. Piezas como esta se han perdido durante siglos y se dice que datan del apogeo del imperio."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_longaxe.nut
    {
        en = "A relatively thin blade on a very long shaft used for devastating cutting attacks over some distance, and to render shields unusable from behind the frontline. This longaxe must be the work of an extraordinary craftsman."
        es = "Una hoja relativamente delgada en un mango muy largo que se usa para ataques cortantes devastadores a cierta distancia y para inutilizar escudos detrás de la línea del frente. Esta hacha larga debe ser obra de un artesano extraordinario."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_mace.nut
    {
        en = "A full-metal mace with a short shaft and attached blades. The smith who forged this weapon certainly knew what he was doing."
        es = "Una maza totalmente metálica con un mango corto y filos en su cabeza. El herrero que forjó esta arma ciertamente sabía lo que estaba haciendo."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_pike.nut
    {
        en = "A long pike used for thrusting over some distance and keeping the enemy at bay. This particular pike is skillfully crafted from flexible wood that may bend but never snap, and the metal tip consists of an alloy rarely seen in these parts of the world."
        es = "Una pica larga que se utiliza para empujar a cierta distancia y mantener al enemigo a raya. Esta pica en particular está hábilmente elaborada con madera flexible que puede doblarse pero nunca romperse, y la punta de metal consiste en una aleación que rara vez se ve en estas partes del mundo."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_poleaxe.nut
    {
        en = "A singularly well-crafted polearm for knightly duels. The intricate decorations upon its striking head leave little doubt to the wielder's status."
        es = ""
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_polehammer.nut
    {
        en = "A crude weapon like a polehammer can also be crafted with passion, skill and attention to detail, as this exemplar showcases impressively."
        es = "Un arma tosca como un martillo enastado también se puede fabricar con pasión, habilidad y atención al detalle, como lo demuestra de manera impresionante este ejemplar."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_polemace.nut
    {
        en = "A crude weapon like a polemace can also be crafted with passion, skill and attention to detail, as this exemplar showcases impressively."
        es = "Un arma tosca como una maza enastada también se puede fabricar con pasión, habilidad y atención al detalle, como lo demuestra de manera impresionante este ejemplar."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_qatal_dagger.nut
    {
        en = "An exquisitely crafted curved blade, notoriously used by assassins of the southern deserts. Particularly effective against targets already debilitated."
        es = "Una hoja curva exquisitamente elaborada, muy utilizada por los asesinos de los desiertos del sur. Particularmente eficaz contra objetivos ya debilitados."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_rusty_warblade.nut
    {
        en = "This massive and exceptionally well-crafted warblade is covered with runes and decorations that are typical for the barbarian tribes of the north."
        es = "Esta enorme hoja de guerra, excepcionalmente bien elaborada, está cubierta de runas y adornos típicos de las tribus bárbaras del norte."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_shamshir.nut
    {
        en = "A Shamshir already is an exquisite and exotic weapon in these parts, but this piece is of extraordinary quality. It will cut through flesh and bone just as easily as through a ripe melon."
        es = "Un Shamshir ya es un arma exquisita y exótica por estos lares, pero esta pieza es de una calidad extraordinaria. Cortará la carne y el hueso con la misma facilidad que a un melón maduro."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_skullhammer.nut
    {
        en = "This crude and heavy hammer is decorated with additional animals skulls as if not impressive enough already. Like a ram's head, it will crush its target."
        es = "Este tosco y pesado martillo está decorado con calaveras de animales adicionales, como si ya no fuera lo suficientemente impresionante. Como la cabeza de un carnero, aplastará a su objetivo."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_spear.nut
    {
        en = "A masterfully crafted spear that feels surprisingly light, yet sturdy."
        es = "Una lanza magistralmente elaborada que se siente sorprendentemente ligera, pero resistente."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_spetum.nut
    {
        en = "This Spetum is especially well-crafted, and its three tips have been honed into perfectly pointy spikes."
        es = "Este Spetum está especialmente bien elaborado y sus tres puntas se han pulido hasta convertirlas en púas perfectamente puntiagudas."
    }
    {
        en = "Spear, Two-Handed"
        es = "Lanza, Dos manos"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_sword.nut
    {
        en = "A well-balanced long sword with a double-edged blade. A weapon crafted as well as this one is hard to find."
        es = "Una espada larga bien equilibrada con hoja de doble filo. Un arma fabricada tan bien como ésta es difícil de encontrar."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_swordlance.nut
    {
        en = "A long pole attached to a sharp and finely balanced curved blade, used to deliver deep sweeping strikes over some distance."
        es = "Un bastón largo unido a una hoja curva, afilada y finamente equilibrada, que se utiliza para asestar golpes profundos y amplios a cierta distancia."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_three_headed_flail.nut
    {
        en = "A very rare weapon built from valuable and strong materials. Despite its ceremonial look it makes for a terrifying tool of destruction."
        es = "Un arma muy rara construida con materiales valiosos y resistentes. A pesar de su aspecto ceremonial, es una aterradora herramienta de destrucción."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_throwing_axe.nut
    {
        en = "Small axes to be thrown in an overhand motion towards a target. These ones are especially well-balanced and hardy enough to inflict serious damage to armor and shields from range."
        es = "Pequeñas hachas que se lanzan con un movimiento por encima de la cabeza hacia un objetivo. Estos están especialmente bien equilibrados y son lo suficientemente resistentes como para infligir graves daños a armaduras y escudos desde la distancia."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_two_handed_flail.nut
    {
        en = "This impressive two-handed flail has little left in common with the farming tool it originates from. It appears to have been designed by an experienced fighter and built by an extraordinarily skilled craftsman."
        es = "Este impresionante mayal de dos manos tiene poco en común con la herramienta agrícola de la que procede. Parece haber sido diseñado por un luchador experimentado y construido por un artesano extraordinariamente hábil."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_two_handed_hammer.nut
    {
        en = "A massive hammer that is surprisingly well-balanced, despite its huge weight. What it lacks in grace, it makes up for in raw force as it is used to shatter even heavily-armored enemy lines by knocking people away or to the ground."
        es = "Un martillo enorme que, a pesar de su enorme peso, está sorprendentemente bien equilibrado. Lo que le falta de gracia lo compensa con fuerza bruta, ya que se utiliza para destrozar incluso las líneas enemigas fuertemente blindadas derribando a los enemigos o tirándola al suelo."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_two_handed_mace.nut
    {
        en = "A large two-handed mace born in the fiery smithy of a true master. Despite its massive head, the weapon is well-balanced and reasonably easy to handle for an experienced individual."
        es = "Una gran maza a dos manos nacida en la ardiente forja de un verdadero maestro herrero. A pesar de su enorme cabeza, el arma está bien equilibrada y es razonablemente fácil de manejar para un individuo experimentado."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_two_handed_scimitar.nut
    {
        en = "A very large scimitar wielded with both hands. The curved blade cleaves right through any enemy, and the blade is surprisingly well balanced for its size."
        es = "Una cimitarra muy grande empuñada con ambas manos. La hoja curva atraviesa a cualquier enemigo y está sorprendentemente bien equilibrada para su tamaño."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_two_handed_spiked_mace.nut
    {
        en = "A heavy spiked mace crafted to resemble a human skull. Despite its crude appearance, this is a well balanced and deadly weapon."
        es = "Una maza pesada con púas diseñada para parecerse a un cráneo humano. A pesar de su tosca apariencia, se trata de un arma bien equilibrada y letal."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_warbow.nut
    {
        en = "Made from very strong yet flexible wood, this warbow has massive pulling power and is a rare piece of skilled craftsmanship."
        es = "Hecho de madera muy fuerte pero flexible, este arco de guerra tiene un enorme poder de tensado y es una pieza poco común de artesanía experta."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_warbrand.nut
    {
        en = "A masterfully crafted and somewhat uncommon variant of the sword with a long and thin blade, sharpened only on one side, and no crossguard. Can be used both for quick slashes and sweeping strikes."
        es = "Una variante de espada magistralmente elaborada y poco común con una hoja larga y delgada, afilada solo en un lado y sin guarda cruzada. Puede usarse tanto para cortes rápidos como para golpes amplios."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_warhammer.nut
    {
        en = "A well-crafted warhammer that easily batters through armor plates."
        es = "Un martillo de guerra bien diseñado que atraviesa fácilmente placas de armadura."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\named\named_warscythe.nut
    {
        en = "A long pole attached to a sharp curved blade, used to deliver deep sweeping strikes over some distance. This exemplar is particularly well-crafted."
        es = "Un bastón largo unido a una hoja curva y afilada, que se utiliza para asestar golpes profundos y amplios a cierta distancia. Este ejemplar está particularmente bien elaborado."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\noble_sword.nut
    {
        en = "Noble Sword"
        es = "Espada de noble"
    }
    {
        en = "A well-balanced long sword with a double-edged blade."
        es = "Una espada larga bien equilibrada con hoja de doble filo. Ornamentada y en buen estado, probablemente haya sido perteneciente a un noble que nunca estuvo en el campo de batalla."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\oriental\composite_bow.nut
    {
        en = "Composite Bow"
        es = "Arco compuesto"
    }
    {
        en = "A short bow made from composite layers for additional drawing power."
        es = "Un arco corto hecho de capas compuestas para un poder de tensado adicional."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\oriental\firelance.nut
    {
        en = "Fire Lance"
        es = "Lanza de fuego"
    }
    {
        en = "A spear of southern design with an explosive charge that will spew fire over two tiles when ignited. The charge is only usable once per battle, but automatically refilled after battle."
        es = "Una lanza de diseño sureño con una carga explosiva que arrojará fuego sobre dos casillas cuando se encienda. La carga solo se puede utilizar una vez por batalla, pero se recarga automáticamente después de la batalla."
    }
    {
        en = "Fire Lance (Spent)"
        es = "Lanza de fuego (Gastada)"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\oriental\handgonne.nut
    {
        en = "Handgonne"
        es = "Cañón de mano"
    }
    {
        en = "An iron barrel with a long wooden handle. It fires shrapnel in a cone and can hit multiple targets with one shot. Can not be used while engaged in melee."
        es = "Un tubo de hierro fundido con un largo mango de madera. Dispara metralla en un cono y puede alcanzar múltiples objetivos con un solo disparo. No se puede utilizar mientras se está en combate cuerpo a cuerpo."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\oriental\heavy_southern_mace.nut
    {
        en = "Heavy Southern Mace"
        es = "Maza pesada sureña"
    }
    {
        en = "A heavy winged mace commonly used by well equipped soldiers of the southern reaches."
        es = "Una maza alada pesada comúnmente utilizada por soldados bien equipados de los confines del sur."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\oriental\light_southern_mace.nut
    {
        en = "Light Southern Mace"
        es = "Maza ligera sureña"
    }
    {
        en = "A metal mace with extended wings for added effectiveness against armor."
        es = "Una maza de metal con alas extendidas para mayor efectividad contra armaduras."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\oriental\nomad_mace.nut
    {
        en = "Nomad Mace"
        es = "Maza nómada"
    }
    {
        en = "A simple wooden mace with a metal head. Weapons like this are popular among the nomads of the deserts."
        es = "Una simple maza de madera con cabeza de metal. Armas como ésta son populares entre los nómadas de los desiertos."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\oriental\nomad_sling.nut
    {
        en = "Nomad Sling"
        es = "Honda nómada"
    }
    {
        en = "A leather sling on a metal-reinforced staff, used to hurl stones at the enemy. With stones abundant everywhere, it will never run out of ammunition."
        es = "Una honda de cuero sobre un bastón reforzado con metal, utilizada para arrojar piedras al enemigo. Con piedras abundantes por todas partes, nunca se quedará sin municiones."
    }
    {
        en = "Throwing Weapon, Two-Handed"
        es = "Arma arrojadiza, Dos manos"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\oriental\polemace.nut
    {
        en = "Polemace"
        es = "Maza enastada"
    }
    {
        en = "A long mace that can be used to deliver stunning blows over a distance."
        es = "Una maza larga que se puede utilizar para asestar golpes impresionantes a distancia."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\oriental\qatal_dagger.nut
    {
        en = "Qatal Dagger"
        es = "Daga Qatal"
    }
    {
        en = "A curved blade notoriously used by assassins of the southern deserts. Particularly effective against targets already debilitated."
        es = "Una hoja curva muy utilizada por los asesinos de los desiertos del sur. Particularmente eficaz contra objetivos ya debilitados."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\oriental\saif.nut
    {
        en = "Saif"
        es = ""
    }
    {
        en = "A curved sword typically found only in the southern reaches. Excellent for slashing, but not for thrusting or penetrating armor."
        es = "Una espada curva que normalmente sólo se encuentra en los confines del sur. Excelente para cortar, pero no para apuñalar o penetrar armaduras."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\oriental\swordlance.nut
    {
        en = "Swordlance"
        es = "Hoja enastada"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\oriental\two_handed_saif.nut
    {
        en = "Two-Handed Saif"
        es = "Saif a dos manos"
    }
    {
        en = "A long version of the Saif wielded with both hands. The curved blade can cleave gruesome wounds."
        es = "Una versión larga del Saif empuñada con ambas manos. La hoja curva puede abrir heridas horribles."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\oriental\two_handed_scimitar.nut
    {
        en = "Two-Handed Scimitar"
        es = "Cimitarra a dos manos"
    }
    {
        en = "A large scimitar wielded with both hands. The curved blade cleaves right through any enemy."
        es = "Una gran cimitarra empuñada con ambas manos. La hoja curva atraviesa a cualquier enemigo."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\pickaxe.nut
    {
        en = "Pickaxe"
        es = "Pico"
    }
    {
        en = "A hard head made from metal attached to a wooden handle, the Pickaxe is a miner's tool used to break up rocks. As an improvised weapon it's unwieldy but can deliver fatal injuries even through armor."
        es = "El pico, una cabeza dura hecha de metal unida a un mango de madera, es una herramienta de minero que se utiliza para romper rocas. Como arma improvisada, es difícil de manejar, pero puede provocar heridas mortales incluso a través de la armadura."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\pike.nut
    {
        en = "A long pike used for thrusting over some distance and keeping the enemy at bay."
        es = "Una pica larga que se utiliza para realizar estocadas a cierta distancia y mantener al enemigo a raya."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\pitchfork.nut
    {
        en = "Pitchfork"
        es = "Horca"
    }
    {
        en = "An agricultural tool with a long handle and thick pointed tines used to lift and pitch straw. As an improvised weapon it can be used to keep an opponent at bay, but it won't inflict the deadliest of injuries and will perform poorly against armor."
        es = "Herramienta agrícola con mango largo y púas puntiagudas y gruesas que se utiliza para levantar y echar paja. Como arma improvisada, puede usarse para mantener a raya a un oponente, pero no infligirá las heridas más mortales y funcionará mal contra armaduras."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\poleaxe.nut
    {
        en = "Pollaxe"
        es = ""
    }
    {
        en = "A versatile polearm designed for armored combat between knights. Can deliver a wide variety of injuries."
        es = ""
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\polehammer.nut
    {
        en = "Polehammer"
        es = "Martillo enastado"
    }
    {
        en = "A warhammer mounted on a long pole, used against armored targets over some distance and from behind the frontline."
        es = "Un martillo de guerra montado en un mango largo, utilizado contra objetivos blindados a cierta distancia y detrás de la línea del frente."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\reinforced_wooden_flail.nut
    {
        en = "Reinforced Wooden Flail"
        es = "Mayal de madera reforzado"
    }
    {
        en = "Two large sticks attached with a short chain and reinforced with metal, the Reinforced Wooden Flail is an agricultural tool turned weapon. A rather unpredictable one at that, but deadly enough to fell most men with a good hit to the head, and useful to strike over or around shield cover."
        es = "Dos grandes palos unidos con una cadena corta y reforzados con metal, el mayal de madera reforzado es una herramienta agrícola convertida en arma. Una bastante impredecible, pero lo suficientemente mortal como para derribar a la mayoría de los hombres con un buen golpe en la cabeza, y útil para golpear por encima o alrededor de la cobertura del escudo."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\rondel_dagger.nut
    {
        en = "Rondel Dagger"
        es = "Daga rondel"
    }
    {
        en = "A long, quadrangular spike designed to pierce through weakpoints in armor."
        es = "Una hoja puntiaguda larga y cuadrangular diseñada para atravesar los puntos débiles de la armadura. Cuando los caballeros están en combate cercano sin sus espadas, tratarán de clavar esta arma en el visor del casco de su enemigo. Bastante brutal."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\scimitar.nut
    {
        en = "An exotic curved sword from the south that is excellent for slashing, but not for thrusting or penetrating armor."
        es = "Una espada curva exótica del sur que es excelente para cortar, pero no para estocadas o penetrar armaduras."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\scramasax.nut
    {
        en = "Scramasax"
        es = ""
    }
    {
        en = "A long and heavy knife with a one sided blade used more for hacking than slashing."
        es = "Un cuchillo largo y pesado con una hoja de un solo filo. Usado más para golpear que para cortar."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\shamshir.nut
    {
        en = "This well-crafted exotic blade from the south has a curved edge that allows it to cut deep wounds with ease, but makes it less suited for thrusting and penetrating armor. A rare find in these lands."
        es = "Esta espada exótica del sur bien elaborada tiene un borde curvo que le permite provocar heridas profundas con facilidad, pero la hace menos adecuada para apuñalar y penetrar armaduras. Un hallazgo raro en estas tierras."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\short_bow.nut
    {
        en = "Short Bow"
        es = "Arco corto"
    }
    {
        en = "A simple wooden short bow with medium range. Requires some expertise to use effectively."
        es = "Un sencillo arco corto de madera de alcance medio. Requiere cierta experiencia para utilizarlo eficazmente."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\shortsword.nut
    {
        en = "Shortsword"
        es = "Espada corta"
    }
    {
        en = "A short raw iron sword with some dents and notches, easy to wield in one hand."
        es = "Una espada corta de hierro en bruto con algunas abolladuras y muescas, fácil de blandir con una mano."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\spetum.nut
    {
        en = "Spetum"
        es = ""
    }
    {
        en = "A cross between a spear and a pike, making for a good defensive weapon. Used for thrusting over some distance and keeping the enemy at bay."
        es = "Un cruce entre una lanza y una pica, lo que la convierte en una buena arma defensiva. Se utiliza para empujar a cierta distancia y mantener al enemigo a raya."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\staff_sling.nut
    {
        en = "Staff Sling"
        es = "Fustíbalo"
    }
    {
        en = "A leather sling on a staff, used to hurl stones at the enemy. With stones abundant everywhere, it will never run out of ammunition."
        es = "Una honda de cuero sujeta a un bastón, utilizada para arrojar piedras al enemigo. Con piedras abundantes por todas partes, nunca se quedará sin municiones."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\three_headed_flail.nut
    {
        en = "Three-Headed Flail"
        es = "Mayal de tres cabezas"
    }
    {
        en = "Three separate striking heads attached to a handle by chains. Each head can hit or miss a target separately and strike over or around shield cover."
        es = "Tres cabezas contundentes separadas unidas a un mango mediante cadenas. Cada cabeza puede acertar o fallar en un objetivo por separado y golpear por encima o alrededor de la cubierta del escudo."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\throwing_axe.nut
    {
        en = "Bundle of Throwing Axes"
        es = "Bolsa de hachas arrojadizas"
    }
    {
        en = "Small axes to be thrown in an overhand motion towards a target. Heavy enough to inflict serious damage to armor and shields from range."
        es = "Pequeñas hachas que se lanzan con un movimiento por encima de la cabeza hacia un objetivo. Lo suficientemente pesada como para infligir graves daños a armaduras y escudos desde la distancia."
    }
    {
        en = "Bundle of Throwing Axes (Empty)"
        es = "Bolsa de hachas arrojadizas (vacía)"
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\throwing_spear.nut
    {
        en = "Throwing Spear"
        es = "Lanza arrojadiza"
    }
    {
        en = "Lighter than a common spear, but heavier than a javelin, this weapon is intended to be thrown over short distances. The tip will bend on impact, potentially rendering shields unusable. Can be used against unshielded opponents as well for great effect."
        es = "Más ligera que una lanza común, pero más pesada que una jabalina, esta arma está pensada para ser lanzada a distancias cortas. La punta se doblará con el impacto, lo que podría inutilizar los escudos. También se puede usar contra oponentes sin escudo para lograr un gran efecto."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\two_handed_flail.nut
    {
        en = "Two-handed Flail"
        es = "Mayal a dos manos"
    }
    {
        en = "A large and heavy metal flail that requires two hands to use. Useful to strike over or around shield cover."
        es = "Un mayal de metal grande y pesado que requiere ambas manos para usarlo. Útil para golpear sobre o alrededor de la cubierta del escudo."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\two_handed_flanged_mace.nut
    {
        en = "Two-Handed Flanged Mace"
        es = "Maza rebordeada a dos manos"
    }
    {
        en = "A large and heavy winged mace held with both hands. Receiving a blow from this weapon will leave anyone dazed and gasping for air, no matter their armor."
        es = "Una maza rebordeada grande y pesada sostenida con ambas manos. Recibir un golpe de esta arma dejará a cualquiera aturdido y sin aliento, sin importar su armadura."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\two_handed_hammer.nut
    {
        en = "Two-Handed Hammer"
        es = "Martillo a dos manos"
    }
    {
        en = "A large and heavy hammer held with both hands. What it lacks in grace, it makes up for in raw force as it is used to shatter even heavily-armored enemy lines by knocking people away or to the ground."
        es = "Un martillo grande y pesado sostenido con ambas manos. Lo que le falta de gracia lo compensa con fuerza bruta, ya que se utiliza para destrozar incluso las líneas enemigas fuertemente blindadas derribando a la gente o tirándola al suelo."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\two_handed_mace.nut
    {
        en = "Two-Handed Mace"
        es = "Maza a dos manos"
    }
    {
        en = "A massive wooden club with a spiked head. Receiving a blow from this weapon will leave anyone dazed and gasping for air, no matter their armor."
        es = "Un enorme garrote de madera con una cabeza con púas. Recibir un golpe de esta arma dejará a cualquiera aturdido y sin aliento, sin importar su armadura."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\two_handed_wooden_flail.nut
    {
        en = "Two-handed Wooden Flail"
        es = "Mayal de madera a dos manos"
    }
    {
        en = "A heavy two-handed wooden flail that can strike over or around shield cover."
        es = "Un pesado mayal de madera de dos manos que puede golpear sobre o alrededor de la cubierta del escudo."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\two_handed_wooden_hammer.nut
    {
        en = "Two-Handed Mallet"
        es = "Almádena a dos manos"
    }
    {
        en = "A large wooden mallet that is held with both hands. Can deal devastating blows that may knock even armored enemies away or to the ground."
        es = "Un gran mazo de madera que se sostiene con ambas manos. Puede asestar golpes devastadores que pueden derribar o derribar incluso a enemigos blindados."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\war_bow.nut
    {
        en = "War Bow"
        es = "Arco de guerra"
    }
    {
        en = "A long bow with massive pulling power. Distinctively designed for battle."
        es = "Un arco largo con un enorme poder de tensado. Distintivamente diseñado para la batalla."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\warbrand.nut
    {
        en = "A two-handed variant of the sword with a long and thin blade, sharpened only on one side, and no crossguard. Can be used both for quick slashes and sweeping strikes."
        es = "Una variante de la espada a dos manos con una hoja larga y delgada, afilada solo en un lado y sin guarda cruzada. Puede usarse tanto para cortes rápidos como para golpes amplios."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\warfork.nut
    {
        en = "Warfork"
        es = "Horca de guerra"
    }
    {
        en = "A pitchfork re-forged into a battlefield weapon that is a cross between a spear and a pike. Used for thrusting over some distance and keeping the enemy at bay."
        es = "Una horca reconvertida en un arma de campo de batalla que es un cruce entre una lanza y una pica. Se utiliza para empujar a cierta distancia y mantener al enemigo a raya."
    }
    // FILE: D:\GOG\Battle Brothers\!Downloads\bbros\bin\comparer\original_current\scripts\items\weapons\warhammer.nut
    {
        en = "Warhammer"
        es = "Martillo de guerra"
    }
    {
        en = "A short iron warhammer that easily batters through armor plates."
        es = "Un martillo de guerra de hierro corto que atraviesa fácilmente las placas de armadura."
    }
